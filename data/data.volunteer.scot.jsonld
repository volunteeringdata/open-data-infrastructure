            "id": "https://data.volunteer.scot/Organisation/00124000008niREAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008niREAAY/rock-trust",
            "name": "Rock Trust",
            "description": "We are Scotland’s leading youth homelessness charity. We believe that no young person should ever face homelessness. We support young people to avoid and move on from homelessness, helping them build the confidence, skills and stability they need to thrive in adulthood. We also influence policy and practice to create a Scotland where no young person is left behind.\r\n\r\nWe don’t follow the system, we change it, continually championing the voices and experiences of all young people.\r\n\r\nOur long-term vision is to end youth homelessness, our more immediate mission is to ensure that every young person in Scotland has access to expert youth specific services to assist them to avoid, resolve and move on from homelessness.\r\n\r\nOur strategy for achieving this focuses on three key activities, which we believe, will make homelessness rare, brief and non-recurring: Prioritise Prevention, Increase Housing, Focus on Futures.",
            "website": "http://www.rocktrust.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC018708"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F4f5fa524-05a0-70c0-104d-be539c9f7caa%2F7q8SDjwvwFOdhTumfNccBbyYZEv1%2Fuser-upload.jpg?alt=media&token=97d04fcf-dc60-497d-ad9c-162cd3b93039",
