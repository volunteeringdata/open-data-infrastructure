            "dc:source": "https://volunteer.scot/organisations/0011p00002iiinqAAA/scottish-communities-climate-action-network",
            "name": "Scottish Communities Climate Action Network",
            "description": "Scottish Communities Climate Action Network (SCCAN)’s purpose is to inspire and promote, connect and support community-led action in Scotland to address the Climate Emergency.  Please see our website: https://www.scottishcommunitiescan.org.uk",
            "website": "https://www.scottishcommunitiescan.org.uk",
