        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002ihEcMAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002ihEcMAAU/food-train-connects-north-ayrshire",
            "name": "Food Train Connects North Ayrshire",
            "description": "To relieve the poverty of disabled, infirm and housebound persons and other persons in necessitous circumstances",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC024843"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000OUumbAAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000OUumbAAD/phone-friends",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Phone Friends",
                    "description": "## Description\n\nFood Train Connects aims to match two groups of people. \r\n•\tOlder people (aged 65+) throughout Scotland requiring a little bit of a helping hand to continue living comfortably and contentedly at home; and\r\n•\tVolunteers who are willing to provide that regular support via telephone to help improve the quality of life of an older person. \r\n\r\nFood Train Connects exists to provide support for older people by making these vital connections.  \r\n\r\n•\tVolunteer Phone Friends who are able to make weekly or fortnightly calls to a Food Train Customer and provide a supportive, listening ear.  You will also be required to provide a brief report of date / length of call and highlight any issues of concern to Food Train staff.\r\nVolunteer’s will use their own phone, guidance will be given on keeping their number hidden for security. We don’t offer expenses for the Phone Friends role.  The calls are for about 30 min every week or fortnight.\n\n## Experience required\n\nFriendly, chatty nature and common sense required.\n\n## Training details\n\nInduction, ongoing support and training from a named person.\n\n## Travel details\n\nHome- based",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000OUumbAAD#role",
                        "type": "Role",
                        "title": "Phone Friends",
                        "description": "Friendly, chatty nature and common sense required.",
                        "applyLink": "https://volunteer.scot/search/a0g0800000OUumbAAD/phone-friends?#modal_register_a0g0800000OUumbAAD",
                        "allowsRemoteParticipation": true,
                        "minimumAge": "16",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/Elderly",
                                "skos:prefLabel": "Elderly"
                            }
                        ],
                        "service": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/NamedContactForVolunteer",
                                "skos:prefLabel": "Named Contact For Volunteer"
                            },
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/WheelchairAccessDisabledAccessToilet",
                                "skos:prefLabel": "Wheelchair Access/Disabled Access Toilet"
                            }
                        ],
                        "specialistRole": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/SpecialistRole/HomeBasedVolunteering",
                                "skos:prefLabel": "Home-based volunteering"
                            }
                        ],
