            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000FUmJVYA1",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000FUmJVYA1/social-media-volunteer",
                    "publishStart": "2026-07-28",
                    "publishEnd": "2027-01-25",
                    "title": "Social Media Volunteer",
                    "description": "## Description\n\nThe Orkney Arts Society require a Social Media Volunteer to manage the OAS website and social media communications via Facebook, Instagram and Threads. \r\n\r\nThe volunteer will be a member of the Orkney Arts Society and attend its committee meetings. The main activity will be posting about OAS events and other arts events in Orkney.\r\n\r\nThe volunteer will have the opportunity to gain an understanding of the arts landscape in Orkney, in particular classical and jazz music, visual arts and literature.  They will also gain experience in growing the online presence of a dynamic voluntary arts association.\n\n## Experience required\n\nPrevious experience in maintaining a website and using social media. An interest in the arts.\n\n## Training details\n\nThere will be a handover from the previous post holder.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F5497e277-0e8e-4efe-a8a8-82482bbbca11%2FliLEC2s9ZwYA46gEa6AxGTVGunx2%2Flisting.jpg?alt=media&token=64183ce4-0ea5-4816-8376-4347f98fc517",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000FUmJVYA1#role",
                        "type": "Role",
                        "title": "Social Media Volunteer",
                        "description": "Previous experience in maintaining a website and using social media. An interest in the arts.",
