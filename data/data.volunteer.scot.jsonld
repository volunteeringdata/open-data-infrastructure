            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000UQvCvYAL/west-lothian-climate-action-network",
            "name": "West Lothian Climate Action Network",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000AR1ruYAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000AR1ruYAD/climate-action-outreach-volunteer",
                    "publishStart": "2026-08-25",
                    "publishEnd": "2027-02-21",
                    "title": "Climate Action Outreach Volunteer",
                    "description": "## Description\n\nThe Outreach Volunteer will aid in Climate Action Education in West Lothian at events organised by WLCAN. The purpose of this role is to help more people get involved in Climate Action and to increase the capacity for Climate Action in West Lothian. The volunteer will benefit from climate action training (in house and external), support from staff and WLCAN Hub, experienced in the environmental sector. The volunteer would also be given the opportunity to give ideas and help organise events for their own community. This role is designed to be flexible and develop the volunteers' own passions, and will be encouraged to share their ideas for future work.\n\n## Experience required\n\nVolunteers do not need to have expertise or experience, just a passion for climate action and an enthusiasm for meeting and talking to new people.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000AR1ruYAD#role",
                        "type": "Role",
                        "title": "Climate Action Outreach Volunteer",
                        "description": "Volunteers do not need to have expertise or experience, just a passion for climate action and an enthusiasm for meeting and talking to new people.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000AR1ruYAD/climate-action-outreach-volunteer?#modal_register_a0gQD00000AR1ruYAD",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/GeneralPublic",
                                "skos:prefLabel": "General Public"
                            }
                        ],
