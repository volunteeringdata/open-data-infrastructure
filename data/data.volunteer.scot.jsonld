        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nWtxAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nWtxAAE/alzheimer-scotland-west-dunbartonshire",
            "name": "Alzheimer Scotland (West Dunbartonshire)",
            "description": "To improve the lives of everyone affected by dementia. To provide information, support and a network of services and support groups.",
            "website": "https://www.alzscot.org/living-with-dementia/getting-support/find-support-near-you/west-dunbartonshire-dementia-resource-centre",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC022315"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Carers",
                    "skos:prefLabel": "Carers"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
