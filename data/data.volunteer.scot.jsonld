                    }
                },
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000AkChxYAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000AkChxYAF/trainee-bicycle-mechanicbicycle-mechanic",
                    "publishStart": "2025-07-04",
                    "publishEnd": "2027-01-01",
                    "title": "Trainee Bicycle Mechanic/Bicycle Mechanic",
                    "description": "## Description\n\nWe are looking for volunteer trainee bike mechanics and already qualified bike mechanics to volunteer.\r\n\r\nYour job will be to attend The Bike Hub and Dr Bike sessions, working closely with the lead mechanic and the rest of the team.  You will assess and carry out repairs on customers bikes and donated bikes for resale.  A knowledge of bicycles or a mechanical background will be an advantage.\r\n\r\nYou will also be required to carry out sales assistant roles and be able to talk to customers about bikes and what we do as a charity.  We maintain very high standards of customer service which you will be expected to uphold.  We also maintain very high standards of work of which you will be expected to do the same, keeping to these standards.\r\n\r\nTraining/support available: On the job training will be given.  You may be invited to attend training sessions out with normal hours but this is not mandatory as a volunteer.  If you fit in and provide good levels of work and team work you will have the opportunity to gain qualifications with the appropriate accreditation.  This will be at the Bike Hub Managers discretion.\r\n\r\nWe are located at the Bike Hub in Cowan Park, Barrhead.\r\n\r\nMinimum age: 18.\r\n\r\nPVG membership is required.\n\n## Travel details\n\nThe Bike Hub, Cowan Park, Barrhead, G78 1SS",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F1c81de4b-a719-4474-bdfd-7b5382f76c17%2FyKvNsCtq9ZNPsjkwuXTxwxTv3Tx2%2Flisting.jpg?alt=media&token=99488215-d666-4524-9237-b1bdff5143dd",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000AkChxYAF#role",
                        "type": "Role",
                        "title": "Trainee Bicycle Mechanic/Bicycle Mechanic",
