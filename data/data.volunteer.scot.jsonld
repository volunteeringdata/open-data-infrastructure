            "dc:source": "https://volunteer.scot/organisations/00124000008nbQYAAY/pilton-equalities-project",
            "name": "Pilton Equalities Project",
            "description": "To enhance the quality of life for older people in North Edinburgh by continuing to develop services that measurably reduce isolation and which enable people and other vulnerable and isolated adults to actively participate in community life.",
            "website": "http://www.pepscot.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC010108"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Elderly",
