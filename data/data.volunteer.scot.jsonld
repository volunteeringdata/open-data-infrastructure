            "dc:source": "https://volunteer.scot/organisations/001QD00000dUOucYAG/the-conservation-volunteers-west-dunbartonshire",
            "name": "The Conservation Volunteers (West Dunbartonshire)",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039302"
