        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZ5JAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZ5JAAU/sport-aberdeen",
            "name": "Sport Aberdeen",
            "description": "Sport Aberdeen is a private limited company (Company Registration No 350981) and a registered charity with the Scottish Charity Register (Registered Charity No. SC040973). We deliver dynamic and innovative services across the city from a network of specialist venues, complemented by a range of cutting-edge sport, physical activity and health-related programmes within community settings.",
            "website": "http://www.sportaberdeen.co.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC040973"
                }
            ],
