        {
            "id": "https://data.volunteer.scot/Organisation/001QD000016HqssYAC",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000016HqssYAC/kilmarnock-rfc",
            "name": "Kilmarnock RFC",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HlYCXYA3",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HlYCXYA3/volunteer-coaches",
                    "publishStart": "2026-07-14",
                    "publishEnd": "2027-01-12",
                    "title": "Volunteer Coaches",
                    "description": "## Description\n\nWe want you! Kilmarnock RFC is looking for enthusiastic volunteer coaches to help our growing club and inspire the next generation of rugby stars.\n\n## Experience required\n\nNo previous experience is required, although previous playing/coaching experience would be advantageous.\n\n## Training details\n\nRegular training courses are available and will supported by the rugby club.\n\n## Frequency commitment details\n\nTraining sessions take place every Wednesday evening with matches taking place on Sunday morning or afternoons. Commitment can be discussed with development officer.\n\n## Travel details\n\nKilmarncok Rugby Club\nQueens Drive\nKA1 3XF\n\n(opposite Asda)\n\n## Taster details\n\nYou will meet with the club development officer who will discuss your role and give guidance on session planning and delivery.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-volunteerscotland-search.appspot.com/o/opportunities%2F1UGZA7uMcqcmWN0PlBRdb85BrMy1%2FVupOSSQRHuPYpoUh-thumbnail.jpg?alt=media&token=bdcf04ec-3fcd-4501-8e96-e6f71de3f20e",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HlYCXYA3#role",
                        "type": "Role",
                        "title": "Volunteer Coaches",
                        "description": "No previous experience is required, although previous playing/coaching experience would be advantageous.",
                        "commitment": "Training sessions take place every Wednesday evening with matches taking place on Sunday morning or afternoons. Commitment can be discussed with development officer.",
