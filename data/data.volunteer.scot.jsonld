                },
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000IwOqvYAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000IwOqvYAF/handy-person",
                    "publishStart": "2026-10-26",
                    "publishEnd": "2027-04-26",
                    "title": "Handy Person",
                    "description": "## Summary\n\nAre you practical and enjoy fixing things? We are looking for a volunteer handy person to help keep the Boomerang Centre welcoming and well maintained for everyone who uses it.\n\n## Description\n\nAre you practical and enjoy fixing things? We are looking for a volunteer handy person to help keep the Boomerang Centre welcoming and well maintained for everyone who uses it.\r\n\r\nThe role could include small repairs, painting and touch-ups, putting up shelves, assembling furniture and other general maintenance tasks around the centre. Tasks will be agreed with you to suit your skills and experience, with specialist work left to qualified tradespeople.\r\n\r\nYour help will make a real difference to the upkeep of our busy community centre and the groups and activities we support.\n\n## Experience required\n\nPractical DIY or general maintenance skills would be helpful, along with a reliable approach and an awareness of working safely. You do not need to be a qualified tradesperson for general tasks.\n\n## Training details\n\nAn introduction to the centre and guidance on agreed tasks will be provided. Tasks will be matched to your skills and confidence.\n\n## Travel details\n\nBoomerang Centre, 10 Kemback Street, Dundee, DD4 6ET.\n\n## Travel expenses\n\nTravel expenses for getting to the centre may be reimbursed.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000IwOqvYAF#role",
                        "type": "Role",
                        "title": "Handy Person",
                        "description": "Practical DIY or general maintenance skills would be helpful, along with a reliable approach and an awareness of working safely. You do not need to be a qualified tradesperson for general tasks.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000IwOqvYAF/handy-person?#modal_register_a0gQD00000IwOqvYAF",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
