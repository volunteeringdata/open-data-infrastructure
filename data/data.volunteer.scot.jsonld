        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000Jxzm6YAB",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000Jxzm6YAB/the-vegan-society-midlothian",
            "name": "The Vegan Society (Midlothian)",
            "description": "The Vegan Society's mission is to make veganism mainstream.\r\n\r\nWe're working tirelessly to make veganism an easily-adopted and widely-recognised approach to reducing animal suffering and environmental damage. We do so through peaceful and factual dialogue with individuals, organisations and businesses.",
            "website": "https://www.vegansociety.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC049495"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CampaigningLobbying",
                    "skos:prefLabel": "Campaigning / Lobbying"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000004XabuYAC",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000004XabuYAC/vegan-community-advocate",
                    "publishStart": "2024-07-11",
                    "publishEnd": "2027-02-10",
                    "title": "Vegan Community Advocate",
                    "description": "## Description\n\nEvery time we launch or refocus on a campaign, you will be sent a collection of tasks to choose from. These could include writing to an MP, posting on social media, or finding locations for our leaflets nearby.\r\n\r\nYou will form part of a local group, headed up by a local Organiser. Your Community Organiser will be in regular contact to ensure you have everything you need and ask for your updates on tasks. They will co-ordinate attendance at local events such as vegan fairs, and invite you to help out.\r\n\r\nYou’ll make sure to stay in touch with the Organiser and bring your passion to tasks. Activities can range from helping out at a stall to emailing a business about their vegan options. It could also mean writing to a local newspaper or lobbying an MP. You're in control of which tasks you get involved in.\n\n## Experience required\n\nThis would suit somebody who would love to be involved in vegan outreach, but needs some flexibility. You would be reliable in answering emails, even if you can't take part in activities for a few weeks.\n\n## Training details\n\nThere will be a full induction to the role. To start with, we will provide handbooks and training videos. This will be done remotely.\r\n\r\nYou will also have a big welcome from your local Organiser.\n\n## Travel expenses\n\nWe never expect volunteers to be out of pocket. We reimburse expenses related to the role, such as travel and payments for stalls at events.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F66c03f67-bc5f-42c2-9414-185aa0e610e4%2FWkLzgT1VE9cAHEWcVMpdVMd5bL63%2Flisting.jpg?alt=media&token=041ad7bf-8f28-4845-a76b-c9329428b1f8",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000004XabuYAC#role",
                        "type": "Role",
                        "title": "Vegan Community Advocate",
                        "description": "This would suit somebody who would love to be involved in vegan outreach, but needs some flexibility. You would be reliable in answering emails, even if you can't take part in activities for a few weeks.",
                        "applyLink": "https://volunteer.scot/search/a0gQD000004XabuYAC/vegan-community-advocate?#modal_register_a0gQD000004XabuYAC",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
