        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002ii6DSAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002ii6DSAAY/earth-worms-community-garden",
            "name": "Earth & Worms Community Garden",
            "description": "Earth & Worms is a community-garden based in Tillydrone, Aberdeen where a range of fruits, vegetables and other plants are grown by volunteers. The community-garden has made amazing progress since it’s foundation during the Covid lockdowns, transforming an area of overgrown derelict land into a productive garden with a polytunnel, raised-beds, wildlife pond, composting stations, pizza oven, fruit trees and wildflower meadow. Earth & Worms also partakes in broader community engagement in Aberdeen by taking part in events such as Envirolution and responding to city-wide consultations. Out work is primarily delivered by a core-group of volunteers during occasional ‘work days’ and we also regularly host social events around the fire, such as winter solstice parties and apple pressing days.",
            "website": "https://www.facebook.com/earth.n.worms",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
                },
