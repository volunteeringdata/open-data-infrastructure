        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZWhAAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZWhAAM/borders-additional-needs-group-bang",
            "name": "Borders Additional Needs Group (BANG)",
            "description": "Our aims are to provide support for families with children who have rare, complex or additional needs. We do this by holding monthly meetings for families so children can play and parent/carers can have some much needed time out. We provide regular trips and days out for the whole family so families who find it difficult or who do not have the means to have a trip can come along at no charge.",
            "website": "https://www.bordersadditionalneeds.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC041955"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Carers",
                    "skos:prefLabel": "Carers"
                },
                {
