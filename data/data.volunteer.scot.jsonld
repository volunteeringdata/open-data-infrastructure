            "name": "University of Edinburgh",
            "description": "To provide first class education to vet students so they qualify with excellent range of skills and knowledge",
            "website": "http://www.ed.ac.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC005336"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
