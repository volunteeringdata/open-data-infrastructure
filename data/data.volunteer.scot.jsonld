            "dc:source": "https://volunteer.scot/organisations/00124000008nXfcAAE/aberdeen-arts-centre",
            "name": "Aberdeen Arts Centre",
            "description": "Aberdeen Arts Centre is an independent arts venue and registered charity in the heart of Aberdeen, Scotland — delivering a varied programme of theatre, dance, music, spoken word, comedy, film and creative learning events.",
            "website": "https://www.aberdeenartscentre.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC028552"
