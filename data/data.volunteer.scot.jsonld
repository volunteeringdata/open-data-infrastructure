            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC018761"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HshKjYAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HshKjYAJ/retail-volunteer-prestwick",
                    "publishStart": "2026-08-11",
                    "publishEnd": "2027-02-09",
                    "title": "Retail Volunteer (Prestwick)",
                    "description": "## Description\n\nWe are looking for friendly volunteers to help our shop management team assist customers and donors, and ensure the shop is tidy and well stocked.\r\n\r\nWhether you have a passion for for customer service and pre-loved fashion or you would prefer to be behind the scenes in our stockroom, your help could make a difference to people in Scotland who are isolated, scared or anxious about their condition.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HshKjYAJ#role",
