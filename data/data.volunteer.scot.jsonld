            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000GK6ckYAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000GK6ckYAD/sspca-student-ambassador-uist",
                    "publishStart": "2026-04-01",
                    "publishEnd": "2027-02-26",
                    "title": "SSPCA Student Ambassador (Uist)",
                    "description": "## Description\n\nCalling all students in the Outer Hebrides!  The SSPCA needs your help to make Scotland the best place for all animals to live!  Volunteering is good for you in many ways.  It has a proven benefit to your physical and mental well being; offers great social opportunities and can also help you gain skills for your CV or applying for jobs.  Want to help but only got a few minutes to spare?  Why not help by simply sharing information and campaigns on social media channels?  These quick and easy tasks can be done on your phone while on campus, on the bus....anywere you like!  Fundraising is a great way to meet new people in your community while raising much needed cash for animals in need - everything from bucket shakes to adrenaline events or set up a small event on campus!\n\n## Experience required\n\nLots of enthusiasm\r\nAbility to use social media channels for online posts.\r\nAn understanding of the Society's work - we will give you training!\r\nA pleasant and polite manner when dealing with the public.\r\nConfidence to interact with other people.\r\nAbility to work as part of a team.\r\nAbility to take instruction and follow health and safety requirements at events.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000GK6ckYAD#role",
