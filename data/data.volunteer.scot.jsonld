        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000l7PbPYAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000l7PbPYAU/adelphe-connect",
            "name": "Adelphe Connect",
            "description": "Adelphe is designed to uplift and support ethnic minority women on their journey to thrive. Many women feel disconnected, isolated, or overlooked, whether they’re adjusting to a new place or have lived in their community for some time. They may have big dreams—like growing a business, advancing their career, or simply feeling more at home—but struggle to find the support and visibility they need to take those steps.\r\nThey run a podcast, Adelphe Drop in Hub (multi cultural/minority groups), and mentoring and coaching support for minority ethnic women.",
            "website": "https://www.adelpheconnect.co.uk/about/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC051953"
                }
            ],
            "cause": [
                {
