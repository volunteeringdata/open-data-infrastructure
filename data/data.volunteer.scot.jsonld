                                "skos:prefLabel": "Home-based volunteering"
                            },
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/SpecialistRole/BoardTrusteeRole",
                                "skos:prefLabel": "Board/trustee role"
                            }
                        ],
                        "reward": [
                            "https://ns.volunteeringdata.io/TrainingProvided"
                        ]
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
                                "type": "Location",
                                "name": "TD6 0SA",
                                "address": "TD6 0SA",
