        {
            "id": "https://data.volunteer.scot/Organisation/0012400000kHUFIAA4",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000kHUFIAA4/abilitynet-north-east-scotland",
            "name": "AbilityNet (North East Scotland)",
            "description": "AbilityNet is a registered charity that exists to help change the lives of disabled people by helping people to use digital technology at work, at home or in education. Our vision is to create “A world in which digital services are equally accessible to all.”",
            "website": "https://www.abilitynet.org.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
