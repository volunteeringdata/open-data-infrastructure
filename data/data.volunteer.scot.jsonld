        {
            "id": "https://data.volunteer.scot/Organisation/001QD000014uGylYAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000014uGylYAE/lgbt-health-and-wellbeing",
            "name": "LGBT Health and Wellbeing",
            "description": "LGBT Health and Wellbeing was founded in 2003 by community members who wanted something simple: a Scotland where every LGBTQ+ person can thrive. Over 20 years on, that vision continues to guide us as we adapt and respond in the face of change.\r\n\r\nWe offer a range of support to help people build connection and confidence. From community-led groups and wellbeing activities, through to information, signposting, and emotional support delivered in groups and one-to-one. For those who need more structured support, we also provide accredited counselling, ensuring people can access the right support at the right time.",
            "website": "https://lgbthealth.org.uk/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Counselling",
                    "skos:prefLabel": "Counselling"
                },
                {
