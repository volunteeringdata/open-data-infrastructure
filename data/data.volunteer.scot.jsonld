        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nYzpAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nYzpAAE/retail-trust",
            "name": "Retail Trust",
            "description": "Retail Trust is the only charity that looks after all five million people working in and retired from retail. Our experience in retirement housing dates back to 1898, making Retail Trust one of the longest established providers of retirement accommodation in the UK. We are the only retirement service exclusive to the retail industry and our experience enables us to understand retirement needs in a way nobody else can.\n\nYou can make a difference to the lives of older people and help them to live independently and with dignity within the Crookfur Homes complex. A few hours a month is all it takes to make a real \ndifference and you will be providing much-needed support and services to people who need them most.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039684"
                }
            ],
            "cause": [
