        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZ9LAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZ9LAAU/boomerang",
            "name": "Boomerang",
            "description": "Boomerang was set up in 1999 to provide a safe, comfortable and friendly centre in the heart of the community to stimulate community involvement and development with an aim to community regeneration. The project provides a user led centre assisting a variety of groups with varying interests to increase confidence, promote skills and strengthen individual identity and responsibilities.",
            "website": "http://www.boomerang.org.uk/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BlackMinorityEthnic",
                    "skos:prefLabel": "Black / Minority Ethnic"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
