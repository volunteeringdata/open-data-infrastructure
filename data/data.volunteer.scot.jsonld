            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00001fiFikAAE/bon-accord-heritage",
            "name": "Bon Accord Heritage",
            "description": "Bon Accord Heritage is the registered charity / SCIO (Scottish Charitable Incorporated Organisation) set up to renovate and reopen the much-loved Art Deco Bon Accord Baths in Aberdeen city centre.",
            "website": "https://www.facebook.com/savebonaccordbaths",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
                    "skos:prefLabel": "Arts and Culture"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
                },
                {
