        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000ecDIEYA2",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000ecDIEYA2/amz-activities-group",
            "name": "AMZ Activities Group",
            "description": "AMZ Activities Group is a non-profit organisation that provides inclusive, meaningful daytime activities for adults with disabilities. We believe in creating a fun, supportive space where everyone can learn new skills, build confidence, and enjoy social connection. We run a wide range of sessions including arts and crafts, music, bingo, cooking, chair Zumba, knitting, pool, darts, sound bath relaxation, and more.\r\n\r\nOur aim is to offer a positive, person-centred environment that encourages independence, creativity, and friendships. We work closely with families and carers to ensure each participant is supported in a way that suits their individual needs. Our team is passionate, friendly, and always looking to welcome new volunteers who want to make a real difference in their community.\r\n\r\nAt AMZ, every day is different—but every day is full of joy.",
            "website": "https://amzactivities.com/",
            "cause": [
                {
