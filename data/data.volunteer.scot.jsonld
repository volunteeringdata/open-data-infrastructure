            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00001VErzIAAT/beach-wheelchairs-portobello",
            "name": "Beach Wheelchairs Portobello",
            "description": "Our aim is to ensure beach access for all.",
            "website": "https://www.beachwheelchairs.org",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Carers",
                    "skos:prefLabel": "Carers"
