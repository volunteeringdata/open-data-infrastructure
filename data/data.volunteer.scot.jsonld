            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000005KTPZYA4",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000005KTPZYA4/kitchen-volunteer",
                    "publishStart": "2024-08-28",
                    "publishEnd": "2027-02-01",
                    "title": "Kitchen Volunteer",
                    "description": "## Description\n\nWe are looking for someone with who has an interest in developing their kitchen skills, with an enthusisic outlook towards food and to help with the production of food labels for our food project.\nSignpost International is based at the Roundhouse and is a charity that supports communities to help them help themselves. In Dundee we run the Roundhouse Kitchen where we take food waste and turn this into healthy nutritious meals that are then distributed through the food larders across the city.\nNo Experience required.  An interest in food and cooking.\nTravel details\n\nThe Roundhouse is in Whitfield opposite the North East Campus on Lothian Crescent. Bus routes are available locally.\nTravel expenses\n\ntravel expenses are reimbursed\n\n## Experience required\n\nNo skills required\n\n## Frequency commitment details\n\nThe kitchen is open Monday through Friday, 9am - 4.00pm\n\n## Travel details\n\nA number 17 bus will take you to the Roundhouse Community Kitchen, DD4 0HU\n\n## Travel expenses\n\nBus travel\n\n## Taster details\n\nA small induction will take place at the first meeting.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-volunteerscotland-search.appspot.com/o/opportunities%2F9DlBAnpRlOgElzzHklKxTOamoO93%2FhrQET7St0SRXBNHX-thumbnail.jpg?alt=media&token=f66b5ea1-883d-44d5-98e2-12e6d0fc2d29",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000005KTPZYA4#role",
                        "type": "Role",
                        "title": "Kitchen Volunteer",
                        "description": "No skills required",
