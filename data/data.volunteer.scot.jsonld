            "dc:source": "https://volunteer.scot/organisations/001QD00000zZEGIYA4/sandwick-fun-day",
            "name": "Sandwick Fun Day",
            "description": "The objective of the Sandwick Fun Day is to raise and distribute funds for voluntary groups, associations, charitable organisations and other groups the committee deems worthy.  By holding an event in the summer open to the whole community, with free entry and lots to see and do (which changes each year).",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityEvent",
