            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ndutAAA/shetland-befriending-scheme",
            "name": "Shetland Befriending Scheme",
            "description": "The Shetland Befriending Scheme offers a one to one support service to young people and young adults aged between 7 and 18 and to adults aged 16+ years of age.  Our volunteers support individuals who can benefit from some additional input.  There are a whole range of reasons why individuals may want to be part of our scheme but all can benefit from taking part in lots of different and exciting activities in their local community.",
            "website": "https://www.shetlandbefriendingscheme.com/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC017286"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
                    "skos:prefLabel": "Befriending / Mentoring"
                },
                {
