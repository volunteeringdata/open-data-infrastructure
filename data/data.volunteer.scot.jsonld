        {
            "id": "https://data.volunteer.scot/Organisation/00124000008ndRxAAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ndRxAAI/survivors-of-bereavement-by-suicide",
            "name": "Survivors of Bereavement by Suicide",
            "description": "Survivors of Bereavement by Suicide exist to meet the needs and break the isolation experienced by those bereaved by suicide.  We are a self-help organisation and we aim to provide a safe, confidential environment in which bereaved people can share their experiences and feelings, so giving and gaining support from each other. We also strive to improve public awareness and maintain contacts with many other statutory and voluntary organisations.\r\n\r\nWe offer a unique and distinct service for bereaved adults across the UK, run by the bereaved for the bereaved.  We currently help around 7000 people each year and we continue to grow in response to significant unmet demand.",
            "website": "https://uksobs.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC041397"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
