        {
            "id": "https://data.volunteer.scot/Organisation/0012400000VHfjlAAD",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000VHfjlAAD/simon-community-scotland",
            "name": "Simon Community Scotland",
            "description": "Every day we help make positive things happen for people facing extremely difficult circumstances. We provide expert, compassionate and flexible support and link people into the services they need.\r\n\r\nWe deliver a range of services across Glasgow, Edinburgh (Streetwork) and across Central Scotland. We work with people so that they can resolve their homelessness as quickly as possible. We maintain contact with people – in diverse circumstances – so that we can help them address the underlying reasons for their homelessness and get the support they need.\r\n\r\nBy working and learning together we can drive impact and change person to person – to transform everyone’s experience of homelessness in Scotland.",
            "website": "http://www.simonscotland.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC003076"
                }
            ],
            "cause": [
