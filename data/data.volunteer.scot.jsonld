        {
            "id": "https://data.volunteer.scot/Organisation/001QD00001AZ1KkYAL",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00001AZ1KkYAL/west-lothian-flames-basketball-club",
            "name": "West Lothian Flames Basketball Club",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000IBS6fYAH",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000IBS6fYAH/community-volunteer",
                    "publishStart": "2026-09-28",
                    "publishEnd": "2027-03-29",
                    "title": "Community Volunteer",
                    "description": "## Description\n\nWest Lothian Flames Basketball is a not-for-profit community basketball club based in Winchburgh. We are looking for friendly, reliable volunteers to help us grow and create positive opportunities for children, young people and families across West Lothian.\r\n\r\nVolunteer opportunities are available across a range of areas, including basketball coaching and assistant coaching, parent/session support, team management, events and fundraising, administration, marketing and social media, photography, sponsorship/community engagement and general volunteering.\r\n\r\nPrevious basketball experience is not required for many of our roles. Volunteers will receive appropriate induction, guidance and support, with opportunities to develop new skills and gain experience within a growing community sports organisation.\r\n\r\nDepending on the role, volunteers may help with club sessions, community outreach, events, recruitment, administration or promotion. Roles involving children will be subject to the appropriate safeguarding requirements and checks.\r\n\r\nWe welcome adults and young people interested in volunteering, including those looking to build confidence, develop employability skills, gain community experience or begin a pathway into sports coaching.\n\n## Experience required\n\nFriendly, reliable, positive and willing to work as part of a team. Good communication skills, patience, enthusiasm for supporting children and young people, and a willingness to learn. Basketball experience is helpful for coaching roles but is not required for many volunteer positions.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000IBS6fYAH#role",
                        "type": "Role",
                        "title": "Community Volunteer",
                        "description": "Friendly, reliable, positive and willing to work as part of a team. Good communication skills, patience, enthusiasm for supporting children and young people, and a willingness to learn. Basketball experience is helpful for coaching roles but is not required for many volunteer positions.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000IBS6fYAH/community-volunteer?#modal_register_a0gQD00000IBS6fYAH",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "12",
