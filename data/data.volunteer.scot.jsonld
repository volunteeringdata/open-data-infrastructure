        {
            "id": "https://data.volunteer.scot/Organisation/0010800002ut6KIAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002ut6KIAAY/sue-ryder-care-south-ayrshire",
            "name": "Sue Ryder Care (South Ayrshire)",
            "description": "Sue Ryder is a British palliative, neurological and bereavement support charity based in the United Kingdom. The organisation provides care and support for people living with terminal illnesses and neurological conditions, as well as individuals who are coping with a bereavement. \r\n\r\nHelp us be there when it matters. Last year, over 15,000 volunteers supported us across the charity, and without them, we simply couldn’t achieve our ambition to provide more expert care for more people. Come along and join our friendly team in the Prestwick Shop to help raise money for this worthwhile cause.",
            "website": "https://www.facebook.com/SueRyderPrestwick",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039578"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CharityShop",
                    "skos:prefLabel": "Charity Shop"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FundraisingFunding",
                    "skos:prefLabel": "Fundraising / Funding"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Marketing",
                    "skos:prefLabel": "Marketing"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000GvdieAAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000GvdieAAB/front-of-shop-volunteer",
                    "publishStart": "2022-11-29",
                    "publishEnd": "2027-01-03",
                    "title": "Front of shop volunteer",
                    "description": "## Description\n\nCome and join our lovely shop team in Prestwick. Have fun, learn new skills and make new friends, while supporting your local community.\r\nYou can develop new and existing a variety of new skills, including:\r\n•\tGreeting our customers who might also be mystery shoppers.\r\n•\tFilling the shop floor with treasures\r\n•\tProviding great customer service on the till\r\n•\tMaking the windows look amazing\r\n\r\nBeing a volunteer at the Sue Ryder Care Prestwick is an opportunity to: \r\n•\tMake new friends\r\n•\tShare in regular social activities\r\n•\tShare tea/coffee and cake/biscuits with other volunteers\r\n•\tShare a blether with volunteers and customers\r\n•\tGet a reference for work \r\n•\tGet experience to include in your CV\r\n•\tGet reimbursed for any out of pocket expenses\r\n•\tSupport a great charity\r\n\r\nDays and hours to suit.\r\nApply online or pop along to the shop 35/37 Main Street, Prestwick.\n\n## Experience required\n\nYou don’t need any experience to join us as a volunteer you just need to be willing and helpful with a flexible and enthusiastic approach.\n\n## Training details\n\nOnline form on first shift\n\n## Travel details\n\nPrestwick Cross bus stop nearby, free parking at train station on Main Street.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F624564f2-27ec-5788-69cf-c32504c174da%2FXiQTI9rs8XhdfYu2EPhcBTs4his2%2Flisting.jpg?alt=media&token=a67aee49-ae98-4292-a65e-5809210ca2b2",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000GvdieAAB#role",
                        "type": "Role",
                        "title": "Front of shop volunteer",
                        "description": "You don’t need any experience to join us as a volunteer you just need to be willing and helpful with a flexible and enthusiastic approach.",
                        "applyLink": "https://volunteer.scot/search/a0g0800000GvdieAAB/front-of-shop-volunteer?#modal_register_a0g0800000GvdieAAB",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
                            {
