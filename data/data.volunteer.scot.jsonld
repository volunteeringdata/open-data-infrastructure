        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nWwiAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nWwiAAE/make-a-wish-foundation-uk",
            "name": "Make-A-Wish Foundation UK",
            "description": "Critical illness brings a child’s joy to an abrupt end, but Make-A-Wish UK is part of a global movement that grants life-changing wishes that have the power to turn tears into cheers, rescuing the magic of childhood even in their toughest times, and providing a lifeline for families to spend precious time together.",
            "website": "https://www.make-a-wish.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC037479"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FamilySupport",
                    "skos:prefLabel": "Family Support"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/YoungPeople",
                    "skos:prefLabel": "Young People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HljpVYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HljpVYAR/community-wish-maker",
                    "publishStart": "2026-07-15",
                    "publishEnd": "2027-01-13",
                    "title": "Community Wish Maker",
                    "description": "## Summary\n\nGetting started as a Community Wish Maker is simple.\n\n## Description\n\nThis is a flexible, volunteer-led role that fits around your lifestyle and commitments. You decide how you'd like to support Make-A-Wish and how much time you can give.\r\n\r\nWhether it's organising a community event, engaging local businesses, securing donations, or encouraging others to get involved, you'll help generate the funds needed to grant wishes. They'll provide guidance, resources, and support along the way.\r\n\r\nGetting started as a Community Wish Maker is simple. Within your first few months, you'll choose a fundraising activity from their toolkit or create your own. This could be organising an activity independently, fundraising with friends, family or colleagues, teaming up with other local Community Wish Makers, or supporting an existing Make-A-Wish fundraising campaign or event.\r\n\r\nWhether it's a bake sale, quiz night, sponsored challenge, workplace fundraiser, school activity or local business partnership, you'll be helping raise the funds needed to grant more wishes.\n\n## Experience required\n\nMake-A-Wish are looking for people who are confident building relationships and engaging others; self-motivated and proactive; creative in finding fundraising opportunities; organised and reliable; and positive, enthusiastic, and passionate about helping others.\n\n## Training details\n\nYou will receive induction training, a Community Fundraising Volunteer Toolkit to help you get started, and a one-to-one introductory phone call with a member of the team. You will also have access to materials to get you started in your role, support from a dedicated Volunteer manager, and access to connections & networks in your region. You will have a Make-A-Wish email address / ID Badge / Letter of Authority to help with your fundraising, help and support you with ideas and steward you as much as you would like, and regular volunteer newsletters with updates, opportunities, and useful information.\n\n## Travel details\n\nThis is a remote role that takes place in the volunteer's local community.\n\n## Travel expenses\n\nTravel expenses can be reimbursed up to 30 miles.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HljpVYAR#role",
                        "type": "Role",
                        "title": "Community Wish Maker",
                        "description": "Make-A-Wish are looking for people who are confident building relationships and engaging others; self-motivated and proactive; creative in finding fundraising opportunities; organised and reliable; and positive, enthusiastic, and passionate about helping others.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000HljpVYAR/community-wish-maker?#modal_register_a0gQD00000HljpVYAR",
