        {
            "id": "https://data.volunteer.scot/Organisation/001QD000011Gt98YAC",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000011Gt98YAC/mcr-pathways",
            "name": "MCR Pathways",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JfVeQYAV",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JfVeQYAV/mentor",
                    "publishStart": "2026-11-09",
                    "publishEnd": "2027-05-10",
                    "title": "Mentor",
                    "description": "## Description\n\nAt MCR Pathways we are driven by the belief that no young person should be held back by their circumstances. Imagine a young person with incredible potential, but no one to help the see it.  You can change that.\r\n\r\nBy giving up just 1 hour of your week, you could make a transformational difference to a local young person. MCR volunteer mentors are there to be consistent, supportive and offer a listening ear.  \r\n\r\nEvery young person has a vital spark within them- a unique potential waiting to be seen, nurtured and set alight. Mentoring is a great opportunity to gain someone in your life with your best interests at heart and who wants to see you succeed.  We help adults from all backgrounds careers, and experiences to change lives through mentoring.  Just one hour per week can ignite the vital spark in a young  person. Help confidence, ambition and positive futures to glow.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000JfVeQYAV#role",
                        "type": "Role",
                        "title": "Mentor",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000JfVeQYAV/mentor?#modal_register_a0gQD00000JfVeQYAV",
                        "allowsRemoteParticipation": false
                    },
