        {
            "id": "https://data.volunteer.scot/Organisation/0012400000cxy73AAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000cxy73AAA/thaw-orkney",
            "name": "THAW Orkney",
            "description": "THAW Orkney is a charitable organisation with the aim to reduce levels of fuel poverty and achieve affordable warmth for households in all Orkney communities. \r\n\r\nWorking in partnership with other organisations we can offer a bespoke service in relation to: \r\n\r\n- energy efficiency information and advice\r\n- assistance with debt and low income\r\n- assistance with national grant funded energy efficiency programmes\r\n- income maximisation and budgeting support\r\n- advocacy and third party support\r\n- Cosy Home Packs and emergency fuel support, including electricity, oil and solid fuel, as and when available",
            "website": "https://www.thaworkney.co.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC045272"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F0cd2bd53-5571-5ace-2022-78f1873b8706%2FOIUJpTJYlES85DiBarGLlF56TE12%2Fuser-upload.jpg?alt=media&token=3f16396d-a506-4e3a-bbc9-1444be1f4aec",
