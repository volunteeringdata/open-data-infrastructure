        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZrWAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZrWAAU/tams-the-allotment-market-stall",
            "name": "TAMS - The Allotment Market Stall",
            "description": "The Allotment Market Stall (TAMS) is a community project collecting and selling excess allotment produce.\r\n\r\nTAMS connects local home growers with the community, offering allotment holders a platform to sell surplus produce. We provide locals with access to fresh, community-grown food, supporting sustainable, neighborhood-driven food networks. \r\n\r\nWhether people are a grower or a buyer, TAMS makes it easy to enjoy and share fresh, seasonal produce, making a real difference for people and communities.",
            "website": "https://www.tamstheallotmentmarketstall.org.uk/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EnvironmentRecycling",
                    "skos:prefLabel": "Environment / Recycling"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
