        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nap5AAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nap5AAA/duke-of-edinburghs-award-lewis",
            "name": "Duke of  Edinburgh's Award (Lewis)",
            "description": "To promote the award to young people and  guide them through the Duke of Edinburgh Awards process to allow them to obtain the Bronze,Silver and Gold D of E award.",
            "website": "https://www.dofe.org",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/YoungPeople",
                    "skos:prefLabel": "Young People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000Vup4lAAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000Vup4lAAB/volunteer-youth-expedition-leaders-lewis",
                    "publishStart": "2025-02-09",
                    "publishEnd": "2027-02-26",
                    "title": "Volunteer Youth Expedition Leaders (Lewis)",
                    "description": "## Description\n\nThe Western Isles Duke of Edinburgh’s Award are looking for volunteer Youth Expedition Leaders.\r\nNot all expeditions are done on foot, although this tends to be logistically most simple so many are, but can also be by other forms of transport that don’t have a motor.  Options include cycling, kayaking, sailing, horse-riding, coasteering, long boarding etc.  If you have experience in any of these activities (or others you can think of) then we would be very happy to hear from you!  Bronze expeditions are for 2 days and 1 night, Silver are 3 days and 2 night, and Gold are 4 days and 3 night.  At Bronze, there is just 1 expedition to complete, but at Silver and Gold each group complete a ‘practice’ expedition at each level, and then if leaders are happy to go on to complete their ‘qualifying’ expedition, which is assessed.  If expeditions are not your thing, you can help out with the ‘admin’ side of things supporting the young people with their ‘edofe’, logging on and uploading their evidence and ensuring that their profile is up to date and assessor reports are in.\r\nTraining will be provided for any new volunteers.\r\nCommitment would be various hours between April – September for Expeditions and the admin role would be ad-hoc all year round.\n\n## Experience required\n\nWe are looking for people throughout the Western Isles who have experience in outdoor activities such as walking, cycling, kayaking, sailing, horse-riding, coasteering and long boarding to support our youth groups on their expeditions.\n\n## Training details\n\nTraining will be provided.\n\n## Frequency commitment details\n\nCommitment would be flexible with various hours between April ? September.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fbaebc75b-ebdb-44b4-b8b8-4321aceaeaaf%2FLRTxG1oQeeZP2aKYQ1WKrkeWOO62%2Flisting.jpg?alt=media&token=d4ef68ac-ac0b-4d80-bafa-294a5b4d5400",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000Vup4lAAB#role",
                        "type": "Role",
                        "title": "Volunteer Youth Expedition Leaders (Lewis)",
                        "description": "We are looking for people throughout the Western Isles who have experience in outdoor activities such as walking, cycling, kayaking, sailing, horse-riding, coasteering and long boarding to support our youth groups on their expeditions.",
                        "commitment": "Commitment would be flexible with various hours between April ? September.",
                        "applyLink": "https://volunteer.scot/search/a0g0800000Vup4lAAB/volunteer-youth-expedition-leaders-lewis?#modal_register_a0g0800000Vup4lAAB",
