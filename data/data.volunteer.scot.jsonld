        {
            "id": "https://data.volunteer.scot/Organisation/001QD000013a1Y3YAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000013a1Y3YAI/seat-spot",
            "name": "SEAT SPOT",
            "description": "SEAT SPOT is Scottish Charity who are championing the need for shops, retail parks and council buildings to provide some accessible seating within their premises for people of all ages, who experience mobility and fatigue issues. We believe that this is a simple solution to reduce social exclusion in our high streets and town centres.",
            "website": "https://www.seatspot.co.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC050490"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityEngagement",
                    "skos:prefLabel": "Community Engagement"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HE34JYAT",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HE34JYAT/business-recruitment-volunteer",
                    "publishStart": "2026-09-14",
                    "publishEnd": "2027-02-11",
                    "title": "Business Recruitment Volunteer",
                    "description": "## Description\n\nSeat Spot is offering an exciting volunteering opportunity. If you have a few hours to spare each week Seat Spot are recruiting a team of Volunteers who will assist Seat Spot to have as many SEAT SPOTS as possible in our High Streets by going out into the community and proactively visit shops, businesses etc and encourage them to provide Seat Spots within their premises. If you enjoy talking to people, including shop and business managers and have good presentation and communications skills and a clear and friendly manner we would like to hear from you. You will inspire them to support SEAT SPOT and help get the message across about what SEAT SPOT does.\r\nAs one of our volunteers you will plan ahead which local High Streets and Businesses to target. You will then visit the identified High Streets and Businesses and explain to them the benefits of having a Seat Spot using the branded brochure. You will supply recruited businesses with branded window stickers as well as keep records and photos of new Seat Spots.\n\n## Experience required\n\nNo Expertise\n\n## Training details\n\nOn the job traning.",
                    "requiresEmergencyParticipation": false,
