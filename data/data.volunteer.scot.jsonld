        {
            "id": "https://data.volunteer.scot/Organisation/001QD000019PILyYAO",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000019PILyYAO/alopecia-uk",
            "name": "Alopecia UK",
            "description": "Alopecia UK is a registered UK charity providing support, community, and education to improve the lives of those affected by alopecia.\r\n\r\nOur Vision:  A world where people affected by alopecia live the life they want.\r\n\r\nOur Mission:  To provide support, community, and education to improve the lives of those affected by alopecia.",
            "website": "https://www.alopecia.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC044702"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityEngagement",
                    "skos:prefLabel": "Community Engagement"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000I0Mz4YAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000I0Mz4YAF/facebook-moderator-with-alopecia-uk",
                    "publishStart": "2026-09-10",
                    "publishEnd": "2027-03-11",
                    "title": "Facebook Moderator with Alopecia UK",
                    "description": "## Description\n\nOur private Facebook groups provide a safe space for people affected by alopecia from across the UK to access 24/7 support. As our online community grows we need help moderating the group to ensure it remains a welcoming, respectful, and supportive environment.\r\n\r\nAbout the role\r\nImage of a mobile phone with a Facebook window open\r\n\r\nIn a nutshell, our volunteer Facebook Moderators do 4 things:\r\n\r\nApprove/decline requests to join our groups\r\nApprove/ decline posts into the groups in line with community rules\r\nAdd supportive and signposting comments to posts\r\nKeeping an eye on content, removing spam and informing the staff team of any concerning comments/posts.\r\n\r\nWe operate a rota system, and ask if you can cover 1 shift per week. It is a very flexible role as you can do in your own time via your phone or laptop!\n\n## Experience required\n\nGood communication and IT skills\r\nReliable and trustworthy \r\nUnderstanding of Facebook Groups\r\nA commitment to building a safe space for people affected by alopecia. Please note this role requires a level 1 disclosure check.\n\n## Training details\n\nA full induction and ongoing training is provided to all volunteers.\n\n## Frequency commitment details\n\no cover a minimum of one, 4-hour shift per week (you only need to check-in on the groups once every hour - so you're not tied to your phone!). As a staff and volunteer team, we moderate the groups from 9am-9pm each day on a rota basis. We are very flexible with the rota and working around commitments.\n\n## Travel details\n\nNo travel required - you can volunteer from the comfort of your own home!",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000I0Mz4YAF#role",
                        "type": "Role",
                        "title": "Facebook Moderator with Alopecia UK",
                        "description": "Good communication and IT skills\r\nReliable and trustworthy \r\nUnderstanding of Facebook Groups\r\nA commitment to building a safe space for people affected by alopecia. Please note this role requires a level 1 disclosure check.",
                        "commitment": "o cover a minimum of one, 4-hour shift per week (you only need to check-in on the groups once every hour - so you're not tied to your phone!). As a staff and volunteer team, we moderate the groups from 9am-9pm each day on a rota basis. We are very flexible with the rota and working around commitments.",
                        "applyLink": "https://www.alopecia.org.uk/become-a-facebook-moderator",
                        "allowsRemoteParticipation": true,
