        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nbQWAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbQWAAY/ymca-edinburgh",
            "name": "YMCA Edinburgh",
            "description": "To provide local children, young people, women and families with a flexible programme of appropriate activities in a safe and welcoming Christian environment, which enables their personal growth, spiritual development, and involvement in the wider community\". We do this through a very full weekly programme.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC004425"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FaithReligionBelief",
                    "skos:prefLabel": "Faith / Religion / Belief"
                },
                {
