                        "type": "Role",
                        "title": "Bakery Assistant",
                        "description": "If you have previous customer service skills that would be helpful but no experience is required.",
                        "commitment": "Anytime",
                        "applyLink": "https://www.narture.co.uk/get-involved",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
