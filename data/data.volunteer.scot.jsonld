        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nYEjAAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nYEjAAM/kincardine-and-mearns-citizens-advice-bureau-kamcab",
            "name": "Kincardine and Mearns Citizens Advice Bureau (KAMCAB)",
            "description": "Citizens Advice Bureau Advisers enable people to make informed choices through the services we provide.  We offer confidential and impartial help in areas such as benefits, housing, employment and debt.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038869"
                }
            ],
            "cause": [
                {
