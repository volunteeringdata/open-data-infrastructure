        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nY4LAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nY4LAAU/scouts-west-lothian-district-scout-council",
            "name": "Scouts - West Lothian District Scout Council",
            "description": "The Scout Association provides adventurous activities and personal development opportunities for 400,000 young people aged 6-25.  Internationally, we have over 28 million young people enjoying the benefits of Scouting across 216 countries.  Personal development means promoting the physical, intellectual, social and spiritual well-being of the individual, helping them achieve their full potential.  In Scouting, we believe that young people develop most when they are 'learning by doing,' when they are given responsibility, work in teams, take acceptable risks and think for themselves.",
            "website": "http://www.westlothianscouts.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC035332"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/YoungPeople",
                    "skos:prefLabel": "Young People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HVBVFYA5",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HVBVFYA5/district-treasurer-board-trustee",
                    "publishStart": "2026-06-16",
                    "publishEnd": "2026-12-27",
                    "title": "District Treasurer (Board Trustee)",
                    "description": "## Description\n\nWant to use your skills to make a difference locally?\r\n\r\nWest Lothian Scouts are looking for a volunteer Treasurer to support the district behind the scenes. It’s a flexible role where your time and skills can directly help create opportunities for young people across the area.\r\n\r\nYou’ll help manage finances, support planning, and work with a friendly volunteer team — all while fitting the role around your existing work and home life.\r\n\r\nAs District Treasurer, you’ll also be part of the District Trustee Board, helping support the governance and future direction of Scouting in West Lothian. This makes the role a great opportunity for personal and career development, particularly for anyone interested in gaining experience in charity governance, leadership, finance, or committee work.\r\n\r\nThe role would suit someone who likes organisation, enjoys working with numbers, and wants to contribute to a positive local organisation.\r\n\r\nFlexible volunteering • Remote-friendly • Full support provided\n\n## Experience required\n\nNo formal qualifications are required.\r\n\r\nWe’d especially welcome people with experience in:\r\n\r\nFinance or bookkeeping\r\nAdministration\r\nRunning a business\r\nCharity or community groups\r\n\r\nMost importantly, we’re looking for someone dependable, approachable, and willing to get involved.\r\n\r\nYou do not need previous Scouting experience, and support will be provided to help you feel confident in the role.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HVBVFYA5#role",
                        "type": "Role",
                        "title": "District Treasurer (Board Trustee)",
                        "description": "No formal qualifications are required.\r\n\r\nWe’d especially welcome people with experience in:\r\n\r\nFinance or bookkeeping\r\nAdministration\r\nRunning a business\r\nCharity or community groups\r\n\r\nMost importantly, we’re looking for someone dependable, approachable, and willing to get involved.\r\n\r\nYou do not need previous Scouting experience, and support will be provided to help you feel confident in the role.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000HVBVFYA5/district-treasurer-board-trustee?#modal_register_a0gQD00000HVBVFYA5",
                        "allowsRemoteParticipation": true,
                        "minimumAge": "18",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/YoungPeople",
                                "skos:prefLabel": "Young People"
                            }
                        ],
