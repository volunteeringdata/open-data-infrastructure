        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000ReZhBYAV",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000ReZhBYAV/euans-guide",
            "name": "Euan's Guide",
            "description": "Euan’s Guide is the trusted disabled access charity working to make it easier, safer and more rewarding for disabled people and their families, friends and carers to discover accessible places.\r\n\r\nWe are best known for www.euansguide.com: thousands of disabled access reviews, one helpful community.",
            "website": "https://www.euansguide.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC045492"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
                },
                {
