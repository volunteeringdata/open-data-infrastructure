        {
            "id": "https://data.volunteer.scot/Organisation/00108000037JVemAAG",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00108000037JVemAAG/project-esperanza",
            "name": "Project Esperanza",
            "description": "Offers practical, emotional and integration support predominantly to families of African heritage but also supports a huge base of people from multi ethnic backgrounds.",
            "website": "https://projectesperanza.org.uk/",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000ILTkbYAH",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000ILTkbYAH/anti-racist-community-volunteer",
                    "publishStart": "2026-10-05",
                    "publishEnd": "2027-04-05",
                    "title": "Anti-Racist Community Volunteer",
                    "description": "## Description\n\nJoin Project Esperanza as an Anti-Racist Community Volunteer and help build a safer, more inclusive, welcoming North Edinburgh. You will be a friendly, visible presence on Friday afternoon community walks, offering reassurance to people who may feel targeted because of their race, faith, language or background. You will also support anti-racism campaigns and events, our Anti-Racist Book Club and our social media, and signpost people to support. We especially welcome people with lived experience of racism, migration or community activism.\n\n## Experience required\n\nEssential: commitment to equality, inclusion and anti-racism; respect for all cultures and backgrounds; good listening and communication skills; confidence talking with the public; reliability and teamwork; understanding of confidentiality and boundaries; willingness to train and follow our policies. Desirable: experience in community work, youth work, advocacy or education; social media skills; experience facilitating discussions or groups; knowledge of anti-racism or human rights; languages spoken in North Edinburgh's communities.\n\n## Training details\n\nYou will receive a full induction, anti-racism and cultural competence training, safeguarding training, and guidance on community engagement and professional boundaries. A designated Project Esperanza Coordinator will provide ongoing supervision and support, alongside regular team meetings and opportunities for personal development and leadership.\n\n## Frequency commitment details\n\nThis is a regular weekly opportunity of around 3–6 hours per week, including Friday afternoon community walks across North Edinburgh where possible. Volunteers also attend regular meetings, training and briefings, and may support occasional evening or weekend events such as our Anti-Racist Book Club. A minimum of six months is preferred to build trust within the community, but we understand you have other responsibilities and will be as flexible as we can.\n\n## Travel details\n\nThis role is based across North Edinburgh. Volunteers meet at our North Edinburgh community office before Friday afternoon walks and activities; full meeting point details are shared at induction. The area is well served by Lothian Buses, and travel expenses are reimbursed.\n\n## Taster details\n\nAll new volunteers attend a group induction before starting. We bring together everyone who joins within the same period, so you will meet other new volunteers and begin together. The induction covers Project Esperanza, our values and anti-racist approach, your role and community walks, safeguarding, confidentiality, boundaries, expenses and communication. We will contact you with the date of the next induction once we receive your application.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-volunteerscotland-search.appspot.com/o/opportunities%2F3K3cpBBh7edjdCxkDLQ76fNPxTc2%2FgPZz1iie8MVPZw2X-thumbnail.jpg?alt=media&token=998875de-4624-426e-bde7-83b467520835",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000ILTkbYAH#role",
                        "type": "Role",
                        "title": "Anti-Racist Community Volunteer",
                        "description": "Essential: commitment to equality, inclusion and anti-racism; respect for all cultures and backgrounds; good listening and communication skills; confidence talking with the public; reliability and teamwork; understanding of confidentiality and boundaries; willingness to train and follow our policies. Desirable: experience in community work, youth work, advocacy or education; social media skills; experience facilitating discussions or groups; knowledge of anti-racism or human rights; languages spoken in North Edinburgh's communities.",
                        "commitment": "This is a regular weekly opportunity of around 3–6 hours per week, including Friday afternoon community walks across North Edinburgh where possible. Volunteers also attend regular meetings, training and briefings, and may support occasional evening or weekend events such as our Anti-Racist Book Club. A minimum of six months is preferred to build trust within the community, but we understand you have other responsibilities and will be as flexible as we can.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000ILTkbYAH/anti-racist-community-volunteer?#modal_register_a0gQD00000ILTkbYAH",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
