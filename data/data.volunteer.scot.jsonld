        {
            "id": "https://data.volunteer.scot/Organisation/0012400000fci2QAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000fci2QAAQ/9th-dunipace-scouts",
            "name": "9th Dunipace Scouts",
            "description": "The Scouting Organisation aims to provide programmes of activities, leading directly to the development of the children. At the 9th Dunipace Group we have 4 sections covering ages 5 to 18. The group is very active, with weekly activity nights, educational visits and trips. We are a full programme of camping and outdoor pursuits programme. The Duke of Edinburgh Award Scheme is run for all children between 16 and 18 years old.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC042587"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
