            "dc:source": "https://volunteer.scot/organisations/00108000034T3LOAA0/hilton-convention-centre-part-of-the-jesus-house-aberdeen-church-charity",
            "name": "Hilton Convention Centre (part of the Jesus House Aberdeen Church Charity)",
            "description": "The Hilton Convention Centre is part of the Jesus House Aberdeen Church Charity. Our facilities in support of our charitable and community work include an excellent conference centre, multipurpose hall, business centre, library and resource centre, office space for short or long term rents. We also provide business support services.",
            "website": "https://hiltonconventioncentre.com/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
