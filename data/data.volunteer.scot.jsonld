            "dc:source": "https://volunteer.scot/organisations/001QD00001E8EN4YAN/felix",
            "name": "Felix",
            "description": "We are Felix. We rescue great food and get it to people who need it. We’re about fuller plates, fuller communities, and fuller lives.",
            "website": "https://felix.org/",
            "charityRegistration": [
