                {
                    "id": "https://data.volunteer.scot/Activity/a0g1p00000DGzpdAAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g1p00000DGzpdAAD/peggys-cafe-helpers",
