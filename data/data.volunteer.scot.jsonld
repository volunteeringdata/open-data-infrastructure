            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HeStRYAV",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HeStRYAV/trustee",
                    "publishStart": "2026-07-07",
                    "publishEnd": "2026-12-07",
                    "title": "Trustee",
                    "description": "## Summary\n\n@yourside is a new Dundee charity looking for trustees to help shape our future and support people to build better lives. We’d love to hear from people with skills in finance, fundraising, business, social media—or anyone passionate about making a difference.\n\n## Description\n\n@yourside is a new charity in Dundee and we’re looking for enthusiastic people to join our Board of Trustees and help shape what comes next.\r\n\r\nThrough twice weekly Drop Ins, we support people facing additional disadvantages, including homelessness, addiction, involvement in the criminal justice system and other barriers. Our aim is to reduce stigma and help people build brighter futures.\r\n\r\nYou don’t need previous trustee experience — we’re looking for people who care, are non-judgemental, bring ideas, and want to make a real difference. Whether you have skills to share or simply want to support our mission, we’d love to hear from you.\r\n\r\nAs a trustee, you’ll help guide the charity, support good decision-making and play a part in creating positive change across Dundee.\n\n## Experience required\n\nNon -judgemental and keen to make a difference.\n\n## Training details\n\nGovernance and compliance, including trustee roles and responsibilities, annual returns, impact of the work by @yourside.\n\n## Travel details\n\n@yourside, Church Hall, 3-5 Nicol Street, Dundee DD1 1LY\n\n## Travel expenses\n\nTravel expenses are reimbursed and this can be mileage or bus fares.\n\n## Taster details\n\nVolunteers are welcome to attend a Board Meeting as a taster session.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HeStRYAV#role",
                        "type": "Role",
                        "title": "Trustee",
                        "description": "Non -judgemental and keen to make a difference.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000HeStRYAV/trustee?#modal_register_a0gQD00000HeStRYAV",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
                            {
