                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HwwwHYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HwwwHYAR/community-golf-activator",
                    "publishStart": "2026-08-28",
                    "publishEnd": "2027-02-26",
                    "title": "Community Golf Activator",
                    "description": "## Description\n\nWhat’s Involved\r\nIt's as simple as helping our team facilitate golf activities and socialising with fellow golfers.  Our golfers require a little extra support to overcome challenges such as dementia and Parkinson's.  A friendly face and kindness is all it takes to make their day out a more enjoyable one.\r\n\r\n* Weekly opportunities to meet your lifestyle\r\n* Free training provided\r\n* Free DBS check\r\n* Make an impact on someone’s life\r\n\r\nTiming: Mondays from 11 am – 1 pm\n\n## Travel details\n\nStrathclyde Park Golf Centre, Hamilton Palace Sports Ground, Mote Hill, Hamilton, ML3 6BY.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fa95717a6-91fb-4060-8b8b-14f07f94067b%2FAiKYnKmpqoQBNMDuyuUXa9mOdcv1%2Flisting.jpg?alt=media&token=bdc8789c-cf31-496f-b243-89a7698e53cd",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HwwwHYAR#role",
                        "type": "Role",
                        "title": "Community Golf Activator",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000HwwwHYAR/community-golf-activator?#modal_register_a0gQD00000HwwwHYAR",
