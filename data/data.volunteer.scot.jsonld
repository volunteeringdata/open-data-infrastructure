                        "description": "No Expertise, Good Communicator,Good Listener,Open minded,Organised,Team Player,",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000Hul5hYAB/trustee-chairperson?#modal_register_a0gQD00000Hul5hYAB",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18"
                    },
