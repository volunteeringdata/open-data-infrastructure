                        ]
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
                                "@id": "https://data.volunteer.scot/Geography/LocalAuthority/Aberdeen",
                                "type": "Location",
                                "name": "Aberdeen"
                            },
                            {
                                "@id": "https://data.volunteer.scot/Geography/LocalAuthority/Aberdeenshire",
                                "type": "Location",
                                "name": "Aberdeenshire"
                            },
