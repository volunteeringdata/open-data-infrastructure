        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000fklNlYAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000fklNlYAI/solidaritee",
            "name": "SolidariTee",
            "description": "SolidariTee is an international charity run and led entirely by volunteers who are students and young people. We're working to make lasting change in the way refugees and other people forced to flee persecution and violence are treated, through a combination of awareness-raising, advocacy, and direct funding to grassroots NGOs providing vital refugee legal aid and mental health support.",
            "website": "https://www.solidaritee.org.uk/join-us",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/LawAndJustice",
                    "skos:prefLabel": "Law and Justice"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/RefugeesAsylumSeekers",
                    "skos:prefLabel": "Refugees / Asylum Seekers"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000Axw2DYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000Axw2DYAR/team-lead-or-team-member-dundee-uni",
                    "publishStart": "2023-07-04",
                    "publishEnd": "2027-02-01",
                    "title": "Team Lead or Team Member - Dundee Uni",
                    "description": "## Summary\n\nSolidariTee is an international charity run and led entirely by volunteers who are students and young people.\n\n## Description\n\nWe're working to make lasting change in the way refugees and other people forced to flee persecution and violence are treated, through a combination of awareness-raising, advocacy, and direct funding to grassroots NGOs providing vital refugee legal aid and mental health support.\r\n\r\nWe are currently looking for volunteers to join our university SolidariTee team as regional fundraising and events officers. No prior knowledge is required, just motivation and dedication to raise awareness for refugees in the UK and beyond and to support legal and psychological aid to refugees in Greece.\r\n\r\nTo apply for this role, you should be a student at University of Dundee.\n\n## Experience required\n\nNo previous experience required, just commitment to raise funds and awareness for refugees and other people facing displacement.\n\n## Training details\n\nWe will provide induction and training through a mix of workshops and written information.\n\n## Travel details\n\nDundee\n\n## Travel expenses\n\nPlease note - No expenses are payable for this opportunity.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000Axw2DYAR#role",
                        "type": "Role",
                        "title": "Team Lead or Team Member - Dundee Uni",
                        "description": "No previous experience required, just commitment to raise funds and awareness for refugees and other people facing displacement.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000Axw2DYAR/team-lead-or-team-member-dundee-uni?#modal_register_a0gQD00000Axw2DYAR",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/RefugeesAsylumSeekers",
                                "skos:prefLabel": "Refugees / Asylum Seekers"
                            }
                        ],
                        "service": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/NamedContactForVolunteer",
                                "skos:prefLabel": "Named Contact For Volunteer"
                            }
                        ],
