            "dc:source": "https://volunteer.scot/organisations/00124000008nbYpAAI/hospices-of-hope-shop-tollcross",
            "name": "Hospices of Hope Shop, Tollcross",
            "description": "Hospice of Hope aims to improve quality of life for terminally ill children and adults and their families in Romania and other countries in the region through increased access to specialist care and training.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
