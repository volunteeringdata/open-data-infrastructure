                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HLmxVYAT",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HLmxVYAT/mens-group-self-advocacy-assistant",
