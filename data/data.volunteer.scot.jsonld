        {
            "id": "https://data.volunteer.scot/Organisation/00124000008niDNAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008niDNAAY/west-dunbartonshire-cvs",
            "name": "West Dunbartonshire CVS",
            "description": "As a Third Sector Interface, WDCVS holds a unique position in supporting, promoting, developing and representing volunteering and sector activity across West Dunbartonshire.",
            "website": "https://www.wdcvs.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC032003"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F04d1ec05-9fa9-6e31-0e6c-2d6fee880fd2%2FfKRYXnqxIgQS0ZWjQN2l8nRsAqL2%2Fuser-upload.jpg?alt=media&token=2e292ab3-b22c-41d2-86c0-e7c8d83830ad",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
