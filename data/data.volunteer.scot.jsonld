            "name": "Age Scotland (Grampian Area)",
            "description": "Age Scotland is the national charity for older people. We work to improve the lives of everyone over the age of 50 so that people can love later life.",
            "website": "https://www.agescotland.org.uk",
            "charityRegistration": [
