            "dc:source": "https://volunteer.scot/organisations/0012400000tsxv4AAA/re-engage-aberdeen-and-north-of-scotland",
            "name": "Re-engage (Aberdeen and North of Scotland)",
            "description": "Re-engage exist to bring older people together into social groups at a time in their lives when their social circles are diminishing.\r\n\r\nLast year, nearly 7,000 older guests were part of over 900 groups across the UK, supported by 12,000 volunteers.",
            "website": "https://www.reengage.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039377"
                }
