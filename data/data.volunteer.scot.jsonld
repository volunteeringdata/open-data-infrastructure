            "name": "St Columba's Hospice Care",
            "description": "St Columba's Hospice Care provides hospice and end-of-life care for people with incurable illnesses and their families.",
            "website": "https://www.stcolumbashospice.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC003634"
                }
