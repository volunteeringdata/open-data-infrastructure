            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000ClYc1YAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000ClYc1YAF/board-member-treasurer",
                    "publishStart": "2025-10-21",
                    "publishEnd": "2027-04-19",
                    "title": "Board Member (Treasurer)",
                    "description": "## Description\n\nAre you a finance professional who wants to make a real difference in your community? \r\n\r\nOur charity, dedicated to Tackling Household Affordable Warmth (THAW), is seeking a passionate and experienced Volunteer Treasurer to join our Board of Trustees. \r\n\r\nUse your financial expertise to ensure our resources are strategically managed and effectively deployed to help vulnerable people stay warm and healthy. This is a vital voluntary role providing governance and financial leadership. \r\n\r\nAs Treasurer, you will:\r\n- Provide financial oversight and strategic governance to support the charity's mission of reducing levels of fuel poverty and achieving affordable warmth;\r\n- Manage and report on the charity's finances, ensuring statutory compliance and efficient resource allocation;\r\n- Attend regular board meetings, contributing strategic advice on budgets, funding, and financial sustainability.\n\n## Experience required\n\n- Passion for the Cause: A genuine and strong commitment to reducing fuel poverty and helping vulnerable households achieve affordable warmth in Orkney.\r\n\r\n- Local Knowledge: A good understanding of the specific challenges, geography (including the linked and non-linked Isles), and service needs of the Orkney community.\r\n\r\n- Values Alignment: A commitment to the charity's principles, such as promoting an inclusive, non-linear approach to support and a focus on dignity and fairness.\r\n\r\n- Ideal for a qualified accountant or finance professional with a passion for social impact.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F4adf4104-10aa-49e9-8c8c-e2dfb9bdad98%2FliLEC2s9ZwYA46gEa6AxGTVGunx2%2Flisting.jpg?alt=media&token=162dd0c5-1bd4-4803-babe-db678f3d6ac5",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000ClYc1YAF#role",
                        "type": "Role",
                        "title": "Board Member (Treasurer)",
                        "description": "- Passion for the Cause: A genuine and strong commitment to reducing fuel poverty and helping vulnerable households achieve affordable warmth in Orkney.\r\n\r\n- Local Knowledge: A good understanding of the specific challenges, geography (including the linked and non-linked Isles), and service needs of the Orkney community.\r\n\r\n- Values Alignment: A commitment to the charity's principles, such as promoting an inclusive, non-linear approach to support and a focus on dignity and fairness.\r\n\r\n- Ideal for a qualified accountant or finance professional with a passion for social impact.",
