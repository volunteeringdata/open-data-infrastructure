        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000Ekk6DYAR",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000Ekk6DYAR/asylum-and-refugee-care-aarc",
            "name": "Asylum and Refugee Care (AARC)",
            "description": "Asylum and Refugee Care (“AARC”) was founded to support individuals seeking asylum and refugees in the Aberdeen area. Since our establishment, we have been committed to creating a welcoming and supportive environment for people facing the complex challenges of seeking safety and rebuilding their lives in a new country. Our services are focused on empowering vulnerable individuals by providing practical support, advocacy, and a sense of community.\r\n\r\nWe offer a wide range of services, from helping people access essential resources such as housing, healthcare, and legal support, to offering language classes and social integration activities. One of our key areas of focus is supporting unaccompanied minors with age disputes and adults who have mental health challenges, recognising that these individuals often face additional barriers. Our vision is to ensure that everyone in our community feels valued, supported, and equipped to pursue a better future.",
            "website": "https://aarc.charity/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC052520"
