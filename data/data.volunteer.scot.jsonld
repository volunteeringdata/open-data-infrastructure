            "dc:source": "https://volunteer.scot/organisations/00108000035ihcBAAQ/aberdeen-north-parish",
            "name": "Aberdeen North Parish",
            "description": "Aberdeen North Parish serves the Mastrick, Northfield and Summerhill communities in Aberdeen. We are also a registered charity.",
            "website": "http://www.aberdeennorthchurch.co.uk/",
            "charityRegistration": [
