            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000QO1yIAAT",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000QO1yIAAT/charity-shop-assistant",
                    "publishStart": "2023-07-04",
                    "publishEnd": "2027-02-01",
                    "title": "Charity Shop Assistant",
                    "description": "## Summary\n\nWe require two afternoon volunteers for our charity shop Deaf links. We are a welcoming team and require extra help now in our new larger premises.\n\n## Description\n\nWe require two afternoon volunteers for our charity shop Deaf links. We are a welcoming team and require extra help now in our new larger premises. This is a rewarding experience to be part of a wider community project. Training will be provided along with any additional support needs being met, we can be flexible to meet your needs.\r\n\r\nAll relevant training will be given, you will work as part of a team and share an interest in retail and fashion. High standard of customer service when dealing with customers, providing a friendly atmosphere, with a respectful attitude. .Good time keeping\n\n## Experience required\n\nGood time keeping, reliable and work well within a team, have a good work ethic and can do attitude.\n\n## Training details\n\nYou will receive training on the day to day running of the shop and working with customers.\n\n## Frequency commitment details\n\n5 hours per day, afternoons from 1pm to 5pm\n\n## Travel details\n\nDeaf Links Charity Shop, Unit 23, Top floor, Wellgate shopping centre",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000QO1yIAAT#role",
                        "type": "Role",
                        "title": "Charity Shop Assistant",
                        "description": "Good time keeping, reliable and work well within a team, have a good work ethic and can do attitude.",
