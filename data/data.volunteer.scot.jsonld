            "dc:source": "https://volunteer.scot/organisations/0012400000VygRmAAJ/cats-protection-dalry-shop",
            "name": "Cats Protection - Dalry Shop",
            "description": "Our aims are to raise funds to support cat neutering education and rehoming.",
            "website": "https://www.cats.org.uk",
            "cause": [
