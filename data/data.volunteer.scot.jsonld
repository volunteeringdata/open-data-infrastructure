            "dc:source": "https://volunteer.scot/organisations/00124000008nZqHAAU/mcsence-group",
            "name": "McSence Group",
            "description": "We strive to establish ongoing and profitable business ventures which will create sustainable long term employment and contribute to the regeneration of our communities.",
            "website": "https://www.mcsence.co.uk",
            "charityRegistration": [
