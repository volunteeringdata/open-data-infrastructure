            "dc:source": "https://volunteer.scot/organisations/001QD00000weUUUYA2/55th-kincorth-scout-troop",
            "name": "55th Kincorth Scout Troop",
            "description": "55th Kincorth Scout Group based in Kincorth but covering the whole south side of Aberdeen.\r\n\r\nWe have young members from 6-14years old.\r\n-Beavers for 6-8 year olds\r\n-Cubs for 8-10&1/2 year olds\r\n-Scouts for 10&1/2-14 year olds",
            "website": "https://www.facebook.com/55thKincorthScoutGroup/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
