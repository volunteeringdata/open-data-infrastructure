        {
            "id": "https://data.volunteer.scot/Organisation/0012400000EojSkAAJ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000EojSkAAJ/restart-orkney",
            "name": "Restart Orkney",
            "description": "Employability Orkney provides a range of sustainable supported employment, training and volunteering opportunities which promote social inclusion for those furthest from the labour market. Our social enterprise Restart Orkney sells furniture, household items, white goods and clothing at affordable prices.",
            "website": "https://www.employabilityorkney.co.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Employment",
                    "skos:prefLabel": "Employment"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000GoIlKYAV",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000GoIlKYAV/retail-assistant-restart-rummage",
                    "publishStart": "2026-05-13",
                    "publishEnd": "2027-05-04",
                    "title": "Retail Assistant, \"Restart Rummage\"",
                    "description": "## Description\n\nWe need your help! Restart is busier than ever selling donated items of household items, electrical goods and bric-a-brac and have opened a new shop called \"Restart Rummage\" next to our furniture showroom. This helps the planet by reusing and recycling and helps people access low cost items at a time they need it most. If you would like to be a part of our amazing local charity and have some spare time to volunteer, we would love to hear from you.\r\n\r\nWhat could a volunteer gain from the experience:\r\nVolunteering at Restart is a great way to meet new people in a busy environment. It’s an opportunity to learn new skills and gain confidence in a supportive, welcoming environment. Perhaps you have skills and knowledge to pass on to other volunteers and supported employees! Being a part of our charity can provide an amazing “feel-good” feeling – whether that’s from assisting people in times of need or from knowing we are helping our environment by actively encouraging the re-use and recycling of goods in our community. If you are looking for work, volunteering is a great addition to your CV and we can also provide a reference to prospective employers. We can assist with your next steps – we have a dedicated staff member who can help with practical areas such as CV’s, job searching, application forms, interview coaching as well as offering emotional and well-being support if required.\n\n## Experience required\n\nA positive attitude and willingness to learn is most important. Ideally, you should like meeting people and be passionate about providing our customers with the best possible shopping experience at Restart.\n\n## Training details\n\nRestart Orkney offers ongoing training on all our systems and procedures. You will learn how to take cash and card payments using izettle, and how to create eye catching displays. Our friendly shop supervisor and other volunteers and staff are always on hand to help. We provide a warm, welcoming, inclusive and supportive environment where volunteers and staff can thrive and flourish.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fa9a51ce7-78a6-45e5-a1a1-fcd6aaefb4f4%2FliLEC2s9ZwYA46gEa6AxGTVGunx2%2Flisting.jpg?alt=media&token=c3a44bff-ce63-4d90-9909-1f0ad5a7d74d",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000GoIlKYAV#role",
                        "type": "Role",
                        "title": "Retail Assistant, \"Restart Rummage\"",
                        "description": "A positive attitude and willingness to learn is most important. Ideally, you should like meeting people and be passionate about providing our customers with the best possible shopping experience at Restart.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000GoIlKYAV/retail-assistant-restart-rummage?#modal_register_a0gQD00000GoIlKYAV",
                        "allowsRemoteParticipation": false,
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/Environment",
