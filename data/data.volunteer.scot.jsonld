        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nWrRAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nWrRAAU/grangemouth-old-peoples-welfare",
            "name": "Grangemouth Old People's Welfare",
            "description": "To promote and assist the general good of all old people in the Burgh of Grangemouth by assisting the work of statutory authorities and voluntary organisations engaged in providing facilities for physical and mental recreation, developing physical improvement, furthering health, relieving poverty, distress or sickness or in pursuing any objects which now are or hereafter may be deemed by law to be charitable.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC014001"
                }
            ],
            "cause": [
                {
