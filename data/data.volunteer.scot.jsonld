        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nYTAAA2",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nYTAAA2/stirling-carers-centre",
            "name": "Stirling Carers Centre",
            "description": "Stirling Carers Centre offers support to unpaid Carers in the Stirling Council Area, irrespective of the condition of the person they care for. The services offered include: information, support, advice, welfare benefit checks, advice on rights and entitlements, etc.  We also have a Young Carers Service that supports young carers through group work and 1:1 personal support.",
            "website": "https://www.stirlingcarers.co.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC020213"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Carers",
                    "skos:prefLabel": "Carers"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000FU1MFYA1",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000FU1MFYA1/stirling-sunshine-singers-dementia-choir-support",
                    "publishStart": "2026-02-18",
                    "publishEnd": "2027-02-06",
                    "title": "Stirling Sunshine Singers Dementia Choir Support",
                    "description": "## Summary\n\nStirling Sunshine Singers Dementia Choir Support\n\n## Description\n\n<p>The <em>Stirling Sunshine Singers</em> is a welcoming and uplifting dementia-friendly choir based at the Albert Halls in Stirling. The choir brings together people living with dementia and their carers to enjoy the power of music, connection and community in a relaxed and supportive environment. You will see first hand the postive impact music has on wellbeing and gain experinece in supporting people living with dementia and their unpaid carers.&nbsp;</p>\n\n<p>We are looking for a kind, reliable and enthusiastic volunteer to join our team and help support this special group.</p>\n\n<h3>What the role involves:</h3>\n\n<ul>\n<li>\n<p>Welcoming and chatting with choir members and carers as they arrive</p>\n</li>\n<li>\n<p>Helping set up and tidy away chairs, refreshments and materials</p>\n</li>\n<li>\n<p>Offering encouragement and gentle support during the session</p>\n</li>\n<li>\n<p>Supporting individuals who may need a little extra reassurance</p>\n</li>\n<li>\n<p>Helping create a warm, inclusive and positive atmosphere</p>\n</li>\n</ul>\n\n## Experience required\n\nWarm, friendly and approachable manner\n\nGood listening and communication skills\n\nPatience, empathy and understanding\n\nReliable and punctual\n\nAbility to work as part of a small team\n\nComfortable engaging with older adults and people living with dementia\n\nWillingness to learn about dementia-friendly practice\n\n## Travel expenses\n\nTravel Expenses will be covered",
                    "requiresEmergencyParticipation": false,
                    "role": {
