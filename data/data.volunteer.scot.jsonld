        {
            "id": "https://data.volunteer.scot/Organisation/00124000009bmReAAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000009bmReAAI/the-turing-trust",
            "name": "The Turing Trust",
            "description": "To further education through reusing IT equipment in sub-Saharan African countries.",
            "website": "https://www.turingtrust.co.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000GvZTmAAN",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000GvZTmAAN/warehouse-assistant",
                    "publishStart": "2021-03-10",
                    "publishEnd": "2027-02-28",
                    "title": "Warehouse Assistant",
                    "description": "## Summary\n\nThe Turing Trust are looking for a workshop assistant who is able to help us to process our donated IT equipment, helping to maintain an efficiently organised warehouse.\n\n## Description\n\nOur operations in our Edinburgh facility include taking deliveries of IT equipment, securely wiping sensitive data and ensuring good working order before packaging for container shipments to schools in Africa. We\noften receive a wide variety of donations from single laptops to hundreds of desktop PCs at once.\nYour role would be vital in helping us to maintain an organised system of incoming donations and outgoing equipment. The main tasks would involve sorting and organising equipment.\n\n## Experience required\n\nPrevious experience with IT, warehousing\nand manual handling are desirable but will be developed through this role so are not specific\nrequirements.\n\n## Training details\n\nInduction training provided.\n\n## Travel details\n\nUnit 7C, Pentland Industrial\nEstate, Loanhead, EH20 9QH\n\n## Travel expenses\n\nTravel, paid daily or weekly for public transport only.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000GvZTmAAN#role",
                        "type": "Role",
