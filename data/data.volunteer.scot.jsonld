        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000Iq0MYYAZ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000Iq0MYYAZ/kirkintilloch-community-sports-club",
            "name": "Kirkintilloch Community Sports Club",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SportLeisureRecreation",
                    "skos:prefLabel": "Sport / Leisure / Recreation"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000IWNvBYAX",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000IWNvBYAX/facility-management-team-member",
                    "publishStart": "2026-10-16",
                    "publishEnd": "2027-04-16",
                    "title": "Facility Management Team Member",
                    "description": "## Description\n\nThe advancement of public participation in sport.\r\nThe advancement of citizenship or community development.\r\nThe advancement of education.\r\nProviding recreational facilities with the aim of improving the lives of people for whom the facility is\r\nintended.\r\nDescribe the volunteering Opportunity\r\nWe are looking for volunteers who will be part of the team who run and maintain the facility. As well as\r\nbeing a customer facing role, the opportunity will involve hands on work to ensure the facility is in an\r\nexcellent condition for use.\r\nThe facility is open seven days a week and we need enthusiastic people who are flexible in their working\r\nhours and have a 'can do' approach to the tasks required.\r\nIn addition to dealing with users of the football pitch, the team member will deal with contractors for\r\nmaintenance as well as being able to clean, tidy up, switch on and off floodlights and generally open up\r\nand close the building.\r\nMembers will be part of a friendly and enthusiastic team who enjoy their roles and make everyone\r\nwelcome to the facility.\n\n## Experience required\n\nThis role may suit someone with caretaking or janitorial experience and who is used to working flexible\r\nhours.\r\nHowever, a willingness to learn and show enthusiasm for the tasks will be a key factor if the above\r\nexperience is not relevant.\r\nIt is an opportunity for someone who enjoys working with people and wants to provide a good service in\r\neverything they do. Job satisfaction is there for the right person.\n\n## Travel details\n\nkirkintilloch",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000IWNvBYAX#role",
                        "type": "Role",
                        "title": "Facility Management Team Member",
                        "description": "This role may suit someone with caretaking or janitorial experience and who is used to working flexible\r\nhours.\r\nHowever, a willingness to learn and show enthusiasm for the tasks will be a key factor if the above\r\nexperience is not relevant.\r\nIt is an opportunity for someone who enjoys working with people and wants to provide a good service in\r\neverything they do. Job satisfaction is there for the right person.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000IWNvBYAX/facility-management-team-member?#modal_register_a0gQD00000IWNvBYAX",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
