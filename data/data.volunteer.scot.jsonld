            "dc:source": "https://volunteer.scot/organisations/00124000008ndMxAAI/homelands-trust-fife-scio",
            "name": "Homelands Trust-Fife (SCIO)",
            "description": "Homelands is an independent Fife-based charity working to improve the quality of life of people affected by disability, long-term health conditions and life-limiting illness through the provision of 4* luxury holiday accommodation. Sitting alongside the lodges is the Paxton Centre, a community hub for use by both the guests of the Homelands lodges and the local community.",
            "website": "https://www.homelands-fife.co.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC047615"
                }
            ],
            "cause": [
                {
