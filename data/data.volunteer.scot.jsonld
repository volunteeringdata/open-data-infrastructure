            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002kWaajAAC/re-engage-east-lothian",
            "name": "Re-Engage East Lothian",
            "description": "Re-engage is a charity that is positive about older age and committed to fighting loneliness so that people can have social lives and friendship groups however old they are.  We inspire and enable meaningful connections and shared experiences within communities across the UK for people over 75 facing loneliness and social isolation.",
            "website": "https://www.reengage.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
