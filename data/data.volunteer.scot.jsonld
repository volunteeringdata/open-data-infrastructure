        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nhE0AAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nhE0AAI/connect-community-trust",
            "name": "Connect Community Trust",
            "description": "To regenerate the area of Wellhouse and surrounding areas",
            "website": "https://www.wellhouseha.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
