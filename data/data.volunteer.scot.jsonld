        {
            "id": "https://data.volunteer.scot/Organisation/0012400000lEfpQAAS",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000lEfpQAAS/citizens-advice-bureau-inverness-badenoch-strathspey",
            "name": "Citizens Advice Bureau - Inverness, Badenoch & Strathspey",
            "description": "We work for a fairer Scotland where people are empowered and their rights respected.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000GGE5pYAH",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000GGE5pYAH/general-adviser",
                    "publishStart": "2026-04-09",
                    "publishEnd": "2027-04-08",
                    "title": "General Adviser",
                    "description": "## Description\n\nWe are looking for Volunteer Advisers to help provide effective and efficient advice to members of the public. In this role, you will work directly with clients, both face to face and over the phone, to understand their situations and support them in accessing the information they need. \r\n\r\nYou will research and interpret information, present clients with options and support them to take appropriate action. This may include referring to other services, drafting letters or acting on behalf of clients where required. You will also be responsible for maintaining clear and accurate case records.\r\n\r\nThis role requires strong communication skills, the ability to work with a wide range of clients and confidence using computers. You should be able to work as part of a team, respect different perspectives and be willing to undertake ongoing training.\r\n\r\nIf at any stage you have a query about volunteering with IBS CAB or wish to discuss the volunteering opportunities more fully, please feel free to contact:\r\nE: volunteering:invernesscab.org\r\nT: 01463 252292\n\n## Training details\n\nAll volunteering roles require a commitment to on-going training. For the role of General Adviser, this includes an initial 4 stage training programme that can take up to 6 months to complete.. This programme includes completing e-learning modules, attending face to face training sessions and shadowing experienced Advisers. Throughout the training process and when you go on to become an Adviser, you will be supported by the Bureau managers and a team of specialist staff.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F2b267c03-b559-4a2a-8e4e-2598d5d50add%2FJqK8q7mcUtcgywKvmhEW9RRQbgy1%2Flisting.jpg?alt=media&token=f4735e32-0436-42e9-83d9-51eea0647a79",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000GGE5pYAH#role",
                        "type": "Role",
                        "title": "General Adviser",
                        "applyLink": "https://www.invernesscab.org/volunteer",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
