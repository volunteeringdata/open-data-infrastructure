        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXD4AAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXD4AAM/macmillan-cancer-support-dundee",
            "name": "Macmillan Cancer Support (Dundee)",
            "description": "Macmillan Cancer Support is here to do whatever it takes to support people living with cancer. Right now, more than 3 million people are living with cancer in the UK. By 2030 this figure will rise to 4million.\r\n\r\nWe’re here to help everyone with cancer live life as fully as they can, by providing physical, financial and emotional support. We'll do whatever it takes, no matter what a person's needs are, we will listen and support them however they need us to — big or small.\r\n\r\nWe provide services. We raise money. We influence decision makers. We support the cancer workforce. We research into cancer care. We help employers support staff.",
            "website": "https://www.macmillan.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039907"
                }
            ],
            "cause": [
                {
