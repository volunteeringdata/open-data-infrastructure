        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002Tf8NmAAJ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002Tf8NmAAJ/scottish-spca",
            "name": "Scottish SPCA",
            "description": "The Scottish SPCA is Scotland’s animal welfare charity. We rescue animals in danger, find pets new homes, investigate abuse and prevent cruelty through our free Prevention through Education programme for Scottish schools.",
            "website": "https://www.scottishspca.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC006467"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FundraisingFunding",
                    "skos:prefLabel": "Fundraising / Funding"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityEvent",
                    "skos:prefLabel": "Community Event"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000EsROAYA3",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000EsROAYA3/sspca-student-ambassador-orkney-islands",
                    "publishStart": "2026-01-21",
                    "publishEnd": "2027-04-23",
                    "title": "SSPCA Student Ambassador (Orkney Islands)",
                    "description": "## Description\n\nCalling all students! The Scottish SPCA needs your help to make Scotland the best place for all animals to live!\r\n\r\nVolunteering with the Scottish SPCA is a wonderful thing to do, not only for Scotland's animals in need and the people in your local community, but also for you!\r\n\r\nVolunteering is good for you in many ways. It has a proven benefit to your physical and mental well-being; offers great social opportunities and can also help you gain skills for your CV or applying for jobs.\r\n\r\nSo, what are you waiting for?  Sign up as an SSPCA Student Ambassador today!\r\n\r\nPlease Note: This role is available only to existing College and University students\r\n\r\nDid you know that it costs us £63,000 per day to look after all the animals in our care? As a student ambassador, you will help ensure that we can continue to provide our vital services.\r\n\r\nWhat you will be doing:\r\n- Online tasks - want to help, but only got a few minutes to spare? Why not help us by simply sharing information and campaigns on your social media channels? These quick and easy tasks can be done on your phone while on campus, on the bus...anywhere you like!\r\n- Community Events - Join our fabulous Community Engagement Team at events near you and help us spread the word about the SSPCA's great work and services!\r\n- Fundraising - Help us to put the 'fun' into fundraising by joining our amazing Regional Fundraising Team for an event or two. Everything from bucket shakes to adrenaline events, or why not set up your own small event on campus? Fundraising is a great way to meet people in your community while raising much needed cash for animals in need.\r\n\r\nWhat could a volunteer gain from the experience:\r\n- You will receive an SSPCA Student Ambassador tote bag with freebies!\r\n- You will have access to your own volunteering account and a FREE learning account with lots of great resources!\r\n- You can be proud that you can you are helping Scotland's animals in need!\n\n## Experience required\n\n- Enthusiasm... Lots of it!\r\n- Ability to use social media channels (for online posts)\r\n- An understanding of the Society's work - we will give you training!\r\n- A pleasant and polite manner when dealing with the public\r\n- Confidence to interact with other people\r\n- Ability to work as part of a small team\r\n- Ability to take instruction and follow health & safety requirements at events\n\n## Training details\n\nRole-related online training via our Knowledge Nest training system.  Support from our volunteering team.\n\n## Travel expenses\n\nExpenses paid for involvement in community events",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F25ef6842-a3e6-4d2d-8444-08687ffcf0e9%2FliLEC2s9ZwYA46gEa6AxGTVGunx2%2Flisting.jpg?alt=media&token=e715929d-c5c6-4567-83be-a51925d521b2",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000EsROAYA3#role",
                        "type": "Role",
                        "title": "SSPCA Student Ambassador (Orkney Islands)",
                        "description": "- Enthusiasm... Lots of it!\r\n- Ability to use social media channels (for online posts)\r\n- An understanding of the Society's work - we will give you training!\r\n- A pleasant and polite manner when dealing with the public\r\n- Confidence to interact with other people\r\n- Ability to work as part of a small team\r\n- Ability to take instruction and follow health & safety requirements at events",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000EsROAYA3/sspca-student-ambassador-orkney-islands?#modal_register_a0gQD00000EsROAYA3",
                        "allowsRemoteParticipation": true,
                        "minimumAge": "18",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/Animals",
                                "skos:prefLabel": "Animals"
                            }
                        ],
                        "service": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/ExpensesPaid",
                                "skos:prefLabel": "Expenses Paid"
                            }
                        ],
                        "specialistRole": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/SpecialistRole/HomeBasedVolunteering",
                                "skos:prefLabel": "Home-based volunteering"
                            }
                        ],
