        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nYXCAA2",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nYXCAA2/charlie-house",
            "name": "Charlie House",
            "description": "Charlie House was established to help make life better for babies, children and young people who have life-threatening or life-limiting conditions, and to support their parents, brothers and sisters, and all those who love them. \r\n\r\nWe started in 2011 and, through the generosity of others, we have been able to develop and grow our projects to support these wonderful children. With continued support we hope to be there when families need us most.",
            "website": "https://www.charliehouse.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC042643"
                }
            ],
            "cause": [
