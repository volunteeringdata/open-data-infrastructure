        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nauWAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nauWAAQ/childrens-panel-western-isles",
            "name": "Childrens Panel (Western Isles)",
            "description": "The Children’s Panel is a group of unpaid trained volunteers, appointed by Scottish Ministers, who come from all types of background and all walks of life.\r\n\r\nThree Panel Members sit on each Children’s Hearing. With the help of reports from professionals, such as Social Workers, and discussions with the child and family the hearing considers what has caused the child to be at risk and what must be done to reduce or prevent that risk from recurring in the future.",
            "website": "https://www.cne-siar.gov.uk/social-care-and-health/childrens-hearings/western-isles-childrens-panel/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FamilySupport",
