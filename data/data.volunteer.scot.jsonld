            "dc:source": "https://volunteer.scot/organisations/00124000008nf8YAAQ/orkney-arts-society",
            "name": "Orkney Arts Society",
            "description": "Orkney Arts Society is a membership body ran entirely by a committee of volunteers. Founded in 1978, its mission is to promote and encourage the study, enjoyment, practice, and knowledge of the arts in Orkney. \r\n\r\nOur core activity is organising a programme of music, literature, drama and visual arts events in the Mainland. This runs from September through to the April in the following year.",
            "website": "https://orkneyartssociety.wordpress.com/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC004819"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2Fbe1a97be-4dff-935a-37ec-23f1e6213fa7%2Fy4Y6e60YtRQisjNIjB79rsh2Vsl1%2Fuser-upload.jpg?alt=media&token=6bfce8d2-38ef-4968-93d6-277df5a8f0af",
