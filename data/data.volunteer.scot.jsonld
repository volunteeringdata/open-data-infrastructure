                        "applyLink": "https://volunteer.scot/search/a0gQD00000HshKjYAJ/retail-volunteer-prestwick?#modal_register_a0gQD00000HshKjYAJ",
                        "allowsRemoteParticipation": false
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
                                "@id": "https://data.volunteer.scot/Geography/LocalAuthority/EastAyrshire",
