            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXNbAAM/bellsmyre-development-trust",
            "name": "Bellsmyre Development Trust",
            "description": "To provide a range of premises, activities and opportunities for residents aimed at alleviating poverty, improving participation and employment levels within Bellsmyre.",
            "website": "http://www.bellsmyretrust.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC042891"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
