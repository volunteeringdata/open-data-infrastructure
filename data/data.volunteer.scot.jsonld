        {
            "id": "https://data.volunteer.scot/Organisation/0010800002ztu4gAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002ztu4gAAA/campy-growers",
            "name": "Campy Growers",
            "description": "We are going to seriously address food insecurity, carbon emissions and the malnutrition associated with a hyper-processed diet as well as offering educational and therapeutic spaces in our fabulous market garden to be located in Camperdown Country Park.",
            "website": "https://campygrowers.uk/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EnvironmentRecycling",
                    "skos:prefLabel": "Environment / Recycling"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000Vhn3dAAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000Vhn3dAAB/treasurer-andor-committee-member",
                    "publishStart": "2023-07-04",
                    "publishEnd": "2027-02-01",
                    "title": "Treasurer and/or Committee member",
                    "description": "## Summary\n\nJoin up with the Campy Growers board as a Chair! We are the largest community food-growing project in Dundee. Be part of the committee, support the decision making and meet our enthusiastic team !\n\n## Description\n\nThis is a vital project to get people growing and eating local food. If you believe you can help to make this happen, please consider joining our committee. \r\n\r\nWe are seriously addressing food insecurity, carbon emissions and the malnutrition associated with a hyper-processed diet as well as offering educational and therapeutic spaces in our fabulous community market garden  located in Camperdown Country Park.\r\n\r\nThe Treasurer keeps an eye on cash reserves and spending, making sure money is spent appropriately and has an allocated budget. That wages and salaries are paid together with their pension, tax and national insurance obligations. If you can look after your own finances then you can easily step into the Treasurer role. \r\n\r\nIf the Treasurer role seems too much at the moment, you can also join the 9 current trustees by joining the committee.\r\n\r\nThe ideal Treasurer or Trustee will also be interested in helping on site and supporting the team of volunteers by doing some manual work.\r\n\r\nWe currently have board meetings every 2-3 weeks on Tuesdays evening but it might differ.\n\n## Experience required\n\nExperience in being part of a ommittee, good communication skills, decision making, funding application\n\n## Training details\n\nWe will discuss what the Chair will need and meet with other members.\n\n## Travel details\n\nOnline or on site, Camperdown Country Park, Coupar Angus Road, Dundee, DD2 4TF\n\n## Travel expenses\n\nPlease note: No expenses are paid for this opportunity\n\n## Taster details\n\nPossibility to meet on site with other volunteers and board members",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000Vhn3dAAB#role",
                        "type": "Role",
                        "title": "Treasurer and/or Committee member",
                        "description": "Experience in being part of a ommittee, good communication skills, decision making, funding application",
                        "applyLink": "https://volunteer.scot/search/a0g0800000Vhn3dAAB/treasurer-andor-committee-member?#modal_register_a0g0800000Vhn3dAAB",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
