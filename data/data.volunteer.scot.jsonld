        {
            "id": "https://data.volunteer.scot/Organisation/00124000008neBRAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008neBRAAY/absafe",
            "name": "Absafe",
            "description": "Absafe is an award-winning, life-saving charity dedicated to educating and empowering young people and communities to make safer, informed choices. We are passionate about creating a lasting impact, whether it’s through our dynamic educational programs for schools, fostering responsible citizenship, or helping individuals develop life-saving skills. Volunteering with Absafe offers a variety of opportunities to make a difference. Whether you’re inspiring young minds through interactive safety sessions, enhancing our presence on social media, or assisting with the upkeep of our grounds and building, there’s a role for everyone. By joining our team, you’ll not only contribute to saving lives but also be part of a positive, inclusive, and forward-thinking charity making a real difference in Aberdeen and beyond. Together, we can create a safer future for all.",
            "website": "https://www.absafe.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC027660"
                }
            ],
            "cause": [
