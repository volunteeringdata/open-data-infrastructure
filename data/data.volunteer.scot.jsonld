        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZBpAAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZBpAAM/food-train-dundee",
            "name": "Food Train Dundee",
            "description": "Our aim is to support older people to live independently at home. Our preventative services address the difficulty older people face getting their weekly grocery shopping, doing jobs around the house and the growing isolation that comes with failing health. We also aim to provide a wide range of supported volunteering opportunities for people of all ages and ability and these include shopper, driver, delivery assistant and office assistant.",
            "website": "https://www.thefoodtrain.co.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC024843"
                }
