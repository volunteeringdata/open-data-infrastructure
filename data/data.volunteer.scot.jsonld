        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZ19AAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZ19AAE/shelter-scotland-east-renfrewshire",
            "name": "Shelter Scotland (East Renfrewshire)",
            "description": "Shelter Scotland is a charity that works to alleviate the distress caused by homelessness and bad housing.  We do this by giving advice, information and advocacy to people in housing need, and by campaigning for lasting political change to end the housing crisis for go",
            "website": "https://scotland.shelter.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC002327"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000000eIy4AAE",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000000eIy4AAE/charity-shop-retail-assistant",
                    "publishStart": "2014-09-14",
                    "publishEnd": "2027-05-11",
                    "title": "Charity Shop Retail Assistant",
                    "description": "## Summary\n\nGeneral day to day duties include - sorting stock hanging and taging of stock serving customers cash handling housekeeping.\n\n## Description\n\nGeneral day to day duties include - sorting stock hanging and taging of stock serving customers cash handling housekeeping.\n\n## Experience required\n\nNone\n\n## Training details\n\nTraining and induction will be mandatory as volunteer will need to know the running of the shop - till management, stock order and pricing.\n\n## Travel details\n\nClarkston Toll, Glasgow.\n\n## Taster details\n\nTrial shifts welcome",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fc46b1447-6fa9-2a64-70d4-5419d7da00e5%2FD5Fkl21abnNxZzKb66uMENQLQQn2%2Flisting.jpg?alt=media&token=f50e1d98-5de2-4fea-9c8e-e3b0b986bb76",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g24000000eIy4AAE#role",
                        "type": "Role",
                        "title": "Charity Shop Retail Assistant",
