        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXhVAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXhVAAU/albury-community-sports-hub",
            "name": "Albury Community Sports Hub",
            "description": "Albury Community Sports Hub (ACSH) is a Scottish Charitable Incorporated Organisation (SC051926) proudly run by volunteers working collaboratively with local people and Sport Aberdeen.\r\n\r\nACSH provides facilities for tennis, lawn bowls, petanque, and putting to Annual Users and Pay and Play users during Opening Hours.\r\n\r\nACSH is a home to other community initiatives like Tennis Teams, Croquet Club, Walk Aberdeen, and Wellbeing group.\r\n\r\nWe are conveniently located in the Ferryhill area of Aberdeen just a short walking distance from Union Street, Ferryhill House Hotel, and Duthie Park. No parking is available on-site, but on-street pay and display parking can be found next to our entrance on Albury Road (free parking on Sunday). Bike rack located under our pavilion could be used to park your bicycle.",
            "website": "https://www.alburyhub.uk/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SportLeisureRecreation",
                    "skos:prefLabel": "Sport / Leisure / Recreation"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
                    "skos:prefLabel": "Volunteering"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000354u9YAA",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000354u9YAA/trustee-members-and-volunteers-opportunities",
                    "publishStart": "2026-11-02",
                    "publishEnd": "2027-04-28",
                    "title": "Trustee Members and Volunteers Opportunities",
                    "description": "## Description\n\nAlbury Outdoor Sports Hub (Scottish charity number: SC051926) is a volunteer partnership between members of the local community and Sport Aberdeen, successfully operating this city centre outdoor sports facility, offering tennis, green bowling, petanque, croquet and the only public 18 hole putting green in Aberdeen. \r\n\r\nAs a registered charity we welcome people interested in volunteering to assist as part of our trustee membership in order to maintain and develop the high standard of outdoor sports provision which is greatly appreciated by the community.\r\n\r\nWe would welcome members from both the local community and the wider area who support the aims of the charity, to be involved as Trustee Members and potentially willing to become Board members involved in managing and progressing the various activities at the Hub.\r\n\r\nWe are also seeking to increase our volunteer team which runs the Hub on a two-hour shift basis, from mid-April to mid-September each year. \r\n\r\nFurther details are to be found on our website – https://www.alburyhub.uk/ or by emailing VolAlbury@gmail.com\n\n## Training details\n\nExcellent support and relevant guidance is provided to all volunteers.\n\n## Travel details\n\nAlbury Outdoor Sports Hub is located at Albury Road, Aberdeen AB11 6TN",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F68e92521-f0a8-4939-b0f0-b06906ad0ab1%2FSlbeIgQomgTI8aWMJUM0k8lOky42%2Flisting.jpg?alt=media&token=0aae5dca-48d9-47a1-a9d5-386d638238f0",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000354u9YAA#role",
                        "type": "Role",
                        "title": "Trustee Members and Volunteers Opportunities",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000354u9YAA/trustee-members-and-volunteers-opportunities?#modal_register_a0gQD00000354u9YAA",
                        "allowsRemoteParticipation": false,
