            "name": "Kaimhill Strollers",
            "description": "An over 50s walking group based at Kaimhill Learning Centre, Pitmedden Terrace, Aberdeen AB10 7HR.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/OlderPeople",
