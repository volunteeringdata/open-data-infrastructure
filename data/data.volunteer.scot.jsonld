            "id": "https://data.volunteer.scot/Organisation/00108000034T2XdAAK",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00108000034T2XdAAK/missing-people",
            "name": "Missing People",
            "description": "We are a lifeline when someone disappears. We are caring and highly trained staff and volunteers working in collaboration with partners across the UK. For those left behind, we provide specialised support to end the heartache and confusion and search for their missing loved one.\r\nMissing People is an independent charity funded by donations. You can make a real difference by joining the search in your area and by supporting us in a range of ways.",
            "website": "https://www.missingpeople.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC047419"
                }
            ],
            "cause": [
                {
