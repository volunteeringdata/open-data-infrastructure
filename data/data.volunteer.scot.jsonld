            "dc:source": "https://volunteer.scot/organisations/0012400001835hfAAA/debra-charity-east-renfrewshire",
            "name": "Debra Charity (East Renfrewshire)",
            "description": "We have a vision of a world where no-one suffers from the painful genetic skin condition Epidermolysis Bullosa. By working with and for Debra we aim to make a positive difference to people living with EB, work together to achieve our purpose of providing care and curing EB, be passionate about what we do with Debra and strive for excellence in all our activities.",
            "website": "https://www.debra.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039654"
                }
            ],
            "cause": [
