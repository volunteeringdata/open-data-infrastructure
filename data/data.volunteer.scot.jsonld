        {
            "id": "https://data.volunteer.scot/Organisation/0012400001MHGQNAA5",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400001MHGQNAA5/ayrshire-recording-services-talking-newspapers-for-the-visually-impaired",
            "name": "Ayrshire Recording Services (Talking Newspapers for the Visually Impaired)",
            "description": "In a world where sight is often taken for granted, many face challenges due to deteriorating vision or eye diseases. At Ayrshire Recording Services, we prioritise accessibility for the visually impaired, ensuring everyone has access to essential information.\r\n\r\nSpecialising in tailored talking newspapers, we provide vital local news, sports updates, and community events.",
            "website": "https://www.arsb.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC054087"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SensoryImpairment",
                    "skos:prefLabel": "Sensory Impairment"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000Hnn0zYAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000Hnn0zYAB/talking-newspaper-producer-south-ayrshire",
                    "publishStart": "2026-07-22",
                    "publishEnd": "2027-01-20",
                    "title": "Talking Newspaper Producer. South Ayrshire",
                    "description": "## Description\n\nSouth Ayrshire Team\r\nWe are building a brand-new South Ayrshire team to bring the talking newspaper to blind, visually impaired and print-impaired people - and those with mobility issues - right across South Ayrshire. Each weekly edition must be recorded, edited and posted via FREEPOST.on the same day the local newspaper is released (e.g. every Wednesday), so our listeners get their news at the same time as everyone else.\r\n\r\nTalking Newspaper Producer — South Ayrshire\r\n \r\nLead the team that brings the week's local news to life.\r\n\r\nCommitment: Weekly — every publication day, without fail!\r\nLocation: South Ayrshire — must have access to your own computer for recording and editing\r\n\r\nYour team starts with you\r\nThis role is our starting point. Once the Producer is in place, we can begin building the South Ayrshire reading team around them — so the right candidate gets to shape a brand-new service from the ground up.\r\n\r\nWhat you'll need\r\n•\tYour own recording equipment, or access to a recording studio.\r\n•\tSuitable space to host other volunteers for recording sessions.\r\n•\tA computer with recording and editing software — full training provided.\r\n•\tOne day a week, every week — the edition must go out same-day via FREEPOST on publication day.\r\nWhat you'll get\r\n•\tFull training and ongoing support from ARSB.\r\n•\tThe chance to shape a brand-new service from the ground up.\r\n•\tA friendly, supportive team of volunteers behind you — and a determination to have fun doing it!\n\n## Experience required\n\n•\tAccess to a computer suitable for recording and editing audio (we'll train you on the software).   Rock-solid reliability — same-day turnaround is the heartbeat of the service.\r\n•\tGood organisational skills and a calm, encouraging way of leading a small team.\r\n\r\nA positive attitude — and a determination to have fun doing it!",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F935fae5d-fc56-44a4-9111-52c151f1a0a0%2FPNprC3wmrFhb2vt6Q70SsC0gjh22%2Flisting.jpg?alt=media&token=380c39bb-f677-4608-9cdf-510fa3bac943",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000Hnn0zYAB#role",
