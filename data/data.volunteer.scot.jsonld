        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002IVHgKAAX",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002IVHgKAAX/anam-cara-fasgadh",
            "name": "Anam Cara Fasgadh",
            "description": "2 The organisation's purpose is the relief of those in need by reason of bereavement through the death of a child by providing respite accommodation & support with the object of improving the conditions of life for bereaved families.",
            "website": "https://www.anamcarafasgadh.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC049149"
