                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HwRm2YAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HwRm2YAF/swan-places-glasgow-west-end-meet-up-group-facilitator",
                    "publishStart": "2026-08-26",
