        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZovAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZovAAE/move-on",
            "name": "Move On",
            "description": "Move On is an organisation which works with vulnerable young people and those affected by homelessness. \r\nWe offer a range of services providing advice, training, guidance and support enabling vulnerable young people and those affected by homelessness to unlock their potential and achieve a range of positive outcomes. These positive outcomes include; securing or progressing towards a job, accessing and sustaining a home, building confidence, growing support networks and increasing life skills.",
            "website": "https://www.moveon.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC026983"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/HousingHomelessnessness",
                    "skos:prefLabel": "Housing / Homelessnessness"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000008rhp3AAA",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000008rhp3AAA/mentoring-children-and-young-people-aged-8-14",
                    "publishStart": "2018-10-16",
                    "publishEnd": "2027-02-10",
                    "title": "Mentoring Children and Young People aged 8 - 14",
                    "description": "## Summary\n\nDo you have what it takes to change a young person's life for the better? \r\nCould you spare 1 - 2 hours a week? \r\nMove On is looking for Volunteer Mentors for our new intandem project in Midlothian.\n\n## Description\n\nWe’re looking for enthusiastic and open-minded adults from all walks of life to volunteer to work with vulnerable children and young people aged 8 - 14 who are looked after at home. Your role will be to work one to one with the young person using your own life experiences and skills to encourage them to achieve their goals. \r\n\r\nNo particular experience or skills are necessary - but a strong belief in the potential of young people is essential. Full training will be given, and once you're matched with a young person we'll expect you to be committed to them for at least a year. \r\n\r\nInterested? \r\n\r\nFor an application pack, or to find out more information about the role, please get in touch!\n\n## Experience required\n\nA strong belief in the potential of a young person.\n\n## Travel details\n\nThroughout Midlothian – will give EH22 4LG (Newtongrange Library) as it’s relatively central in relation to Midlothian’s geographical area!",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g24000008rhp3AAA#role",
                        "type": "Role",
                        "title": "Mentoring Children and Young People aged 8 - 14",
                        "description": "A strong belief in the potential of a young person.",
                        "applyLink": "https://volunteer.scot/search/a0g24000008rhp3AAA/mentoring-children-and-young-people-aged-8-14?#modal_register_a0g24000008rhp3AAA",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
                            {
