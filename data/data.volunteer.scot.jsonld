            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HHwFWYA1",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HHwFWYA1/diamonds-over-sixties-lunch-club-volunteers",
                    "publishStart": "2026-06-15",
                    "publishEnd": "2026-12-14",
                    "title": "Diamonds Over Sixties Lunch Club volunteers",
                    "description": "## Description\n\nNew Life is a lively AoG Church in Prestwick. Our Church services are on every week at 11am and everyone is welcome to attend!\r\nOur Vision is To Stretch, Strengthen & Send people, Locally, Nationally & Globally.\r\n\r\nOur wonderful Diamonds Over Sixties Lunch Club continues to grow, and we’re looking for a few extra helping hands to keep blessing our seniors\r\neach week.\r\n\r\nWe meet every Thursday at New Life Church, with lunch served at 12:30pm,\r\nfollowed by light entertainment until around 2pm.\r\n\r\nWe’re currently looking for volunteers who can help in any of these\r\nareas:\r\n\r\nKitchen support — helping with dishes and some simple prep for our chef\r\n\r\nBus assistance — supporting our driver by helping guests safely on and off the bus.\r\n\r\nServing team — bringing meals to tables and offering a warm, friendly presence.\r\n\r\nWe are looking for people who have a heart to serve and a couple of hours to spare on a Thursday, we’d love to hear from them. They'll  be\r\nmaking a real difference to a group of people who treasure this time together.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Ff820a9cc-6f55-4a0a-bd7d-df98a8fcacd7%2Fu6pON37TQjYdM5UHI6HGmnnbgQ23%2Flisting.jpg?alt=media&token=3f53107f-0812-4492-895f-122a2d4fce64",
