        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000VVomgYAD",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000VVomgYAD/glasgow-disabled-scouts",
            "name": "Glasgow Disabled Scouts",
            "description": "We are a Scout Group for girls, boys and young adults with disabilities and life limiting conditions aged 6 to 25.  We are a full part of the UK Scout Association and run the same programme using the same uniform, structure and everything else. However we are a specialist group supporting young people with disabilities. \r\n\r\nWe exist to ensure that all young people are fully included in Scouts, and for the young people who join our group that is only possible with specialist one to one support and adaptations to the programme and activities.\r\n\r\nAll of our young people have some form of additional support needs and we provide one to one support through a team of over 100 volunteers so that those needs are met and the young person can fully participate in the activities.",
            "website": "https://glasgowdisabledscouts.org/contact/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC008726"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/LearningDisability",
                    "skos:prefLabel": "Learning Disability"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/PhysicalDisability",
                    "skos:prefLabel": "Physical Disability"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SensoryImpairment",
                    "skos:prefLabel": "Sensory Impairment"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/UniformedGroups",
                    "skos:prefLabel": "Uniformed Groups"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HukcfYAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HukcfYAB/your-monday-their-adventure",
                    "publishStart": "2026-08-19",
                    "publishEnd": "2027-02-17",
                    "title": "Your Monday. Their Adventure.",
                    "description": "## Description\n\nJoin Glasgow Disabled Scouts and help disabled children and young people take part in fun, inclusive Scouting activities across Glasgow.\r\n\r\nOur volunteers support young people aged 6 to 25 during weekly term-time meetings, helping with games, activities, creative projects, challenges and opportunities to build confidence and independence.\r\n\r\nYou might help a young person take part in an activity, adapt equipment or games to meet individual needs, support trips and events, or simply provide encouragement and friendship as part of our volunteer team.\r\n\r\nYou do not need previous Scouting, youth work or disability experience. Full training, induction and ongoing support are provided.\r\n\r\nOur regular sections meet on Monday evenings in Glasgow, including the West End and Southside. Opportunities are available across different age groups, and we will work with you to find a role that suits your interests, experience and availability.\r\n\r\nVolunteers will be required to complete the relevant Scout safeguarding and training requirements and, where applicable, PVG membership.\n\n## Experience required\n\nNo formal qualifications or previous experience are required.\r\n\r\nWe are looking for volunteers who are:\r\n\r\nReliable and committed.\r\nPatient and understanding.\r\nFriendly and approachable.\r\nComfortable working as part of a team.\r\nPositive about inclusion and supporting disabled young people.\r\nWilling to learn and complete relevant training.\r\nAble to communicate appropriately with young people and other volunteers.\r\n\r\nTraining and ongoing support will be provided.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HukcfYAB#role",
                        "type": "Role",
                        "title": "Your Monday. Their Adventure.",
                        "description": "No formal qualifications or previous experience are required.\r\n\r\nWe are looking for volunteers who are:\r\n\r\nReliable and committed.\r\nPatient and understanding.\r\nFriendly and approachable.\r\nComfortable working as part of a team.\r\nPositive about inclusion and supporting disabled young people.\r\nWilling to learn and complete relevant training.\r\nAble to communicate appropriately with young people and other volunteers.\r\n\r\nTraining and ongoing support will be provided.",
                        "applyLink": "https://glasgowdisabledscouts.org/volunteer/",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "14",
                        "theme": [
