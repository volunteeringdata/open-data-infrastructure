        {
            "id": "https://data.volunteer.scot/Organisation/0010800002te8oNAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002te8oNAAQ/west-kilbride-larder",
            "name": "West Kilbride Larder",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000Gvbw8AAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000Gvbw8AAB/volunteer-larder-delivery-driver",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Volunteer Larder Delivery Driver",
                    "description": "## Description\n\nAccess to good food is essential for the Larder, and we want to get more of it to our members. We have a number of businesses willing to donate stock which requires collection from sites across the North Coast. This additional stock is vital to supporting the operation of the Pantries, as well as helping to reduce food waste.· Collection of goods, observing appropriate food safety and manual handling regulations\r\n\r\n· Drop off goods at Larder, ensuring they are stored as appropriate to Health & safety/Environmental Health guidelines.\n\n## Experience required\n\nEnthusiasm and good communication skills will make you an excellent candidate for this role.\r\n\r\nYou will need to hold a full driving license; and have access to a vehicle",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000Gvbw8AAB#role",
                        "type": "Role",
                        "title": "Volunteer Larder Delivery Driver",
                        "description": "Enthusiasm and good communication skills will make you an excellent candidate for this role.\r\n\r\nYou will need to hold a full driving license; and have access to a vehicle",
