        {
            "id": "https://data.volunteer.scot/Organisation/001QD00001ECYeyYAH",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00001ECYeyYAH/peacock-and-the-worm",
            "name": "Peacock and the Worm",
            "description": "peacock is a printmaking workshop in the north east of Scotland, established in 1974. We offer a wide range of artistic techniques, such as relief printing, intaglio, screenprint, lithography, risograph, and letterpress. We are a charity supported by Aberdeen City Council & Creative Scotland.\r\n\r\nthe worm is a contemporary visual art gallery in Aberdeen, Scotland. We showcase artworks from all over the world, focussing on printing and publishing. Our exhibitions show work by contemporary artists, fine art prints from our archives and objects related to Aberdeen’s rich print history.",
            "website": "https://peacock.studio/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC056235"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
