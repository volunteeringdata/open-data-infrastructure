        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nWuJAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nWuJAAU/clasp",
            "name": "CLASP",
            "description": "The aims of CLASP are the relief of poverty and advancement of education. The charity’s objectives are:\r\n\r\nTo develop a community managed and run sustainable project in the Stevenston area but serving the North Ayrshire area.\r\n\r\nTo encourage a more empowered, informed and socially active community through community capacity building and active citizenship training and activities.\r\n\r\nTo support and facilitate individual and group activity on issues relating to social inclusion.\r\n\r\nTo provide a local base for information, advice, assistance and resources on issues such as poverty, health, unemployment, money advice, literacies and local training opportunities in partnership with other voluntary and statutory organisations.\r\n\r\nTo recruit and train local volunteers in the above activities offering, where possible, recognised accredited opportunities in partnership with training and education providers.\r\nTo develop a community managed and run sustainable project in the Stevenston area but serving the North Ayrshire area.\r\n\r\nTo encourage a more empowered, informed and socially active community through community capacity building and active citizenship training and activities.\r\n\r\nTo support and facilitate individual and group activity on issues relating to social inclusion.\r\n\r\nTo provide a local base for information, advice, assistance and resources on issues such as poverty, health, unemployment, money advice, literacies and local training opportunities in partnership with other voluntary and statutory organisations.\r\n\r\nTo recruit and train local volunteers in the above activities offering, where possible, recognised accredited opportunities in partnership with training and education providers.",
            "website": "http://www.clasps.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC029988"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
