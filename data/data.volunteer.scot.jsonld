                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JiE2jYAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JiE2jYAF/elcan-board-members-and-trustees",
