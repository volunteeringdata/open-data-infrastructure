        {
            "id": "https://data.volunteer.scot/Organisation/0010800003Br9H2AAJ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003Br9H2AAJ/calderwood-baptist-church",
            "name": "Calderwood Baptist Church",
            "description": "Calderwood Baptist Church aim to promote faith and religion through the local community and also provide a place of worship for the people of the area. They meet at 10:30am on a Sunday morning and 7pm on a Sunday evening plus the last Sunday of every month at 4pm for prayer, connection, and food.",
            "website": "https://www.calderwoodbaptist.co.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
