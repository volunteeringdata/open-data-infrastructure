        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nbUZAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbUZAAY/british-heart-foundation-shop-leith",
            "name": "British Heart Foundation Shop (Leith)",
            "description": "Our work has been central to the discoveries of vital treatments that are changing the fight against heart disease. Our shops raise vital funds to help fight heart disease by selling a range of quality new and donated items.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039426"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000QNuKvAAL",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000QNuKvAAL/cashier-sales-assistant-volunteer",
                    "publishStart": "2021-11-22",
                    "publishEnd": "2026-12-31",
                    "title": "Cashier Sales Assistant Volunteer",
                    "description": "## Summary\n\nCould you be the face of your local British Heart Foundation shop? If you want to gain cashier and sales experience in a friendly environment, this is a great way to get a taste of a career in retail while helping raise live-saving funds.\n\n## Description\n\nEngaging with customers and serving them in a helpful and friendly way.\nCommunicating with fellow volunteers about what has sold and needs re-stocking.\nHoning your retail and cashier skills behind the till and taking payments.\nHelping with administration and reception duties around the till area.\nPromoting Gift Aid and sales campaigns, and chatting to customers.\nActing as an ambassador for the British Heart Foundation.\n\n## Experience required\n\nFriendly.\nTeam player.\nGood Customer service skills.\n\n## Training details\n\nInduction Training\n\n## Travel details\n\n23-29 Great Jct St, Leith, Edinburgh EH6 5HX\n\n## Travel expenses\n\nReimbursed for reasonable travel expenses in agreement with the shop manager",
                    "requiresEmergencyParticipation": false,
