        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nYxQAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nYxQAAU/28th-giffnock-scout-group",
            "name": "28th Giffnock Scout Group",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC014819"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F5b8c8f2c-096c-6c85-2ed1-84922a6a070c%2FUC59fMqTlUgceOwgyfCxCWOzN1y2%2Fuser-upload.jpg?alt=media&token=e12294bc-50ef-47f3-85e7-0a5d360026d8",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000H9FfZYAV",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000H9FfZYAV/team-memberleader-various-days",
                    "publishStart": "2026-06-05",
                    "publishEnd": "2026-12-04",
                    "title": "Team Member/Leader (Various Days)",
                    "description": "## Description\n\nLooking to make a real difference in your community, develop new skills, and have some fun along the way?  The 28th Glasgow Scout Group is looking for enthusiastic volunteers to join our team and help inspire the next generation of young people.\r\n\r\nAt Scouts, we help young people gain confidence, learn life skills, and experience adventure.  As a volunteer, you’ll:\r\n* Make a meaningful impact on young people’s lives\r\n* Build confidence, leadership and teamwork skills\r\n* Meet new people and become part of a supportive community\r\n* Try new activities – from outdoor adventures to creative projects\r\n* Gain recognised training and development opportunities (if you want them!)\r\n\r\nNo prior experience in Scouting is needed - just enthusiasm, reliability and a willingness to get involved.\r\n\r\nWe have a range of flexible roles to suit different interests and availability:\r\nSection Volunteers across all age groups (Beaver, Cub & Scout Leaders)\r\nThis involves:\r\n* Working directly with young people aged 6-14\r\n* Helping run fun, engaging weekly meetings\r\n* Leading or support activities like games, crafts and outdoor experiences\r\n\r\nWe're also looking for occasional helpers, with no long-term commitment required!\r\n\r\nIf you can support events, trips or special activities or provide behind-the-scenes support like helping with administration or fundraising then we also would love to hear from you.\r\n\r\nWe offer flexible volunteering - from a couple of hours a month to regular weekly sessions.  You can shape your role around your availability.\r\n\r\nNo Experience?  No Problem!\r\nWe provide full support and guidance from experienced leaders, optional training opportunities and a friendly, welcoming environment.\r\n\r\nWhether you want to gain experience, give back or try something new, there’s a place for you at 28th Glasgow Scout Group.\r\n\r\nPVG membership required.\n\n## Travel details\n\nOur Scout Hall is based at Arthurlie Drive, Giffnock, G46 6UP and the meetings take place at this location for the majority of the time.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F96a9346e-f743-4717-9f9f-208b3e8dfd6a%2FUC59fMqTlUgceOwgyfCxCWOzN1y2%2Flisting.jpg?alt=media&token=55484cca-be37-4874-9549-0685c9c2470e",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000H9FfZYAV#role",
                        "type": "Role",
                        "title": "Team Member/Leader (Various Days)",
