        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZyBAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZyBAAU/the-haddington-bridge-centre",
            "name": "The Haddington Bridge Centre",
            "description": "The Bridge Centre provides let spaces to community groups who offer educational, social welfare or recreational opportunities to the residents of Haddington and surrounding East Lothian area. The Centre offers a wide range of activities from birth upwards.\r\n\r\nPlease note - the Centre does not host birthday parties.",
            "website": "http://www.bridgecentrehaddington.co.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC019857"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000DIXvhYAH",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000DIXvhYAH/board-member",
                    "publishStart": "2026-09-07",
                    "publishEnd": "2027-03-06",
                    "title": "Board Member",
                    "description": "## Description\n\nJoin Our Board – Make a Difference in Haddington!\r\n\r\nVolunteer Board Member Opportunity\r\n\r\nHaddington Bridge Centre | Charity No. SC019587\r\n\r\nAre you passionate about community, connection, and creating opportunities for all? The Haddington Bridge Centre is seeking enthusiastic and committed individuals to join our Board of Trustees.\r\n\r\nAs a Board Member, you’ll help guide the strategic direction of the Centre, ensuring we continue to serve as a vibrant hub for learning, wellbeing, and community engagement in Haddington and beyond.\r\n\r\nWhat We’re Looking For:\r\nWe welcome applications from people of all backgrounds and experiences. We’re especially keen to hear from individuals with skills or experience in:\r\n• Charity governance and/or leadership\r\n• Finance or fundraising\r\n• Community development\r\n• Marketing and communications\r\n• Youth or adult education\r\n• Health and wellbeing\r\n• Partnership working\r\n\r\nWhat You’ll Gain:\r\n• A chance to give back to your community\r\n• Experience in charity governance and strategic planning\r\n• Opportunities to collaborate with a passionate and supportive team\r\n• Personal and professional development\r\n\r\nTime Commitment:\r\nApproximately 6–10 hours per month, including quarterly board meetings and occasional events or working groups.\r\n\r\nOther information\r\nBecoming a Board member will require a PVG for children and young people and an ID check with Companies House.\r\n\r\nHow to Apply:\r\nTo express your interest or request an informal chat, please contact us at haddbridgecentre@outlook.com or call 01620 823137\n\n## Experience required\n\nAccountancy / Finance\r\nCommunity Development / Social work\r\nComputer / IT / Web\r\nEvent Management / Organising\r\nFundraising\r\nGeneral Admin / Office Support\r\nLegal\r\nResearch / Policies\r\nYouth / Childcare\r\n\r\nCaring\r\nCreative\r\nGood Communicator\r\nGood Listener\r\nHard Working\r\nOpen minded\r\nOrganised\r\nPractical\r\nReliable / Dependable\r\nSociable;Social Conscience\r\nTeam Player\r\nTrustworthy\n\n## Frequency commitment details\n\nCommitment 2 Years + 10 Hours, Monthly",
                    "requiresEmergencyParticipation": false,
                    "role": {
