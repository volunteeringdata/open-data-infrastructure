        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000PaDWkYAN",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000PaDWkYAN/lochlans-legacy-north-ayrshire",
            "name": "Lochlans Legacy North Ayrshire",
            "description": "Lochlan's Legacy-SCIO was founded by then 11 year old Lochlan Murdoch. Lochlan who is now 14 lives with type1diabetes. Lochlan's Legacy was set up to raise awareness and understanding of Type1Diabetes, breakdown barriers,reduce stigma and build community.",
            "website": "https://www.lochlanslegacyt1d.co.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC050543"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000068GXEYA2",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000068GXEYA2/youth-voice-volunteers",
                    "publishStart": "2026-09-07",
                    "publishEnd": "2027-03-01",
                    "title": "Youth Voice Volunteers",
                    "description": "## Description\n\nLochlan’s Legacy is a charity which raises awareness and understanding of type 1 diabetes, reducing stigma, breaking down barriers, promoting youth voice and building a strong community. Lochlan’s Legacy is led by our founder, Lochlan Murdoch BCyA, who is fourteen years old.  The charity has been working since 2020 and our work includes raising awareness of Type 1 diabetes in sport, and setting up our youth group 'T1D and ME - Giving Youth a Voice'. Come and be part of something incredible, driven by our iWill Ambassador Lochlan.\r\n\r\nWe are currently looking for Youth Voice Volunteers to promote the work we do as part of our youth group.\n\n## Experience required\n\nYou do not need to live with type 1 diabetes to volunteer for us, just a keen interest to learn and develop.\r\n\r\nWe have various volunteering opportunities so they can be tailormade to your time, availability and interests.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F27d02940-9485-4f0f-a6a6-aa3f98b9351c%2F0nFCUqNjeiXPIFO483j0BVWArU43%2Flisting.jpg?alt=media&token=bde6b1be-f36e-40cb-8d98-deb9e3e1ff00",
                    "role": {
