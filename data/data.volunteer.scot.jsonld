                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HneovYAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HneovYAB/adult-activity-leader-barra",
                    "publishStart": "2026-07-21",
                    "publishEnd": "2027-01-19",
                    "title": "Adult Activity Leader (Barra)",
                    "description": "## Summary\n\nTo support or lead informal learning, creative, or wellbeing activities for adults, helping libraries act as welcoming community spaces.\n\n## Description\n\nRole Purpose\r\nTo support or lead informal learning, creative, or wellbeing activities for adults, helping libraries act as welcoming community spaces.\r\nKey Responsibilities\r\n•\tSupport delivery of adult learning or interest-based activities\r\n•\tEncourage participation in a supportive and inclusive way\r\n•\tAssist with preparation and tidying of spaces and materials\r\n•\tSignpost participants to library services and staff\r\n\r\nSkills and Attributes\r\n•\tFriendly and respectful approach\r\n•\tGood communication skills\r\n•\tInterest in community learning or engagement\r\n•\tWillingness to undertake safeguarding training\r\n\r\nTraining details\r\nThe volunteer will liaise with the branch manager at their local library, who will guide them through their induction, and will be the first point of contact for any issues, questions, or problems should they arise.\r\nRestrictions Minimum age: 17 \r\nSafeguarding Responsibilities\r\n•\tFollow safeguarding procedures for working with vulnerable adults\r\n•\tMaintain professional boundaries at all times\r\n•\tReport any concerns about wellbeing, safety, or behaviour immediately\r\n\r\nPVG and Recruitment\r\n•\tPVG membership may be required, depending on the nature of the activity and participants\r\n•\tAppropriate checks will be discussed before appointment\n\n## Experience required\n\n•\tFriendly and respectful approach\r\n•\tGood communication skills\r\n•\tInterest in community learning or engagement\r\n•\tWillingness to undertake safeguarding training\n\n## Travel details\n\nLocation: Library branches",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HneovYAB#role",
                        "type": "Role",
                        "title": "Adult Activity Leader (Barra)",
                        "description": "•\tFriendly and respectful approach\r\n•\tGood communication skills\r\n•\tInterest in community learning or engagement\r\n•\tWillingness to undertake safeguarding training",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000HneovYAB/adult-activity-leader-barra?#modal_register_a0gQD00000HneovYAB",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "17",
