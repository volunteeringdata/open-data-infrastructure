        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nbS6AAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbS6AAI/corstorphine-dementia-project",
            "name": "Corstorphine Dementia Project",
            "description": "Our aims are to support people with dementia, and their carers, in the Corstorphine area\n( including Clermiston and Carrickknowe).\nOur services include social club type day care; outreach support service ( one to one ); carers support; information and advice.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC026190"
                }
            ],
            "cause": [
                {
