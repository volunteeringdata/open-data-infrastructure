                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000GJiwzYAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000GJiwzYAD/responder",
                    "publishStart": "2026-04-13",
                    "publishEnd": "2027-04-12",
                    "title": "Responder",
                    "description": "## Description\n\nARCHIES Child Bereavement Service provide a range of services for children and young people who have lost a loved one. \r\n\r\nOne of the services is to provide direct support, advice and guidance to a child or young person in the child's home or at their school. \r\n\r\nThe aim is to help the child navigate their way through their grief and help them adapt to life without their special person being there.\n\n## Training details\n\nFull training, via Teams, is provided",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fb4df3b62-397e-4f2f-9c9c-c0ed49a46068%2FJqK8q7mcUtcgywKvmhEW9RRQbgy1%2Flisting.jpg?alt=media&token=8bccea22-7dd0-4bce-b556-1ecd08e84f62",
