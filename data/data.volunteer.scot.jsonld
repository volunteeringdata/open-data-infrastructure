            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZB2AAM/dundee-independent-advocacy-support",
            "name": "Dundee Independent Advocacy Support",
            "description": "Dundee Independent Advocacy Support (DIAS) is an independent charity for people who experience disadvantage, disability and social exclusion within the Dundee area to express their needs and wishes around their health and wellbeing. DIAS promotes, protects and safeguards individual’s rights and strengthens voices by using trained staff and volunteers.",
            "website": "https://www.diasdundee.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC027180"
