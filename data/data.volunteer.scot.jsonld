            "dc:source": "https://volunteer.scot/organisations/001QD00000znIotYAE/scottish-spca-western-isles",
            "name": "Scottish SPCA (Western Isles)",
            "description": "Since 1839 the Scottish SPCA has existed for one reason - to make Scotand the best place in the world for an animal to call home.  We rescue protect and lead the conversation on animal welfare.  The SSPCA rely on the generosity of donations and have no government funding.",
            "website": "https://www.scottishspca.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC006467"
                }
