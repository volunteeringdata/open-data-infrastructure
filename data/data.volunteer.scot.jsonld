        {
            "id": "https://data.volunteer.scot/Organisation/0010800002ut4kEAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002ut4kEAAQ/marys-meals-midlothian",
            "name": "Mary's Meals (Midlothian)",
            "description": "Mary’s Meals provides life-changing meals to some of the world’s poorest children every school day. We are a no-frills charity with a simple idea that works: by providing one good meal in a place of learning, children are drawn into the classroom where they can receive an education that could one day free them from poverty.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC022140"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EmergencyResponseDisasterRelief",
                    "skos:prefLabel": "Emergency Response / Disaster Relief"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/OverseasAidDevelopingWorld",
                    "skos:prefLabel": "Overseas Aid / Developing World"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Poverty",
                    "skos:prefLabel": "Poverty"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000GvdhMAAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000GvdhMAAR/community-volunteer",
                    "publishStart": "2021-06-03",
                    "publishEnd": "2027-02-10",
                    "title": "Community Volunteer",
                    "description": "## Description\n\nWe need volunteers to help raise awareness about Mary's Meals and fundraise for our work. As a Community Volunteer you will grow our movement by motivating and inspiring your local community to support our work.\r\nWe need people who are passionate about ending child hunger and ensuring that every child receives a daily meal in a place of education. We have a range of activities that can be done from the comfort of your home that include: hosting virtual talks, spreading the word about our work on social media or holding screenings of our inspiring videos with family and friends. If you don't mind public speaking, we can also train you to give talks to schools, Rotary Clubs and other local organisations to generate support for our cause. Oher activities may include: * Sharing our story with local community organisations, schools, churches, and faith groups. * Organising fundraising events in your local area – such as coffee mornings, quizzes, and bucket collections. * Promoting Mary's Meals' fundraising campaigns in your community. * Distributing and displaying promotional materials and placing collection tins.\n\n## Experience required\n\nFriendly, diplomatic, excellent communication skills, share our vision, mission and values, honest, trustworthy, confident, resilient, flexible, self-motivated, enthusiastic.\n\n## Training details\n\nInduction training with volunteer manager lasting 1.5 hours. Speaker training with vm although professional training is available periodically. Zoom training if needed. Other health & wellbeing and training sessions available as requested and when available.\n\n## Frequency commitment details\n\n2 hours per week\n\n## Travel expenses\n\n45p per mile or public transport costs reimbursed weekly. Other expenses paid as agreed.",
                    "requiresEmergencyParticipation": false,
                    "role": {
