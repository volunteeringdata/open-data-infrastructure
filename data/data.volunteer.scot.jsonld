        {
            "id": "https://data.volunteer.scot/Organisation/001QD000014U2JLYA0",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000014U2JLYA0/girlguiding-scotland-cults-district",
            "name": "Girlguiding Scotland (Cults District)",
            "website": "https://www.girlguidingscotland.org.uk/",
