            "dc:source": "https://volunteer.scot/organisations/00108000039a7rgAAA/bravehound",
            "name": "BRAVEHOUND",
            "description": "BRAVEHOUND'S mission is to help heal the invisible wounds of military veterans with our specially trained assistance dogs.  BRAVEHOUND provides assistance dogs to veterans who have a clinical diagnosis of a mental health condition such as Post Traumatic Stress Disorder, depression and anxiety.",
            "website": "https://www.bravehound.co.uk/",
            "charityRegistration": [
                {
