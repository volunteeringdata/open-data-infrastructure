        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nfrbAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nfrbAAA/the-buddy-beat",
            "name": "The Buddy Beat",
            "description": "The Buddy Beat are a Renfrewshire djembe drumming group for adults with mental health experience. We promote social inclusion and help people self-manage their week. Now in our 12th year, we meet once a week in Johnstone.\r\n\r\nBeing part of the Buddy Beat reduces social isolation, improves self confidence and builds lasting friendships. We play for two hours each week, jamming, playing musical games and we also compose our own rhythms, which we share when we hold gigs/workshops (more than 200 to date). Check us out on Youtube too and see among others our award winning film \"Keep the Beat...Our Journey in Rhythm\"",
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F329324ba-82f8-186b-9bce-06c1ba3962e2%2F4WX3kxOmhYg5yp2v3octCSeFr5k2%2Fuser-upload.jpg?alt=media&token=dc115aec-d3e9-4b7b-8226-cb09ee0d7dca",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                }
            ],
            "activity": [
                {
