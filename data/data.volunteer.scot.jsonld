        {
            "id": "https://data.volunteer.scot/Organisation/0010800002w6yKWAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002w6yKWAAY/greener-orkney",
            "name": "Greener Orkney",
            "description": "Greener Orkney was set up to advance environmental protection by reducing Orkney’s carbon footprint, and to raise awareness of climate change among the community. \r\n\r\nOur aim is to improve people’s knowledge of environmental matters and show how individuals can make a difference. We run community fridges in Kirkwall, Stromness and Dounby, organise beach cleans and deliver the slow cooker project.",
            "website": "https://greenerorkney.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC049148"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F5dff8723-2707-3b02-8698-6a0b6d6d1f2d%2Fy4Y6e60YtRQisjNIjB79rsh2Vsl1%2Fuser-upload.jpg?alt=media&token=52a58aea-4cb6-4956-9c2c-ae4920975f48",
