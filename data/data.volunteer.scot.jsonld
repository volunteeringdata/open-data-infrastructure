                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000000FdDxYAK",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000000FdDxYAK/chss-community-connector",
                    "publishStart": "2023-08-28",
                    "publishEnd": "2027-02-06",
                    "title": "CHSS Community Connector",
                    "description": "## Description\n\nAs a CHSS Community Connector you can support CHSS any time or anywhere, giving as much or as little time to the tasks as you wish. As long as you have access to a smartphone, tablet or computer you can get involved to ensure No Life is Half Lived.\n\n## Experience required\n\nFor this fully flexible, home-based volunteering opportunity you must have access to a computer, tablet, or smartphone, and have some experience using social media. \r\n\r\nYou will be liking and sharing posts on social media to help us spread our word, completing on-line surveys, signing campaigns or petitions, and more. As little as 5 minutes of your time per week could help us ensure no life is half lived in Scotland!\n\n## Training details\n\nA comprehensive welcome pack will be provided.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Ffd93b58c-436c-44d4-8606-047f563df53f%2F7cZDzeFFyHXyEiHwbCWA8ee9N2n1%2Flisting.jpg?alt=media&token=58004a81-26c3-439f-b684-1356290b876a",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000000FdDxYAK#role",
                        "type": "Role",
                        "title": "CHSS Community Connector",
                        "description": "For this fully flexible, home-based volunteering opportunity you must have access to a computer, tablet, or smartphone, and have some experience using social media. \r\n\r\nYou will be liking and sharing posts on social media to help us spread our word, completing on-line surveys, signing campaigns or petitions, and more. As little as 5 minutes of your time per week could help us ensure no life is half lived in Scotland!",
