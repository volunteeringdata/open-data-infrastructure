        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000SMK00YAH",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000SMK00YAH/rnid-royal-national-institute-for-deaf-people-midlothian",
            "name": "RNID (Royal National Institute for Deaf People) Midlothian",
            "description": "We’re here for the 18 million people in the UK who are deaf, have hearing loss or tinnitus.\r\nWith our communities, we’ll change society to make it more inclusive for everyone, help people hear better now and fund world-class research.\r\nOur communities are huge: 1 in 3 adults in the UK are deaf, have hearing loss or tinnitus.\r\nIf our work doesn’t directly impact you, it will almost certainly be making a difference for someone you know and love.\r\nWe work with our communities and partners across health, employment, research, government and more to change life for the better",
            "website": "https://rnid.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038926"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2Fd75cf79a-a379-4a7a-bbfb-551ef9e44110%2FWkLzgT1VE9cAHEWcVMpdVMd5bL63%2Fuser-upload.jpg?alt=media&token=b0112ccf-4fb5-49ce-a0c9-2569b788eada",
            "cause": [
