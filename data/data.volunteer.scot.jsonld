        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nav7AAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nav7AAA/action-for-children-western-isles",
            "name": "Action for Children (Western Isles)",
            "description": "Action for Children is a national children’s charity which has been present in the Outer Hebrides for 14 years. We have 2 bases in Stornoway; one for community outreach and the children’s residential unit. We run 5 services 2 disability, 1 Children and Family Support, 1 Throughcare and Aftercare and the residential unit. We aim to provide needs led service for each child or young person referred to our services and aim to work in partnership with other organisations.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038092"
