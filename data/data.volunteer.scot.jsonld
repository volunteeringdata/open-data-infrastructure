            "dc:source": "https://volunteer.scot/organisations/00124000008nbUfAAI/edinburgh-peace-and-justice-resource-centre",
            "name": "Edinburgh Peace and Justice Resource Centre",
            "description": "The Centre is a networking hub who promote issues around  peace, justice and the environment, working with many different groups in Edinburgh, Scotland, and throughout the world. This is reflected in our monthly newsletter and diary of events, which includes events organised by PJRC to educate, stimulate discussion, and raise awareness.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC026864"
                }
            ],
            "cause": [
