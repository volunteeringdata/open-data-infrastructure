        {
            "id": "https://data.volunteer.scot/Organisation/0012400001KTDGAAA5",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400001KTDGAAA5/british-heart-foundation-clydebank-furniture-electrical",
            "name": "British Heart Foundation-Clydebank Furniture & Electrical",
            "description": "Our mission is to win the fight against cardiovascular disease and our vision is a world in which people do not die prematurely or suffer from cardiovascular disease.",
            "website": "https://www.bhf.org.uk/about-us/find-bhf-near-you/clydebank-furniture-electrical-store",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039426"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g2400000ApQjDAAV",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g2400000ApQjDAAV/volunteer-recruiter",
                    "publishStart": "2024-05-10",
                    "publishEnd": "2027-05-03",
                    "title": "Volunteer Recruiter",
                    "description": "## Summary\n\nWhether you’re great with people, an admin expert, a DIY enthusiast or a whiz with electricals, there's a role for you at one of our Furniture & Electrical stores.\n\n## Description\n\nTime to meet and greet your local community. Become an important member of the British Heart Foundation team and help to support not only your local store but BHF research into heart and circulatory disease. We need volunteers who are chatty, friendly and willing to follow our volunteering guidelines to help us recruit more like minded people. \r\n\r\nGet involved with your community, face to face and web based, placing adverts online and making contacts within the local colleges and job centers. Join your local team and help to introduce people to the wonderful world of volunteering and our lifesaving research into heart disease.\n\n## Experience required\n\nNo Experience Necessary as training will be given\n\n## Travel details\n\nBased in the Clydebank Furniture and Electrical Store in Clydebank Shopping Centre",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g2400000ApQjDAAV#role",
                        "type": "Role",
                        "title": "Volunteer Recruiter",
                        "description": "No Experience Necessary as training will be given",
                        "applyLink": "https://volunteer.scot/search/a0g2400000ApQjDAAV/volunteer-recruiter?#modal_register_a0g2400000ApQjDAAV",
                        "allowsRemoteParticipation": false,
