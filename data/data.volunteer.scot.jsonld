        {
            "id": "https://data.volunteer.scot/Organisation/0012400000ZlomhAAB",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000ZlomhAAB/kingswells-community-centre",
            "name": "Kingswells Community Centre",
            "description": "Kingswells Community Centre lies in the heart of the village and is the heart of the community. \r\n\r\nThe Centre boasts a large sports hall, a coffee shop and 2 meeting rooms which provide a very busy schedule for all age groups. As well as activities we aim to provide a wide scope of services for the community which includes a library, free school uniform, a warm space, baby weighing facilities and free sanitary products.\r\n\r\nWe also engage with the community to put on large scale events for the whole family, our annual Christmas party tickets for 220 people sell out in a day and we have organised and run 2 highly successful gala days.",
            "website": "https://www.kccwp.co.uk/",
            "cause": [
