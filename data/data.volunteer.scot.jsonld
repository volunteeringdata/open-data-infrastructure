            "dc:source": "https://volunteer.scot/organisations/00124000008nXf5AAE/shelter-community-shop-george-street",
            "name": "Shelter - Community Shop, George Street",
            "description": "Shelter Scotland helps over half a million people a year struggling with bad housing or homelessness – and we campaign to prevent it in the first place.\r\n\r\nWe’re here so no-one has to fight bad housing or homelessness on their own.",
            "website": "http://scotland.shelter.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC002327"
                }
            ],
