        {
            "id": "https://data.volunteer.scot/Organisation/001QD000015l1dJYAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000015l1dJYAQ/autistic-girls-network",
            "name": "Autistic Girls Network",
            "description": "AGN has been a registered charity since November 2021, although we have been supporting autistic individuals as an organisation since 2017. We take pride in being autistic and neurodivergent-led, aiming to co-produce all our services with our community.\r\n\r\nOur Vision: We empower, support and provide community for autistic women, girls and their families, advocating for the change necessary to build in a world in which they can flourish on their own terms.\r\n\r\nOur Mission: To support autistic women, girls and their families by providing education, resources and community, helping them develop a positive sense of self.",
            "website": "https://autisticgirlsnetwork.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC054837"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
                    "skos:prefLabel": "Befriending / Mentoring"
                },
                {
