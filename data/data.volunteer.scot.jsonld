            "dc:source": "https://volunteer.scot/organisations/001QD00000KeEFJYA3/beauty-banks",
            "name": "Beauty Banks",
            "description": "Beauty Banks is a charity focused on supporting adults, children and babies living in hygiene poverty in the UK. We supply brand new essential toiletries to charities and other organisations around the country, including food banks, homeless shelters, family support centres, women's refuges, mental health trusts, care leavers' support centres and schools.",
            "website": "https://www.beautybanks.org.uk/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EnvironmentRecycling",
