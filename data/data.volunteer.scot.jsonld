        {
            "id": "https://data.volunteer.scot/Organisation/00124000008ncc1AAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ncc1AAA/sunny-garden-bilingual-russian-english-playgroup",
            "name": "Sunny Garden: Bilingual (Russian-English) Playgroup",
            "description": "Sunny Garden: Bilingual (Russian-English) Playgroup provide a safe, caring bilingual environment which will promote a child’s health, individuality and dignity, and an opportunity for fun, learning through play, socialising with adults and children from a wide range of cultures free from any discrimination.\n\nWe aim to provide and support knowledge and education that encourages children’s physical, social, emotional, intellectual and creative development through a wide range of activities suitable for their age range.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
                    "skos:prefLabel": "Arts and Culture"
