        {
            "id": "https://data.volunteer.scot/Organisation/0012400000yLgVyAAK",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000yLgVyAAK/royal-air-forces-association-aberdeen",
            "name": "Royal Air Forces Association (Aberdeen)",
            "description": "The RAF Association is a member-led, welfare charity that exists to ensure that all members of the RAF community are supported, when they require it.",
            "website": "https://www.rafa.org.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Counselling",
