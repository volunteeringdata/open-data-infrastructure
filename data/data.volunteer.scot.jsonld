                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000AmTefYAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000AmTefYAF/sales-assistant",
                    "publishStart": "2025-07-07",
                    "publishEnd": "2027-01-01",
                    "title": "Sales Assistant",
                    "description": "## Description\n\nWe're looking for friendly and enthusiastic individuals to volunteer as Sales Assistants at the Bike Hub.  You’ll often be the first point of contact, offering a warm welcome and help with sales enquiries.  If a customer’s question is mechanical related, liaising with our team of skilled Bike Hub Mechanics will ensure they get the support they need.\r\n\r\nA knowledge of cycling would be an advantage but not essential as training will be provided.  A positive attitude, good communication skills and a willingness to learn are essential.\r\n\r\nResponsibilities include:\r\n\r\n* Greeting and assisting customers in a friendly manner\r\n* Handling cash and card transactions accurately\r\n* Setting up and packing down the Bike Hub before and after each shift (typically 6 hours if this is suitable)\r\n* Sharing information about our work as a charity and the services the Bike Hub offer\r\n* Maintaining high standards of customer service\r\n* Upholding health and safety practices and keeping the Bike Hub clean and tidy\r\n* Occasionally supporting off-site events, such as Dr Bike sessions in the community\r\n\r\nIf you're interested in joining us, we’d love to hear from you!\r\n\r\nPVG membership required.\n\n## Travel details\n\nThe Bike Hub, Cowan Park, Barrhead, G78 1SS",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F680d7f16-882b-46f6-8b8b-6bcc2651478b%2FyKvNsCtq9ZNPsjkwuXTxwxTv3Tx2%2Flisting.jpg?alt=media&token=a760f49b-9107-4cc4-b185-7093f8b7713e",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000AmTefYAF#role",
                        "type": "Role",
                        "title": "Sales Assistant",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000AmTefYAF/sales-assistant?#modal_register_a0gQD00000AmTefYAF",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "service": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/NamedContactForVolunteer",
                                "skos:prefLabel": "Named Contact For Volunteer"
                            },
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/WheelchairAccessDisabledAccessToilet",
                                "skos:prefLabel": "Wheelchair Access/Disabled Access Toilet"
                            }
                        ]
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
                                "type": "Location",
                                "name": "G76 7AT",
                                "address": "G76 7AT",
