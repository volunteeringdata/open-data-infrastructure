        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZ7eAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZ7eAAE/sight-support-social-hub",
            "name": "Sight Support & Social Hub",
            "description": "Dundee Blind and Partially Sighted Society is working towards a world where all people who are visually impaired, enjoy the same rights, opportunities and responsibilities as everyone else. DBPSS aims to contribute to this vision by providing a range of statutory and non-statutory services, to visually impaired children, adults and their carers, who reside within the City of Dundee.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC016947"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SensoryImpairment",
                    "skos:prefLabel": "Sensory Impairment"
                },
                {
