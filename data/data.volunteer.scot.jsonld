        {
            "id": "https://data.volunteer.scot/Organisation/001QD00001A7nc9YAB",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00001A7nc9YAB/dart",
            "name": "DART",
            "description": "DART - Being a DART volunteer is about helping make Darvel a better, brighter and more connected place to live.  Volunteers support community events, activities and projects, share ideas and help identify new opportunities that benefit local people.  DART welcomes everyone, regardless of age, experience or specific skills- sometimes the most valuable contribution is simply an idea, enthusiasm, a helping hand of willingness to get involved.  By working together, sharing skills and encouraging participation, DART helps create opportunities for everyone in our community to connect, contribute and make a difference.",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JrSCzYAN",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JrSCzYAN/manager-volunteer-part-time",
                    "publishStart": "2026-11-12",
                    "publishEnd": "2027-05-13",
                    "title": "Manager volunteer (Part-time)",
                    "description": "## Description\n\nYou will be required to oversee our events such as Darvelo Cycling Festival which is held annually in May and other events such as our Market days and Music evenings. You will oversee and co-ordinate stallholders, and ensure that events run safely and profitably for the local community. You will ensure that tables, gazebos and signage are set up neatly and safely.  You will act as the main point of contact for visitors and monitor crowd movement to prevent bottlenecks around popular stalls. You will schedule and brief event volunteers who help with car parking, litter picking and greeting guests. You will capture photos and updates for the market's social media channels during the event.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000JrSCzYAN#role",
                        "type": "Role",
                        "title": "Manager volunteer (Part-time)",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000JrSCzYAN/manager-volunteer-part-time?#modal_register_a0gQD00000JrSCzYAN",
                        "allowsRemoteParticipation": false
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
                                "@id": "https://data.volunteer.scot/Geography/LocalAuthority/EastAyrshire",
                                "type": "Location",
                                "name": "East Ayrshire"
                            }
                        ]
                    }
                },
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000I37sDYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000I37sDYAR/volunteer",
                    "publishStart": "2026-09-21",
                    "publishEnd": "2027-03-22",
                    "title": "Volunteer",
                    "description": "## Description\n\nBeing a DART volunteer is about helping make Darvel a better, brighter and more connected place to live.  Volunteers support community events , activities and projects, share ideas and help identify new opportunities that benefit local people.  DART welcomes everyone, regardless of age, experience or specific skills- sometimes the most valuable contribution is simply an idea, enthusiasm, a helping hand or willingness to get involved.  By working together, sharing skills and encouraging participation, DART helps create opportunities for everyone in our community to connect, contribute and make a difference. You will help with setting up gazebos, staging and sound systems at our market days and music evenings.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000I37sDYAR#role",
