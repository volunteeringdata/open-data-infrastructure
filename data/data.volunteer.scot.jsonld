                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000DWt6kYAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000DWt6kYAD/community-support-walk-leader-ayrshire",
                    "publishStart": "2026-06-17",
                    "publishEnd": "2026-12-07",
                    "title": "Community Support Walk Leader (Ayrshire)",
                    "description": "## Description\n\nJoin our amazing team, who support people who have had one or more of our conditions, enabling them to fully engage with their community through supporting them with a range of physical activities to develop their confidence.\r\nYou’ll provide in person support to people living with our conditions in the community, at home or in a hospital setting, empowering and enabling them to engage fully with walking activities and gentle exercise where appropriate\r\nEmbrace a non-judgement, supportive approach to enable service users to achieve their goal(s)\r\nUndertake walk leader & first aid training if appropriate\r\nComplete a record of activity and progress\r\nUpdate Co-ordinator with any concerns or identified areas where additional support may be required",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000DWt6kYAD#role",
