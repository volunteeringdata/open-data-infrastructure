            "dc:source": "https://volunteer.scot/organisations/001QD00000Wy2RJYAZ/re-engage-south-ayrshire",
            "name": "Re-Engage (South Ayrshire)",
            "description": "Re-Engage provides vital, life-enhancing social connections for older people at a time in their lives when their social circles are diminishing. All of our services are volunteer led and through connecting people, we connect community.",
            "website": "https://www.reeengage.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
