        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZVhAAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZVhAAM/royal-voluntary-service-scottish-borders-hub",
            "name": "Royal Voluntary Service (Scottish Borders Hub)",
            "description": "Every day Royal Voluntary Service helps thousands of older people to live the life they want. We provide practical services in homes, in hospitals and in communities all across England, Scotland and Wales so people can be independent and active. Royal Voluntary Service is one of the largest voluntary organisations and much of our work is supporting older people. We provide practical solutions to the everyday problems of loneliness and isolation. Volunteers are vital to the work of Royal Voluntary Service. Without them Royal Voluntary Service simply wouldn't exist. Our volunteers come from all walks of life, men or women, young or older and we've got something for everyone, including specialist roles such as this. Anyone who volunteers for Royal Voluntary Service knows that they are joining a charity which people trust - our style is practical, positive, personal and professional. Royal Voluntary Service is committed to being an Investing in Volunteers organisation.",
            "website": "https://www.royalvoluntaryservice.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038924"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CreditUnionsCommunityBanking",
                    "skos:prefLabel": "Credit Unions / Community Banking"
                },
