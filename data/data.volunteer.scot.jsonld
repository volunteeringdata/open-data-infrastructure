                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000AxYHeYAN",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000AxYHeYAN/volunteer-befriender",
                    "publishStart": "2026-08-20",
                    "publishEnd": "2027-01-01",
                    "title": "Volunteer Befriender",
                    "description": "## Description\n\nProviding friendly, one-to-one support to older adults who are experiencing loneliness or isolation. Support may include home visits, telephone calls, accompanying individuals to local groups or community activities. The role helps build confidence, reduce social isolation, and support people to reconnect with their communities. Volunteers are expected to be reliable, empathetic, and good communicators. Full training and support is provided.\n\n## Experience required\n\n• Good listening and communication skills\r\n• Friendly personality \r\n• Reliable with good time keeping\r\n• Patience and empathy\r\n• Respectful of confidentiality\r\n• Able to work within set boundaries\r\n• Good organisation skills",
                    "requiresEmergencyParticipation": false,
