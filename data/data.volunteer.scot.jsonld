            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002zs2tXAAQ/irvine-and-troon-cancer-care",
            "name": "Irvine and Troon Cancer Care",
            "description": "The aims are to support cancer patients with free transport to hospitals in Ayrshire, Glasgow and Edinburgh.",
            "website": "https://www.irvineandtrooncancercare.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC014645"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F27acf72f-a542-98f3-9ea6-c224f73c68a1%2FXiQTI9rs8XhdfYu2EPhcBTs4his2%2Fuser-upload.jpg?alt=media&token=bf105969-59d5-4ee8-b6d0-bfcc784ead3d",
