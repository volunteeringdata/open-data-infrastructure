        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZoBAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZoBAAU/thornton-rose-riding-for-the-disabled",
            "name": "Thornton Rose Riding for the Disabled",
            "description": "Thornton Rose provides riding opportunities for people of all ages and disabilities to enjoy a safe, stimulating, therapeutic and recreational sport. The group was established as Thornton Rose in 2004 when we relocated to Thornton Farm, Rosewell.\r\n\r\nOur Team of volunteers works hard towards a common goal:\r\n\r\nTo provide disabled people with the means to ride and work around horses that provide them with the most benefit. Whether that is regional dressage competitions or spending quality time in our barn with their favourite pony.\r\n\r\nOur volunteers assist in the smooth and safe running of an RDA session by helping with pony care duties, leading or side-walking one of our ponies with a rider or assisting the coach during a session. There are also opportunities to help with fundraising, administration and general maintenance. Experience with horses is great but not essential, there is always the opportunity to learn.",
            "website": "https://www.thornton-rose-rda.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC028617"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
