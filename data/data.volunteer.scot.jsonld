        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000guLrKYAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000guLrKYAU/give-a-dog-a-bone-dunfermline",
            "name": "Give a Dog a Bone Dunfermline",
            "description": "Give a Dog a Bone tackle loneliness and isolation in older adults through animal companionship. In Dunfermline, they have several services/activities:\r\n\r\n- community space - lovely cafe environment that anyone can use to have a free tea/coffee, chat, and pet dogs\r\n- activities for older adults - amazing variety of free programmes, for older adults in the community, including such things as art for wellbeing, reiki, and more.\r\n- animal companionship - removal of financial barriers for an older person to get a dog. This could be the initial adoption fee, or include a more long-term assistance package, such as monthly payments toward dog food/insurance.",
            "website": "https://www.giveadogabone.net/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC044440"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
