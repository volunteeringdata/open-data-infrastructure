            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000002QBJYA2",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000002QBJYA2/walk-leader-volunteers",
                    "publishStart": "2023-09-21",
                    "publishEnd": "2027-03-20",
                    "title": "Walk Leader Volunteers",
                    "description": "## Description\n\nSouth Ayrshire Walking Development - Walking Scotland want everyone to have the opportunity to walk everyday creating a happier, healthier and greener Scotland. There are currently 15 active health walks across South Ayrshire and we are looking for walk leader volunteers to support one of the existing health walks or perhaps start up a new group. If you like to walk and have a blether this could be the ideal opportunity for you.\n\n## Experience required\n\nExperience required\r\nThere are no specific skills or experience required but walk leader should like being outdoors and enjoy working with people. You must take part in two existing health walks before starting training and then complete a 3-4 hour  walk leader training course.\r\nIf you would like more information please contact lindsay.johnson@south-ayrshire.gov.uk",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Faebf7378-167e-45a5-a424-276138e3e719%2FcJdW0lmlOSSkht3fHIw2RKaUhVU2%2Flisting.jpg?alt=media&token=78932ef7-9790-497b-a57a-6b5bccba2e60",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD0000002QBJYA2#role",
