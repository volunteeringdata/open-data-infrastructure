                            "https://ns.volunteeringdata.io/TrainingProvided"
                        ]
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
                                "@id": "https://data.volunteer.scot/Geography/LocalAuthority/EastAyrshire",
                                "type": "Location",
                                "name": "East Ayrshire"
                            },
                            {
                                "@id": "https://data.volunteer.scot/Geography/LocalAuthority/NorthAyrshire",
