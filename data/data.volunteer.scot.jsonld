            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HyF41YAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HyF41YAF/volunteer-christmas-elves-for-santas-grotto",
                    "publishStart": "2026-09-28",
                    "publishEnd": "2026-12-17",
                    "title": "Volunteer Christmas Elves for Santa's Grotto",
                    "description": "## Summary\n\nSanta and the All Life Chances charity is looking for enthusiastic, fun-loving volunteer Elves to help in Santas Grotto in the Bon Accord Centre Aberdeen this Christmas.\r\nPlease get in touch if you are a fun, energetic person who loves Christmas and committed to bring smiles to all the children's faces in Santa's Grotto. We are looking for a number of elves to help Santa bring the magic of Christmas to the Bon- Accord Centre in Aberdeen.\r\nWe are looking for anybody who can commit to at least 3 shifts in the period that the Grotto is open.\r\nWe will provide induction and organise Elf School for all volunteers where we will go through all the necessary training, provide elf costumes and walk through all the Elf roles. You will be introduced to other elves during the training period. During the event there will be a Chief Elf on hand to keep naughty elves in check and keep everyone right. We can pay expenses for local transport and these will be reimbursed at the end of the event.\r\nThis is a busy and fun role where you will be helping to make special Christmas memories.  \r\nA fantastic opportunity to help. All help (and Elves) make a real difference and are greatly appreciated.\r\nFor more details please contact Dolina at email: dolina@alllifechances.org or telephone: 07752632944\n\n## Description\n\nSanta and the All Life Chances charity is looking for enthusiastic, fun-loving volunteer Elves to help in Santas Grotto in the Bon Accord Centre Aberdeen this Christmas.\r\n\r\nPlease get in touch if you are a fun, energetic person who loves Christmas and committed to bring smiles to all the children's faces in Santa's Grotto. We are looking for a number of elves to help Santa bring the magic of Christmas to the Bon- Accord Centre in Aberdeen. We are looking for anybody who can commit to at least 3 shifts in the period that the Grotto is open.\r\n\r\nWe will provide induction and organise Elf School for all volunteers where we will go through all the necessary training, provide elf costumes and walk through all the Elf roles. You will be introduced to other elves during the training period. During the event there will be a Chief Elf on hand to keep naughty elves in check and keep everyone right. We can pay expenses for local transport and these will be reimbursed at the end of the event.\r\n\r\nThis is a busy and fun role where you will be helping to make special Christmas memories.  \r\n\r\nA fantastic opportunity to help. All help (and Elves) make a real difference and are greatly appreciated.\r\n\r\nFor more details please contact Dolina at email: dolina@alllifechances.org or telephone: 07752632944\n\n## Training details\n\nExcellent support and relevant training is provided to all volunteers. \r\n\r\nWe will provide induction and organise Elf School for all volunteers where we will go through all the necessary training, provide elf costumes and walk through all the Elf roles. You will be introduced to other elves during the training period. During the event there will be a Chief Elf on hand to keep naughty elves in check and keep everyone right. We can pay expenses for local transport and these will be reimbursed at the end of the event.\n\n## Frequency commitment details\n\nFlexible times available to help. We are looking for anybody who can commit to at least 3 shifts in the period that the Grotto is open.  All help is greatly appreciated.\n\n## Travel details\n\nSanta’s Grotto, Bon Accord Centre Aberdeen, Aberdeen City Centre. Close to bus and train station.\n\n## Travel expenses\n\nWe can pay expenses for local transport and these will be reimbursed at the end of the event.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F228abd1e-d8ee-49f9-b777-bbe9b7deba8c%2FwCNKx5Vdb8U64DS0kBUuytt0Bkt2%2Flisting.jpg?alt=media&token=dae52272-9c84-4177-9194-93856bfe69b6",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HyF41YAF#role",
                        "type": "Role",
                        "title": "Volunteer Christmas Elves for Santa's Grotto",
                        "commitment": "Flexible times available to help. We are looking for anybody who can commit to at least 3 shifts in the period that the Grotto is open.  All help is greatly appreciated.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000HyF41YAF/volunteer-christmas-elves-for-santas-grotto?#modal_register_a0gQD00000HyF41YAF",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
