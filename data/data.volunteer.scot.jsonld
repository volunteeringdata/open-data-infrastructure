        {
            "id": "https://data.volunteer.scot/Organisation/0012400001Ct466AAB",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400001Ct466AAB/marys-meals",
            "name": "Mary’s Meals",
            "description": "Mary’s Meals is an international charity that provides a daily nutritious meal in school to more than 1.2million hungry and impoverished children in 14 countries.  \r\nOur vision is that every child receives one daily meal in their place of education and that all those who have more than they need, share with those who lack even the most basic things.\r\nWorking together with those who share our vision, we believe there is no good reason why this cannot be realised.",
            "website": "https://www.marysmeals.org.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Poverty",
                    "skos:prefLabel": "Poverty"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000QNs6vAAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000QNs6vAAD/community-volunteer",
                    "publishStart": "2021-05-10",
                    "publishEnd": "2027-03-31",
                    "title": "Community Volunteer",
                    "description": "## Summary\n\nWould you like the opportunity to support Mary’s Meals’ work to feed hungry children in some of the world’s poorest countries and help give them a brighter future?\nWe’re looking for volunteers to join our global movement, to help raise awareness about Mary’s Meals and fundraise for our work.\n\n## Description\n\nWe are looking for people who are passionate about ending child hunger and ensuring that every child receives a daily meal in a place of education.\nWe have a range of activities that can be done from the comfort of your home. They include: hosting virtual talks, spreading the word about our work on social media or holding screenings of our inspiring videos with family and friends.\n\n## Experience required\n\nFriendly and diplomatic to everyone you meet. \nExcellent communication skills with the ability to liaise with people at all levels.\nShare our vision, mission and values. \nEnjoy meeting new people and interacting with others.\nHonest and trustworthy.\n\n## Training details\n\nInduction is an hour and a half with the volunteer manager.\nSpeaker training is with volunteer manager but professional courses are offered periodically.\nZoom training if needed.\nOther health and wellbeing sessions and training offered as requested and when available.\n\n## Travel details\n\nInitially volunteering will take place from home but as speaker engagements arise or fundraising opportunities present themselves, we would hope that the volunteer is able to travel within the Edinburgh area either by private car or public transport.\n\n## Travel expenses\n\nExpense form to be completed with receipts when necessary.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000QNs6vAAD#role",
                        "type": "Role",
                        "title": "Community Volunteer",
                        "description": "Friendly and diplomatic to everyone you meet. \nExcellent communication skills with the ability to liaise with people at all levels.\nShare our vision, mission and values. \nEnjoy meeting new people and interacting with others.\nHonest and trustworthy.",
                        "applyLink": "https://volunteer.scot/search/a0g0800000QNs6vAAD/community-volunteer?#modal_register_a0g0800000QNs6vAAD",
                        "allowsRemoteParticipation": false,
