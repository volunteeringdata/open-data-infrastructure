                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000Pc734AAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000Pc734AAB/group-worker",
                    "publishStart": "2026-09-07",
                    "publishEnd": "2027-03-01",
                    "title": "Group Worker",
                    "description": "## Description\n\nNorth Ayrshire Council’s Community Learning & Development team operate a range of social and learning opportunities and groups for New Scots in the area (mainly Syrian and Afghan refugees). The Group Worker/Assistant role will support the Locality Link Workers or tutors in the running of regular group activities for New Scots. These will include general social groups for Men, Women, Young Women and Young Men, along with specific interest groups which include gardening/vegetable growing, creative projects, Duke of Edinburgh etc. Group Workers/Assistants will assist the group leaders to ensure all members receive support and are enabled to take part fully. They can also contribute ideas and group sessions as agreed if they wish.\n\n## Experience required\n\nE = Essential D = Desirable\r\nExcellent people and communication skills (E) \r\nAble to build relationships with sensitivity to individual and cultural differences (E) \r\nWilling to support group activity plans as instructed by group leaders, but also to contribute ideas and energy (E) \r\nExperience of working with groups/vulnerable people (D)",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000Pc734AAB#role",
                        "type": "Role",
                        "title": "Group Worker",
                        "description": "E = Essential D = Desirable\r\nExcellent people and communication skills (E) \r\nAble to build relationships with sensitivity to individual and cultural differences (E) \r\nWilling to support group activity plans as instructed by group leaders, but also to contribute ideas and energy (E) \r\nExperience of working with groups/vulnerable people (D)",
                        "applyLink": "https://volunteer.scot/search/a0g0800000Pc734AAB/group-worker?#modal_register_a0g0800000Pc734AAB",
                        "allowsRemoteParticipation": false
                    },
