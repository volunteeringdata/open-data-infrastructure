            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000QhjWQAAZ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000QhjWQAAZ/committee-members",
                    "publishStart": "2023-08-30",
                    "publishEnd": "2027-02-16",
                    "title": "Committee Members",
                    "description": "## Description\n\nRelationships Scotland are Scotland's largest provider of relationship counselling, family mediation and child contact centres. Relationships Scotland - Couple Counselling Ayrshire are currently looking for committee members. We are ideally looking for individuals with a background in finance or law but would be open to other skills. \r\nOur meetings are currently held every 2nd month on a Friday afternoon. Volunteers will provide support and advice on our goals and activities and ensure the effective and efficient administration of the organisation. Committee members also ensure that the charity operates within its charitable purpose and complies with the requirements of OSCR. Our committee members are an essential and valued part of the team.\n\n## Experience required\n\nIdeally we are looking for someone from a legal or financial background but other skills will be considered. If you have any queries please email info.rsccayrshire@gmail.com",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F00ba6420-e9d9-4d8d-bf3f-0ff3fa039531%2F0nFCUqNjeiXPIFO483j0BVWArU43%2Flisting.jpg?alt=media&token=1a5a7d9b-08f3-4ce6-a3f8-1acc30c913b4",
