            "dc:source": "https://volunteer.scot/organisations/00124000008ngSiAAI/the-david-livingstone-trust",
            "name": "The David Livingstone Trust",
            "description": "David Livingstone Centre is set along the banks of the River Clyde and surrounded by stunning parkland, the Birthplace Museum invites you to follow Livingstone’s journey from Blantyre to Africa through their new interactive exhibition.\nThe centre provides activities and events for families and local community members. Many of their classes and events are free of charge to support their community. DLT have over 50 volunteers who give of their time in the grounds, the museum and the gift shop.",
            "website": "https://www.david-livingstone-trust.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC015490"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
