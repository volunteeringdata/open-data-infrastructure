        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nfAFAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nfAFAAY/womens-aid-orkney",
            "name": "Women's Aid Orkney",
            "description": "We offer trauma informed support for women and children who have/are experiencing domestic abuse. We have a:\r\n\r\n- Women's Service\r\n- Children & Young People's (CYP) Service\r\n- Young Women, Family Support practitioners\r\n- Own My Life facilitators\r\n\r\nWe undertake risk assessments, safety planning and advocacy alongside offering a range of practical support and emotional care. \r\n\r\nWe aim to offer support to keep women and their families safer whilst enabling healing and recovery from the short, medium and long term effects of a perpetrators abuse.",
            "website": "https://womensaidorkney.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC005241"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2Fcfc422f9-a717-23b6-73d5-100d8a3c99b3%2FOIUJpTJYlES85DiBarGLlF56TE12%2Fuser-upload.jpg?alt=media&token=699f8dfd-6f5f-4829-8922-0168d82944bc",
