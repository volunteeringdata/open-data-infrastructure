        {
            "id": "https://data.volunteer.scot/Organisation/00124000008niLNAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008niLNAAY/scottish-maritime-museum",
            "name": "Scottish Maritime Museum",
            "description": "Situated on Irvine's Harbourside, you will find exhibitions and ship models as well as Scotland's 'Cathedral of Engineering', the Linthouse Engine Shop, built in 1872. Inside you can explore much of the Museum's collection including shipbuilding machinery and machine tools, small boats, canoes, lifeboats, and much more. A visit also includes a tour to the shipyard workers' tenement flat, restored to its pre-1920s appearance and you can board the MV kyles the oldest floating clydebuilt vessel in the world.",
            "website": "https://www.scottishmaritimemuseum.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC036337"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
                    "skos:prefLabel": "Arts and Culture"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000QhjSTAAZ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000QhjSTAAZ/visitor-service-volunteer",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Visitor Service Volunteer",
                    "description": "## Description\n\nhis exciting opportunity is perfect for anyone that would like to improve their public speaking and knowledge of history as we look for Visitor Services volunteers. The activities you can expect to be involved in include –\r\n⚓️Guiding tours to our working triple expansion steam engine and 1920’s shipyard workers tenement flat in Irvine or the iconic Denny Ship Model Experiment Tank in Dumbarton.\r\n⚓️Explaining some of the exhibitions around the museum buildings to our visitors.\r\n⚓️Helping out in our program of annual events that include Pirate Days, Halloween and much more!",
                    "requiresEmergencyParticipation": false,
                    "role": {
