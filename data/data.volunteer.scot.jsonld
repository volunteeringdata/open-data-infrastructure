        {
            "id": "https://data.volunteer.scot/Organisation/0010800002utCKUAA2",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002utCKUAA2/narture-cic",
            "name": "Narture CIC",
            "description": "Narture CIC is an artist collective baking real bread and food/drinks from scratch to earn the dough to fund arts projects. We aim to use creativity to reanimate the historic quarter of Ayr, driven by experiential retail and cultural tourism. Our core objective is to provide community benefits by developing income sources, primarily through food and drinks and socially engaged arts. Being a community interest company, we value volunteering for the people contributing back to their communities but also through the people who would like to develop their own skills.",
            "website": "https://www.narture.co.uk/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
                    "skos:prefLabel": "Arts and Culture"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FundraisingFunding",
                    "skos:prefLabel": "Fundraising / Funding"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000067mnYAA",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000067mnYAA/bakery-assistant",
                    "publishStart": "2023-10-10",
                    "publishEnd": "2027-03-04",
                    "title": "Bakery Assistant",
                    "description": "## Description\n\nNarture CIC is looking for Bakery Assistants for their Sourdough Bakery in Ayr. If you are interested in gaining customer service skills and learning about baking this could be the ideal opportunity for you. Share your baking skills and contribute to our acclaimed sourdough bakery.\r\n\r\nTasks will include:\r\n•\tAssisting bakery team with, weighing, mixing and shaping doughs\r\n\r\nIf you feel the call to contribute your talents to our journey, reach out! Whether you're skilled and ready to share or eager to learn and develop skills for future paid work, Narture welcomes your enthusiasm\n\n## Experience required\n\nIf you have previous customer service skills that would be helpful but no experience is required.\n\n## Frequency commitment details\n\nAnytime\n\n## Travel details\n\nCentral  Ayr -  close to public transport\n\n## Travel expenses\n\nTravel expenses will be paid.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F89d6acdb-9dc2-4fef-9212-cb5d2eb42f75%2F0nFCUqNjeiXPIFO483j0BVWArU43%2Flisting.jpg?alt=media&token=d846f020-0171-448c-89e7-af3d7405a200",
