            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g2400000ApfCHAAZ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g2400000ApfCHAAZ/donation-centre-logistics-assistant",
                    "publishStart": "2017-09-22",
                    "publishEnd": "2027-03-31",
                    "title": "Donation Centre Logistics Assistant",
                    "description": "## Summary\n\nWe are looking for someone to volunteer alongside our driver in deliveries and collection of furniture.\n\n## Description\n\nThe Salvation Army is opening a brand new Donation Centre which we hope will become a re-use hub for the local area and beyond.  Reducing how much we all send to landfill is so very important and we will offer people a convenient hub to donate items that still have re-use potential.  Part of our work will be to offer to collect donations of furniture from people’s houses and deliver some sold items.  We are looking for a volunteer to assist in this work.\n\n## Experience required\n\nThis role would suit an outgoing and friendly individual who is physically fit and able to fulfil the lifting required in the role.  No formal qualifications are required for the role, and all training will be offered in house.\n\n## Training details\n\nAll training and induction is conducted in house. Training is not currently certified\n\n## Travel details\n\nSalvation Army Donation Centre, 40 Piershill Place, Edinburgh, EH8 7EH.\n\n## Travel expenses\n\nTravel expenses paid.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g2400000ApfCHAAZ#role",
                        "type": "Role",
                        "title": "Donation Centre Logistics Assistant",
                        "description": "This role would suit an outgoing and friendly individual who is physically fit and able to fulfil the lifting required in the role.  No formal qualifications are required for the role, and all training will be offered in house.",
