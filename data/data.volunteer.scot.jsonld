        {
            "id": "https://data.volunteer.scot/Organisation/0010800003Br7rDAAR",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003Br7rDAAR/wateraid",
            "name": "WaterAid",
            "description": "Clean water, decent toilets and good hygiene are basic human rights. They should be a normal part of daily life for everyone, everywhere – but they aren't. That's why we're here.\r\n\r\nWe're working with our partners in some of the toughest places in the world. Together, we have reached millions of people with clean water, decent toilets and good hygiene, enabling entire communities to unlock their potential, break free from poverty and change their lives for good.\r\n\r\nAnd while installing taps and toilets is essential to our work, we do so much more. We convince governments to change laws, link policy makers with people on the ground, pool knowledge and resources and rally support from people and organisations around the world, making lasting change happen on a massive scale.",
            "website": "https://www.wateraid.org/uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039479"
                }
            ],
