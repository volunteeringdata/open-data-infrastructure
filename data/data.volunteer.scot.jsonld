                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000002fA9fAAE",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000002fA9fAAE/garden-volunteer",
                    "publishStart": "2026-10-30",
                    "publishEnd": "2026-11-29",
                    "title": "Garden Volunteer",
                    "description": "## Description\n\nDo you like to garden and build things? Would you like to learn about growing fruit and vegetables? Do you have a few hours free each week to develop The Heugh Community Growing Garden? We have been developing the old Tranent Gasworks site on The Heugh into a community growing garden and a resource for the local community. We are looking for volunteers to help with bramble clearing, tree-planting, ground digging, path works, weeding, building raised beds and helping to grow organic fruit and veg.\n\n## Experience required\n\nNo Expertise Everyone is welcome, no experience or skills needed, just a great opportunity to work, learn, help the local community and have fun too!\n\n## Training details\n\nTool safety talk and introduction to the site when you start volunteering and ongoing instruction and demonstrations of tools and activities\n\n## Frequency commitment details\n\nCommitment Flexible 4 Hours, Weekly",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g24000002fA9fAAE#role",
