        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nbZ5AAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbZ5AAI/barnardos-shop-stockbridge",
            "name": "Barnardo's Shop, Stockbridge",
            "description": "Barnardo's Scotland provides more than 122 community-based services throughout the country working with over 26,500 vulnerable children, young people and their families. Services include: leaving care services which help young people to bridge the gap between being in care and living in the adult world, family activity services which work to support families in trouble, disability services supporting children with disabilities and offering short breaks to their families. Our website provides a search for local services.",
