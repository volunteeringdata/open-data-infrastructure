        {
            "id": "https://data.volunteer.scot/Organisation/00124000008neEkAAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008neEkAAI/uppertunity",
            "name": "Uppertunity",
            "description": "We are a registered Community Interest Company (a type of non-profit social enterprise), working with individuals (16+) with learning disabilities, autism and mental health barriers. We focus on an individual’s strengths and aspirations, then work with them to realise their potential, leading to self-worth and independence. We do this through: creative workshops, group and community work, mentoring, skill development programs, meaningful volunteering roles, jobs and social events.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
