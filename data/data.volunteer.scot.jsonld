            "dc:source": "https://volunteer.scot/organisations/00124000008niPEAAY/national-autistic-society",
            "name": "National Autistic Society",
            "description": "The National Autistic Society exists to champion the rights and interests of all people with autism and to ensure that they and their families receive quality services appropriate to their needs.",
            "website": "https://www.autism.org.uk",
            "charityRegistration": [
                {
