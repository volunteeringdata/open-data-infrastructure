            "dc:source": "https://volunteer.scot/organisations/00124000008nb0IAAQ/friends-of-queen-margaret-hospital",
            "name": "Friends of Queen Margaret Hospital",
            "description": "We are a registered charity who raise funds be selling handcrafted clothes and gift items for babies, children and adults at events within the hospital and the local area of Dunfermline",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
