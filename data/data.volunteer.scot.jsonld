        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZnVAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZnVAAU/ageing-well-midlothian-council",
            "name": "Ageing Well - Midlothian Council",
            "description": "Ageing Well aims to improve and maintain the health and wellbeing of people over the age of 50 in Midlothian by organising various activities including health walks, pilates, yoga, keep fit, dance, tai chi and aquafit with the aid of volunteers who lead and encourage others to take part in these activities.",
            "website": "https://www.midlothian.gov.uk",
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F8611bed3-52a7-8662-3e2f-3c531c2b8600%2FqsIKEg0s46fnoJfCh2nxdqMBJlB3%2Fuser-upload.jpg?alt=media&token=baadf0e7-c3c5-425e-af0b-bb58b11b45b5",
