        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nb0HAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nb0HAAQ/families-first-st-andrews",
            "name": "Families First St Andrews",
            "description": "Families First is a very small independent charity working with children and their families aged 5 – 16 years who face significant challenges in life living in North East Fife. These challenges include Autistic Spectrum Disorders (ASD), various learning disabilities, social and emotional problems, mental health issues, caring responsibilities, being looked after away from their family, low self-esteem, medical problems and poverty.     Isolation can be a significant challenge to the children we work with due to their personal circumstances and rural location. By supporting these children and their families we aim to:    •\tReduce isolation  •\tDevelop self-esteem  •\tImprove social skills  •\tImprove relationships    All of the people we work with are referred to us by external statutory and voluntary agencies.  We offer 3 core services - Family Support (adults), One-to-One Befriending (children) and Children's Group Work.     Our overall objectives are to strengthen the social and emotional development of children, young people and their parents and carers; so they can become effective contributors to their communities. We do this in a number of ways, by providing opportunities for our service users to explore the challenges they face and gain new experiences in a safe environment with supportive staff and volunteers.     In addition to one-to-one support and group work activities, we provide access to events throughout the year through our Family Support Service. These events give families a chance to spend time and have fun together, thus creating lasting memories with each other.",
            "website": "https://www.familiesfirststandrews.org.uk/index.asp?mainid=17595",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC032506"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FamilySupport",
                    "skos:prefLabel": "Family Support"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
                    "skos:prefLabel": "Volunteering"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/YoungPeople",
                    "skos:prefLabel": "Young People"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
                    "skos:prefLabel": "Befriending / Mentoring"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000000eLJfAAM",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000000eLJfAAM/volunteer-driver",
                    "publishStart": "2026-07-10",
                    "publishEnd": "2027-01-08",
                    "title": "Volunteer Driver",
                    "description": "## Description\n\nFamilies First St Andrews work with children, young people and their families who are facing various challenges and adversities. Volunteer Drivers provide vital support to individuals who would struggle to access their activities and sessions without transport. Volunteer Drivers also provide additional positive interactions between a service user, their family and Families First volunteers/staff, extending these to include their journeys to and from sessions.\n\n## Experience required\n\nVolunteer Drivers are friendly, kind and prioritise safety. They should be a proficient driver and feel comfortable in this position of responsibility Volunteer Drivers are empathetic towards individuals with additional support needs and are willing to learn how to manage certain behaviours as needed.\n\n## Training details\n\nAll volunteers participate in our mandatory induction training. This includes information about being a volunteer for Families First, Child and Adult Protection, and relevant policies and procedures, such as Health and Safety. Additionally, there is specific training about driving service users and safety in this role.\r\nStaff provide support during, before and after the sessions as required, to ensure safety whilst in the community. All volunteers meet with the Volunteer Coordinator for 1:1 support and supervision meetings. Regular training opportunities from external agencies are advertised to all volunteers.\n\n## Travel details\n\nMost sessions happen in Rose Lane Centre off South Street, St Andrews. Details of locations for pick up (local schools/the SU’s home) and drop off will be provided along with a journey planner.\n\n## Travel expenses\n\nExpenses are reimbursed monthly and staff will assist with expense forms. Mileage is reimbursed at 45p per mile.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g24000000eLJfAAM#role",
                        "type": "Role",
                        "title": "Volunteer Driver",
                        "description": "Volunteer Drivers are friendly, kind and prioritise safety. They should be a proficient driver and feel comfortable in this position of responsibility Volunteer Drivers are empathetic towards individuals with additional support needs and are willing to learn how to manage certain behaviours as needed.",
                        "applyLink": "https://volunteer.scot/search/a0g24000000eLJfAAM/volunteer-driver?#modal_register_a0g24000000eLJfAAM",
