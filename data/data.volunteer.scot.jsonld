        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000JFIY2YAP",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000JFIY2YAP/dunnikier-park-community-golf",
            "name": "Dunnikier Park Community Golf",
            "description": "They are passionate about offering barrier-free access to people of all ages and abilities to socialise and have fun playing community sport. \r\nThe introduction of park golf to Scotland, or park Gowf as we are calling it, plays a major part in achieving this goal.\r\nThere are strong signs that we are contributing towards improving mental health and wellbeing, with many local groups engaging with us, including: Alzheimer Scotland, Sporting Memories, the Nourish Support Centre, the Salvation Army, Step by Step (a bereavement support group), Phoenix Futures and Active Fife.\r\nWe have also strengthened our engagement across the full age spectrum - from hundreds of primary school pupilsthrough to residents participating in our fun Care Home League.",
            "website": "https://www.dpcomgolf.com/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC051184"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Addictions",
                    "skos:prefLabel": "Addictions"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/DrugAlcoholIssues",
                    "skos:prefLabel": "Drug / Alcohol Issues"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FamilySupport",
                    "skos:prefLabel": "Family Support"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/MentalHealth",
                    "skos:prefLabel": "Mental Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SportLeisureRecreation",
                    "skos:prefLabel": "Sport / Leisure / Recreation"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
                    "skos:prefLabel": "Volunteering"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityEngagement",
                    "skos:prefLabel": "Community Engagement"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000GUU2iYAH",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000GUU2iYAH/park-golf-community-helper",
                    "publishStart": "2026-10-21",
                    "publishEnd": "2027-04-19",
                    "title": "Park Golf - Community Helper",
                    "description": "## Description\n\nDunnikier Park Community Golf - an award-winning organisation engaging with around 10 schools, 12 care homes and over 20 community groups across the full age spectrum requires volunteers to help them reach more members of the community.\r\n\r\nPark Golf is a simple game imported from Japan – involving only one club and a ball. It’s accessible to all ages and abilities, played over a short, 500-yard course, taking less than one hour to play. It’s about getting people who wouldn’t normally play sport being active outside having fun, which helps support their physical and mental health and wellbeing.\r\n\r\nThis role involves welcoming customers, organising clubs and balls, providing health and safety guidance, assisting with organising play, and helping to create a friendly, enjoyable experience through general conversation.\r\n\r\nIf you are passionate about supporting others to have fun, and improve their wellbeing, we’d love to welcome you to our Park Golf Family.\n\n## Experience required\n\nReasonable level of fitness. No previous experience needed - just a positive attitude.\r\n\r\nFriendly and approachable with social skills. Good communicator and listener.\r\n\r\nCommunity spirited, looking to help vulnerable and disadvantaged people live a fuller, enjoyable, fun life.\r\n\r\nYou don’t need to have an interest in golf.\n\n## Training details\n\nAn induction will be provided.\r\n\r\nSafeguarding with Scottish Golf online training will be provided.\r\n\r\nFirst Aid training is provided by Active Fife\r\n\r\nOngoing peer support from fellow volunteers.\n\n## Travel details\n\nDunnikier Park Golf Club, Dunnikier Country Park, Dunnikier Way, Kirkcaldy. KY1 3LP\r\n\r\nIt is most easily accessible by car, with a sizeable car park.\r\n\r\nThe nearest public transport is the bus stop at the top of Whyteman’s Brae – a 10/15-minute walk to the clubhouse.\n\n## Travel expenses\n\nTravel expenses are reimbursed at a rate of 55p per mile, or public transport rates (based on receipts).",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000GUU2iYAH#role",
                        "type": "Role",
                        "title": "Park Golf - Community Helper",
                        "description": "Reasonable level of fitness. No previous experience needed - just a positive attitude.\r\n\r\nFriendly and approachable with social skills. Good communicator and listener.\r\n\r\nCommunity spirited, looking to help vulnerable and disadvantaged people live a fuller, enjoyable, fun life.\r\n\r\nYou don’t need to have an interest in golf.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000GUU2iYAH/park-golf-community-helper?#modal_register_a0gQD00000GUU2iYAH",
                        "allowsRemoteParticipation": false,
