        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000UorJJYAZ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000UorJJYAZ/the-vegan-society",
            "name": "The Vegan Society",
            "description": "1.  Improved vegan catering, nutrition, education and agriculture; encouraging government, public and private sector bodies to adopt and reward sustainable, healthy and compassionate lifestyles.\r\n\r\n2.  Greatly increase the number of people trying veganism and remaining vegan, because they believe that:\r\n\r\nAnimals have a right to life and freedom\r\nAnimal exploitation also negatively affects human justice (global food distribution issues, etc)\r\nAnimal farming is not sustainable and is severely damaging to the environment\r\nBalanced vegan nutrition is healthy.",
            "website": "https://www.vegansociety.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC049495"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2Fab1280b0-cb4c-4aca-8707-302981108f2e%2FbHNYaxHxAUc1xaVAsL6LrYe7W5R2%2Fuser-upload.jpg?alt=media&token=3b9148e5-5722-4718-8596-a1eaab287b7b",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
