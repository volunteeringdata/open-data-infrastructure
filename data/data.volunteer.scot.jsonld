                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000003uIGfYAM",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000003uIGfYAM/inventory-and-donation-sorters",
                    "publishStart": "2026-08-17",
                    "publishEnd": "2027-02-10",
                    "title": "Inventory and Donation Sorters",
                    "description": "## Description\n\nMamacita Foundation is seeking organized and detail-oriented volunteers to assist with sorting and managing donated items. Volunteers will help ensure that donations are processed efficiently and distributed to those in need.\n\nResponsibilities:\n\nSort and categorize donated items such as clothing, food, household goods, and other essentials.\nMaintain an organized inventory system.\nAssist with the preparation and distribution of donation packages.\nEnsure that donated items meet quality standards.\nHelp with the setup and cleanup of donation sorting areas.\nWork with other volunteers and staff to support the overall mission of the foundation.\n\n## Experience required\n\nStrong organizational skills and attention to detail.\nAbility to lift and move boxes and bags of donated items.\nReliable and punctual with a commitment to scheduled shifts.\nAbility to work well in a team environment.\nPrevious experience in inventory management or a similar role is a plus.\nFlexibility to adapt to varying tasks and responsibilities as needed.\nBenefits:\n\nOpportunity to support a vital community service.\nGain experience in inventory management and logistics.\nMeet new people and work in a collaborative team environment.\nTraining and support provided by the Mamacita Foundation.\nFlexible schedule to accommodate your availability.\n\n## Travel details\n\nAberdeen",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-volunteerscotland-search.appspot.com/o/opportunities%2F2MwPF5yVuafuRWZmJnwbkWOFay02%2FBHH8SyAsq065M8Pw-thumbnail.jpg?alt=media&token=f96b9151-fd69-40cc-ba3f-7c7417083979",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000003uIGfYAM#role",
                        "type": "Role",
                        "title": "Inventory and Donation Sorters",
                        "description": "Strong organizational skills and attention to detail.\nAbility to lift and move boxes and bags of donated items.\nReliable and punctual with a commitment to scheduled shifts.\nAbility to work well in a team environment.\nPrevious experience in inventory management or a similar role is a plus.\nFlexibility to adapt to varying tasks and responsibilities as needed.\nBenefits:\n\nOpportunity to support a vital community service.\nGain experience in inventory management and logistics.\nMeet new people and work in a collaborative team environment.\nTraining and support provided by the Mamacita Foundation.\nFlexible schedule to accommodate your availability.",
