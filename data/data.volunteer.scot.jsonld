            "id": "https://data.volunteer.scot/Organisation/0011p000021u5zBAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p000021u5zBAAQ/cycling-uk-shetland",
            "name": "Cycling UK (Shetland)",
            "description": "Cycling UK are committed to ensuring cycling is open to all, that communities everywhere can enjoy cycling.  The main objectives are to break down any barriers which prevent people using a bike as a mode of transport.",
            "website": "https://www.cyclinguk.org/scotland",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC042541"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000006dzo9YAA",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000006dzo9YAA/event-helper",
                    "publishStart": "2024-11-12",
                    "publishEnd": "2027-04-01",
                    "title": "Event Helper",
                    "description": "## Description\n\nWhat you will be doing \r\n-Attend local community events, such as community festivals, fetes or awareness days to represent Cycling UK\r\n-Help with the smooth running of the event and ensure an enjoyable and supportive experience for participants and the public \r\n-Be ready to help with various tasks such as registering participants, collecting surveys, covering a stand or putting up/taking down signage \r\n-Help to create a friendly and inclusive atmosphere \r\n\r\nWhat's in it for you \r\n-Skills development including communication skills and an insight into event organising\r\n-A chance to meet new people, socialise with other volunteers and be part of a team \r\n-Satisfaction of increasing health and wellbeing of your local community and supporting Cycling UK's mission of enabling millions more people to cycle\n\n## Experience required\n\nThe skills you need\r\n-Confidence to interact with the public\r\n-An interest in the benefits of cycling \r\n-Friendly, welcoming and encouraging attitude \r\n-Ability to work with a team of volunteers\n\n## Travel details\n\nEvents will take place throughout Shetland.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000006dzo9YAA#role",
                        "type": "Role",
                        "title": "Event Helper",
                        "description": "The skills you need\r\n-Confidence to interact with the public\r\n-An interest in the benefits of cycling \r\n-Friendly, welcoming and encouraging attitude \r\n-Ability to work with a team of volunteers",
                        "applyLink": "https://volunteer.scot/search/a0gQD000006dzo9YAA/event-helper?#modal_register_a0gQD000006dzo9YAA",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/Environment",
                                "skos:prefLabel": "Environment"
                            },
