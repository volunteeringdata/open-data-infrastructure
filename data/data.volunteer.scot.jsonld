        {
            "id": "https://data.volunteer.scot/Organisation/0012400000VLGyoAAH",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000VLGyoAAH/shetland-rape-crisis-compass-centre",
            "name": "Shetland Rape Crisis / Compass Centre",
            "description": "Free and confidential information, advocacy and support for anyone in Shetland (age 13 and over) affected by any form of sexual violence.\r\nProvide support regarding sexual violence.  Delivering prevention programme to young people in secondary schools.  Challenge behavioiurs and raise awareness about gender inequality and sexual violence.  Run activism campaigns.",
            "website": "https://www.shetlandrapecrisis.scot",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
