            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000009FAxxYAG",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000009FAxxYAG/volunteer",
                    "publishStart": "2025-04-03",
                    "publishEnd": "2027-02-01",
                    "title": "Volunteer",
                    "description": "## Summary\n\nMake your Monday afternoon a delight by assisting people living with Parkinsons and their carers at a weekly “Dance for Parkinson’s” class at Olympia centre. No dance experience required.\n\n## Description\n\nDance can help people living with Parkinson’s physically, mentally and socially, aiding mobility and improving overall feelings of wellbeing. Dance for Parkinson’s Scotland classes improve balance, spatial awareness, confidence and fluidity of movement and can really make a big impact of the lives of people living with Parkinsons Disease and their carers. If you enjoy having fun and meeting new people why not come along and lend a hand? \r\n\r\nYou could help welcome participants when they arrive and help them safely to their seats. Check if folk need help moving about the building, chat to anyone who looks like they need it and make sure everyone has a drink and a biscuit at the social café after the class. We provide training to all our volunteers and support to them to make their volunteering fun , safe and bring joy to the Parkinson’s community.\n\n## Experience required\n\nInterest in physical movement, movement therapy, community support\n\n## Training details\n\nPhone call or Teams chat with either Coordinator or Engagement Producer to give company background and chat through the role.\n\n## Travel details\n\nOlympia leisure centre, 3 E Whale Ln, Dundee DD1 3JU\n\n## Travel expenses\n\nPlease note: no expenses are payable for this opportunity.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000009FAxxYAG#role",
                        "type": "Role",
                        "title": "Volunteer",
                        "description": "Interest in physical movement, movement therapy, community support",
                        "applyLink": "https://volunteer.scot/search/a0gQD000009FAxxYAG/volunteer?#modal_register_a0gQD000009FAxxYAG",
                        "allowsRemoteParticipation": false,
