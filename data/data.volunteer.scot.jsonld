        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXb1AAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXb1AAE/lanarkshire-cancer-care-trust",
            "name": "Lanarkshire Cancer Care Trust",
            "description": "Lanarkshire Cancer Care Trust are a voluntary organisation that provides support for cancer patients and families by providing free transport to individuals who don't have transport of their own and/or who find it difficult to cope with sometimes prolonged ambulance journeys. The transport covers specialist clinics, therapy centres, day care facilities and transport to hospitals for treatment. Based in Wishaw, the supports any cancer patient living within the boundaries of NHS Lanarkshire.",
            "website": "https://lcctdrivers.com/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC020978"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FamilySupport",
                    "skos:prefLabel": "Family Support"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000SsKiNAAV",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000SsKiNAAV/volunteer-driver",
                    "publishStart": "2026-09-21",
                    "publishEnd": "2027-03-20",
                    "title": "Volunteer Driver",
                    "description": "## Description\n\nIf you have spare time any weekday and a car, we are looking for new Volunteer Drivers who can take local Lanarkshire Cancer Patients to and from their hospital and clinic appointments.\n\nWe can repay your fuel expenses at a rate of 55p per mile.\n\nYour role will be to drive patients and any escort only.  You will be asked for your availability by our office staff and given plenty of notice as to when and where a patient’s appointment will take place.  \n\nOur drivers agree a pick-up time with the patient the night before and will either drop them off or bring them home if their treatment is a short one.  For longer treatment times, drivers will be asked to either drop the patients off or be asked if they are available to pick them up later if their time allows.\n\n## Experience required\n\nDriving, Caring,Good Communicator,Good Listener,Patient,Reliable / Dependable,\n\n## Frequency commitment details\n\nFlexible\n\n## Travel details\n\nThe opportunity takes place at multiple location across South Lanarkshire Yes\nAcross South Lanarkshire\n\n## Travel expenses\n\n45p per mile driven",
                    "requiresEmergencyParticipation": false,
