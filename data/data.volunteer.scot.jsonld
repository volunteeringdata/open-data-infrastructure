            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbXYAAY/british-heart-foundation-furniture-shop-dalry",
            "name": "British Heart Foundation Furniture Shop (Dalry)",
            "description": "The aim of the British Heart Foundation is to play a leading role in the fight against disease. We aim to do this through research, education and care, funding medical research, providing support and information and also providing life saving equipment for hospitals and funding British Heart Foundation nurses.",
            "charityRegistration": [
