            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000004lDFYAY",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000004lDFYAY/eventevent-planning-volunteers",
                    "publishStart": "2023-10-03",
                    "publishEnd": "2027-05-01",
                    "title": "Event/Event Planning Volunteers",
                    "description": "## Description\n\nLochlan’s Legacy is a charity which raises awareness and understanding of type 1 diabetes, reducing stigma, breaking down barriers, promoting youth voice and building a strong community. Lochlan’s Legacy is led by our founder, Lochlan Murdoch BCyA, who is fourteen years old.  The charity has been working since 2020 and our work includes raising awareness of Type 1 diabetes in sport, and setting up our youth group 'T1D and ME - Giving Youth a Voice'. Come and be part of something incredible, driven by our iWill Ambassador Lochlan.\r\n\r\nWe are currently looking for Event/Event Planning Volunteers to help plan and run our fundraising events. This could be the ideal opportunity for someone looking to gain some experience in events management.\n\n## Experience required\n\nYou do not need to live with type 1 diabetes to volunteer for us, just a keen interest to learn and develop. \r\n\r\nWe have various volunteering opportunities so they can be tailormade to your time, availability and interests. \r\nThe events volunteer is a flexible role that can fit around your life.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F84d7189b-6816-4a3a-8242-4ab8276ecf92%2F0nFCUqNjeiXPIFO483j0BVWArU43%2Flisting.jpg?alt=media&token=3929ded5-1e9e-46f7-b2fb-dffddb797c08",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD0000004lDFYAY#role",
                        "type": "Role",
                        "title": "Event/Event Planning Volunteers",
                        "description": "You do not need to live with type 1 diabetes to volunteer for us, just a keen interest to learn and develop. \r\n\r\nWe have various volunteering opportunities so they can be tailormade to your time, availability and interests. \r\nThe events volunteer is a flexible role that can fit around your life.",
                        "applyLink": "https://volunteer.scot/search/a0gQD0000004lDFYAY/eventevent-planning-volunteers?#modal_register_a0gQD0000004lDFYAY",
                        "allowsRemoteParticipation": true,
                        "minimumAge": "12",
