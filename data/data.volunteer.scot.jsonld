        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000E6VHBYA3",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000E6VHBYA3/aberdeen-archives-gallery-and-museums",
            "name": "Aberdeen Archives, Gallery and Museums",
            "description": "Aberdeen Archives, Gallery & Museums (AAGM) cares for collections of outstanding importance and quality on behalf of the people of Aberdeen.  Through our collections, buildings, exhibitions and events we strive to make a positive impact on the lives of everyone who lives, works, studies and visits our city. Our collections are recognised by UNESCO and the Scottish Government as nationally and internationally important. The historical records of Aberdeenshire Council are also preserved and managed by the team.",
            "website": "https://www.aberdeencity.gov.uk/AAGM",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
