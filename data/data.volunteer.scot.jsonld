        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000Vz2O3YAJ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000Vz2O3YAJ/downs-connection-theatre-group",
            "name": "Downs Connection Theatre Group",
            "description": "Downs Connection is a theatre group for children and adults with Downs Syndrome\n and their families. Downs Connection offers a safe space for our cast to explore\n their creativity and express themselves through the arts without judgement.\n Downs Connection also provides a safe space for families to connect and support\n each other through shared experiences.",
            "website": "https://downsconnection.co.uk/",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000008PcQTYA0",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000008PcQTYA0/on-stage-helper",
                    "publishStart": "2026-10-01",
                    "publishEnd": "2027-03-31",
                    "title": "On Stage Helper",
                    "description": "## Description\n\nAt Downs Connection, our aim is to provide people with Downs Syndrome the opportunity to perform on stage through aspect of musical theatre. We want to help build their confidence, develop \ntheir communication skills and most importantly, have fun! None of this is possible without our wonderful helpers.\n  \nRoles and Responsibilities \nAs a helper, you will work with the cast on a weekly basis to support them to learn their lines, song words and dances.   You will perform alongside the cast on stage, to help them during performances.   The spotlight will not be on you, so don’t worry if you’re not a solo performer. If you enjoy singing and dancing, that’s all that matters!  We expect you to be inclusive, supportive and respectful to all group members at all times.  Some of our cast may communication using Makaton or Sign Language.  Prior knowledge or experience of this is not necessary, as long as you are willing to learn! You may also be required to play games with our younger cast members.\n\n## Experience required\n\nNo Expertise, Caring,Good Communicator,Good Listener,Hard Working,Open minded,Organised,Patient,Practical,Reliable / Dependable,Sociable,Trustworthy,Essential Skills \n• Kind \n• Caring \n• Patience  \n• Desire to help others \n• Confidence\n\n## Travel details\n\nThe opportunity takes place at multiple location across South Lanarkshire \nAcross South Lanarkshire,East Kilbride",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000008PcQTYA0#role",
                        "type": "Role",
                        "title": "On Stage Helper",
                        "description": "No Expertise, Caring,Good Communicator,Good Listener,Hard Working,Open minded,Organised,Patient,Practical,Reliable / Dependable,Sociable,Trustworthy,Essential Skills \n• Kind \n• Caring \n• Patience  \n• Desire to help others \n• Confidence",
                        "applyLink": "https://volunteer.scot/search/a0gQD000008PcQTYA0/on-stage-helper?#modal_register_a0gQD000008PcQTYA0",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/LearningDisabilities",
                                "skos:prefLabel": "Learning Disabilities"
                            }
                        ]
                    },
                    "session": {
                        "type": "Session",
