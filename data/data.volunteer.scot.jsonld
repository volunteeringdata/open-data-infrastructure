        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002TgqxWAAR",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002TgqxWAAR/heart-research-uk",
            "name": "Heart Research UK",
            "description": "Proud to stand out from the crowd, Heart Research UK is the charity dedicated  to your heart.  We inspire and invest in pioneering medical research, ground-breaking training and education and in communities to improve their heart health for themselves.\r\n\r\nAlways looking to the future, we give clinicians unique opportunities to gain the latest skills, knowledge and hands-on experience to become the experts of tomorrow.  We show youngsters born with heart disease, and those who care for them, that they can live active lives.\r\n\r\nOur Healthy Heart Grants focus on communities to prevent heart disease in the first place.",
            "website": ["https://www.heartresearch.org.uk", "https://www.heartofscotland.org.uk"],
            "cause": [
