        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZ7wAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZ7wAAE/advocating-together-dundee-scio",
            "name": "Advocating Together (Dundee) SCIO",
            "description": "We defend and safeguard people’s human rights independent advocacy – professional, collective and self-advocacy.\r\n\r\nWe enable people to have a stronger voice and access the most suitable information they need to make real choices.\r\n\r\nWe encourage people to have as much control as possible over their own lives.\r\n\r\nWe may speak up for people who are unable to do so for themselves through non-instructed advocacy.",
            "website": "https://www.advocating-together.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC026064"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Advocacy",
                    "skos:prefLabel": "Advocacy"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000ASP8zYAH",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000ASP8zYAH/self-advocacy-assistant",
                    "publishStart": "2025-06-19",
                    "publishEnd": "2027-02-01",
                    "title": "Self Advocacy Assistant",
                    "description": "## Summary\n\nAdvocating Together supports people with learning disabilities and autistic people to speak up and be heard. As a Self-Advocacy Assistant, you will support our group members to build their confidence, stay informed and know their rights.\n\n## Description\n\nAdvocating Together supports people with learning disabilities and autistic people to speak up and be heard. As a Self-Advocacy Assistant, you will support our group members to build their confidence, stay informed and know their rights.\r\n\r\n Small groups meet regularly to discuss a variety of topics that affect or interest our members. This could be local changes or initiatives, national legislation changes or campaigns, human rights, health matters, keeping safe, or exploring Dundee.\r\n\r\nYour role is to make sure everyone is comfortable, included, respected and having fun. Supporting members to facilitate the group and discussions, with making teas and coffees, and tidying up.\r\n\r\nOur three Self-Advocacy groups run every two weeks: on a Monday evening, or Tuesday and Wednesday afternoons. There is also a drop-in group which runs weekly on a Thursday.\n\n## Experience required\n\nFriendly and welcoming\r\nActive listener\r\nGood at adapting your communication style\r\nPatience and empathy\r\nA positive attitude\n\n## Training details\n\nInduction and ongoing support will be provided by our self-advocacy co-ordinator.\n\n## Travel details\n\nWe are located on Ryehill Lane, adjacent to Perth Road Dundee.\n\n## Travel expenses\n\nTravel to and from the office will be paid if coming by bus or by car (45p/mile)",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000ASP8zYAH#role",
                        "type": "Role",
                        "title": "Self Advocacy Assistant",
                        "description": "Friendly and welcoming\r\nActive listener\r\nGood at adapting your communication style\r\nPatience and empathy\r\nA positive attitude",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000ASP8zYAH/self-advocacy-assistant?#modal_register_a0gQD00000ASP8zYAH",
