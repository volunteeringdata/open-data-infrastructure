            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000AEotdYAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000AEotdYAD/panel-members-harris",
                    "publishStart": "2025-02-25",
                    "publishEnd": "2027-02-26",
                    "title": "Panel Members (Harris)",
                    "description": "## Description\n\nVolunteering opportunity! Children’s Hearings Scotland is looking for enthusiastic people to join the team as Panel Members. The qualities you use every day are exactly what Scotland’s infants, children and young people look for in a Panel Member. Make a difference in your local community and put your empathy, compassion, and listening abilities to great use.\r\n\r\nIf you are interested in volunteering and want to find out more about the role, click visit: chscotland.gov.uk\r\n\r\nAnyone with an interest in joining the Children’s Panel in the Western Isles is encouraged to attend.  Please contact Marina Macaulay (mmacaulay@cne-siar.gov.uk) and you will be sent the Teams link for the Information Session.\n\n## Experience required\n\nWe are looking for good listeners, people who are caring, compassionate and reliable. You need to be over 18 and live and/or work in the local authority area in which you wish to volunteer.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000AEotdYAD#role",
