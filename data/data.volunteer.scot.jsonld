            "dc:source": "https://volunteer.scot/organisations/00124000008nZnbAAE/lothian-community-transport-services-lcts",
            "name": "Lothian Community Transport Services (LCTS)",
            "description": "LCTS's primary aim is to deliver, promote and support high quality accessible passenger transport services in Edinburgh, Midlothian and the surrounding areas.",
            "website": "https://www.lcts.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC018884"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F8f5d9d35-5d57-9f43-8bc8-282807775086%2FHi3K7lHa8wXatOHLGJFdBGJQtau2%2Fuser-upload.jpg?alt=media&token=f51444b0-7e2c-40d8-b693-00409e9f0a2f",
