        {
            "id": "https://data.volunteer.scot/Organisation/0011p00001hYyH3AAK",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00001hYyH3AAK/love-music",
            "name": "Love Music",
            "description": "Established to provide public benefit in Scotland and elsewhere to promote, maintain, improve and advance education, appreciation, understanding of and access to the Arts, in particular to provide high quality access for children, young people and the wider community to create, participate in and perform music, not limited to any particular genre or style.",
            "website": "https://www.lovemusic.org.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
                    "skos:prefLabel": "Arts and Culture"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/YoungPeople",
                    "skos:prefLabel": "Young People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000RxNH9AAN",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000RxNH9AAN/junior-choir-chaperone",
                    "publishStart": "2022-06-29",
                    "publishEnd": "2027-01-31",
                    "title": "Junior Choir Chaperone",
                    "description": "## Summary\n\nLove Music are seeking volunteer chaperones to join our team looking after the children who participate in our Junior Choir’s weekly rehearsals on Mondays after school at Edinburgh’s Usher Hall.\n\n## Description\n\nChaperones look after the children’s safety around the building and assist our artistic team to support children who benefit from a little extra help during rehearsals. The role is a non-musical one as rehearsals are led by our choir leaders. There is no need for applicants to have experience of singing or music-making, but they should be able to demonstrate enthusiasm and encouragement to the children. Chaperones are needed from 3.40pm to 5.50pm on Monday afternoons during choir terms.\n\n## Experience required\n\nExperience and confidence of working with children, good verbal communication,  a positive outlook, punctual and reliable. \nShare our values and enjoyment and appreciation of community music-making, \nability to explain their motivation for volunteering in this role. Understanding of child protection issues.\n\n## Training details\n\nWe provide training in child protection, an introduction to first aid, familiarity with the Usher Hall, the opportunity to meet some of our current chaperone team, and a full explanation of our procedures. New chaperones will be placed in groups with more experienced chaperones. Our training normally takes place over the course of 1 full day or 2 half-day sessions in the week or two before the start of choir term.\n\n## Travel details\n\nCentral location with lots of bus routes nearby.\n\n## Travel expenses\n\nTravel expenses paid",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000RxNH9AAN#role",
