        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nbTDAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbTDAAY/pet-care-network-edinburgh",
            "name": "Pet Care Network (Edinburgh)",
            "description": "Pet Care Network's aim is to provide help for people with disabilities and social needs by offering short term fostering and support with various aspects of pet care. Our network of volunteers can help give them the opportunity to enjoy a rewarding and ongoing relationship with their companion animals for as long as possible.",
            "website": "https://www.petcarenetwork.co.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC024816"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
