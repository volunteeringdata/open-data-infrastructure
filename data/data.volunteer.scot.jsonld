        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002ZEiWlAAL",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002ZEiWlAAL/spacethe-broomhouse-hub",
            "name": "Space@The Broomhouse Hub",
            "description": "Space @ The Broomhouse Hub is a Scottish Award nominated Charity organisation delivering diverse services supporting young people, families, older people, and carers – amongst others – engaging with local people more than 34,000 times last year. \nMore than 30 years on, with a new community hub building and still with local community groups and trustees at its core, Space continues working to improve the happiness, mood & mental well-being of our community members, enhancing physical health, and developing skills & job opportunities, whilst growing the confidence of the residents of our area and beyond in South West Edinburgh. We do this by nurturing, supporting, and inspiring people of all ages so that lives are fuller, the potential is fulfilled and community connections flourish.",
            "website": "https://www.spacescot.org/",
