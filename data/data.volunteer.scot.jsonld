        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000tKLITYA4",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000tKLITYA4/team-jak-foundation",
            "name": "Team Jak Foundation",
            "description": "We provide emotional social and practical support to children and young people age 0-25 with cancer and related illnesses, their families firends and those bereaved throughout Scotland .\r\nWe do this from Jak's Den HQ Livingston, Jak's Den Aberdeen and pop up dens in Glasgow and Fife, and through Schiehallion ward Glasgow, Lochranza Ward, Edinburgh, Aberdeen hospital and in schools and community throughout Scotland.",
            "website": "https://teamjak.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC045586"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F6d0da256-7634-48c8-90d0-95af6a546b6f%2FbHNYaxHxAUc1xaVAsL6LrYe7W5R2%2Fuser-upload.jpg?alt=media&token=8c1ec215-7485-414e-ad89-1bdac219cdad",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Counselling",
                    "skos:prefLabel": "Counselling"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
                    "skos:prefLabel": "Volunteering"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/YoungPeople",
                    "skos:prefLabel": "Young People"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityEngagement",
                    "skos:prefLabel": "Community Engagement"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HnH5xYAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HnH5xYAF/community-fundraiser",
                    "publishStart": "2026-07-21",
                    "publishEnd": "2027-01-19",
                    "title": "Community Fundraiser",
                    "description": "## Description\n\nAs a Community Fundraiser Volunteer, you will support Team Jak in raising awareness and funds in the community. You will assist staff at events, participate in bag packing, merchandise stalls, and awareness campaigns, representing Team Jak at a variety of public events. In addition, this role can also involve;\r\n\r\n· Cheering our fundraisers on at local events and if interested, supporting other events in Edinburgh such as the Kiltwalks, Edinburgh Marathon Festival and other running events.\r\n· Helping us create and maintain networks with local communities and groups by representing Team Jak and undertaking speaking engagements.\r\n· Forming a local fundraising group or even setting up your own group with your friends to raise money on a monthly or annual basis.\n\n## Experience required\n\nNo prior experience is required; the organisation is looking for enthusiastic, friendly, hard-working, and committed volunteers. This role can be emotionally challenging, and therefore requires a resilient individual.\n\n## Training details\n\n· Initial induction training, ongoing support and any further relevant training opportunities.\r\n\r\n· Opportunity to join Jak’s Den certificate programme\n\n## Travel details\n\nFundraising activities throughout Fife, such as Gala days, bucket collection or awareness stalls.\n\n## Travel expenses\n\nWe cover public transport expenses and reimburse when they give in their expenses form (when they choose).\r\n\r\nWe also cover 0.35p of every mile.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HnH5xYAF#role",
                        "type": "Role",
                        "title": "Community Fundraiser",
                        "description": "No prior experience is required; the organisation is looking for enthusiastic, friendly, hard-working, and committed volunteers. This role can be emotionally challenging, and therefore requires a resilient individual.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000HnH5xYAF/community-fundraiser?#modal_register_a0gQD00000HnH5xYAF",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "14",
                        "theme": [
