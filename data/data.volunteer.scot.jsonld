            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000I1wXRYAZ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000I1wXRYAZ/volunteer-member-of-the-progressing-forward-steering-group",
                    "publishStart": "2026-09-16",
                    "publishEnd": "2027-03-17",
                    "title": "Volunteer member of the Progressing Forward Steering Group",
                    "description": "## Description\n\nAn opportunity to be part of a group of people who have an interest in how substances impact individuals, families and communities in West Lothian and to play a part in evaluation and developing WLDAS services  in future.\n\n## Experience required\n\nAn ability to be non- judgemental, be inclusive and view substance use as an issue which can impact anyone.\r\nTo be proactive in approach to future developments of services and be happy to be an active participant in events which promote the service.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000I1wXRYAZ#role",
