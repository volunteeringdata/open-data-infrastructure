        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZyIAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZyIAAU/haddington-citizens-advice-bureau",
            "name": "Haddington Citizens Advice Bureau",
            "description": "Haddington Citizens Advice Bureau is a local, independent charity which provides free, impartial and confidential advice and information to citizens of East Lothian.  This organisation aims to give its clients the tools they need to sort out any issues or problems they are experiencing.",
            "website": "https://www.haddingtoncab.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC000814"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/MoneyDebtAdvice",
                    "skos:prefLabel": "Money / Debt Advice"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/WelfareRightsBenefits",
                    "skos:prefLabel": "Welfare Rights / Benefits"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000IFgUPYA1",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000IFgUPYA1/volunteer-generalist-adviser",
                    "publishStart": "2026-10-01",
                    "publishEnd": "2027-04-01",
                    "title": "Volunteer Generalist Adviser",
                    "description": "## Description\n\nHaddington Citizens Advice Bureau is a local, independent charity providing free, impartial and confidential advice and information since 1979. We aim to make sure people in our community have the information, advice and support they need to deal with the issues and problems they face.\r\n\r\nOur service relies heavily on the amazing contribution of our volunteers, particularly within our advice service.\r\n\r\nOur Volunteer Generalist Advisers meet with clients attending our drop-in advice sessions or by appointment. They discuss and diagnose clients' issues, provide relevant information and advice, agree next steps, offer practical support to help clients take those steps, and write clear and accurate records of client contacts.\r\n\r\nNo previous experience is required. We provide comprehensive training, including the opportunity to work towards a recognised qualification. You'll also have plenty of ongoing support from our paid staff and our highly experienced volunteers, some of whom have been with us for more than 15 years.\r\n\r\nIf you're interested in the role, or would simply like to find out more, please feel free to get in touch. We'd be happy to hear from you.\n\n## Experience required\n\nNo Expertise\n\n## Frequency commitment details\n\nCommitment 1 Year 7 Hours, Weekly\n\n## Travel details\n\nAvailable at Multiple Locations false",
                    "requiresEmergencyParticipation": false,
                    "role": {
