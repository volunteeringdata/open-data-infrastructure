        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXR1AAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXR1AAM/overtonlea-care-centre",
            "name": "Overtonlea Care Centre",
            "description": "Overtonlea is a modern, purpose built residential home for adults with complex support needs in the South Mainland of Shetland. We offer residential support on a long term basis as well as respite support.  \r\nWe provide person centred support to individuals who reside at Overtonlea.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
