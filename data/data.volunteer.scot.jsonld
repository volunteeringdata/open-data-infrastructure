        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nbzfAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbzfAAA/kinning-park-complex",
            "name": "Kinning Park Complex",
            "website": "https://www.kinningparkcomplex.org",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
