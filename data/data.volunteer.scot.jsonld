            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000001Mt7PAAS",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000001Mt7PAAS/volunteer-victim-service",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Volunteer Victim Service",
                    "description": "## Summary\n\nTo provide emotional and practical support to people affected by crime and anti-social behaviour in North Ayrshire through a variety of settings including visiting victims in their own home.\n\n## Description\n\nProvide emotional support to anyone who has been affected by crime and asb through use of counselling skills, needs assessments and Individual support plans to help people normalise their situation. To provide information on the criminal justice system to those who have become involved with the police through no fault of their own and have no idea of what happens next. To assist people to claim for Criminal Injuries Compensation for serious injury, completion of Victim Impact Statements and sign posting to other agencies.\n\n## Experience required\n\nExcellent communicator with good Life skills. Non judgemental , flexible.\n\n## Travel details\n\nALL OVER NORTH AYRSHIRE\n\n## Travel expenses\n\npaid as required",
                    "requiresEmergencyParticipation": false,
