        {
            "id": "https://data.volunteer.scot/Organisation/0010800003D5k6hAAB",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003D5k6hAAB/night-before-christmas-campaign",
            "name": "Night Before Christmas Campaign",
            "description": "We provide Night Before Christmas boxes in the hope that it will bring some magic for children and homeless at Christmas. We are building a team of volunteers who give their time to providing children with hope at a special time of year. Our charitable purpose is the prevention or relief of poverty, and we feel strongly that no one should go without at Christmas.",
            "website": "https://nightbeforechristmas.co.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC047995"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FamilySupport",
                    "skos:prefLabel": "Family Support"
                },
                {
