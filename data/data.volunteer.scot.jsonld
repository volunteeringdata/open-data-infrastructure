        {
            "id": "https://data.volunteer.scot/Organisation/00124000008niROAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008niROAAY/stroke-association",
            "name": "Stroke Association",
            "description": "Surviving a stroke is just the start of a long and difficult recovery journey. We’re here to support stroke survivors and their families find the strength they need to find their way back to life.\r\n\r\nOur stroke support is tailored to tens of thousands of stroke survivors each year. This support includes one-to-one and group support, vital scientific research into stroke prevention, acute treatment and recovery and campaigning to secure the best care for all those affected by stroke. \r\n\r\nProviding support after a stroke is a team effort. It takes the determination of stroke survivors and carers, the generosity of supporters and the dedication of the healthcare and research communities to get there.",
            "website": "http://www.stroke.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC037789"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CampaigningLobbying",
                    "skos:prefLabel": "Campaigning / Lobbying"
                },
