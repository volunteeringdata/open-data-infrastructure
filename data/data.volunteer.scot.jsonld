            "id": "https://data.volunteer.scot/Organisation/0010800003K5w6uAAB",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003K5w6uAAB/the-mindful-partnership",
            "name": "The Mindful Partnership",
            "description": "We deliver training in Mindfulness and Self-Compassion based practices, which includes various movement practices, within local communities in Fife and to 3rd sector organisations to support volunteers/ teams who are supporting others.  We aim to support people with mental and physical health issues, building resilience and wellbeing and also aim to strengthen capacity in communities in Fife so they become self managing in terms of mental/physical health and wellbeing . We have begun to do this by increasing the number of trainers and delivering teacher training.  Longer term training in the form of retreat places are being offered to deepen the practices for those who wish to train as trainers - and also to fulfil the need for more support for participants who attend the training.",
            "website": "https://www.themindfulpartnership.co.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC051766"
                }
