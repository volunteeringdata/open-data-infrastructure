            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000J70zdYAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000J70zdYAB/volunteer-kitchen-helper",
                    "publishStart": "2026-10-29",
                    "publishEnd": "2027-04-29",
                    "title": "VOLUNTEER KITCHEN HELPER",
                    "description": "## Description\n\nBraid House Day Centre is looking for a friendly and reliable Kitchen Volunteer to join our team on:\r\n Wednesdays & Thursdays\r\n⏰ 10.00am – 1.30pm\r\nWe are looking for someone who would enjoy helping out in our busy kitchen and being part of our friendly day centre.\r\nWhat would you be doing?\r\n• ️ Washing and drying dishes – we have a lovely new dishwasher! \r\n•  Helping to keep the kitchen tidy and organised\r\n•  Helping our chef with general kitchen tasks\r\nYou don't need to be a professional chef – just a willingness to help, a friendly attitude and the ability to work as part of a team.\r\nOur kitchen plays an important part in the day at Braid House, where we provide freshly prepared meals for our clients.\r\nIf you have a few hours to spare on Wednesdays and Thursdays and would like to make a difference in your local community, we would love to hear from you!\r\n Braid House Day Centre, Livingston\r\n 01506 430615\r\n contact@braidhouse.com\n\n## Experience required\n\nWe are looking for someone who would enjoy helping out in our busy kitchen and being part of our friendly day centre.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000J70zdYAB#role",
                        "type": "Role",
                        "title": "VOLUNTEER KITCHEN HELPER",
                        "description": "We are looking for someone who would enjoy helping out in our busy kitchen and being part of our friendly day centre.",
