            "dc:source": "https://volunteer.scot/organisations/00124000008niKsAAI/trees-for-life",
            "name": "Trees For Life",
            "description": "Restoration and regeneration of the Caledonian forest in Scotland.",
            "website": "https://www.treesforlife.org.uk",
            "charityRegistration": [
