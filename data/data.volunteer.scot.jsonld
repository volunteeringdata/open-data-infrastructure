            "dc:source": "https://volunteer.scot/organisations/001QD00001ACXurYAH/autistic-social-hub-aberdeen",
            "name": "Autistic Social Hub - Aberdeen",
            "description": "ASH - Autistic Social Hub - is a charity in Aberdeen. Our groups and support are designed for autistic (including Aspergers) adults who are 18 and over.",
            "website": "https://ash-a.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC054031"
                }
            ],
            "cause": [
