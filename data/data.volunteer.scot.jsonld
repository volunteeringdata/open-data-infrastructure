        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000JbdUFYAZ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000JbdUFYAZ/independent-monitoring-board-imb",
            "name": "Independent Monitoring Board (IMB)",
            "description": "Independent Monitoring Boards are made up of over a thousand unpaid volunteers operating in every prison in England and Wales, and every immigration detention facility across the UK. IMB members are the eyes and ears of the public, appointed by ministers to perform a vital task: independent monitoring of prisons and immigration detention. They report on whether the individuals held there are being treated fairly and humanely and whether prisoners are being given the support they need to turn their lives around. This can make a huge difference to the lives of those held within these facilities.",
            "website": "https://imb.org.uk/",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000IEEojYAH",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000IEEojYAH/independent-monitor",
                    "publishStart": "2026-09-30",
                    "publishEnd": "2027-02-05",
                    "title": "Independent Monitor",
                    "description": "## Description\n\nMembers of Independent Monitoring Board at Dungavel House Immigration removal centre.  Board members carry out weekly visits to the centre to monitor the management of the facilities and listening to any concerns raised in the centre.  This includes talking to detainees and centre staff.\n\nAttendance ant monthly, on site, Board meertings is required.\n\nNo specialist skills required as full training will be given.\n\n## Experience required\n\nNo Expertise, Good Communicator,Good Listener,Open minded,Patient,Team Player,Trustworthy,\n\n## Training details\n\nIMB learning courses\n\n## Travel details\n\nThe opportunity takes place at multiple location across South Lanarkshire \nAcross South Lanarkshire,Strathaven\n\n## Travel expenses\n\nReasonable travelling expenses will be paid",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000IEEojYAH#role",
                        "type": "Role",
                        "title": "Independent Monitor",
                        "description": "No Expertise, Good Communicator,Good Listener,Open minded,Patient,Team Player,Trustworthy,",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000IEEojYAH/independent-monitor?#modal_register_a0gQD00000IEEojYAH",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/RefugeesAsylumSeekers",
                                "skos:prefLabel": "Refugees / Asylum Seekers"
                            }
