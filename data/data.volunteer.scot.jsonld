        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXh1AAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXh1AAE/disabled-persons-housing-service-aberdeen",
            "name": "Disabled Persons Housing Service Aberdeen",
            "description": "We are a local charity offering housing advice, support and advocacy to vulnerable/disabled individuals. We are a recipient of the Queens Award for Voluntary Service in recognition of our work, volunteering and positive difference we make.",
            "website": "https://www.dphsaberdeen.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC034791"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Advocacy",
                    "skos:prefLabel": "Advocacy"
                },
                {
