            "dc:source": "https://volunteer.scot/organisations/00124000008nZoHAAU/penicuik-citizens-advice-bureau",
            "name": "Penicuik Citizens Advice Bureau",
            "description": "To provide a free, confidential, impartial holistic advice, information and advocacy service on any subject including housing, benefits, debt, money advice, employment, consumer, utility, family and legal issues",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
