        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000zQqZKYA0",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000zQqZKYA0/girotondo-italian-school-charity-based-at-aberdeen-grammar-school",
            "name": "Girotondo Italian School Charity (based at Aberdeen Grammar School)",
            "description": "We are a Scottish Charity.\r\n \r\nWe provide courses of Italian language to children and young people 5-17yo in Edinburgh, Glasgow, Aberdeen and online.  We are funded by the Italian Ministry of Foreign Affairs.",
            "website": "https://girotondoitalianschool.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC049175"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
