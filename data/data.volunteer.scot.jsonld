            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HTS5ZYAX",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HTS5ZYAX/clock-repair-volunteer",
                    "publishStart": "2026-06-26",
                    "publishEnd": "2026-12-25",
                    "title": "Clock Repair Volunteer",
                    "description": "## Description\n\nHelp Grantown Remakery respond to enquiries about clock repairs and support the repair, restoration and reuse of valued items. Many items have practical, financial or sentimental value, and your skills will help keep them in use for longer.\r\n\r\nTypical Tasks:\r\nAssess clocks brought to Grantown Remakery \r\nAdvise whether repairs are possible \r\nCarry out repairs where appropriate \r\nSignpost customers to specialist services when required \r\nShare knowledge with staff and volunteers\r\n\r\nBenefits:\r\nUse specialist skills in a meaningful way \r\nHelp preserve traditional craftsmanship \r\nSupport sustainability and repair culture \r\nShare knowledge with others \r\nContribute to a local community project\n\n## Experience required\n\nExperience of clock repair, mechanical restoration or related practical skills is required. You will receive ongoing support from a named contact within Grantown Remakery.\r\n\r\nPlease get in touch if you require any adjustments to help you volunteer with us.",
                    "requiresEmergencyParticipation": false,
