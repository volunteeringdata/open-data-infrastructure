        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000cLYXAYA4",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000cLYXAYA4/meeting-centres-scotland-royal-victoria-hospital-meeting-centre",
            "name": "Meeting Centres Scotland - Royal Victoria Hospital Meeting Centre",
            "description": "Meeting Centres Scotland is a charitable organisation dedicated to creating inclusive spaces where people living with dementia and their families receive support, engage in meaningful activities, and connect with others who understand their experiences. Our mission is to establish a network of Meeting Centres across Scotland, providing social, emotional, and practical assistance to empower individuals and enhance their quality of life. We work closely with local communities, health and social care providers, and academic institutions to deliver person-centred support tailored to the unique needs of people affected by dementia.",
            "website": "https://www.meetingcentres.scot",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC052857"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
