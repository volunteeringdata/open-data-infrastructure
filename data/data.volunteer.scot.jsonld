            "dc:source": "https://volunteer.scot/organisations/001QD00000oKYvBYAW/1st-city-of-aberdeen-scout-group",
            "name": "1st City of Aberdeen Scout Group",
            "description": "The 1st City of Aberdeen Scout Group provides fun, challenge & adventure for young people aged 6 - 14.",
            "website": "https://www.scouts.org.uk/groups/10010867?loc=aberdeen&page=2&slug=1st-Aberdeen-Aberdeen-Grammar-School",
            "cause": [
