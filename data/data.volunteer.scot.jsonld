        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nhtNAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nhtNAAQ/save-the-children",
            "name": "Save the Children",
            "description": "In over 110 countries, we support children to transform their lives. By providing life-saving short-term help, and pushing for deep-rooted social change, we can help children take their future into their own hands.\r\n\r\nWe believe every child has the right learn. Every child should have good food to fuel their bodies and every child should have medicine when they’re sick.  We’re passionate about what we do, and love giving second-hand items a chance of going to a good home. Our volunteers are key to raising vital funds for our work and act as incredible advocates for the rights of children both in the UK and around the world.",
            "website": "https://Savethechildren.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
