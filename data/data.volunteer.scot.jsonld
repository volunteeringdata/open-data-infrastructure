            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000007SUBrAAO",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000007SUBrAAO/youth-befriender-east-fife",
                    "publishStart": "2026-07-15",
                    "publishEnd": "2027-01-13",
                    "title": "Youth Befriender (East Fife)",
                    "description": "## Description\n\nWant to make a difference, and have fun? Can you spare 2 hours a fortnight to support a marginalised young person?\r\n\r\nLINK works with 12-18 year olds who have become isolated due to mental health issues.\r\n\r\nThe in-person, 1 to 1 befriending meetings take place out in the community. This safe, supported timeout helps the young people to increase their wellbeing, resilience, social and relationship skills.\r\n\r\nWhen you meet, and what you do with your befriending time together is left up to you and the young person to decide. It may be a walk, cafe, cinema, bowling, there is a monthly allowance to cover expenses.\n\n## Experience required\n\nExperience required: No special qualifications or experience required.\r\n\r\nDesirable skills - reliability; sense of fun and friendly; kindness; patience; good communication and listening skills; ability to volunteer independently, with regular supervision – over a cuppa and cake.\n\n## Training details\n\nTraining provided: Volunteers receive training; ongoing support and supervision; personal development and social outing opportunities.\n\n## Travel details\n\nThe opportunity takes place in East Fife.\n\n## Travel expenses\n\nTravel and out-of-pocket expenses are paid, up to a set monthly amount.",
                    "requiresEmergencyParticipation": false,
