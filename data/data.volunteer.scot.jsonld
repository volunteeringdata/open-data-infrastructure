            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000008xqSbYAI",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000008xqSbYAI/charity-shop-volunteer-sorter",
                    "publishStart": "2025-03-17",
                    "publishEnd": "2027-02-26",
                    "title": "Charity Shop Volunteer Sorter",
                    "description": "## Summary\n\nTo assist with sorting donated items, tasks will include assessing condition for suitability for sale, \r\nfreshening up all garments deemed suitable for sale by pressing, steaming and/or de-bobbling, \r\nhanging on correct sized hanger on ready for sale rail. \r\n• Set aside any donations deemed unsuitable for sale for onward donation \r\n• To monitor stock and rotate as required \r\n• To maintain health and safety as necessary in sorting room and alert staff and volunteers to any \r\nhazards \r\n• To regularly clean and maintain equipment to ensure it is in good working order, advise staff of \r\nany faults \r\n• To attend a shop induction session and ongoing training where required \r\n• To input into the ongoing development and strategy of The Courtyard Collective – tell us what you \r\nsee and what you feel! \r\n• To observe our confidentiality policy\r\n\r\n• 2 references (1 professional and 1 personal referee who should have known you for at least 1 \r\nyear). Please let us know if there are any issues with this and we will try and help. \r\n• A basic disclosure PVG check as this role will involve you being in contact with vulnerable adults. \r\nThis process can take a few weeks to complete but there’s no reason why you can’t get involved \r\nin the meantime. \r\n• Safe Guarding Training must be attended which will be provided.\n\n## Description\n\nTo work with the TSH staff team and volunteers in The Courtyard Collective Community Charity \r\nShop to become a community asset in tackling poverty and reducing our carbon footprint in the \r\nWestern Isles\n\n## Experience required\n\n• Interested in working with people of all ages from all different walks of life. \r\n• Good listeners and communicators. \r\n• Willing to read and follow the guidance provided about the role and to ask for help from staff \r\nwhere needed. \r\n• To attend volunteer meetings and ongoing training. \r\n• Diligent, with positive aspirations and motivations for volunteering. \r\n• Willing to observe the organisation's guidelines and policies. \r\n• Reliable, patient, kind, sensitive, caring and happy to be part of a team. \r\n• Willing to undertake a PVG check and to provide details of two referees. \r\n• Understanding of the need for and able to keep confidentiality. \r\n• To use TeamUp, our volunteer app, to sign up for volunteering at events.\n\n## Travel details\n\nWe will pay you travel expenses when you submit a completed timesheet each month.  \r\nComplimentary hospitality is provided for volunteers, including snacks and lunches.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000008xqSbYAI#role",
                        "type": "Role",
                        "title": "Charity Shop Volunteer Sorter",
                        "description": "• Interested in working with people of all ages from all different walks of life. \r\n• Good listeners and communicators. \r\n• Willing to read and follow the guidance provided about the role and to ask for help from staff \r\nwhere needed. \r\n• To attend volunteer meetings and ongoing training. \r\n• Diligent, with positive aspirations and motivations for volunteering. \r\n• Willing to observe the organisation's guidelines and policies. \r\n• Reliable, patient, kind, sensitive, caring and happy to be part of a team. \r\n• Willing to undertake a PVG check and to provide details of two referees. \r\n• Understanding of the need for and able to keep confidentiality. \r\n• To use TeamUp, our volunteer app, to sign up for volunteering at events.",
                        "applyLink": "https://volunteer.scot/search/a0gQD000008xqSbYAI/charity-shop-volunteer-sorter?#modal_register_a0gQD000008xqSbYAI",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18"
