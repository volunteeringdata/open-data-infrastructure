        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZRSAA2",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZRSAA2/orkney-citizens-advice-bureau",
            "name": "Orkney Citizens Advice Bureau",
            "description": "Orkney Citizens Advice Bureau (CAB) is independent, and provides free, confidential and impartial advice to anyone living and/or working in the local community. We deliver information, advice and representation covering a wide range of subjects, including:\r\n\r\n- benefits\r\n- debt and money advice\r\n- consumer issues\r\n- housing issues\r\n- neighbour problems\r\n- family and personal problems\r\n- legal matters including eviction, mortgage repossession and small claims\r\n- employment advice\r\n- immigration\r\n- NHS health care\r\n\r\nOur services are delivered by a team of trained volunteers and specialist staff.",
            "website": "https://www.orkneycommunities.co.uk/CAB",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC026265"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F5540363b-2598-9457-1374-b9c05dc907b6%2FBjA8itcPfHQ5QR1dwi2pYnBMdoW2%2Fuser-upload.jpg?alt=media&token=c0142b12-5f63-4442-be3d-945b3abc6bb6",
            "cause": [
