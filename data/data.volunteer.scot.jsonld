        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXgLAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXgLAAU/scottish-ambulance-service-involving-people-network",
            "name": "Scottish Ambulance Service Involving People Network",
            "description": "The Scottish Ambulance Service is on the frontline of the NHS, despatching immediate medical assistance or clinical advice to over 5 million people across Scotland. Our aim is to offer the highest level of care to our patients as we preserve life and promote recovery, with our skilled workforce bringing care and compassion to those who need it most.\r\n\r\nWe provide ambulance care to patients who need support to reach their healthcare appointment, or for their admission to and discharge from hospital, due to their medical or clinical needs.",
            "website": "https://www.scottishambulance.com",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000SsINbAAN",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000SsINbAAN/scottish-ambulance-service-involving-people-network-volunteers",
                    "publishStart": "2026-08-17",
                    "publishEnd": "2027-02-10",
                    "title": "Scottish Ambulance Service Involving People Network Volunteers",
                    "description": "## Description\n\nThe Scottish Ambulance Service Infection Control Committee plays a vital role in ensuring ambulance staff are trained to the highest standards and our vehicles maintained in accordance with national cleanliness specifications. We need a volunteer to provide an independent patient’s perspective to assist in this process. \r\n  \r\n This role will require you to have access to Microsoft Teams and an internet connection. The group meets for four times per year for three hours. Though we cannot pay for attendance, we do pay agreed expenses.   \r\n  \r\nWe pride ourselves on providing a very high standard of care and you could play a key role in helping to maintain these standards. Please get in touch here to apply: https://www.scottishambulance.com/contact-us/involving-people-network/\n\n## Training details\n\nAll volunteers are provided with excellent support and guidance relevant to the role you undertake volunteering.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000SsINbAAN#role",
                        "type": "Role",
                        "title": "Scottish Ambulance Service Involving People Network Volunteers",
                        "applyLink": "https://volunteer.scot/search/a0g0800000SsINbAAN/scottish-ambulance-service-involving-people-network-volunteers?#modal_register_a0g0800000SsINbAAN",
                        "allowsRemoteParticipation": false,
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/HealthHospitalsHospices",
                                "skos:prefLabel": "Health / Hospitals / Hospices"
                            }
                        ],
                        "service": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/NamedContactForVolunteer",
                                "skos:prefLabel": "Named Contact For Volunteer"
                            },
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/WheelchairAccessDisabledAccessToilet",
                                "skos:prefLabel": "Wheelchair Access/Disabled Access Toilet"
                            },
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/NamedContactForVolunteer",
                                "skos:prefLabel": "Named  Contact For Volunteer"
                            },
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/WheelchairAccessDisabledAccessToile",
                                "skos:prefLabel": "Wheelchair Access, Disabled Access Toile"
