        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nWuFAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nWuFAAU/the-ayrshire-community-trust",
            "name": "The Ayrshire Community Trust",
            "website": "https://www.tact.scot",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC028874"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000G974HYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000G974HYAR/volunteer-craft-tutor",
                    "publishStart": "2026-10-07",
                    "publishEnd": "2027-03-29",
                    "title": "Volunteer Craft Tutor",
                    "description": "## Summary\n\nThe Volunteer Craft Tutor will support the delivery of a welcoming and inclusive craft club designed for individuals experiencing isolation and loneliness. Through creative activities, the tutor will help participants build confidence, social connections, and wellbeing.\n\n## Description\n\nThe Volunteer Craft Tutor will support the delivery of a welcoming and inclusive craft club designed for individuals experiencing isolation and loneliness. Through creative activities, the tutor will help participants build confidence, social connections, and wellbeing.\r\n\r\nKey Responsibilities\r\n\r\n· Plan and deliver engaging craft sessions for small groups\r\n\r\n· Facilitate a range of creative activities, such as:\r\n\r\no Painting and drawing\r\n\r\no Sewing, textiles, and knitting\r\n\r\no Using digital crafting tools (e.g. Cricut)\r\n\r\no Upcycling and creative recycling projects\r\n\r\n· Adapt activities to suit different skill levels and abilities\r\n\r\n· Create a friendly, supportive, and inclusive environment\r\n\r\n· Encourage conversation and social interaction among participants\r\n\r\n· Prepare materials and ensure sessions run smoothly\r\n\r\n· Support participants on a one-to-one basis where needed\r\n\r\n· Promote wellbeing through creativity and positive engagement\r\n\r\nSkills & Experience\r\n\r\n· Strong interest or experience in arts, crafts, or creative activities\r\n\r\n· Ability to plan simple, structured craft sessions\r\n\r\n· Confident in facilitating small groups\r\n\r\n· Good communication and interpersonal skills\r\n\r\n· Patient, empathetic, and supportive approach\r\n\r\n· Experience working with vulnerable adults or community groups (desirable but not essential)",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000G974HYAR#role",
                        "type": "Role",
                        "title": "Volunteer Craft Tutor",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000G974HYAR/volunteer-craft-tutor?#modal_register_a0gQD00000G974HYAR",
                        "allowsRemoteParticipation": false
                    },
