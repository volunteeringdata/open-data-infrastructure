        {
            "id": "https://data.volunteer.scot/Organisation/001QD00001BhM9iYAF",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00001BhM9iYAF/golf-in-society-aberdeen-and-surrounding-areas",
            "name": "Golf in Society (Aberdeen and surrounding areas)",
            "description": "At Golf in Society, we run welcoming Golf Health Hubs at local golf clubs — inclusive spaces where people living with long-term conditions, along with carers and families, can move more, connect with others, and rediscover joy.\r\n\r\nNo experience needed — just a place to belong, feel better, and take the first step.",
            "website": "https://golfinsociety.com/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/PhysicalDisability",
