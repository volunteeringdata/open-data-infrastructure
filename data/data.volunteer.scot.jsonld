            "dc:source": "https://volunteer.scot/organisations/00124000008nXW0AAM/canine-concern-scotland-trust",
            "name": "Canine Concern Scotland Trust",
            "description": "Canine Concern Scotland Trust(CCST) established the Therapet Service in 1988, where volunteer members take their registered dogs on a regular basis to visit the elderly, children and people with disabilities in Residential Homes, Day Centres, Hospitals etc. The dogs who must be a year old are assessed for temperament and suitability. The owners have to be members of The Protecting Vulnerable Groups Scheme. In addition, CCST provides an educational service to schools and other bodies to promote responsible dog ownership, runs a 'Reading With Dogs' service and 'Paws Against Stress' a de-stressing service for students.",
            "website": "https://www.canineconcernscotland.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC014924"
                }
            ],
