        {
            "id": "https://data.volunteer.scot/Organisation/0010800002opKC6AAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002opKC6AAM/age-concern-ayr",
            "name": "Age Concern Ayr",
            "description": "Age Concern Ayr is a registered Charity in Scotland dedicated to protecting and promoting the wellbeing of the those aged 55+ in South Ayrshire.\r\nAge Concern Ayr is 100% funded by the Charity Shop and Public Donation and all money raised is used for the benefit of residents in South Ayrshire.\r\nWe have been operating in South Ayrshire since the opening of our Charity Shop in 1975.\r\nVery quickly The Charity Shop proved to be a great success, but something else was needed.\r\nCustomers to the shop were looking for advice on a number of topics ranging from benefits to details on local lunch clubs.\r\nAlthough the shop volunteers at the time dealt with these enquiries as best they could, it was evident that there was a local need for more.\r\nWith funds that had been raised from the Charity Shop it was decided that an Advice & Information Centre would be established and after 13 years of hard work by dedicated Volunteers this was realised in late 1987.",
            "website": "https://ageconcernayr.co.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/OlderPeople",
                    "skos:prefLabel": "Older People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000GvcmaAAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000GvcmaAAB/shop-volunteer",
                    "publishStart": "2021-10-27",
                    "publishEnd": "2027-04-02",
                    "title": "Shop Volunteer",
                    "description": "## Description\n\nMain duties: We would love to find some new people to help in our Crown Street charity shop which is open Monday to Saturday. We have teams of volunteers working each day: receiving, unpacking and pricing donations; helping on the shop floor; and serving customers. Ideally volunteers would be able to commit to a full day each week, but even half a day would be welcome.\n\n## Experience required\n\nEasy to communicate with, able to work on own initiative and able to follow instructions.\n\n## Training details\n\n-\tMentoring, there is always a companion volunteer.\r\n-\tInformal meetings to update people on requirements, any changes, etc.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fc2f6d80b-2a85-3900-5e50-93a091f74627%2FXiQTI9rs8XhdfYu2EPhcBTs4his2%2Flisting.jpg?alt=media&token=ea4e6acb-6e3d-4573-87e9-a395203227ce",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000GvcmaAAB#role",
                        "type": "Role",
                        "title": "Shop Volunteer",
                        "description": "Easy to communicate with, able to work on own initiative and able to follow instructions.",
                        "applyLink": "https://ageconcernayr.co.uk/contact-us/",
                        "allowsRemoteParticipation": false,
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/Elderly",
                                "skos:prefLabel": "Elderly"
                            },
