        {
            "id": "https://data.volunteer.scot/Organisation/0012400000ccJXfAAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000ccJXfAAM/generations-working-together",
            "name": "Generations Working Together",
            "description": "Generations Working Together is the nationally recognised centre of excellence supporting the development and integration of intergenerational work across Scotland.\r\n\r\nGWT’s vision is to live in a Scotland where different generations are more connected and everyone has the opportunity to build relationships that help to create a fairer society.",
            "website": "http://generationsworkingtogether.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC045851"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityEngagement",
                    "skos:prefLabel": "Community Engagement"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000E8P64YAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000E8P64YAF/intergenerational-community-connector",
                    "publishStart": "2025-12-18",
                    "publishEnd": "2027-01-20",
                    "title": "Intergenerational Community Connector",
                    "description": "## Description\n\nJoin GWT as we work towards a Scotland where generations are more connected. If you would like to get involved in intergenerational work, learn more about the practice, and help strengthen community connections across the Highlands, this could be the perfect volunteer role for you!\r\n\r\nAs an intergenerational Community Connector, key duties include:\r\n- Help one of our development team members plan and run 2-3 local network meetings each year\r\n- Spread the word about the benefits of intergenerational work within your community\r\n- Share and promote GWT events, meetings, publications and training opportunities \r\n- Connect with local groups and encourage them to showcase their intergenerational projects through the network and GWT\n\n## Training details\n\nInduction of the role from GWT\r\nOne to one support with a named GWT employee\r\nFree access to a wide range of training, both online and in-person to develop greater knowledge and understanding of intergenerational practice",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fdf7c3b68-174e-47b7-b373-0f5e6e374cae%2FJqK8q7mcUtcgywKvmhEW9RRQbgy1%2Flisting.jpg?alt=media&token=0a6a0072-a7cc-40b7-9d84-c5cf1287c0ff",
