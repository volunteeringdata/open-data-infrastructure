            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000006NzycYAC",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000006NzycYAC/telephone-befriender-with-someone-living-with-parkinsons",
                    "publishStart": "2024-10-29",
                    "publishEnd": "2027-02-10",
                    "title": "Telephone Befriender with someone living with Parkinson's",
                    "description": "## Description\n\nAre you a kind and empathetic person who likes a chat? Could you volunteer and make someone’s day brighter from the comfort of your own home and flexibly suited to your schedule?\r\nWe’re working with Parkinson’s UK to offer older people with Parkinson’s, and the people who care for them, a telephone befriending service. Living with Parkinson’s, or caring for someone who does, can feel isolating. But you can help someone with just 30 minutes of your time.\r\nA regular chat with someone who just wants someone to listen. You will be matched with an Older Person and make weekly or fortnightly calls depending on your availability and preferences. Parkinson’s does not normally affect speech or memory and is a physical condition. People who are living with Parkinson’s may find leaving the house difficult but are still looking for social company in a way that is accessible.\n\n## Training details\n\nFull online training provided as well as access to online library of training. Full support team for volunteers as well.\n\n## Frequency commitment details\n\n0.5 hours per week",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fe44ecb31-2211-41a1-90d0-80e9e4020cee%2FWkLzgT1VE9cAHEWcVMpdVMd5bL63%2Flisting.jpg?alt=media&token=bad0a02d-21e2-4a85-b50d-05508f96af5c",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000006NzycYAC#role",
