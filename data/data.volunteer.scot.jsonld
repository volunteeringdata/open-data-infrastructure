            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000Hw6rFYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000Hw6rFYAR/sound-engineertechnician",
                    "publishStart": "2026-08-25",
                    "publishEnd": "2027-02-15",
                    "title": "Sound Engineer/Technician",
                    "description": "## Description\n\nWe are looking for a Sound Engineer/Technician on an ad-hoc volunteer basis.\r\n\r\nWhat you'll be doing:\r\n- Studio Support: Help maintain and organise our studio equipment to keep everything running smoothly\r\n- Troubleshoot and problem solve; Use your technical skills to diagnose issues and find solutions\r\n-Equipment Maintenance: Carry out checks, updates and general maintenance of our audio equipment\r\n- On call support; Be available on an ad-hoc basis to support with urgent issues, upgrades or special projects\r\n\r\nInterested? Get in touch! Email us at; ahrwithlaura@gmail.com\n\n## Experience required\n\nNo previous hospital radio experience required.\r\nWhat we are looking for:\r\n- Experience with audio equipment and studio systems\r\n- Good problem solving and technical skills\r\n- Reliable and happy to help when needed\r\n- A positive team player attitude\r\n- Based in Ayrshire or nearby (happy to discuss)",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F4edb3d5e-daaa-4fbf-b979-094e9f0633d1%2FHRS7DIGy6maeRWl51qNGz1KT6f23%2Flisting.jpg?alt=media&token=2ae7a011-c29f-4879-8087-001a23e47fb7",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000Hw6rFYAR#role",
                        "type": "Role",
                        "title": "Sound Engineer/Technician",
                        "description": "No previous hospital radio experience required.\r\nWhat we are looking for:\r\n- Experience with audio equipment and studio systems\r\n- Good problem solving and technical skills\r\n- Reliable and happy to help when needed\r\n- A positive team player attitude\r\n- Based in Ayrshire or nearby (happy to discuss)",
                        "applyLink": "https://www.ayrhospitalradio.co.uk/volunteer-with-us",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
