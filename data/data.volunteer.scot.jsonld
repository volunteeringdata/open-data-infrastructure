        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXfSAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXfSAAU/aberdeen-city-council-countryside-rangers-service",
            "name": "Aberdeen City Council - Countryside Rangers Service",
            "description": "Aberdeen City Council Countryside Ranger Service is committed to working for a biodiverse, best value and socially inclusive future for all the City's countryside resources. It works in partnership to offer quality environmental education and recreational opportunities for all.",
            "website": "https://www.facebook.com/Aberdeen-City-Council-Countryside-Ranger-Service-280078812133223/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EnvironmentRecycling",
