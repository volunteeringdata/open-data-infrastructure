        {
            "id": "https://data.volunteer.scot/Organisation/0012400000QpXukAAF",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000QpXukAAF/marie-curie-scotland",
            "name": "Marie Curie (Scotland)",
            "description": "We provide care and support for people living with any terminal illness, and their families. Every day of your life matters, from the first to the last. We believe everyone living with a terminal illness should be able to get the most from the time they have left, however hard that may sometimes feel. We'll be here for you and your family when you may feel like no-one else is, to help you cope when you don't know how. Marie Curie Nurses care for you in your home, when you need them most, day or night. Our hospices are at the heart of communities around the UK. And our trained volunteers and advisers are here for you with practical information and support when you don't know what to do next or just need to talk. We'll be by your side with care and support every step of the way, bringing light in the darkest hours.",
            "website": "https://www.mariecurie.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038731"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000009bTU6YAM",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000009bTU6YAM/marie-curie-retail-volunteer-portobello",
                    "publishStart": "2025-04-23",
                    "publishEnd": "2027-01-31",
                    "title": "Marie Curie Retail Volunteer Portobello",
                    "description": "## Summary\n\nWhat You'll Do:\nTreasure Hunting: Dive into donations to uncover hidden gems and high-quality brands.\nPreparation: Check, hang, steam, size and price items to get them ready for sale.\nCustomer Service: Engage with shoppers on the shop floor, providing excellent service.\n\n## Description\n\nJoin our team at the Marie Curie Store in Portobello Edinburgh! Are you passionate about making a difference in your community? Our Marie Curie charity shop in Portobello is looking for enthusiastic volunteers aged 18 and over to join our vibrant team. By donating your time, you'll help us raise crucial funds that support our nurses in providing care to terminally ill people and their families.\n\n## Travel details\n\n162 Portobello High Street, Edinburgh, EH15 1AH \nView on Google Maps.\n\n## Travel expenses\n\nNo expenses.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000009bTU6YAM#role",
