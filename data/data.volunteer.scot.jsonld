                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000I2YfxYAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000I2YfxYAF/volunteer-befriender",
                    "publishStart": "2026-09-18",
                    "publishEnd": "2027-03-19",
                    "title": "Volunteer Befriender",
                    "description": "## Description\n\nBefriending is designed for children aged 5 – 16 years old who are facing difficult life circumstances.\r\n\r\nChildren can be referred to our befriending programme by education, social work, health professionals or third-sector partners for a number of reasons including a lack of a positive adult role model, child or parent mental health, abuse or neglect, parental alcohol or substance use, social isolation and more. \r\n\r\nBefrienders meet with their befriendees twice a month for a couple of hours each time for a minimum of one year to take part in fun activities to help them increase their confidence and self-esteem, learn new skills, reduce their social isolation and show them more of what life has to offer.\n\n## Travel expenses\n\nA monthly allowance to cover expenses",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F644f9e6f-0b23-4aba-a5a5-1bffcf022cb2%2FWCWlmACEQ1Nry2jeILPqzwR6TLb2%2Flisting.jpg?alt=media&token=c2d816f0-9f9c-4254-bb23-5b2e47b8fb6a",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000I2YfxYAF#role",
                        "type": "Role",
                        "title": "Volunteer Befriender",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000I2YfxYAF/volunteer-befriender?#modal_register_a0gQD00000I2YfxYAF",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "19",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/Children",
                                "skos:prefLabel": "Children"
                            }
                        ]
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
