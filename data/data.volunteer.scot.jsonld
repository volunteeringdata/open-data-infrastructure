                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000I1wHJYAZ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000I1wHJYAZ/community-volunteer",
                    "publishStart": "2026-09-16",
                    "publishEnd": "2027-03-17",
                    "title": "Community Volunteer",
                    "description": "## Description\n\nWe support 20 West Lothian based groups.\r\nThe requirement is to attend one or more groups on a weekly or fortnightly basis.  Your support and encouragement could help an older person to:\r\n• Remain socially connected and engaged\r\n• Reduce feelings of loneliness and isolation\r\n• Remain active and independent and make new friends\r\n• Increase self-confidence \r\n• Empower attendees to lead activities in their local area \r\n• Create links with the local community\r\n\r\nExamples of activities undertaken include:\r\n• Planning and leading activity delivery\r\n• Assistance in the setting up and tidying away pre and post group/event\r\n• Chatting to group members ensuring they are made to feel welcome \r\n• Ensuring activities are inclusive for all attendees \r\n• Encourage and empower attendees and volunteers\r\n• Assisting with refreshments \r\n• Liaising with OPAL staff to keep them updated of group attendance, feedback, quotes and photos\n\n## Experience required\n\n• Good at listening and engaging with people\r\n• Friendly and easy to approach\r\n• Reliable with good time keeping\r\n• Patient and empathetic\r\n• Respectful of confidentiality and do not judge\r\n• Flexible to the needs and ability of others\r\n• Able to work within set boundaries",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000I1wHJYAZ#role",
                        "type": "Role",
                        "title": "Community Volunteer",
                        "description": "• Good at listening and engaging with people\r\n• Friendly and easy to approach\r\n• Reliable with good time keeping\r\n• Patient and empathetic\r\n• Respectful of confidentiality and do not judge\r\n• Flexible to the needs and ability of others\r\n• Able to work within set boundaries",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000I1wHJYAZ/community-volunteer?#modal_register_a0gQD00000I1wHJYAZ",
