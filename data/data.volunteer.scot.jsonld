        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002igusWAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002igusWAAQ/camphill-school-aberdeen",
            "name": "Camphill School Aberdeen",
            "description": "*Our Mission:\r\nTo create a community where children and adults feel a sense of belonging, support and personal growth. A place where there is an inclusive, lifelong learning culture with an integrated approach to health, education and care.\r\n\r\n*Our Vision:\r\nTo be recognised as a centre of excellence where children and adults can live, learn and work in an integrated community based on mutual respect and the unfolding of individual potential.\r\n \r\n*Our Ethos:\r\nWe are committed to treating everyone with respect and dignity to enable them to discover their potential. We use a social pedagogical approach which is informed by the understanding of a spiritual dimension in each individual and integrates education, care, crafts and therapy to create a holistic response to the needs of individuals.\r\n\r\nWe strengthen our community through social integration in the celebration of personal achievements and cultural life. We are committed to caring for the land and strive to use the environment in the most sustainable way to support and enhance a healthy lifestyle.\r\n\r\nWe seek to further develop a living and working community based on equality of rights and opportunities, collaboration, freedom and empowering, respectful relationships. We have an active engagement with the wider society, facilitating a mutually beneficial flow of information and learning.\r\n\r\nWe are a community in which people can feel safe and nurtured and in which we all work towards a future where people with additional support needs are fully included and respected in society.",
            "website": "https://www.camphillschool.org.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/LearningDisability",
                    "skos:prefLabel": "Learning Disability"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/PhysicalDisability",
                    "skos:prefLabel": "Physical Disability"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SensoryImpairment",
                    "skos:prefLabel": "Sensory Impairment"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SocialCare",
                    "skos:prefLabel": "Social Care"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
                    "skos:prefLabel": "Volunteering"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/YoungPeople",
                    "skos:prefLabel": "Young People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g1p00000Nde3uAAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g1p00000Nde3uAAB/voluntary-coworkers-within-residential-school-and-care-homes",
                    "publishStart": "2026-08-17",
                    "publishEnd": "2027-02-15",
                    "title": "Voluntary Coworkers within Residential School and Care Homes",
                    "description": "## Description\n\nAs a Voluntary Co-worker you will become part of a team within one of our 10 residential Care homes, set in beautiful surroundings 5 miles outside of Aberdeen City centre and close to the Deeside Railway line.\r\n\r\nThe opportunity does not require you to have previous experience, we just ask that you are caring, patient and willing to help our pupils, have an interest in people and different ways of communications.\r\n\r\nOur pupils age from 12-25 years old and as part of your position, you will be with them when they attend the school, farm and gardens, workshops or even riding stables as part of their personalised daily routines and assist them with their tasks throughout the day.\r\n\r\nTraining provided in induction and support given throughout the volunteering time within Camphill School Aberdeen. \r\n\r\nA fantastic opportunity to help with all assistance making a real difference and greatly appreciated.\r\n\r\nFor more details please contact Naomi Paton, Recruitment Administrator at E Mail: n.paton@crss.org.uk or tel.: 01224 866162.\n\n## Experience required\n\nNo previous experience needed. Just patience, compassion, a bit of elbow grease and team spirit required.\n\n## Training details\n\nExcellent support and relevant training is provided to all volunteers. \r\nInduction training comprises of first aid, manual handling and a vulnerable groups session.\r\nThroughout volunteering support by House Manager and Deputy House Manager. Further training given – BSS (Behavioural Support Strategies) and house/pupil dependant, Epilepsy training and/or Hoist training is given.\n\n## Frequency commitment details\n\nFlexible times available. All help greatly appreciated.\n\n## Travel details\n\nThe opportunity happens throughout our Camphill School Aberdeen estates- Camphill estate, Murtle estate and Cairnlee Estate.\r\n \r\nThere is the Deeside railway line for keen cyclists and reliable bus routes, both with first and stagecoach (Numbers 19, 201 and 202) that can take you within a minute of the door.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g1p00000Nde3uAAB#role",
                        "type": "Role",
                        "title": "Voluntary Coworkers within Residential School and Care Homes",
                        "description": "No previous experience needed. Just patience, compassion, a bit of elbow grease and team spirit required.",
                        "commitment": "Flexible times available. All help greatly appreciated.",
                        "applyLink": "https://volunteer.scot/search/a0g1p00000Nde3uAAB/voluntary-coworkers-within-residential-school-and-care-homes?#modal_register_a0g1p00000Nde3uAAB",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
