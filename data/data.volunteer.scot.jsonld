        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002e1GueAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002e1GueAAE/who-cares-scotland",
            "name": "Who Cares? Scotland",
            "description": "Who Cares? Scotland is a national organisation for care experienced children and young people. We provide advocacy and participation opportunities and are confidential, professional and independent - this is crucial as it ensures that there is no conflict of interest. \r\n\r\nWe deliver services in most local authority areas in Scotland working with young people, to help them have a say in what is happening to them. Our advocacy support helps young people feel respected, included, listened to and understood. \r\n\r\nWe believe independent advocacy should be available to care experienced people as a lifelong offer via our helpline.",
            "website": "https://www.whocaresscotland.org/",
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2Fe6c6d4f4-a1d8-0137-2c48-b3104f527aeb%2F3uVZwq4G6wPp4T1RmlCOJnO1IX52%2Fuser-upload.jpg?alt=media&token=08a5f6cf-c871-4ddb-8a80-91456e91039e",
