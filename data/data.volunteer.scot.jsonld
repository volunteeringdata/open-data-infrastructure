            "id": "https://data.volunteer.scot/Organisation/00124000008nXbVAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXbVAAU/kilbryde-hospice",
            "name": "Kilbryde Hospice",
            "description": "Kilbryde Hospice is a voluntary independent hospice which exists to provide specialist palliative care to patients with life limiting progressive illnesses, and to their relatives and carers. Services provided by Kilbryde Hospice are available to those people with palliative care needs. \nKilbryde Hospice have an in patient unit, Day Services, Drop In, Out patient services, CLAN (formerly Care@Home) carers and family services, wellbeing, and spiritual care.",
            "website": "https://kilbrydehospice.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC032424"
                }
            ],
            "cause": [
                {
