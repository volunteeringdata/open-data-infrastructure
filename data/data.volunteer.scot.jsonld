        {
            "id": "https://data.volunteer.scot/Organisation/001QD000002Rrv7YAC",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000002Rrv7YAC/pet-fostering-services-scotland-south-ayrshire",
            "name": "Pet Fostering Services Scotland (South Ayrshire)",
            "website": "https://www.pfss.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC015672"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000007c3lYAA",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000007c3lYAA/animal-foster-carer",
                    "publishStart": "2023-10-17",
                    "publishEnd": "2027-04-29",
                    "title": "Animal Foster Carer",
                    "description": "## Description\n\nPet Fostering Service Scotland provide short term care for pets, when their owner is unable to do so through illness, homelessness or domestic abuse and cannot arrange any alternative care.\r\nWe are looking for volunteer foster carers for these pets who would be responsible for meeting the daily needs of the pets in your care, including feeding, cleaning, grooming, exercising and socialising until the pet is returned to its owner. Pet costs such as food and veterinary fees will be met by the owner.\n\n## Experience required\n\nWe are looking for volunteers who have previous experience of pet ownership and pet care. You must have a concern for animal welfare and willingness to follow our procedures. You must have previous experience of caring for the type of animal that you wish to foster.\n\n## Training details\n\nYou will have an induction carried out by an area organiser.\n\n## Travel details\n\nThe only travel required might be to collect an animal at a hand over point.\n\n## Travel expenses\n\nOut of pocket expenses will be paid if required.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F06ad2fa0-e955-4646-8f8f-f55fe9f8dfba%2F0nFCUqNjeiXPIFO483j0BVWArU43%2Flisting.jpg?alt=media&token=18b218ac-74d9-4686-8bd2-e5b68207fe41",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD0000007c3lYAA#role",
                        "type": "Role",
                        "title": "Animal Foster Carer",
                        "description": "We are looking for volunteers who have previous experience of pet ownership and pet care. You must have a concern for animal welfare and willingness to follow our procedures. You must have previous experience of caring for the type of animal that you wish to foster.",
