        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nfA9AAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nfA9AAI/rspb-scotland-orkney",
            "name": "RSPB Scotland (Orkney)",
            "description": "RSPB Scotland manage 12 stunning nature reserves in Orkney. They include spectacular sea-cliffs, wonderous wetlands and tranquil heather moorlands, supporting iconic wildlife such as hen harriers, puffins and the Orkney vole.  Our reserves and 4 birdwatching hides are open to visitors year-round. \r\n\r\nRSPB Scotland is part of the RSPB, the UK’s largest nature conservation charity, inspiring everyone to give nature a home. Together with our partners, we protect threatened birds and wildlife so our towns, coast and countryside will teem with life once again. We play a leading role in Birdife International, a worldwide partnership of nature conservation organisations.",
            "website": "https://www.rspb.org.uk/orkney",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC037654"
