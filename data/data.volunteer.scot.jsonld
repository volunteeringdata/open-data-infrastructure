            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000008fqnYAA",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000008fqnYAA/volunteer-youth-work-assistant",
                    "publishStart": "2023-10-20",
                    "publishEnd": "2027-01-31",
                    "title": "Volunteer Youth Work Assistant",
                    "description": "## Summary\n\nA great opportunity to help with our fun Friday night youth club!\n\n## Description\n\nYour role will be to assist with our Friday night youth club.  Your main duties will include building positive relationships with the young  people (8 to 11 years), helping with arts and crafts, playing games and prepping some food.\n\n## Experience required\n\nGood communication skills. Some experience working with children (can be informal). Friendly and positive manner. Must be PVG checked.\n\n## Training details\n\nSenior Youth Worker will lead you through induction process.\n\n## Frequency commitment details\n\n4.00-6.30 pm.\n\n## Travel details\n\nAddress: 79-89 Broomhouse Cres, Edinburgh EH11 3RH.\n\n## Travel expenses\n\nNo expenses.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD0000008fqnYAA#role",
