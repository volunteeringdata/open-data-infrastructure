                    }
                },
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000VhvHHAAZ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000VhvHHAAZ/volunteer-tea-party-driver",
                    "publishStart": "2026-11-12",
                    "publishEnd": "2027-04-09",
                    "title": "Volunteer Tea Party Driver",
                    "description": "## Description\n\nCould you spare a few hours each month to help an older person enjoy an afternoon of friendship and conversation?\r\n\r\nRe-engage is looking for friendly, reliable volunteer drivers to help older people experiencing loneliness or social isolation attend regular local tea parties.\r\n\r\nAs a Volunteer Tea Party Driver, you'll use your own car to collect one or two older guests, take them to a local tea party and return them home safely afterwards.\r\n\r\nBut this role is about much more than driving.  You'll stay at the tea party, join in the conversation, help serve refreshments and build friendships with the older guests and fellow volunteers.\r\n\r\nOver time, you'll get to know the people you support, helping them feel connected, included and valued.\r\n\r\nWhat will you be doing?\r\n* Collecting one or two older guests from their homes and driving them to a local Re-engage tea party\r\n* Returning guests home safely after the gathering\r\n* Staying at the tea party to chat, share stories and help create a welcoming atmosphere\r\n* Helping serve refreshments and offering practical assistance where appropriate\r\n* Liaising with the group co-ordinator about collection arrangements, guest needs and event details\r\n* Following Re-engage's training, safeguarding and safety guidance\r\n* Reporting any concerns or issues to your group co-ordinator\n\n## Travel details\n\nNewton Mearns, Neilston, Barrhead, Clarkston and Paisley.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F59564041-5ef2-4b0b-bf7f-9ba4d53436ea%2FD5Fkl21abnNxZzKb66uMENQLQQn2%2Flisting.jpg?alt=media&token=2f05ddc4-7dda-48f8-89a9-35d9040f1e1d",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000VhvHHAAZ#role",
                        "type": "Role",
                        "title": "Volunteer Tea Party Driver",
                        "applyLink": "https://volunteer.scot/search/a0g0800000VhvHHAAZ/volunteer-tea-party-driver?#modal_register_a0g0800000VhvHHAAZ",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "21",
