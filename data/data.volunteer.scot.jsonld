        {
            "id": "https://data.volunteer.scot/Organisation/0012400001BdcUtAAJ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400001BdcUtAAJ/caps-independent-advocacy",
            "name": "CAPS Independent Advocacy",
            "description": "CAPS is an independent advocacy organisation for people with mental health issues,\r\nled by people with mental health issues.",
            "website": "https://www.capsadvocacy.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC021772"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Advocacy",
                    "skos:prefLabel": "Advocacy"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/MentalHealth",
                    "skos:prefLabel": "Mental Health"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HefvWYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HefvWYAR/neurological-conditions-collective-advocacy",
                    "publishStart": "2026-07-07",
                    "publishEnd": "2027-01-05",
                    "title": "Neurological Conditions Collective Advocacy",
                    "description": "## Description\n\nDo you have a neurological condition?\r\nDo you live in Edinburgh or the Lothians or access social care services there?\r\nYou can get involved in this Collective Advocacy project to have your voice heard. You’ll meet like-minded people and help make sure that people with neurological conditions have their say about the provision of social care services.\r\n\r\n\r\nThis is a Collective Advocacy project that will help you to express your views, wishes and lived experience. Your voice will help to improve social care services for people with neurological conditions and increase understanding and information about living with these conditions.\r\n\r\nBeing involved will also help you to increase your awareness and understanding of your rights and options. People who participate in Collective Advocacy at CAPS value the sense of community and purpose it creates and how it helps to reduce isolation.\r\n\r\n\r\nBy getting involved you will meet with others who have neurological conditions in East Lothian, Midlothian, West Lothian or City of Edinburgh, in-person or online, whichever suits you best.\n\n## Experience required\n\nComputer / IT / Web No specialist skills are required but you must have your own lived experience of a neurological condition.\n\n## Frequency commitment details\n\nCommitment Flexible 1 Hours, Fortnightly",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HefvWYAR#role",
