            "dc:source": "https://volunteer.scot/organisations/00124000008nbQLAAY/parkinsons-uk-aberdeen",
            "name": "Parkinsons UK (Aberdeen)",
            "description": "Parkinson's UK are working to find a cure and improve life for everyone affected by Parkinson's. We offer information, friendship and support to local people with Parkinson's, their families and carers.",
            "website": "http://www.parkinsons.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC037554"
                }
            ],
            "cause": [
                {
