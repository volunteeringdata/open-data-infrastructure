        {
            "id": "https://data.volunteer.scot/Organisation/0012400000P55YhAAJ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000P55YhAAJ/greyhope-bay",
            "name": "Greyhope Bay",
            "description": "Greyhope Bay has bold and exciting plans to deliver a new, world class visitor and marine education centre for Aberdeen, creating a unique platform to view the city’s most charismatic visitors – dolphins! Dolphins are regularly spotted at the site we have identified making it one of the best places in Europe to see dolphins from the shore.\r\n\r\nBuilt at Greyhope Bay, the centre will aspire to be transformational for Aberdeen, a signature project that will act as a catalyst to establish the city as an international tourist destination promoting its unique coastal location, exciting marine wildlife and status as an international hub for marine research.",
            "website": "http://www.greyhopebay.org.uk/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Employment",
