        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nY6TAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nY6TAAU/cyrenians-opal-west-lothian",
            "name": "Cyrenians OPAL West Lothian",
            "description": "Cyrenians mission is to support people excluded from family, home, work or community on their life journey. Cyrenians is a registered SCIO  (number SC011052) with an outstanding track record in pioneering creative solutions to the contemporary problems faced by people on the margins of society, such as: homelessness, loneliness, isolation, hunger, poverty, unemployment, or recovery from addiction. \r\n \r\nThe name Cyrenians comes from the biblical story of Simon the Cyrene but Cyrenians was founded as and remains a secular organisation.\r\n \r\nFor more information on Cyrenians visit: http://cyrenians.scot",
            "website": "http://cyrenians.scot",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC011052"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F34ca456a-56cd-1a85-8bd1-5076dcf54456%2F7q8SDjwvwFOdhTumfNccBbyYZEv1%2Fuser-upload.jpg?alt=media&token=56b1937f-5916-4b2a-a7a4-a6960d55bc17",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000I1wNlYAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000I1wNlYAJ/digital-support-volunteer",
                    "publishStart": "2026-09-16",
                    "publishEnd": "2027-03-17",
                    "title": "Digital Support Volunteer",
                    "description": "## Description\n\nTeaching and providing the wisdom and knowledge associated with using digital devices. This includes but not limited to tablets, phones and laptops. \r\nThrough short weekly sessions, support and encouragement can help clients to:\r\n• Understand the basics of using their chosen device\r\n• Undertake specific online tasks such as email, joining online groups, liaising with health professionals, undertaking online shopping and using search engines\r\n• Feel connected and engaged \r\n• Reduce feelings of loneliness, isolation and vulnerability\r\n\r\nThis support can be provided in our Bathgate Hub or at home for those clients unable to travel to the Hub.\n\n## Experience required\n\n• Good at listening and engaging with people\r\n• Friendly and easy to approach\r\n• Reliable with good time keeping\r\n• Patient and empathetic\r\n• Respectful of confidentiality and do not judge\r\n• Flexible to the needs and ability of others\r\n• Able to work within set boundaries\r\n• Able to keep accurate visit records and feed back to the team regularly",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000I1wNlYAJ#role",
                        "type": "Role",
                        "title": "Digital Support Volunteer",
                        "description": "• Good at listening and engaging with people\r\n• Friendly and easy to approach\r\n• Reliable with good time keeping\r\n• Patient and empathetic\r\n• Respectful of confidentiality and do not judge\r\n• Flexible to the needs and ability of others\r\n• Able to work within set boundaries\r\n• Able to keep accurate visit records and feed back to the team regularly",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000I1wNlYAJ/digital-support-volunteer?#modal_register_a0gQD00000I1wNlYAJ",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
