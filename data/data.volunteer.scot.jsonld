            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000000eGnbAAE",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000000eGnbAAE/radio-presenter",
                    "publishStart": "2026-09-07",
                    "publishEnd": "2027-03-01",
                    "title": "Radio Presenter",
                    "description": "## Summary\n\nTo attend meetings & training, prepare all aspects of a radio show, work in conjunction with producers, assist in pre-recording jingles, present a live show timetabled within the 3TFM broadcast schedule, abide by all legal issues relating to radio broadcast and carry out administrative duties as required\n\nThe length of time for volunteering commencement can vary as per a phone call on 15/01/08 - BC\n\n## Description\n\nTo attend meetings & training, prepare all aspects of a radio show, work in conjunction with producers, assist in pre-recording jingles, present a live show timetabled within the 3TFM broadcast schedule, abide by all legal issues relating to radio broadcast and carry out administrative duties as required\n\n## Experience required\n\nAn interest in radio/media is essential, as is a clear speaking voice and an interest in local issues and music.  No previous experience is required as full training will be provided.  Demo tape must be supplied, tape can be made using 3TFM equipment.\n\n## Travel details\n\nThe Focus Adult Learning Centre, Primrose Place, Saltcoats",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g24000000eGnbAAE#role",
                        "type": "Role",
                        "title": "Radio Presenter",
                        "description": "An interest in radio/media is essential, as is a clear speaking voice and an interest in local issues and music.  No previous experience is required as full training will be provided.  Demo tape must be supplied, tape can be made using 3TFM equipment.",
                        "applyLink": "https://volunteer.scot/search/a0g24000000eGnbAAE/radio-presenter?#modal_register_a0g24000000eGnbAAE",
                        "allowsRemoteParticipation": false,
