        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXPHAA2",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXPHAA2/pets-as-therapy",
            "name": "Pets As Therapy",
            "description": "The organisation provides therapeutic visits to hospitals, hospices, nursing and care homes, special needs schools and a variety of other venues by volunteers with their own friendly, temperament tested and vaccinated dogs and cats. There are currently over 4,500 active P.A.T. visiting dogs and 108 P.A.T. cats at work in the UK.",
            "website": "http://www.petsastherapy.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038910"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Carers",
                    "skos:prefLabel": "Carers"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
