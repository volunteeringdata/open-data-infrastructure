        {
            "id": "https://data.volunteer.scot/Organisation/0011p00001hYdxMAAS",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00001hYdxMAAS/lanark-community-development-trust",
            "name": "Lanark Community Development Trust",
            "description": "Lanark Community Development Trust is a charitable, non-profit body which carries out projects for the common good. It is an independent, volunteer-led organisation which is part of a growing network of Development Trusts which exist across Scotland and the UK. Here in Lanark, they  aspire to develop and deliver priority community projects which have a social, environmental and economic impact. They do not and will not deliver on the responsibilities of statutory authorities, but rather seek to add value to existing activity.\nCurrent projects include Castlebank Horticultural Centre, DEadmans Lane, Wallace House gap site and the Clydesdale Horse sculpture.",
            "website": "https://lanarktrust.co.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC040584"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g1p00000CNjZMAA1",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g1p00000CNjZMAA1/community-gardening-volunteer",
                    "publishStart": "2026-09-21",
                    "publishEnd": "2027-03-20",
                    "title": "Community Gardening Volunteer",
                    "description": "## Summary\n\nLanark Community Development Trust are a charitable, non-profit body which carries out projects for the common good of the Lanark area. The Trust aims to develop and deliver priority community projects which have a social, environmental and economic impact.\n\n## Description\n\nAre you interested in growing local produce, greening your fingers and learning new skills? \nCome along to Castlebank Horticultural Centre on Tuesdays and Thursdays from 9am - 3pm to join our volunteers in some gardening work. Meet new people, learn new skills and enjoy some fresh air with a cuppa and a chat! Volunteers are welcome to come along for a couple of hours or the full day. All equipment and tools will be provided, just wear some comfy clothes and sensible shoes. \nAll ages welcome, children under 16 should be accompanied by a parent / guardian.\nPlease note this opportunity has no time limits for applying and is an open opportunity any dates shown are for admin purposes only\n\n## Experience required\n\nNo Expertise, Creative,Hard Working,Practical,Reliable / Dependable,Team Player,\n\n## Frequency commitment details\n\nFlexible to suit.\n\n## Travel details\n\nThe opportunity takes place at multiple location across South Lanarkshire \nLanark",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g1p00000CNjZMAA1#role",
                        "type": "Role",
                        "title": "Community Gardening Volunteer",
                        "description": "No Expertise, Creative,Hard Working,Practical,Reliable / Dependable,Team Player,",
                        "commitment": "Flexible to suit.",
                        "applyLink": "https://volunteer.scot/search/a0g1p00000CNjZMAA1/community-gardening-volunteer?#modal_register_a0g1p00000CNjZMAA1",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/Environment",
                                "skos:prefLabel": "Environment"
                            }
                        ],
                        "service": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/NamedContactForVolunteer",
                                "skos:prefLabel": "Named Contact For Volunteer"
                            }
                        ]
                    },
                    "session": {
                        "type": "Session",
