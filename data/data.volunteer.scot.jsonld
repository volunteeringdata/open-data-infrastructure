            "dc:source": "https://volunteer.scot/organisations/0010800002opQyNAAU/dalkeith-thistle-community-football-club",
            "name": "Dalkeith Thistle Community Football Club",
            "description": "To provide football for boys and girls, from walking to 19 year’s old. To provide enjoyment and personal development opportunities for all",
            "website": "https://www.dalkeiththistlecfc.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
