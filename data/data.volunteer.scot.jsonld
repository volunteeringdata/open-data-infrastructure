        {
            "id": "https://data.volunteer.scot/Organisation/00124000008naudAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008naudAAA/cobhair-bharraigh",
            "name": "Cobhair Bharraigh",
            "description": "To relieve stress on the persons or families caring for the elderly or people with physical, mental or sensory impairment.\r\nTo care in approppriate circumstances for the elderly or people with physical, mental or sensory impairement who are living alone.\r\nTo enable people, if they wish , to remain in their own home as long as possible.\r\nTo provide information and support for those in crisis, their carers and dependents.\r\nTo raise awarenes of about all aspect of Dementia. \r\nTo provide support for people with Dementia and those who care for them.\r\nTo provide specialised day care for people with dementia.\r\nTo liase with other agencies in the provision of care for all service users.\r\nTo continue to provide a person centered care focusing on each individual client needs.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC032278"
                }
            ],
            "cause": [
