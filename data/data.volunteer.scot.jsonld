            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000VhvaxAAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000VhvaxAAB/volunteer-minibus-drivers",
                    "publishStart": "2023-04-25",
                    "publishEnd": "2027-01-04",
                    "title": "Volunteer Minibus Drivers",
                    "description": "## Description\n\nFriends of Hillcrest is a charity group ran by many volunteers to support Hillcrest Care home in Girvan. \r\n\r\nWe are looking for people who would go on a rota to join our minibus drivers team. With our minibus service we try to provide the residents of Hillcrest transport to and from hospital appointments but also to get out and about on day trips to sight see, build relationships, make memories, reminisce old places, support mental health and generally to provide different experiences for all residents.\r\n\r\nYou do not need to commit to weekly, monthly days or dates it’s as and when you are available. \r\n\r\nIf this is something you may be interested in, please get in touch to find out how you can help, join our fantastic team of volunteers and make a real difference at Hillcrest.\r\n\r\nMiDAS (Minibus Driving Awareness Scheme) training would have to be carried out but full costs would be covered by Friends of Hillcrest Charity",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F6c362193-a99a-46e6-afef-e72bf71f3a6e%2F0nFCUqNjeiXPIFO483j0BVWArU43%2Flisting.jpg?alt=media&token=0cb18845-2bdc-487b-b5a1-525dd640b835",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000VhvaxAAB#role",
                        "type": "Role",
                        "title": "Volunteer Minibus Drivers",
                        "applyLink": "https://volunteer.scot/search/a0g0800000VhvaxAAB/volunteer-minibus-drivers?#modal_register_a0g0800000VhvaxAAB",
                        "allowsRemoteParticipation": false,
                        "theme": [
