        {
            "id": "https://data.volunteer.scot/Organisation/0012400001KSbZpAAL",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400001KSbZpAAL/the-salvation-army-donation-centre",
            "name": "The Salvation Army Donation Centre",
            "description": "We’re a centre promoting re-use and recycling of fabrics, hardware and furniture.  We aim to further the work of the Salvation Army through supporting their shops. As a voluntary organisation we offer meaningful volunteering experiences listening to what our volunteers are looking for and meeting those needs.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
