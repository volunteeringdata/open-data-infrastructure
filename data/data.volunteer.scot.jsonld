        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZ8QAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZ8QAAU/hms-unicorn",
            "name": "HMS Unicorn",
            "description": "The Unicorn Preservation Society is a charity registered in Scotland who preserve and conserve HMS Unicorn, the most original old ship in the world.\r\n\r\nThe purpose of the organisation is to ensure a sustainable future for the vessel, provide education relating to the ship and maritime heritage, and to provide recreational facilities for the community.",
            "website": "https://www.hmsunicorn.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC002771"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
                    "skos:prefLabel": "Arts and Culture"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
