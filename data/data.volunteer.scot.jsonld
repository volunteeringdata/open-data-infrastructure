        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXeQAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXeQAAU/clan-cancer-support",
            "name": "Clan Cancer Support",
            "description": "Clan Cancer Support provides emotional and practical support to people affected by cancer, their family, carers and friends.",
            "website": "https://www.clanhouse.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
