                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000Eo06QYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000Eo06QYAR/volunteer-health-and-wellbeing-tutors",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Volunteer Health and Wellbeing Tutors",
                    "description": "## Summary\n\nWe are seeking enthusiastic and skilled volunteer tutors and instructors to support our health, wellbeing, and creative programs. Volunteers will help deliver engaging classes and activities that promote physical, mental, and emotional wellbeing within our community.\n\n## Description\n\nWe are seeking enthusiastic and skilled volunteer tutors and instructors to support our health, wellbeing, and creative programs. Volunteers will help deliver engaging classes and activities that promote physical, mental, and emotional wellbeing within our community.\r\nPlan and deliver high-quality classes or sessions in your area of expertise\r\n\r\nFacilitate inclusive, welcoming, and safe learning environments\r\n\r\nLead group or individual activities such as:\r\n\r\nHealth and wellbeing classes\r\n\r\nYoga, Pilates, Tai Chi, and similar movement-based practices\r\n\r\nCreative or artistic workshops\r\n\r\nAdapt content to suit participants’ abilities and needs\r\n\r\nCollaborate with our team to schedule and promote sessions\n\n## Experience required\n\nQualified, experienced, or knowledgeable in your chosen discipline\r\n\r\nConfident facilitating groups and engaging participants\r\n\r\nPassion for wellbeing, learning, and community support\r\n\r\nStrong communication and interpersonal skills\r\n\r\nRelevant certifications or teaching experience are desirable (where applicable)",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000Eo06QYAR#role",
                        "type": "Role",
                        "title": "Volunteer Health and Wellbeing Tutors",
                        "description": "Qualified, experienced, or knowledgeable in your chosen discipline\r\n\r\nConfident facilitating groups and engaging participants\r\n\r\nPassion for wellbeing, learning, and community support\r\n\r\nStrong communication and interpersonal skills\r\n\r\nRelevant certifications or teaching experience are desirable (where applicable)",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000Eo06QYAR/volunteer-health-and-wellbeing-tutors?#modal_register_a0gQD00000Eo06QYAR",
