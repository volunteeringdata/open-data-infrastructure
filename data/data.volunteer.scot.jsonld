                        "title": "Team Members of Aberdeen University SolidariTee Team",
                        "commitment": "Flexible times to help. All help makes a difference and is greatly appreciated.",
                        "applyLink": "https://www.solidaritee.org.uk/join-us",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "17",
