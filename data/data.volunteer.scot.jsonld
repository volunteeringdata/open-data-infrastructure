        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nbQpAAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbQpAAI/edinburgh-college-community-based-english-as-a-second-language",
            "name": "Edinburgh College - Community Based English as a Second Language",
            "description": "To provide access to learning English for adults, including refugees, permanently resident in the area, who are unable to attend a local community-based class or who need additional support to continue with a class. This is achieved through trained volunteers working once a week on a one-to-one basis in a student's home or other suitable venue.",
            "website": "https://www.edinburghcollege.ac.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
