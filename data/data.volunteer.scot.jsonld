            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JHijJYAT",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JHijJYAT/macmillan-buddy",
                    "publishStart": "2026-11-02",
                    "publishEnd": "2026-12-07",
                    "title": "Macmillan Buddy",
                    "description": "## Description\n\nOur Macmillan Buddy service provides a lifeline for people with cancer by offering them weekly support through our Telephone service. The service is delivered by volunteers, who undergo comprehensive training and are fully supported by our staff and lead volunteers. As a Macmillan Buddy volunteer, you can make a real difference to people's lives, at the hardest time of their life. As a volunteer buddy, you are there as someone for your service user to talk to about how they are feeling and their support needs during this difficult time.\r\nYou will also:\r\n-\tBe a key part of a friendly team of volunteers and staff \r\n-\tReceive comprehensive training and support\r\n-\tHave the opportunity to develop your communication and people skills\n\n## Training details\n\nWe provide comprehensive online training for our buddy volunteers, alongside support from our team of staff.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fe25e64db-54b3-4f9f-8b0b-08816940989c%2FyQtgfFOBwSNxO4OoLShS0rahK193%2Flisting.jpg?alt=media&token=0bb6d674-a9d9-4274-adcc-d109ebfb070e",
