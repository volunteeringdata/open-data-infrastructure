            "dc:source": "https://volunteer.scot/organisations/00124000008nWuqAAE/north-ayrshire-libraries",
            "name": "North Ayrshire Libraries",
            "description": "To provide informal one to one tuition to members of the public at a suitable time to suit both parties - student and volunteer.",
            "website": "https://www.ers.north-ayrshire.gov.uk",
