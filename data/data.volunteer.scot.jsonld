        {
            "id": "https://data.volunteer.scot/Organisation/001QD00001424cfYAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00001424cfYAA/ayrshire-litter-volunteer-network",
            "name": "Ayrshire Litter Volunteer Network",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000H8AQDYA3",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000H8AQDYA3/alvn-social-media-volunteer",
                    "publishStart": "2026-06-04",
                    "publishEnd": "2027-01-04",
                    "title": "(ALVN) Social Media Volunteer",
                    "description": "## Description\n\nThe Ayrshire Litter Volunteer Network (ALVN) is a Community based partnership of like-minded individuals who have great concern for the quality of their local environment; aiming to promote greater community responsibility towards the disposal of their rubbish. \r\n\r\nWe are currently looking to recruit a social media volunteer to maintain and develop our social media presence across Ayrshire.\r\nWe are looking for someone to share and design interesting, eye catching and informative posts to promote our work and to encourage the efforts of individuals and groups, encouraging others to consider litter picking. We currently only have a presence on Facebook but would be willing to use other forms of social media.\n\n## Experience required\n\nExperience of social media essential and volunteers must live in Ayrshire and have a good knowledge of the local area. \r\nComfortable communicating with representatives of all three Ayrshire councils.\n\n## Travel details\n\nNone - takes place within volunteers' local area with secure internet connections.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F85387671-b546-4111-9c9c-d4f15d581439%2Fu6pON37TQjYdM5UHI6HGmnnbgQ23%2Flisting.jpg?alt=media&token=6c64bed0-7fdb-4cbb-87da-a251695d562f",
