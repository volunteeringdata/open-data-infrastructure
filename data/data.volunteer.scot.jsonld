            "dc:source": "https://volunteer.scot/organisations/0012400000YSvulAAD/natural-connections",
            "name": "Natural Connections",
            "description": "To support individuals and communities to engage with nature and deliver volunteer led solutions to help improve the environment.\r\nA community growing garden providing volunteers with space to learn about organic growing, healthy eating, recycling and sustainability while sharing skills and socialising to the wider community we offer a natural space for outdoor events, environmental workshops and training.",
            "website": "https://naturalconnections.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC046141"
                }
            ],
            "cause": [
                {
