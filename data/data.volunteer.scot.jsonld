        {
            "id": "https://data.volunteer.scot/Organisation/0010800003J1afvAAB",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003J1afvAAB/midlothian-wildflowers",
            "name": "Midlothian Wildflowers",
            "description": "MWF care for, create and conserve wildflower meadows, habitats and green spaces in Midlothian while supporting the positive health and wellbeing of the community through conservation, rewilding and community solidarity.\r\n\r\nMWF are a grassroot community group engaged in supporting the local ecology, biodiversity and communities that rely on wild green spaces to feel well.\r\nInterested in conservation rewilding and community then please get in touch.",
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F6e075c04-8c8b-4616-ba3a-e232d39d045e%2FqsIKEg0s46fnoJfCh2nxdqMBJlB3%2Fuser-upload.jpg?alt=media&token=ba53d27c-d848-430b-a25a-0946e9ec019b",
