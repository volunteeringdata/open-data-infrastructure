        {
            "id": "https://data.volunteer.scot/Organisation/0012400000hH1RcAAK",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000hH1RcAAK/fab-friends-of-aberdeen-beach",
            "name": "FAB-Friends of Aberdeen Beach",
            "description": "Friends of Aberdeen Beach (a.k.a FAB) is a community group committed to maintaining and improving the quality of seaside between the mouth of the rivers Dee and Don.",
            "website": "https://www.friends-of-aberdeen-beach.co.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EnvironmentRecycling",
