        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000JTCz4YAH",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000JTCz4YAH/20th-dundee-brownies",
            "name": "20th Dundee Brownies",
            "description": "Brownies welcomes all girls from 7 to 10 years old for fun, learning and adventure.\r\n\r\nBrownies might grow plants, bake cakes, put up tents, light a fire, and go away for a fun weekend. With a helping hand from encouraging volunteers, Brownies explore their creative side, get out into the great outdoors, and start to look after themselves, others, and the world we live in.",
            "website": "https://www.girlguidingdundee.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC043086"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
