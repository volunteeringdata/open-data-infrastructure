        {
            "id": "https://data.volunteer.scot/Organisation/0012400000jm1T2AAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000jm1T2AAI/mearnskirk-helping-hands",
            "name": "Mearnskirk Helping Hands",
            "description": "Mearns Kirk Helping Hands is based in Newton Mearns and we aim to improve health and wellbeing and reduce isolation and loneliness in our community.  We do this by providing a range of groups and activities throughout the week including Tai Chi, Blether & Brew Coffee Afternoon, Friendship Club and a Men's Breakfast Club.  We also have a befriending project for people aged 65+ who are feeling lonely or isolated and would like the companionship of a volunteer befriender.  We are volunteer led and cannot provide any of the services we do, without our amazing volunteer team.  We are community helping itself.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC046646"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F9e24a2b9-9c68-42fa-53e3-f998b9990fe0%2FmQsKXYYIupgt1ub9BeDSGFfo1O33%2Fuser-upload.jpg?alt=media&token=586da968-5897-4780-baa3-d0fc445d11ec",
            "cause": [
