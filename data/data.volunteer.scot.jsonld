        {
            "id": "https://data.volunteer.scot/Organisation/00124000019TqAYAA0",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000019TqAYAA0/st-john-scotland-fife",
            "name": "St John Scotland (Fife)",
            "description": "Local St John Scotland volunteers run a Patient Transport service for renal patients at the Queen Margaret Hospital, Dunfermline and Victoria Hospital, Kirkcaldy. They also support communities across Fife to be resilient in the face of cardiac arrest by helping them install Public Access Defibrillators, and providing CPR awareness training.",
            "website": "https://www.stjohnscotland.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC047485"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000069hgbYAA",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000069hgbYAA/pad-lead",
                    "publishStart": "2026-08-26",
                    "publishEnd": "2027-02-24",
                    "title": "PAD Lead",
                    "description": "## Description\n\nSt John Scotland promotes and supports the placing of Public Access Defibrillators (PADs) in communities across Scotland. St John Scotland helps local community groups by donating towards the cost of the equipment and offering free Bystander CPR and defibrillator awareness sessions.\r\nAs PAD Lead you will:\r\n• Promote the placement of PADs in your area\r\n• Lead a small defibrillator awareness volunteer team\r\n• Deliver defibrillator awareness to people of all ages and backgrounds\r\n• Manage the equipment required for the delivery of PAD events\r\n• Travel to communities to advise them on placement of a PAD\n\n## Experience required\n\n• Automated External Defibrillator (AED) and/or Public Access Defibrillator (PAD) knowledge\r\n• Ability to communicate effectively by phone, email and in person with volunteers and organisations requesting demonstrations\r\n• Organised, outgoing and welcoming personality\r\n• Supportive of volunteers\r\n• Comfortable using IT systems and websites\r\n• Desire to make a difference to the outcomes of Out-of-Hospital Cardiac Arrests in Scotland\n\n## Training details\n\n• Ongoing support from our staff team and other PAD Leads across the country as required\r\n• Ongoing volunteer training, mentorship, and opportunities are offered as part of your role\n\n## Travel details\n\nVolunteers will be expected to travel around your area to support local communities on where it is best to place the PAD.\n\n## Travel expenses\n\nExpenses reimbursed at 45p per mile.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD0000069hgbYAA#role",
                        "type": "Role",
                        "title": "PAD Lead",
                        "description": "• Automated External Defibrillator (AED) and/or Public Access Defibrillator (PAD) knowledge\r\n• Ability to communicate effectively by phone, email and in person with volunteers and organisations requesting demonstrations\r\n• Organised, outgoing and welcoming personality\r\n• Supportive of volunteers\r\n• Comfortable using IT systems and websites\r\n• Desire to make a difference to the outcomes of Out-of-Hospital Cardiac Arrests in Scotland",
