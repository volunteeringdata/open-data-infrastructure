            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JMzoHYAT",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JMzoHYAT/were-recruiting-chair-of-the-board-of-trustees-voluntary",
                    "publishStart": "2026-11-12",
                    "publishEnd": "2026-12-01",
                    "title": "We’re Recruiting: Chair of the Board of Trustees (Voluntary)",
                    "description": "## Summary\n\nCould you help shape the future of Grampian Women’s Aid and make a lasting difference to the lives of women, children and young people affected by domestic abuse?\r\n\r\nWe’re looking for an inspiring and strategic woman leader to become our new Chair of Trustees.\r\n\r\nAs Chair, you’ll provide leadership to our Board, support our Chief Executive, help shape our strategic direction and champion our work externally.\r\n\r\nWe’re looking for someone with:\r\n• Strategic leadership and decision-making skills\r\n• Board, governance or senior leadership experience\r\n• Strong communication and influencing skills\r\n• A commitment to equality, inclusion and women’s rights\r\n• A passion for supporting women, children and young people affected by domestic abuse\r\n\r\nPrevious Chair or trustee experience is welcome, but not essential, full induction and ongoing support will be provided.\r\n\r\nTime commitment: Approximately 6–8 hours per month.  Board meetings every two months, online or in person (in-person meetings at our registered office - The Gatehouse, Quarry Road, Aberdeen. Online meetings take place via Teams).\r\n\r\nIf you’re passionate about creating lasting change and want to help lead an established organisation, supporting women and children since 1978, we’d love to hear from you.\r\n\r\nInformal, confidential enquiries: Aileen Forbes, Chief Executive Officer – info@grampianwa.com\n\n## Description\n\nCould you help shape the future of Grampian Women’s Aid and make a lasting difference to the lives of women, children and young people affected by domestic abuse?\r\n\r\nWe’re looking for an inspiring and strategic woman leader to become our new Chair of Trustees.\r\n\r\nAs Chair, you’ll provide leadership to our Board, support our Chief Executive, help shape our strategic direction and champion our work externally.\r\n\r\nWe’re looking for someone with:\r\n• Strategic leadership and decision-making skills\r\n• Board, governance or senior leadership experience\r\n• Strong communication and influencing skills\r\n• A commitment to equality, inclusion and women’s rights\r\n• A passion for supporting women, children and young people affected by domestic abuse\r\n\r\nPrevious Chair or trustee experience is welcome, but not essential, full induction and ongoing support will be provided.\r\n\r\nTime commitment: Approximately 6–8 hours per month.  Board meetings every two months, online or in person (in-person meetings at our registered office - The Gatehouse, Quarry Road, Aberdeen. Online meetings take place via Teams).\r\n\r\nIf you’re passionate about creating lasting change and want to help lead an established organisation, supporting women and children since 1978, we’d love to hear from you.\r\n\r\nInformal, confidential enquiries: Aileen Forbes, Chief Executive Officer – info@grampianwa.com\r\n\r\n(please note that as an organisation led by and for women and in accordance with the Equality Act 2010, we can only accept applications from women).\n\n## Experience required\n\nWe are seeking someone who has board member experience, ideally in an office bearer role. The role requires someone who can engage with the organisation to lead the strategic development and planning alongside board member colleagues. As an organisation led by and for women, we can only accept applications from women.\n\n## Training details\n\nInduction, training and mentoring support will be offered to the successful candidate. On-going training and development will also be offered both by in-house and external sources relevant to the role.\n\n## Frequency commitment details\n\n-Time commitment: Approximately 6–8 hours per month.\r\n-Board meetings every two months, online or in person.\r\n-In-person meetings at our registered office - The Gatehouse, Quarry Road, Aberdeen. Online meetings take place via Teams.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F04622a1a-6f8e-48b8-aaaa-4be99682e027%2FNzQErv4FETWS0CjlsXdTQl3Wb6g1%2Flisting.jpg?alt=media&token=eef69ae0-9a66-4b3e-af09-f1c0a6560099",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000JMzoHYAT#role",
                        "type": "Role",
                        "title": "We’re Recruiting: Chair of the Board of Trustees (Voluntary)",
                        "description": "We are seeking someone who has board member experience, ideally in an office bearer role. The role requires someone who can engage with the organisation to lead the strategic development and planning alongside board member colleagues. As an organisation led by and for women, we can only accept applications from women.",
                        "commitment": "-Time commitment: Approximately 6–8 hours per month.\r\n-Board meetings every two months, online or in person.\r\n-In-person meetings at our registered office - The Gatehouse, Quarry Road, Aberdeen. Online meetings take place via Teams.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000JMzoHYAT/were-recruiting-chair-of-the-board-of-trustees-voluntary?#modal_register_a0gQD00000JMzoHYAT",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
