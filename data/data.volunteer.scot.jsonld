            "dc:source": "https://volunteer.scot/organisations/001QD00000u19YzYAI/yourside",
            "name": "@yourside",
            "description": "The prevention and/or relief of poverty and/or isolation of those with an offending and/or substance use background in the Dundee area. The promotion of equality and advancement of Human Rights of those disadvantaged by reason of addiction, mental illness, offending background, financial hardship or other disadvantage.",
            "website": "https://www.yoursidedundee.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC054750"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Addictions",
