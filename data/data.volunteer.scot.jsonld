                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HuwYzYAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HuwYzYAJ/volunteer-walk-leader-linlithgow",
