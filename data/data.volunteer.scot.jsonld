        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nY2DAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nY2DAAU/citizens-advice-bureau-hamilton",
            "name": "Citizens Advice Bureau (Hamilton)",
            "description": "Hamilton Citizens Advice Bureau works closely within the local community to meet local people's needs, offering free and impartial advice on a wide range of issues, including benefits, debt, employment, health, relationships, caring issues, or legal problems.  Advisors are mostly trained volunteers.  They offer a drop-in service where people will be triaged and given an appointment with an advisor either in person or via the telephone.   The CAB is a referral source for food banks and fuel banks.\nOpen Hours:\nMonday 9.30am-4.30pm\nTuesday 9.30am-4.30pm\nWednesday - CLOSED - pre-arranged appointments only\nThursday 9.30am-4.30pm\nFriday 9.30am-4.30pm",
            "website": "https://hamiltoncab.cas.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC007443"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Advocacy",
                    "skos:prefLabel": "Advocacy"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000IWLADYA5",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000IWLADYA5/social-media-digital-content-volunteer",
                    "publishStart": "2026-10-21",
                    "publishEnd": "2027-01-06",
                    "title": "Social Media & Digital Content Volunteer",
                    "description": "## Description\n\nAs our Social Media & Digital Content Volunteer you will work with the Business Development Officer to help us develop engaging, accessible and visual digital content, across 3 key areas:\n•\tEstablishing and developing our presence on TikTok, creating content that helps us connect with younger audiences through fresh ideas about formats, styles and approaches. \n•\tCreating more short-form video, animation and graphic content for our wider digital channels and campaigns, which reach people of all ages.\n•\tSupporting the development of visual legal and rights explainers for our sibling website, the Hamilton CAB blog. We want to make important information easier to understand and engage with through video, animation and graphics. The Business Development Officer and relevant CAB staff will provide the subject knowledge, your role will be to assist in bringing that information to life visually.\n\nTasks include: \n•\tHelping to establish and develop our TikTok presence.\n•\tGenerating creative ideas for short-form videos aimed at younger audiences.\n•\tFilming, editing and producing short-form video content.\n•\tCreating simple animations, motion graphics and visual content.\n•\tHelping adapt content for different social media platforms and audiences.\n•\tWorking with the Business Development Officer to turn identified legal and rights topics into clear, engaging visual explainers.\n•\tContributing ideas to our wider digital content planning.\n•\tUsing feedback and basic performance information to help us understand which content works well.\n\n## Experience required\n\nJornalism / Media,PR / Marketing, Creative,Open minded,Organised,Reliable / Dependable,Social Conscience,Trustworthy,•\tIs creative and enjoys developing ideas for digital content.\n•\tHas experience creating and editing short-form video content.\n•\tUnderstands TikTok and how younger audiences engage with content on the platform.\n•\tHas an eye for strong visual communication and storytelling.\n\n## Travel details\n\nThe opportunity takes place at multiple location across South Lanarkshire \nBlantyre,Bothwell,Hamilton,Larkhall,Uddingston\n\n## Travel expenses\n\nLocal travel and other out of pocket expenses are paid.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000IWLADYA5#role",
                        "type": "Role",
                        "title": "Social Media & Digital Content Volunteer",
                        "description": "Jornalism / Media,PR / Marketing, Creative,Open minded,Organised,Reliable / Dependable,Social Conscience,Trustworthy,•\tIs creative and enjoys developing ideas for digital content.\n•\tHas experience creating and editing short-form video content.\n•\tUnderstands TikTok and how younger audiences engage with content on the platform.\n•\tHas an eye for strong visual communication and storytelling.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000IWLADYA5/social-media-digital-content-volunteer?#modal_register_a0gQD00000IWLADYA5",
