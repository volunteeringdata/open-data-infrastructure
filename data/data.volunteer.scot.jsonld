            "name": "Oxfam Shop, Nicolson St",
            "description": "Oxfam is a Charity, it raises money in various ways but most commonly through its High Street Shops. The money the shops raise helps to overcome poverty and suffering in the world.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039042"
                }
            ],
            "cause": [
