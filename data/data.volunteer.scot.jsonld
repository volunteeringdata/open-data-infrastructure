        {
            "id": "https://data.volunteer.scot/Organisation/001QD0000114k6fYAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD0000114k6fYAA/long-covid-scotland-western-isles",
            "name": "Long Covid Scotland (Western Isles)",
            "description": "Long Covid Scotland is a Scottish charity advocating for people living with Long Covid.",
            "website": "https://www.longcovid.scot",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC052053"
