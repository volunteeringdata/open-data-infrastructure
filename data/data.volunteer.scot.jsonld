        {
            "id": "https://data.volunteer.scot/Organisation/0010800002utCJ7AAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002utCJ7AAM/marys-meals-dundee",
            "name": "Mary's Meals Dundee",
            "description": "Mary's Meals provides life-changing meals to some of the world's poorest children every school day. We are a no-frills charity with a simple idea that works: by providing one good meal in a place of learning. Children are drawn into the classroom where they can receive an education that could one day free them from poverty.",
            "website": "https://www.marysmeals.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC022140"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/OverseasAidDevelopingWorld",
                    "skos:prefLabel": "Overseas Aid / Developing World"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000Gvdl9AAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000Gvdl9AAB/community-volunteer",
                    "publishStart": "2021-06-04",
                    "publishEnd": "2027-02-01",
                    "title": "Community Volunteer",
                    "description": "## Summary\n\nWe need volunteers to help raise awareness about Mary's Meals and fundraise for our work. As a Community Volunteer you will grow our movement by motivating and inspiring your local community to support our work.\n\n## Description\n\nWe are looking for people who are passionate about ending child hunger and ensuring that every child receives a daily meal in a place of education.\r\n\r\nWe have a range of activities that can be done from the comfort of your home, while Covid-19 restrictions are in place. They include: hosting virtual talks, spreading the word about our work on social media or holding screenings of our inspiring videos with family and friends.\r\n\r\nIf you don’t mind public speaking, we can also train you to visit schools, Rotary Clubs and other local organisations to give talks virtually and generate support for our cause.\n\n## Experience required\n\nFriendly & diplomatic to everyone. Excellent communication skills with the ability to liaise with people at all levels. \r\nShare our vision, mission & values. \r\nEnjoy meeting new people & interacting with others\r\nHonest & trustworthy.\r\nConfident & willing to act as the face of Marys Meals in your local community \r\nResilient & flexible - comfortable with independent working\r\nSelf-motivated & capable of motivating others \r\nEnthusiastic to support the organisation and running of fundraising events\n\n## Training details\n\nInduction training with volunteer manager lasting around 1.5 hours. Speaker training with vm and professional training is available if needed peridocially. Zoom training available if needed. Other health\r\nand wellbeing and training sessions available as requested and when available.\n\n## Frequency commitment details\n\nApprox 2 hours per week\n\n## Travel details\n\nDundee and Angus\n\n## Travel expenses\n\n45p per mile or public transport costs",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000Gvdl9AAB#role",
                        "type": "Role",
                        "title": "Community Volunteer",
                        "description": "Friendly & diplomatic to everyone. Excellent communication skills with the ability to liaise with people at all levels. \r\nShare our vision, mission & values. \r\nEnjoy meeting new people & interacting with others\r\nHonest & trustworthy.\r\nConfident & willing to act as the face of Marys Meals in your local community \r\nResilient & flexible - comfortable with independent working\r\nSelf-motivated & capable of motivating others \r\nEnthusiastic to support the organisation and running of fundraising events",
                        "commitment": "Approx 2 hours per week",
                        "applyLink": "https://volunteer.scot/search/a0g0800000Gvdl9AAB/community-volunteer?#modal_register_a0g0800000Gvdl9AAB",
                        "allowsRemoteParticipation": false,
