        {
            "id": "https://data.volunteer.scot/Organisation/0010800002sV9BKAA0",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002sV9BKAA0/ayrshire-cancer-support",
            "name": "Ayrshire Cancer Support",
            "description": "We are Ayrshire’s leading cancer charity that provides practical help and emotional support to people in Ayrshire affected by cancer. Whether you’ve just been diagnosed with cancer, having treatment or caring for someone with cancer, we can help.\r\n\r\n﻿﻿﻿\r\n\r\nFrom providing transport and complementary therapies to offering expert information or to just being there to listen, we’re here for you.",
            "website": "https://www.ayrshirecs.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC016098"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F93089f1e-1d28-a789-5f67-2eb3e3bc3c92%2F0nFCUqNjeiXPIFO483j0BVWArU43%2Fuser-upload.jpg?alt=media&token=6061eb40-c41d-457e-aec4-0a2eedc6053f",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
