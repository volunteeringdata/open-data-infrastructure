        {
            "id": "https://data.volunteer.scot/Organisation/00124000008ndmcAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ndmcAAA/stable-life",
            "name": "Stable Life",
            "description": "Stable Life is a registered charity working with vulnerable young people between 10 and 18 years of age in the Scottish Borders who are experiencing personal challenges. We offer a safe, nurturing and learning experience using the horse and its surroundings to help young people reach their full potential and become healthier and happier.",
            "website": "https://www.stablelife.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC011786"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/DrugAlcoholIssues",
