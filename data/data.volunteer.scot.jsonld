            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000GTc77YAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000GTc77YAD/mini-bus-driver",
                    "publishStart": "2026-04-22",
                    "publishEnd": "2027-03-21",
                    "title": "Mini Bus Driver",
                    "description": "## Description\n\nPlease provide a brief description of your charitable purposes\r\nTwechar Community Action and its projects including East Dunbartonshire Climate Action Hub focus on\r\nenhancing the lives of Twechar residents and residents from the wider East Dunbartonshire on climate\r\nemergency issues, well-being, youth and elderly projects as well as life long learning. With a host of\r\nactivities and events for the community to enjoy and get involved with.\r\nDescribe the volunteering Opportunity\r\nWe need confident mini bus drivers for our 15 seat electric community mini bus. Journeys could include\r\nlocal shopping trips as well as local and further afield daily adventures. These trips are for Twechar\r\nresidents both young and old. All journeys will leave and return from Twechar Healthy Living & Enterprise\r\nCentre\n\n## Experience required\n\nThere is an insurance criteria that needs to be met, which will be emailed out to potential volunteers\n\n## Training details\n\nAfter an application is filled in and an informal chat taken place, if the post is to be filled is suitable for both\r\nparties then an induction will take place. This will include a tour of the building covering health & safety, fire\r\nregulations and relevant policy and procedure forms filled in. The volunteer will be introduced to key\r\nmembers of staff and be given a buddy to have as a contact who will meet at least once a month to check\r\nin, of course they can be contacted when the volunteer needs them. Further training will be offered to the\r\nvolunteer\n\n## Travel details\n\nTwechar Healthy Living & Enterprise Centre\n\n## Travel expenses\n\nWe do however offer a light meal and drink when the volunteer is on duty.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000GTc77YAD#role",
                        "type": "Role",
                        "title": "Mini Bus Driver",
                        "description": "There is an insurance criteria that needs to be met, which will be emailed out to potential volunteers",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000GTc77YAD/mini-bus-driver?#modal_register_a0gQD00000GTc77YAD",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "21",
