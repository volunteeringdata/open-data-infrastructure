            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JPzweYAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JPzweYAD/support-at-peep",
                    "publishStart": "2026-11-04",
                    "publishEnd": "2026-12-15",
                    "title": "Support at Peep",
                    "description": "## Summary\n\nThe opportunity to support an experienced Community Learning worker who has Multiple Sclerosis mobility and sensory limitations to delivery family learning to parents and carers with babies 0-1 year olds.). And an opportunity to gain Early Years and Family learning skills.\n\n## Description\n\nThe role involves:\r\n\r\nPhysical support: \r\n- Carry files, resources, art material, laptop- pull wheeled trolley\r\n- lay out gym mats -lay out for refreshments\r\n- lay out for simple activities \r\n- handout refreshments, relevant paperwork occasionally\r\n- take photographs at the group on Lead work mobile\r\n- hold up song laminates\r\n- Moving away safely tripping items\r\n- blow bubbles to babies\r\n- help clear up after group\r\n- Wash & dry baby toys\r\n- Wash up mugs and cutlery and crockery used for refreshments\r\n- Put away gym mats\r\n- clear up room\r\n- Basic Carer responsibilities\r\n\r\nOther support (optional):\r\n- Model good listening skills \r\n- help Lead create models for craft activities by cutting, sticking, laminating,  & gluing \r\n\r\nMeta skills:\r\n- Good communication skills\r\n- Integrity\r\n- Confidentiality\n\n## Experience required\n\n-Care skills\r\n-Disability support\r\n-Communication skills\n\n## Training details\n\nBasic Carer support training with the Carer Centre.\n\n## Taster details\n\nHelp Lead worker set up, deliver learning at a Peep group and clear up.",
                    "requiresEmergencyParticipation": false,
