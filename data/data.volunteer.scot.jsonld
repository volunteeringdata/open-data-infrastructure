        {
            "id": "https://data.volunteer.scot/Organisation/0010800003F0fk7AAB",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003F0fk7AAB/riverfly-on-the-esk",
            "name": "Riverfly on the Esk",
            "description": "Our aim is to connect the community to its river and work together to: protect the water quality of our rivers; further the understanding of riverfly populations; and actively conserve riverfly habitats.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC031951"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F98485bf6-fd6b-4b3b-ab2b-40881f51610f%2FWkLzgT1VE9cAHEWcVMpdVMd5bL63%2Fuser-upload.jpg?alt=media&token=e2b9d08c-b209-415f-8bfc-8661b0b1adc0",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EnvironmentRecycling",
                    "skos:prefLabel": "Environment / Recycling"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000VhmxaAAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000VhmxaAAB/river-health-surveys",
                    "publishStart": "2023-02-13",
                    "publishEnd": "2027-02-10",
                    "title": "River Health Surveys",
                    "description": "## Description\n\nLearn about how monitoring Riverfly can tell you about the health of your local river. Riverfly on the Esk is a citizen science group that have been monitoring the health of the Lothian Esk for over 3.5 years. Made up of trained citizen scientists from the local community we survey and monitor the Riverfly that inhabit the waters from the source to the sea. Presence or absence of these invertebrates can tell us a lot about the health of the river. By joining our local citizen science trained volunteers for a survey we will show you how to take a sample, identify the sensitive groups. You will\r\nlearn about the river ecosystem and how important it is to look after it.\n\n## Experience required\n\nAn interest in the environment and conservation.\n\n## Travel details\n\nLocated off the B073, Newbattle Abbey Road. On Bus Route.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fa1a24622-3e3e-46d6-b7f7-7b087eb908b1%2FWkLzgT1VE9cAHEWcVMpdVMd5bL63%2Flisting.jpg?alt=media&token=1f14dd8d-bc64-42e0-87ee-d0dee4877f5e",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000VhmxaAAB#role",
                        "type": "Role",
                        "title": "River Health Surveys",
                        "description": "An interest in the environment and conservation.",
                        "applyLink": "https://volunteer.scot/search/a0g0800000VhmxaAAB/river-health-surveys?#modal_register_a0g0800000VhmxaAAB",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/Environment",
                                "skos:prefLabel": "Environment"
                            }
                        ],
                        "service": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/NamedContactForVolunteer",
                                "skos:prefLabel": "Named Contact For Volunteer"
                            }
                        ]
                    },
