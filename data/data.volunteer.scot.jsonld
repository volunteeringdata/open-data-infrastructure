        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZxUAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZxUAAU/volunteer-centre-east-lothian",
            "name": "Volunteer Centre East Lothian",
            "description": "We provide support, learning and development opportunities for people and organisations.  We provide guidance, support and training to Third Sector organisations and community groups.  We enable people to engage with their local community, develop and learn new skills through volunteering.  We also facilitate Third Sector representation at a local level through our delegate system.  Elected from with the Sector, delegates voice challenges and opinions on emerging issues, get involved in local decision making and champion the work of the Sector.",
            "website": "https://www.volunteereastlothian.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC029045"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2Ffc5cc1a8-56b7-00a0-49c2-e3f7ec327fcb%2FCpc5BhwfZdZ22rk2Dh5YH2l3Cj22%2Fuser-upload.jpg?alt=media&token=b454e556-55ad-45da-ab16-51ae4ec63849",
