        {
            "id": "https://data.volunteer.scot/Organisation/00124000008neIiAAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008neIiAAI/cyrenians",
            "name": "Cyrenians",
            "description": "Our vision is an inclusive society in which we all have the opportunities to live valued and fulfilled lives. We work to make that vision a reality by our mission to support people excluded from family, home, work or community on their life journey.",
            "website": "http://cyrenians.scot/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Addictions",
                    "skos:prefLabel": "Addictions"
                },
                {
