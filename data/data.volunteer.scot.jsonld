        {
            "id": "https://data.volunteer.scot/Organisation/0010800002myTgNAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002myTgNAAU/boys-brigade-aberdeen",
            "name": "Boys Brigade Aberdeen",
            "description": "The Boys’ Brigade is the oldest uniformed youth organisation in the country.  We promote habits which leads young people to be good all round citizens, through an extensive programme. It is rewarding and an honour to watch 5 year old shy children grown into confident young adults, ready to play their part in society.",
            "website": "http://aberdeen.boys-brigade.org.uk/",
            "cause": [
