                },
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000009TafdYAC",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000009TafdYAC/fundraising-treasurer",
                    "publishStart": "2026-07-13",
                    "publishEnd": "2027-01-11",
                    "title": "Fundraising Treasurer",
                    "description": "## Description\n\nIf you are someone with an interest in numbers and want to use your skills to support a charity, then this could be the perfect role for you!This role involves supporting your local fundraising group to manage the funds they have raised to support Guide Dogs. You will be part of a team of like-minded people, helping to maintain the accuracy of the team’s financial records. A beneficial role for people looking to expand their skills in accountancy or share them to support a charity.",
                    "requiresEmergencyParticipation": false,
