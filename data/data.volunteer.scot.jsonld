        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXeYAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXeYAAU/fersands-fountain-scio",
            "name": "Fersands & Fountain SCIO",
            "description": "Our Mission is to provide a range of vital services to a regeneration area of Aberdeen, Empowering residents through informal learning, support, education, volunteering and other services to reduce poverty and increase equality.",
            "website": "https://www.fersandsscio.co.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC026690"
                }
