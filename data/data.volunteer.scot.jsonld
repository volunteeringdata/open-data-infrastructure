        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000RGgrpYAD",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000RGgrpYAD/young-sea-changers-scotland",
            "name": "Young Sea Changers Scotland",
            "description": "We are a Scottish charity, founded in 2022, on a mission to amplify the voices of young people in the decisions affecting Scotland’s marine environment; an area in which the involvement of young people is often overlooked. \r\n\r\nWe recognise that young people from all walks of life in Scotland want our seas to be better protected, our marine resources to be responsibly managed, and for our coastal communities to thrive for years to come, but often lack opportunities to participate in marine decision-making.\r\n\r\nOur vision is for young people in Scotland, regardless of background or experience, to be empowered to have their voices heard on how our seas are managed.",
            "website": "https://www.youthforseas.org/",
            "charityRegistration": [
                {
