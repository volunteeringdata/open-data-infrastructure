        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nWr7AAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nWr7AAE/cruse-scotland-bereavement-support",
            "name": "Cruse Scotland Bereavement Support",
            "description": "We are Scotland's only open to all, bereavement charity offering support to bereaved adults, young people and children. \r\n\r\nOur national helpline is open 9am - 8pm, Monday to Friday and 1pm - 4pm at the weekend.",
            "website": "https://www.crusescotland.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC031600"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F5bc42759-5567-07af-6c22-b9c8475e4ba9%2FeZskf9PV07hGfYRBvUIgDjdp9zC3%2Fuser-upload.jpg?alt=media&token=f903c27f-8e75-465a-8e15-c7b3ddd495d0",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Counselling",
                    "skos:prefLabel": "Counselling "
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000009loAgYAI",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000009loAgYAI/counsellor",
                    "publishStart": "2025-05-06",
                    "publishEnd": "2027-04-09",
                    "title": "Counsellor",
                    "description": "## Description\n\nAre you a qualified counsellor? We need compassionate people like you to join our therapeutic team. Please join us in our mission to reach every adult in desperate need of support after the death of someone close. \r\n\r\nCruse Scotland provides a range of specialist support to bereaved people across Scotland.  Our counselling and listening volunteer team have a wide range of skills and expertise working with people to help them overcome obstacles to wellbeing and find ways forward through the challenges that life can bring when dealing with a bereavement.\r\n\r\nWhat could a volunteer gain from the experience:\r\nIncreasing skills and experience in the area of bereavement support. As part of Cruse Scotland, work as part of a team with clients, in person, online or phone. Free core supervision, 1:12 ratio.  Offer of free CPD nationally and locally.  Attend annual conference and other volunteer related events on behalf of Cruse Scotland.\n\n## Experience required\n\nVolunteers will be required to have a Diploma/Degree in counselling.\n\n## Training details\n\nNational CPD, some local online CPD, both throughout the year. National conference with workshops and keynote speakers.\r\nSupport provided from Volunteer Manager, Wendy Diack, then North Area Manager for local induction and continual support thereafter from North Area Co-ordinator and Area Manager.\n\n## Frequency commitment details\n\nIdeally two clients per week. Session duration of 50 minutes. Flexibility available.\n\n## Travel expenses\n\nTravel expenses and other expenses depending on circumstances.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000009loAgYAI#role",
