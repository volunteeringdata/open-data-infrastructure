            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000006mdgLYAQ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000006mdgLYAQ/volunteer-coffee-shop",
                    "publishStart": "2026-10-27",
                    "publishEnd": "2027-03-15",
                    "title": "Volunteer Coffee Shop",
                    "description": "## Description\n\nJoining our fantastic team, you will be one of our friendly faces in greeting guests\r\nwith a warm and welcoming smile as well as giving them an unforgettable hospitality\r\nexperience.\r\nWe welcome volunteers from all backgrounds and walks of life. We value the unique\r\nperspective you bring to our team.\n\n## Experience required\n\nAyrshire Hospice welcomes applications from all sections of the community. You\r\ndo not need to have any experience to volunteer in this role but ideally you should\r\nbe able to demonstrate: \r\nFriendly, confident and sensitive approach\r\nGood communication and listening skills\r\nAbility to help as part of a team and within guidelines\r\nFlexible, and responsive to others needs as they arise\r\nBasic numeracy will be required as cash handling\r\nAdopting a thoughtful and sensitive approach to the role due to the complex\r\nnature of the surroundings\r\nAbility to relate well to all staff, patients and their families, carers and general\r\npublic",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000006mdgLYAQ#role",
                        "type": "Role",
                        "title": "Volunteer Coffee Shop",
                        "description": "Ayrshire Hospice welcomes applications from all sections of the community. You\r\ndo not need to have any experience to volunteer in this role but ideally you should\r\nbe able to demonstrate: \r\nFriendly, confident and sensitive approach\r\nGood communication and listening skills\r\nAbility to help as part of a team and within guidelines\r\nFlexible, and responsive to others needs as they arise\r\nBasic numeracy will be required as cash handling\r\nAdopting a thoughtful and sensitive approach to the role due to the complex\r\nnature of the surroundings\r\nAbility to relate well to all staff, patients and their families, carers and general\r\npublic",
                        "applyLink": "https://volunteer.scot/search/a0gQD000006mdgLYAQ/volunteer-coffee-shop?#modal_register_a0gQD000006mdgLYAQ",
