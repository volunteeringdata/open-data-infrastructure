                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000002VAEtYAO",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000002VAEtYAO/volunteer-hairdresserbarber-glasgow-hospice",
