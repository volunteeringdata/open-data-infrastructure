                },
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000DX1VhYAL",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000DX1VhYAL/community-support-volunteer-1-1-ayrshire",
                    "publishStart": "2026-06-17",
                    "publishEnd": "2026-12-07",
                    "title": "Community Support Volunteer (1-1) (Ayrshire)",
                    "description": "## Description\n\nJoin our amazing team of Community Support Volunteers, who support people with one or more of our conditions to develop autonomy and confidence in self-management, enabling them to fully engage with their community and activities of their choosing. The service follows a pathway from hospital to community and can be delivered in a one-to-one and/or group setting in person, virtually or via telephone.",
                    "requiresEmergencyParticipation": false,
