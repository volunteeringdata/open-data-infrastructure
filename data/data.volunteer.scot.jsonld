        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXb0AAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXb0AAE/blantyre-volunteer-group-ltd",
            "name": "Blantyre Volunteer Group Ltd",
            "description": "Blantyre Volunteer Group are the providers of Blantyre Community Transport (BCT) a local charity providing innovative, flexible and accessible transport solutions to Affiliated Organisations, Local Schools, Church Groups, Out of hours Nurseries, Lunch Clubs, the elderly as well as individuals in Blantyre and surrounding districts.\nThey have a fleet of 5 minibuses with up to 16 seats and 3 wheelchairs and Smaller People Carrier type vehicles 5 to 7 seats are also available\nTo be able to hire our buses the organisations require to become a member of the organisation, we can provide a volunteer driver with the bus if required or organisations can self hire.\nOpen Monday to Friday 9.00am - 4.00pm",
            "charityRegistration": [
                {
