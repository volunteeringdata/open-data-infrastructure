        {
            "id": "https://data.volunteer.scot/Organisation/0010800003ET75rAAD",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003ET75rAAD/walk-run-cycle-east-dunbartonshire",
            "name": "Walk Run Cycle East Dunbartonshire",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/MentalHealth",
                    "skos:prefLabel": "Mental Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SportLeisureRecreation",
                    "skos:prefLabel": "Sport / Leisure / Recreation"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000FvLlRYAV",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000FvLlRYAV/walk-leader-event-host",
                    "publishStart": "2026-09-25",
                    "publishEnd": "2027-02-22",
                    "title": "Walk Leader Event Host",
                    "description": "## Description\n\nWRCED is a constituted community group encouraging residents of East Dunbartonshire to enjoy the\r\noutdoors. Either by offering inspiring ideas for their next adventures from their Facebook group or by\r\nallowing members to join one of the many in person events that happen each week. We increase physical\r\nfitness and promote wellbeing as well as reduce social isolation. Our events range from Walking Scotland\r\nHealth Walk and Strength and Balance sessions to big hill adventures and national long trails - with\r\neverything in between!\r\n\r\nWe provide on average 10 meet up events each week, we are a very popular group and we are always\r\nhappy to try and do more, but we need volunteers with knowledge and ideas for walking routes both East\r\nDunbartonshire and further afield.\n\n## Experience required\n\nConfident knowledge of any walking / hiking routes. People person with good communication skills. We\r\nbuddy all our new volunteers up with a more experienced volunteer to understand our events schedule,\r\nrisk assessments that is needed for each event.\n\n## Training details\n\nAfter an informal chat either in person or by zoom we then let the potential volunteer know how our events\r\nworks, ie our FB schedule, risk assessments and any recce that needs to happen prior to the event. The\r\nnew volunteer will buddy up with a more experienced volunteer and we even offer \"co host\" opportunities\r\non events to make sure our new volunteers are comfortable and confident before they go it alone.\r\nEveryone is so supportive here at WRCED and does this for the love of of the outdoors and sharing that\r\nwith others. Ongoing communication and training opportunities are available - we offer all our volunteers\r\nfirst aid training and walk leader training either with Walking Scotland or The Ramblers\n\n## Travel details\n\nWe meet all over East Dunbartonshire and further afield, most events have car share opportunities and the\r\nparticipants share travel costs",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000FvLlRYAV#role",
                        "type": "Role",
                        "title": "Walk Leader Event Host",
                        "description": "Confident knowledge of any walking / hiking routes. People person with good communication skills. We\r\nbuddy all our new volunteers up with a more experienced volunteer to understand our events schedule,\r\nrisk assessments that is needed for each event.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000FvLlRYAV/walk-leader-event-host?#modal_register_a0gQD00000FvLlRYAV",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
