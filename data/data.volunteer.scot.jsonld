            "dc:source": "https://volunteer.scot/organisations/001QD000019zpkzYAA/cupar-and-district-u3a",
            "name": "Cupar and District u3a",
            "description": "Cupar u3a is part of a UK wide learning organisation for retired and semi retired people, managed by the third Age Trust.  They offer educational and leisure groups covering languages, sport, music the arts and much more",
            "website": "https://cupar.u3asite.uk/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
                    "skos:prefLabel": "Arts and Culture"
                },
