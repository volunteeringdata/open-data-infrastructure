        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXT2AAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXT2AAM/transition-turriefield-cic",
            "name": "Transition Turriefield CIC",
            "description": "Transition Turriefield's aim is to reduce the dependence of the local community on imported produce.  The organisation provides the community with fresh, locally grown produce; encourages and supports indiviuals to grow their own and raises individual and community awareness of environmental and health issues arising from food production and consumption.\r\n\r\nTT was set up to: Reduce the dependence of the local community on imported produce... Reducing local carbon footprints and increasing personal health benefits by:\r\n- Growing fresh produce\r\n- Supporting folks to grow their own\r\n- Involoving community in growing\r\n- developing practice that avoids fossile fuel use\r\n- Raise awareness of issues associated with food\r\n- production and consumption",
            "website": "https://www.turriefieldveg.co.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
