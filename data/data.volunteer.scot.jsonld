                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/MentalHealth",
                    "skos:prefLabel": "Mental Health"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000005zWJRYA2",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000005zWJRYA2/board-members",
                    "publishStart": "2024-10-09",
                    "publishEnd": "2027-02-10",
                    "title": "Board Members",
                    "description": "## Description\n\nMWF are looking to recruit passionate people who have skills and experience to enhance and diversify our organisation.\r\nSpecific Skills  \r\nEcology\r\nEnvironmental Education\r\nYouth Work and Outdoor Education\r\nMental Health and Wellbeing\r\nNature Conservation\r\nDigital Marketing and Events\n\n## Experience required\n\nWe are looking for people who are keen to support the health and wellbeing of our local community as well as having a commitment to the environment in Midlothian. We are keen to welcome people from a variety of backgrounds such as:\r\nClimate Science and Education\r\nEcology and Environmental Managements\r\nExperienced Youth and Community Workers \r\nProject Management \r\nFinance and IT\r\nCreative Practitioners\n\n## Training details\n\nAttend informal gatherings for support with colleagues\r\nSupport and Supervision on request\r\nInduction meeting and introduction to MWF and projects\n\n## Travel expenses\n\nWe will reimburse expenses as required and necessary.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Faa5f6771-3944-4898-89c9-0c84847a0423%2FqsIKEg0s46fnoJfCh2nxdqMBJlB3%2Flisting.jpg?alt=media&token=b88ba81e-9d1b-4310-9795-af77f1773fda",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000005zWJRYA2#role",
                        "type": "Role",
                        "title": "Board Members",
                        "description": "We are looking for people who are keen to support the health and wellbeing of our local community as well as having a commitment to the environment in Midlothian. We are keen to welcome people from a variety of backgrounds such as:\r\nClimate Science and Education\r\nEcology and Environmental Managements\r\nExperienced Youth and Community Workers \r\nProject Management \r\nFinance and IT\r\nCreative Practitioners",
                        "applyLink": "https://volunteer.scot/search/a0gQD000005zWJRYA2/board-members?#modal_register_a0gQD000005zWJRYA2",
