        {
            "id": "https://data.volunteer.scot/Organisation/0010800003J0j3DAAR",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003J0j3DAAR/muscular-dystrophy-uk",
            "name": "Muscular Dystrophy UK",
            "description": "Muscular Dystrophy UK (previously known as the Muscular Dystrophy Campaign) was founded in 1959 and is the charity bringing individuals, families and professionals together to fight muscle-wasting conditions. We bring together more than 60 rare and very rare progressive muscle-weakening and wasting conditions affecting around 110,000 children and adults in the UK.",
            "website": "https://www.musculardystrophyuk.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039445"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Advocacy",
                    "skos:prefLabel": "Advocacy"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FundraisingFunding",
                    "skos:prefLabel": "Fundraising / Funding"
                },
                {
