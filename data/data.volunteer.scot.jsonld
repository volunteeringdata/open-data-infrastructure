            "dc:source": "https://volunteer.scot/organisations/00124000008nhLaAAI/crimestoppers-trust",
            "name": "Crimestoppers Trust",
            "description": "We are an independent charity that gives people the power to speak up and stop crime, 100% anonymously. By phone and online, 24/7, 365 days a year. We also share advice on how to protect the people you care about from crime. We’re working towards a country where everyone will feel safe, wherever they live.\r\n\r\nWe are proud to welcome volunteers from all communities across the UK to support our charity.",
            "website": "http://crimestoppers-uk.org/in-your-area/scotland",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC037960"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunitySafety",
                    "skos:prefLabel": "Community Safety"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HLSAnYAP",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HLSAnYAP/community-volunteer",
                    "publishStart": "2026-06-18",
                    "publishEnd": "2026-12-17",
                    "title": "Community Volunteer",
                    "description": "## Description\n\nThis role offers a flexible way to support Crimestoppers locally, ideal for those who want to help with community engagement and building awareness of our mission.\r\n\r\nAs a Community Volunteer, you’ll be part of a local team or committee, contributing ideas and initiatives to promote our mission of preventing and solving crime through anonymous reporting and increased community awareness.\r\n\r\nNo experience is needed, as full training is provided. \r\n\r\nWe’re looking for someone enthusiastic about Crimestoppers’ mission, community‑minded, a good communicator, and able to work independently or in a team.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F42be42f4-e0e9-4c2c-a4e4-a68c836730ac%2Fcgb9FiJAgMchQ5dOay5JlAHyKhg2%2Fheader.jpg?alt=media&token=00838280-701f-4732-b216-fe66252c5c51",
