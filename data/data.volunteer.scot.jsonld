            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JY0icYAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JY0icYAD/kids-play-assistant-volunteers",
                    "publishStart": "2026-11-13",
                    "publishEnd": "2027-05-03",
                    "title": "Kids Play Assistant Volunteers",
                    "description": "## Summary\n\nJoin our friendly team and help create a fun, safe, and welcoming space for children and families at our regular Friday play sessions. As a Kids Play Assistant, you'll play an important role in helping children enjoy a range of games, activities, crafts, and free play opportunities while giving parents and carers a chance to connect with others in the community, or take part in the coinciding Fitness Circuit sessions for parents. \r\n\r\nYour role will include helping to set up activities before the session, welcoming families, encouraging children to participate, supporting play and creative activities, and helping to tidy up at the end. No special qualifications are required, just enthusiasm, reliability, and a positive approach to working with children and families.\r\n\r\nThis is a rewarding opportunity to gain experience in children's activities, build confidence, develop communication and teamwork skills, and make a real difference in your local community. Whether you're looking to enhance your CV, meet new people, explore a career working with children, or simply give something back, we'd love to hear from you.\r\n\r\nFull support and guidance will be provided, and you'll be part of a caring and supportive team helping local families thrive together.\r\n\r\nTo find out more, please contact Ben Abel, Operations & Development Manager at email:  ben@cwt.scot or tel.: 01224678830\r\n\r\nCompass is a project of Aberdeen medical charity Camphill Wellbeing Trust (CWT). Find out more about the project and the charity at www.compassaberdeen.org.uk and www.camphillwellbeing.org.uk\n\n## Description\n\nJoin our friendly team and help create a fun, safe, and welcoming space for children and families at our regular Friday morning play sessions. As a Kids Play Assistant, you'll play an important role in helping children enjoy a range of games, activities, crafts, and free play opportunities while giving parents and carers a chance to connect with others in the community, or take part in the coinciding Fitness Circuit sessions for parents. \r\n\r\nYour role will include helping to set up activities before the session, welcoming families, encouraging children to participate, supporting play and creative activities, and helping to tidy up at the end. No special qualifications are required, just enthusiasm, reliability, and a positive approach to working with children and families.\r\n\r\nThis is a rewarding opportunity to gain experience in children's activities, build confidence, develop communication and teamwork skills, and make a real difference in your local community. Whether you're looking to enhance your CV, meet new people, explore a career working with children, or simply give something back, we'd love to hear from you.\r\n\r\nFull support and guidance will be provided, and you'll be part of a caring and supportive team helping local families thrive together.\r\n\r\nTo find out more, please contact Ben Abel, Operations & Development Manager at email:  ben@cwt.scot or tel.: 01224678830\r\n\r\nCompass is a project of Aberdeen medical charity Camphill Wellbeing Trust (CWT). Find out more about the project and the charity at www.compassaberdeen.org.uk and www.camphillwellbeing.org.uk\n\n## Training details\n\nExcellent support and relevant training is provided to all volunteers. \r\n\r\nVolunteers will receive a full induction covering the role, health and safety procedures, safeguarding, and how the play sessions operate. Ongoing support will be provided by experienced staff and volunteers throughout each session. Volunteers will have opportunities to develop skills in communication, teamwork, supporting children's play, and engaging with families. Regular guidance, feedback, and encouragement will be available to help volunteers feel confident in their role and gain the most from their volunteering experience.\n\n## Travel details\n\nThis volunteering opportunity takes place at The Compass Project, which is part of Camphill Wellbeing Trust, located on Craigton Road, Aberdeen. Compass is accessible by car, bicycle or on foot. Free parking is available on site, and local bus services operate nearby, but do not run directly to the site. Assistance with transport from local bus stop may be arranged if necessary. We aim to create a welcoming and supportive environment and will provide a full induction and guidance upon arrival. Please get in touch if you have any accessibility requirements or questions about travelling to the venue.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F4cf23185-6ea1-43e3-8c4c-c491e6cab6ff%2FdlGIWk3Bq8SY6ASxONtoW42H7Hi2%2Flisting.jpg?alt=media&token=8f922a48-f7da-4736-854c-9eecc78f620c",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000JY0icYAD#role",
                        "type": "Role",
                        "title": "Kids Play Assistant Volunteers",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000JY0icYAD/kids-play-assistant-volunteers?#modal_register_a0gQD00000JY0icYAD",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
