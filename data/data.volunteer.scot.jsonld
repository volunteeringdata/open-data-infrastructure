            "id": "https://data.volunteer.scot/Organisation/001QD000002XcWnYAK",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000002XcWnYAK/bylines-scotland",
            "name": "Bylines Scotland",
            "description": "Bylines Scotland is part of the Bylines Network, an IMPRESS-regulated not-for-profit organisation which works with volunteers to fill the gap between the established media and ordinary people, diversifying public conversation and training new journalists.",
            "website": "https://bylines.scot/",
            "cause": [
                {
