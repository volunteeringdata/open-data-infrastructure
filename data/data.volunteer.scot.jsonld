        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXP8AAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXP8AAM/bowel-cancer-uk",
            "name": "Bowel Cancer UK",
            "description": "Bowel Cancer UK aims to save lives by raising awareness of bowel cancer, campaigning for best treatment and care and providing practical support and advice.\r\nEarly diagnosis of bowel cancer in the UK is a problem because people either find it uncomfortable to discuss the symptoms of the disease or simply do not know what they are. \r\n\r\nSurvival rates in the UK are amongst the lowest in Europe, with 15% more patients being diagnosed at a later stage of the disease compared with most other European countries. \r\n\r\nThis is why Bowel Cancer UK’s work – to encourage people to recognise the symptoms of the disease and to act on their concerns so that they have the best chance of survival – is so important.",
            "website": "http://www.bowelcanceruk.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC040914"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CampaigningLobbying",
                    "skos:prefLabel": "Campaigning / Lobbying"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000I0iZlYAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000I0iZlYAJ/early-diagnosis-volunteer",
                    "publishStart": "2026-09-11",
                    "publishEnd": "2027-03-12",
                    "title": "Early Diagnosis Volunteer",
                    "description": "## Description\n\nOur exciting new early diagnosis programme needs your support.  We’re working with local health partners across the UK to run a year long programme of activities to improve early diagnosis.  We'll be bringing local communities together to help more people spot bowel cancer symptoms early and increase bowel screening uptake.\r\n\r\nThis role focuses on the awareness side getting people talking about bowel cancer, feeling better informed and confident about taking action for their health.\r\n\r\nIt’s a one year role and a great fit for anyone passionate about bowel cancer awareness.  A personal connection to the cause is helpful but not required.\n\n## Travel details\n\nAround Glasgow & Inverclyde - travel expenses reimbursed as per our expenses policy.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000I0iZlYAJ#role",
                        "type": "Role",
                        "title": "Early Diagnosis Volunteer",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000I0iZlYAJ/early-diagnosis-volunteer?#modal_register_a0gQD00000I0iZlYAJ",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
