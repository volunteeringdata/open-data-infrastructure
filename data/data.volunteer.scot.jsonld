        {
            "id": "https://data.volunteer.scot/Organisation/00108000037IyvGAAS",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00108000037IyvGAAS/grampian-disability-sport",
            "name": "Grampian Disability Sport",
            "description": "Grampian Disability Sport (GDS) is a charitable organisation dedicated to fostering regular high-quality sport and physical activity opportunities for people with a disability. We achieve this through: strong partnership working; promoting participation opportunities for all; and building capacity of our volunteers and advocating for our community. GDS leads in the development of sport for people with physical, sensory or learning disability alongside partners in the three local authority areas of Aberdeen City, Aberdeenshire and Moray.\r\n\r\nOur vision: sport and physical activity are open and inclusive for all people with disabilities across Grampian.\r\n\r\nOur mission: to work in partnership to support people with disabilities to engage, participate and progress in sport and physical activity.\r\n\r\nOur values: Inclusion, Collaboration, Inspiration, Determination.",
            "website": "https://www.grampiandisabilitysport.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC030188"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/LearningDisability",
