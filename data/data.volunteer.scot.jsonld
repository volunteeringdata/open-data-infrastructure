            "dc:source": "https://volunteer.scot/organisations/00108000030zOQsAAM/temple-old-kirk-friends",
            "name": "Temple Old Kirk Friends",
            "description": "Temple Old Kirk Friends is committed to bring the beautiful old Temple Kirk and kirkyard to 'life' by raising money for conservation and gaining appreciation of their significance to the public, historians and genealogists.",
            "website": "https://www.templeoldkirk.org/",
