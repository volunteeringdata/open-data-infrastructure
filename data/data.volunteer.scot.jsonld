        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXcuAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXcuAAE/guide-dogs-scotland",
            "name": "Guide Dogs Scotland",
            "description": "Guide Dogs is one of the UK’s leading sight loss charities. Their expert staff,\n volunteers and life-changing guide dogs help people with sight loss live the life\n they choose. They support children and adults with a vision impairment, through a\n range of services. They couldn’t continue their vital work without generous\n donations and their amazing volunteers. At Guide Dogs Scotland, there are a range\n of volunteer opportunities including fundraising group members, lead fundraising\n roles, puppy raising and fostering training guide dogs. The charity also offers free\n training in how to guide adults with sight loss.",
            "website": "https://www.guidedogs.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038979"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
