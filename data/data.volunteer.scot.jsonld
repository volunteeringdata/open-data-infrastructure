        {
            "id": "https://data.volunteer.scot/Organisation/001QD000008zuFBYAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000008zuFBYAY/rnid-fife",
            "name": "RNID (Fife)",
            "description": "Provide support to people with hearing loss in local communities.\r\n\r\n\r\nCampaign for deaf and hard of hearing people to be able to participate fully in Uk society\r\n\r\nSupport employers to better understand the needs of people with hearing loss and deafness in the workplace\r\n\r\nFund research into deafness and hearing loss.",
            "website": "https://rnid.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038926"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SensoryImpairment",
                    "skos:prefLabel": "Sensory Impairment"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000022NozYAE",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000022NozYAE/near-you-hearing-aid-support",
                    "publishStart": "2026-07-14",
                    "publishEnd": "2027-01-12",
                    "title": "Near You ( hearing aid support)",
                    "description": "## Description\n\nRNID volunteers help people get the most out of their hearing aids by cleaning them, replacing batteries and doing other important maintenance. They provide tips and hints about getting the most from your hearing aids. Their volunteers also help people access the RNID online hearing check. It takes 3 minutes and is completely free. It will suggest if your hearing is in a normal range or if you may have hearing loss.\r\n\r\nHelp RNID offer a free, in-person drop-in service for people who are deaf, have hearing loss or tinnitus, or want to get their hearing checked.\n\n## Experience required\n\nThey are looking for people who are friendly and who want to contribute to their community and who are approachable. Supporting others is a major aspect of this volunteer role and caring and understanding as well as listening to others is important to them.\n\n## Training details\n\nAll volunteers will receive induction training\n\n## Travel details\n\nRNID’s free, in-person drop-in services are delivered from local community settings such as libraries, health hubs and other community centres and in some cases local care homes.\n\n## Travel expenses\n\nRNID pays public transport rates and national milage rate 0.45p per mile, and volunteer expenses are reimbursed monthly by bank transfer",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD0000022NozYAE#role",
