                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HXb3pYAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HXb3pYAD/receptionist",
                    "publishStart": "2026-06-30",
                    "publishEnd": "2027-02-26",
                    "title": "Receptionist",
                    "description": "## Summary\n\nGreet clients and visitors to the bureau be able to update  databases and information systems, carry out scanning and photocopying as well as answering the telephone and taking messages where appropriate, respond to email enquiries and make appointments for clients with the appropriate Adviser\n\n## Description\n\nLooking for people who will commit  to the aims and principles of the CAB service, are organised, flexible and systematic\r\nUnderstand of the importance of CAB work with good written and verbal communication skills. Willing to attend training and meetings and able to work well as part of a team\r\nWilling to attend training and meetings\r\n•\tAble to work well in a team",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HXb3pYAD#role",
