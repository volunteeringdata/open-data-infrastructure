                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000001eNdGYAU",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000001eNdGYAU/chaperone-volunteer-kindness-krew",
                    "publishStart": "2026-07-13",
                    "publishEnd": "2027-01-11",
                    "title": "Chaperone volunteer - Kindness Krew",
                    "description": "## Description\n\nChaperone volunteers are here to assist people who may face difficulty attending their daily appointments. They will meet with the beneficiaries at their homes and provide support throughout their appointments, whether it be for medical, leisure, or shopping purposes. Transportation to and from the appointment can be arranged through walking, public transport, or utilizing the beneficiary's own vehicle.",
                    "requiresEmergencyParticipation": false,
