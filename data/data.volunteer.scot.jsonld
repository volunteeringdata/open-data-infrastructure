                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000IB1bLYAT",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000IB1bLYAT/young-carer-volunteer-driver",
                    "publishStart": "2026-09-28",
                    "publishEnd": "2027-03-29",
                    "title": "Young Carer Volunteer Driver",
                    "description": "## Description\n\nCould you help a young carer get to the support they need? We are looking for volunteer drivers to help transport young carers aged 5-18 to and from our regular weekly and monthly groups. For some young people, attending these groups would simply not be possible without the support of our volunteer drivers. By giving a little of your time, you can help a young carer access fun activities, make friends, build confidence, and connect with others who understand their experiences. A PVG check will be completed, and mileage expenses are paid. All you need is a valid driving licence, access to a vehicle with business insurance, and a desire to make a difference in a young person's life.\n\n## Experience required\n\nWe are looking for volunteer drivers who are:\r\n\r\nReliable and punctual\r\nFriendly, approachable, and caring\r\nGood communicators who can help young people feel comfortable and safe\r\nPatient and understanding of the challenges young carers may face\r\nRespectful of confidentiality and professional boundaries\r\nFlexible and willing to support young people attending groups and activities\r\nComfortable driving in a safe and responsible manner",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000IB1bLYAT#role",
                        "type": "Role",
                        "title": "Young Carer Volunteer Driver",
                        "description": "We are looking for volunteer drivers who are:\r\n\r\nReliable and punctual\r\nFriendly, approachable, and caring\r\nGood communicators who can help young people feel comfortable and safe\r\nPatient and understanding of the challenges young carers may face\r\nRespectful of confidentiality and professional boundaries\r\nFlexible and willing to support young people attending groups and activities\r\nComfortable driving in a safe and responsible manner",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000IB1bLYAT/young-carer-volunteer-driver?#modal_register_a0gQD00000IB1bLYAT",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "service": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/NamedContactForVolunteer",
                                "skos:prefLabel": "Named Contact For Volunteer"
                            }
                        ]
                    },
