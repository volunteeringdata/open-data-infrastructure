                        "description": "We are looking for anyone that has had an office-based job for two years or more. We want you to share your experiences of navigating the job market, interviews, entering into a professional workplace and building a career.",
                        "commitment": "One, six-week cycle of one hour per week. 1:1, remote sessions.",
                        "applyLink": "https://thecloudcrew.io/sign-up-1",
                        "allowsRemoteParticipation": true,
                        "minimumAge": "18",
