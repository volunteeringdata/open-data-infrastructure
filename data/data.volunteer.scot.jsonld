            "name": "St Stephen's Church Aberdeen",
            "description": "Aberdeen St Stephen’s Church is a welcoming Church which serves the community. We are also a registered charity.",
            "website": "https://www.st-stephens.co.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
