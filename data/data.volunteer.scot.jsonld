        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nb21AAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nb21AAA/aberlour-child-care-trust",
            "name": "Aberlour Child Care Trust",
            "description": "Aberlour works with children and young people who have experienced disadvantage or trauma, or who have disabilities. They pride themselves on their child-centred focus and strong commitment to the individual development of each child emotionally, socially, physically and intellectually. \r\n\r\nThey work with whole families as well as children on their own.",
            "website": "https://www.aberlour.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC007991"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
                    "skos:prefLabel": "Befriending / Mentoring"
