                            }
                        ]
                    }
                }
            ]
        },
        {
            "id": "https://data.volunteer.scot/Organisation/001QD000011e5w2YAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000011e5w2YAA/cwas-twechar",
            "name": "CWAS Twechar",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
                    "skos:prefLabel": "Befriending / Mentoring"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000GViDFYA1",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000GViDFYA1/trishaw-pilot",
                    "publishStart": "2026-04-24",
                    "publishEnd": "2027-03-23",
                    "title": "Trishaw Pilot",
                    "description": "## Description\n\nPlease provide a brief description of your charitable purposes\r\nProviding free Trishaw rides in Twechar for passengers living with limited mobility, loneliness or isolation. \r\nTrishaws are specially adapted e-bikes. All volunteer cyclists are fully trained and PVG checked by CWAS.\r\nDescribe the volunteering Opportunity\r\nOur cycle leaders are known as Pilots of our Trishaw. You do not have to be an experienced cyclist nor \r\nsuper fit nor super strong! Virtually anyone aged 18 and upwards can become a CWAS Trishaw Pilot and \r\nthe rewards are simply amazing. Full training and sign off is done by the national charity CWAS\n\n## Experience required\n\nIn good health, friendly and pleasant.\n\n## Training details\n\nPlease give a brief description of induction, ongoing training and support for the volunteer\r\nAfter an application is filled in and an informal chat taken place, if the post is to be filled is suitable for both \r\nparties then an induction will take place. This will include a tour of the building covering health & safety, fire \r\nregulations and relevant policy and procedure forms filled in. The volunteer will be introduced to key \r\nmembers of staff and be given a buddy to have as a contact who will meet at least once a month to check \r\nin, of course they can be contacted when the volunteer needs them. Further training will be offered to the \r\nvolunteer.\n\n## Travel details\n\nEast Dunbartonshire\n\n## Travel expenses\n\nWe do however offer a light meal and drink when the volunteer is on duty",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000GViDFYA1#role",
                        "type": "Role",
                        "title": "Trishaw Pilot",
                        "description": "In good health, friendly and pleasant.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000GViDFYA1/trishaw-pilot?#modal_register_a0gQD00000GViDFYA1",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/GeneralPublic",
                                "skos:prefLabel": "General Public"
                            }
                        ],
                        "reward": [
                            "https://ns.volunteeringdata.io/TrainingProvided"
                        ]
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
