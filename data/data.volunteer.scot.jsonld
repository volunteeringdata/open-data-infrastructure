        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nY2CAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nY2CAAU/chas-childrens-hospices-across-scotland-aberdeen-north-east-services",
            "name": "CHAS-Childrens Hospices Across Scotland (Aberdeen & North East Services)",
            "description": "CHAS is a Scottish charity that provides hospice services for children and young people with  life-shortening conditions. We also run a homecare service called CHAS at Home helping families in their own homes across Scotland when they need it most.\r\n\r\nCHAS offers care in two children’s hospices,-Rachel House and Robin House. Rachel House was Scotland first children’s hospice.\r\n\r\nCHAS also provides a home care service called CHAS at Home, staffed from both hospices and with dedicated teams in Aberdeen and Inverness. The service offers care and support to families in their own homes when they need it most.",
            "website": "https://www.chas.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC019724"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Carers",
                    "skos:prefLabel": "Carers"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CharityShop",
                    "skos:prefLabel": "Charity Shop"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
