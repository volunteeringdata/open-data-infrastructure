        {
            "id": "https://data.volunteer.scot/Organisation/0012400000Q0ihEAAR",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000Q0ihEAAR/hcl-handicabs-midlothian",
            "name": "HcL Handicabs (Midlothian)",
            "description": "Charity providing transport for disabled and elderly.",
            "website": "https://www.HcLtransport.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC013906"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2Fccbc8a86-a426-1704-5cfe-08b334d22682%2FHi3K7lHa8wXatOHLGJFdBGJQtau2%2Fuser-upload.jpg?alt=media&token=e132a391-530d-4f37-ab44-563a70c1eb09",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000001NzRZAA0",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000001NzRZAA0/volunteer-despatcher",
                    "publishStart": "2019-03-12",
                    "publishEnd": "2027-02-10",
                    "title": "Volunteer Despatcher",
                    "description": "## Summary\n\nTo help elderly and disabled people to live in their own homes for as long as possible and should be able to be included in the life of the community.\n\n## Description\n\nPassengers register with us to use our services either by telephone, online or with a registration form. Our despatchers take passengers details and other information for bookings, arrange journeys, deal with enquiries and provide information when requested using various office equipment including IT, telephone and photocopier.\n\n## Experience required\n\nA good knowledge of Edinburgh, East and Midlothian is essential.\r\n· An ability to relate to older people and/or people living with a disability is necessary. Previous experience is preferred but not essential.\r\n· Good IT and communication skills are essential.\r\n· Candidates must be contactable by telephone.\n\n## Training details\n\nVolunteers will be given an induction and will complete a variety of training opportunities including Disability Awareness.\n\n## Frequency commitment details\n\n4 hours per week (half day)\n\n## Travel details\n\nOur services cover East Lothian, Midlothian and Edinburgh from our base at 24/3a Dryden Road, Bilston Glen Industrial Estate, Loanhead, EH20 9HX\r\nFree car park and bus stop nearby for buses 37 and 140\n\n## Travel expenses\n\nOut of pocket expenses paid",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fbbadb4a1-16b3-a209-2259-e7837e952c0d%2FHi3K7lHa8wXatOHLGJFdBGJQtau2%2Flisting.jpg?alt=media&token=6a271ada-e907-4518-8f45-305bd9b2728a",
