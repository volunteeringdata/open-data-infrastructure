        {
            "id": "https://data.volunteer.scot/Organisation/0010800003DzXnqAAF",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003DzXnqAAF/friends-of-the-broadway-prestwick",
            "name": "Friends of the Broadway Prestwick",
            "description": "Friends of the Broadway Prestwick was founded in 2012 by local volunteers, with the aim of purchasing the building and reopening the Broadway Cinema once again. We’re Friends of the Broadway Prestwick, and we’re a community group dedicated to bringing the former Broadway Cinema in Prestwick into community ownership. Our aim is to reopen the Broadway as a cinema and inter-generational community hub.",
            "website": "http://friendsofthebroadwayprestwick.com/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC048992"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2Feb43d6d9-efdd-4767-8707-5ba4925de9b1%2FXiQTI9rs8XhdfYu2EPhcBTs4his2%2Fuser-upload.jpg?alt=media&token=2cb7039f-693b-4bd2-9204-1c0bb8be2532",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Media",
                    "skos:prefLabel": "Media"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000ARWZ7YAP",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000ARWZ7YAP/ebay-store-volunteer-donation-processor",
                    "publishStart": "2025-06-18",
                    "publishEnd": "2027-03-31",
                    "title": "eBay Store Volunteer Donation Processor",
                    "description": "## Description\n\nVolunteer with Friends of the Broadway Prestwick.\r\n\r\nFriends of the Broadway Prestwick is a community group dedicated to bringing the former Broadway Cinema in Prestwick into community ownership.\r\n\r\nOur aim is to reopen the Broadway as a professional cinema, exciting multi-use venue, and inter-generational community hub. \r\n\r\nWe are looking for responsible volunteers to provide a welcoming and timely pick-up and delivery service for all items donated to the Friends of the Broadway to sell on our Ebay store for fundraising.  \r\nResponsibilities will include:\r\n•\tTo regularly liaise with the Volunteer eBay Store Administrator regarding potential donations.\r\n•\tTo ensure mutually agreed-upon arrangements with the donor are made for the smooth collection of goods\r\n•\tTo assess all health and safety aspects of lifting and transporting donated goods from the place of origin, and summon         the Administrator if more support is required before accepting items\r\n•\tTo ensure all donors are thanked for their generosity and that donated items are safely transported to the Regency depot\r\n•\tTo assess the overall condition of items and accurately record key selling points\r\n•\tTo photograph and reference all items, record details, itemise on the register, and submit all info to the Store Administrator\r\n•\tTo highlight to the volunteer packer any relevant information that may impact the packing and transportation of items \r\n•\tTo update the Store Administrator of any perceived/issues that may arise\r\n\r\nIf you would like to volunteer in a role which allows you to give back to the local community while participating in a innovative project, and to join an enthusiastic, diverse and dynamic team of volunteers this could be the opportunity for you. The role can also allow you to make a significant contribution to the future of the Broadway. You will also be able to access a range of training and gain experience in a variety of new activities.\n\n## Experience required\n\n•\tAbility to work flexibly\r\n•\tAccess to own transport, with relevant insurance in place (expenses will be reimbursed at standard agreed mileage rate)\r\n•\tExcellent interpersonal skills\r\n•\tPhysically capable of occasional heavy lifting\r\n•\tSound awareness of health and safety considerations and manual handling procedures\r\n•\tGood time management and organisational skills\r\n•\tAbility to work under pressure \r\n•\tDiscretion and confidentiality",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fd1de4579-0cb1-4f4f-aa2a-478cc1508fff%2Fgpx6nnIWvxXFMLCpJdEzZH9maTg1%2Flisting.jpg?alt=media&token=16b6eeb2-82ec-4654-869a-13a63f3e6d8d",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000ARWZ7YAP#role",
                        "type": "Role",
                        "title": "eBay Store Volunteer Donation Processor",
                        "description": "•\tAbility to work flexibly\r\n•\tAccess to own transport, with relevant insurance in place (expenses will be reimbursed at standard agreed mileage rate)\r\n•\tExcellent interpersonal skills\r\n•\tPhysically capable of occasional heavy lifting\r\n•\tSound awareness of health and safety considerations and manual handling procedures\r\n•\tGood time management and organisational skills\r\n•\tAbility to work under pressure \r\n•\tDiscretion and confidentiality",
