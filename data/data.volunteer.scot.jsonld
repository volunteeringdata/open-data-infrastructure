        {
            "id": "https://data.volunteer.scot/Organisation/00124000008ncDoAAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ncDoAAI/youth-outreach-bus-trust",
            "name": "Youth Outreach Bus Trust",
            "description": "The Youth Outreach Bus Trust or ‘Red Bus’ as it has become known as is a converted double decker bus which has been completely re-designed inside to become a mobile youth drop in centre for ages s1-s6 (secondary school).\n\nYouth Outreach Bus was an idea initially by the local community group P.A.R Dyce, in conjunction with members of Dyce Church over 2 years ago. The aim of the group was to provide an outreach platform to reach out to the young people in Dyce and to provide a safe and fun environment for them to meet.\n\nLed by an enthusiastic and committed team of volunteers from all age groups, assisted by a part time youth worker, helps ensure the young folk are looked after and are kept safe and entertained while on the bus. \n\nThe bus currently operates in Dyce, but is mobile and we are actively looking to expand to working in other parts of Aberdeen as well.",
            "website": "https://dyceparishchurch.org.uk/dyce-youth-outreach-bus",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC042700"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
