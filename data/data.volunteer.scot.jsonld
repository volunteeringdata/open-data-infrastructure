            "dc:source": "https://volunteer.scot/organisations/0010800002zt0rvAAA/bonnyrigg-and-lasswade-community-council",
            "name": "Bonnyrigg and Lasswade Community Council",
            "description": "Bonnyrigg and Lasswade Community Council is a place where people can find out what's happening in the town, discuss issue affecting the community and make their opinions and concerns known to local authorities.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityCouncil",
