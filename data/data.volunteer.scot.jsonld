        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXyiAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXyiAAE/voluntary-action-orkney",
            "name": "Voluntary Action Orkney",
            "description": "VAO exists to promote, support, inspire and develop the third sector in Orkney. VAO provides proactive, quality, responsive services to local organisations. VAO represents and empowers the third sector to work in partnership as key contributors to the social economy.",
            "website": "https://www.vaorkney.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC010691"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
