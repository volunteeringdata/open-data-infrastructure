        {
            "id": "https://data.volunteer.scot/Organisation/00124000008ndleAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ndleAAA/ferryhill-community-centre",
            "name": "Ferryhill Community Centre",
            "description": "A vibrant and engaged community centre with activities running 6 days a week.",
            "website": "https://www.ferryhillcommunitycentre.org.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/OlderPeople",
