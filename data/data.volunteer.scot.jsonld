        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000J0dXxYAJ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000J0dXxYAJ/flexible-childcare-services-scotland",
            "name": "Flexible Childcare Services Scotland",
            "description": "Flexible Childcare Services Scotland (FCSS) is a national charity in Scotland with numerous childcare settings delivering early learning and school age childcare as well as specialist support for children and young people with Additional Support Needs.  The charity was created to challenge the inflexibility of current childcare provision across Scotland with the goal of improving parental employment while simultaneously reducing child poverty.\r\n\r\nOur vision is simple; to enable every child, family, and community to access the individual early learning support and childcare services they need to thrive.",
            "website": "https://www.fcss.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC049318"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
                    "skos:prefLabel": "Community Facilities"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FamilySupport",
                    "skos:prefLabel": "Family Support"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000004FFu5YAG",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000004FFu5YAG/board-member",
                    "publishStart": "2024-06-26",
                    "publishEnd": "2026-11-20",
                    "title": "Board Member",
                    "description": "## Summary\n\nHelp us to tackle child poverty by making flexible childcare the rule, not the exception!\n\n## Description\n\nFCSS has been created to challenge the inflexibility of current childcare provision across the country and to ensure equity of early years’ and childcare experience for all children regardless of family circumstances, location or specific needs.\n\nWe are now seeking new Trustees to join our board and help us to drive flexible childcare across Scotland.\n\nBoard Trustees are responsible for the charity’s governance and strategy, and for making sure that the charity is administered effectively. \n\nHelp us to tackle child poverty by making flexible childcare the rule, not the exception!\n\n## Experience required\n\n- Early learning and childcare\n- Third sector finance\n- Working with local and national policy makers\n\n## Frequency commitment details\n\nWe host 4 - 6 board meetings per year and most of these will be held online.\n\n## Travel details\n\nWe host 4 - 6 board meetings per year and most of these will be held online.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-volunteerscotland-search.appspot.com/o/opportunities%2FRe1o0YmBM0S7X7FzupIOhKXVzGP2%2FnpE1ommOgnF3coD0-thumbnail.jpg?alt=media&token=ec6d67a8-2727-4cdd-92a8-e49d7aac6bb2",
