        {
            "id": "https://data.volunteer.scot/Organisation/0010800003AlzNeAAJ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003AlzNeAAJ/the-ardrossan-15th-ayrshire-scout-group",
            "name": "The Ardrossan (15th Ayrshire) Scout Group",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000SsMhfAAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000SsMhfAAF/scout-leaders",
                    "publishStart": "2026-09-07",
                    "publishEnd": "2027-03-01",
                    "title": "Scout Leaders",
                    "description": "## Description\n\n\"Scout Sections meet once weekly and sometimes with weekend outdoor activities. We need leaders who are enthusiastic to work with children and pass on skills and expertise in a safe environment for the benefit of young people. Fun and games can be part of the programme but our members undertake 'badge work' which involves learning about a wide variety of new subjects. If you can offer some of your time in assisting youth learning, then we would be very pleased to hear from you. \r\nActivities can range from sailing/ canoeing, mountaineering, archery, camping, wildlife and nature and a range of indoor and more domestic skills which might start with cooking for a group or simply learning to tie knots. \r\nAll our staff are volunteers and there are some relatively simple training modules which all leaders require to undertake and which ensure a high level of safety awareness when dealing with young people. If you are up for a 'challenge' then we'd love to hear from you!\"",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000SsMhfAAF#role",
                        "type": "Role",
                        "title": "Scout Leaders",
                        "applyLink": "https://volunteer.scot/search/a0g0800000SsMhfAAF/scout-leaders?#modal_register_a0g0800000SsMhfAAF",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18"
                    },
