        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000VaNYxYAN",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000VaNYxYAN/pets-as-therapy-aberdeen-aberdeenshire",
            "name": "Pets As Therapy (Aberdeen & Aberdeenshire)",
            "description": "Pets As Therapy (PAT) is a national charity that enhances the health and wellbeing of thousands of people in communities across the UK. We strive to ensure that everyone, no matter their circumstances, has access to the companionship of an animal. \r\n\r\nOur volunteers and their temperament-assessed pets visit establishments such as care homes, hospitals, hospices, schools and prisons, and bring smiles to many faces. People of all ages get the chance to chat to someone — and stroke a friendly dog or cat.",
            "website": "https://petsastherapy.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038910"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
