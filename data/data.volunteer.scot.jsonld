            "id": "https://data.volunteer.scot/Organisation/0010800002yxAIcAAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002yxAIcAAM/golf-in-society-cic-clacks",
            "name": "Golf in Society (CIC) (Clacks)",
            "description": "GOLF IN SOCIETY is a social enterprise with a vision to improve the lives of the ageing population by introducing them to the health & wellbeing benefits of golf, particularly in those with dementia and Parkinson's disease",
            "website": "https://golfinsociety.com/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC024309"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/OlderPeople",
