            "id": "https://data.volunteer.scot/Organisation/00124000008nZ3zAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZ3zAAE/relationships-scotland-orkney",
            "name": "Relationships Scotland Orkney",
            "description": "We provide a range of confidential counselling, family mediation and support services. This includes counselling for individuals, couples, children/young people as well as play therapy for younger children and specialist drug/alcohol counselling.\r\n\r\nOur Support Workers can help with a range of issues including relationship breakdown, anxiety and low mood. They can also help with parenting and support for young people as well as provide help for people who want to reduce their alcohol/drug consumption and support for their loved ones. \r\n\r\nOur Child Contact Centre provides a safe space where parents can meet children they no longer live with. \r\n\r\nThese services are offered to people in Orkney free of charge. Our vision is for positive and respectful relationships to be at the heart of our community.",
            "website": "https://www.rsorkney.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC023164"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F4a05f943-8699-a366-02fd-8bda2302141e%2FOIUJpTJYlES85DiBarGLlF56TE12%2Fuser-upload.jpg?alt=media&token=61b33267-b656-4c49-abcb-3a86e81255ce",
