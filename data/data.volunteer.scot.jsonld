        {
            "id": "https://data.volunteer.scot/Organisation/00124000008ncvlAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ncvlAAA/the-pars-foundation",
            "name": "The Pars Foundation",
            "description": "Established in 2013, The Pars Foundation are responsible for the\r\nrunning of the community programme on behalf of Dunfermline\r\nAthletic Football Club.\r\n\r\nOur aim is to provide a wide and diverse programme of events. We strive to make a positive difference in the local community through our innovative and inclusive programme of activities. Encouraging active lifestyles & opportunities while promoting health and wellbeing.\r\nWe have a vision that we will work in partnership with others building stronger, healthier, happier and successful communities, both at home and abroad.",
            "website": "https://parsfoundation.co.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC043970"
                }
            ],
            "cause": [
