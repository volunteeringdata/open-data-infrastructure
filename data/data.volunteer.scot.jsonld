                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000OUwZjAAL",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000OUwZjAAL/retail-volunteer-dundee",
