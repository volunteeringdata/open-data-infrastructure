                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000002hmrRYAQ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000002hmrRYAQ/advocacy-support-session-volunteer-north-ayrshire",
