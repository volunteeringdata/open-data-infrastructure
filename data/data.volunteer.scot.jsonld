        {
            "id": "https://data.volunteer.scot/Organisation/0011p00001lQPJ2AAO",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00001lQPJ2AAO/lead-scotland-north-east-of-scotland-services",
            "name": "Lead Scotland (North East of Scotland Services)",
            "description": "Lead Scotland - Specialists in Linking Education and Disability, is a voluntary organisation set up to empower disabled young people and adults and carers across Scotland to access learning opportunities",
            "website": "https://www.lead.org.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
