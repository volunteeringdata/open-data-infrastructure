        {
            "id": "https://data.volunteer.scot/Organisation/0011p00001hYxUfAAK",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00001hYxUfAAK/south-lanarkshire-council",
            "name": "South Lanarkshire Council",
            "description": "The Local council  for the South Lanarkshire area",
            "website": "https://www.southlanarkshire.gov.uk",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g1p00000DH3pvAAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g1p00000DH3pvAAD/mauldslie-woods-conservation-volunteer",
                    "publishStart": "2026-11-09",
                    "publishEnd": "2027-04-05",
                    "title": "Mauldslie Woods Conservation Volunteer",
                    "description": "## Summary\n\nCCI engages people with support needs in projects which make a significant contribution to local communities. We build community gardens, work on nature reserves and public art works. Volunteers work alongside groups sharing skills.\n\n## Description\n\nLove being outdoors?  Love your local woodland? Join the Mauldslie Woods Volunteering Team.  Come along and carry out a variety of practical woodland conservation and management tasks, whilst having fun, learning new skills and meeting new people. The group meet on Mauldslie Bridge in Carluke at 10.15am and the group runs until 3.00pm.\n\n## Experience required\n\nNo Expertise, Hard Working,Practical,Team Player,\n\n## Travel details\n\nThe opportunity takes place at multiple location across South Lanarkshire \nCarluke,Dalserf",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g1p00000DH3pvAAD#role",
                        "type": "Role",
                        "title": "Mauldslie Woods Conservation Volunteer",
                        "description": "No Expertise, Hard Working,Practical,Team Player,",
                        "applyLink": "https://volunteer.scot/search/a0g1p00000DH3pvAAD/mauldslie-woods-conservation-volunteer?#modal_register_a0g1p00000DH3pvAAD",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
                        "theme": [
