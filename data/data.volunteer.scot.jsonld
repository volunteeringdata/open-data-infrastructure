        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002lJczsAAC",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002lJczsAAC/change-grow-live-falkirk",
            "name": "Change Grow Live - Falkirk",
            "description": "If you want to change your direction, grow as a person, and live life to its full potential, we’re here to help you.\r\n\r\nWe’re a health and social care charity. We can help you with challenges including drugs and alcohol, housing, justice, health and wellbeing.\r\n\r\nWe exist to help people achieve their goals, to be the best that they can be and to help change society for the better. This is true whether we are talking about the people who use our services, our staff or our volunteers.\r\n\r\nWe are not in control of everything that impacts upon the people who use our services. However, we are in control of what we do, how we behave and where we focus our expertise, resources and energy.\r\n\r\nOur aim is to work together to challenge stigma and oppression. We want our charity to be a place where our staff and people who use our services are respected and engaged. Ultimately we want to make life safer, easier and better for as many people as we can.",
            "website": "https://www.changegrowlive.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039861"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Addictions",
                    "skos:prefLabel": "Addictions"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/HousingHomelessnessness",
                    "skos:prefLabel": "Housing / Homelessnessness"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SocialCare",
                    "skos:prefLabel": "Social Care"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HqrCvYAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HqrCvYAJ/befriender",
                    "publishStart": "2026-08-04",
                    "publishEnd": "2027-02-02",
                    "title": "Befriender",
                    "description": "## Description\n\nMaking positive life changes can feel overwhelming for the people we support. By volunteering your time as a Befriender, you can make a meaningful difference. Our aim is to empower individuals using our services to build confidence, make informed decisions, and create opportunities for a better future.\r\n\r\nBefriending is a supportive, pro-social relationship between a volunteer and the person they are matched with. As a Befriender, you will work with an individual on a one to one basis, helping to reduce social isolation and encourage engagement in the community. This may involve attending activities, groups, or appointments together, and supporting them to build confidence and develop positive relationships.\r\n\r\nBuilding trust can take time, so consistency, patience, and resilience are key. You will receive full training, guidance, and ongoing support from Change Grow Live to help you feel confident in the role.\r\n\r\nSupporting someone to achieve their goals is incredibly rewarding, and as a Befriender, you have the opportunity to make a real and lasting impact on someone’s life. This role is ideal for a compassionate, non judgmental person who is committed to helping others make positive changes.\n\n## Experience required\n\n- Ability to work within professional boundaries\t\r\n- Good communication skills \r\n- Understanding of the issues faced by the people who use our service\r\n- Excellent time management skills\r\n- Ability to respect and maintain confidentiality\n\n## Training details\n\n- Induction training consists of 6 sessions including Boundaries & Confidentiality, Drug & Alcohol Awareness and Trauma Informed Practice.\r\n- Volunteers have a named supervisor who provides regular 1:1's and annual appraisals.\r\n- Volunteers can take part in development plans and access ongoing training opportunities.\n\n## Frequency commitment details\n\nFlexible - can be arranged with the volunteer.\n\n## Travel details\n\nChange Grow Live, Vicar Street, Falkirk. Train station 5 minute walk. On main bus route. Offsite parking.\n\n## Travel expenses\n\n50p per mile, reimbursement of public transport.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HqrCvYAJ#role",
                        "type": "Role",
                        "title": "Befriender",
                        "description": "- Ability to work within professional boundaries\t\r\n- Good communication skills \r\n- Understanding of the issues faced by the people who use our service\r\n- Excellent time management skills\r\n- Ability to respect and maintain confidentiality",
                        "commitment": "Flexible - can be arranged with the volunteer.",
