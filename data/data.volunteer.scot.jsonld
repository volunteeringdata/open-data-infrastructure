                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000003teHYAQ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000003teHYAQ/volunteer-directors",
                    "publishStart": "2023-09-29",
                    "publishEnd": "2026-11-30",
                    "title": "Volunteer Directors",
                    "description": "## Description\n\nOrkney Zerowaste are seeking new Directors to strategically steer and shape the future of their charity, including the redevelopment of their community reuse and recycling site in Stromness. With a new 5-year lease, planning permission, and funding applications in place for exciting expansions, now is the time to join Orkney Zerowaste to help bring them into a new era! \r\n\r\nDirectors are expected to attend monthly online Board meetings, communicate with external bodies, and collaborate to further Orkney Zerowaste’s interests.\n\n## Experience required\n\nWe are looking for people with a passion for recycling, reusing and repurposing waste.\n\n## Travel expenses\n\nAny expenses will be remunerated.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Ff5d63841-3a8c-48f8-91d1-10d6f4e86036%2F47Tx2kdmwYfilSzPKnW1PvQyS0A2%2Flisting.jpg?alt=media&token=ac36bd4e-cbe6-4bb8-85fe-dfa942ada01c",
