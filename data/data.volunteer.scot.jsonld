        {
            "id": "https://data.volunteer.scot/Organisation/0010800002sV7gNAAS",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002sV7gNAAS/girvan-and-south-carrick-community-action-network-can-sa",
            "name": "Girvan and South Carrick Community Action Network (CAN) (SA)",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000VhnZtAAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000VhnZtAAJ/volunteer-drivers",
                    "publishStart": "2023-02-27",
                    "publishEnd": "2027-04-17",
                    "title": "Volunteer Drivers",
                    "description": "## Description\n\nAre you interested in becoming a volunteer driver? Do you enjoy driving and helping people?\r\n\r\nIf you have your own vehicle and able to offer regular commitment, we have opportunities available in South Carrick.\r\n\r\nWe are looking for volunteer drivers to help us transport people to their GP or hospital appointment. We pay your mileage expenses. If you are interested please get in touch with us or drop by our shop at 40, Dalrymple Street Girvan.\n\n## Experience required\n\nDrivers are required. Drivers must be able to communicate with clients and understanding toward them. Reliability and confidentiality essential. Drivers must have a valid driving licence and have accurate current paperwork for their vehicles.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000VhnZtAAJ#role",
                        "type": "Role",
                        "title": "Volunteer Drivers",
                        "description": "Drivers are required. Drivers must be able to communicate with clients and understanding toward them. Reliability and confidentiality essential. Drivers must have a valid driving licence and have accurate current paperwork for their vehicles.",
                        "applyLink": "https://volunteer.scot/search/a0g0800000VhnZtAAJ/volunteer-drivers?#modal_register_a0g0800000VhnZtAAJ",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "25",
                        "theme": [
                            {
