            "name": "Age Scotland Comradeship Circles (Aberdeen & Grampian)",
            "description": "The Age Scotland Comradeship Circles service aims to reduce loneliness by offering older members of the ex-service community the opportunity to enjoy regular group camaraderie by telephone.",
            "website": "https://www.ageuk.org.uk/scotland/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC010100"
