        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002CIwIUAA1",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002CIwIUAA1/wave-trust-charity-7030-campaign",
            "name": "WAVE Trust Charity-70/30 Campaign",
            "description": "We are a network dedicated to bringing about a 70% reduction in child abuse and neglect by the year 2030 – we are the 70/30 Campaign. 70/30 is not just another campaign - it is part of a highly-developed, long-term, ground-breaking action plan to stop child abuse and neglect from ever beginning. We call this Primary Prevention. The 70/30 Campaign was created by the WAVE Trust charity.",
            "website": "https://www.wavetrust.org/7030",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Advocacy",
                    "skos:prefLabel": "Advocacy"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CampaigningLobbying",
                    "skos:prefLabel": "Campaigning / Lobbying"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
                    "skos:prefLabel": "Volunteering"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g1p00000FLjg5AAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g1p00000FLjg5AAD/7030-ambassadors",
                    "publishStart": "2026-08-17",
                    "publishEnd": "2027-02-15",
                    "title": "70/30 Ambassadors",
                    "description": "## Description\n\nThe 70/30 Campaign is aiming to reduce child abuse and neglect by 70% by 2030. As a 70/30 Ambassador you will be empowering your local community to protect our children by spreading awareness and gaining support to prevent child abuse and neglect from happening in the first place. You will gain new skills, and be part of a large network of volunteers and professionals, while making a real difference in your local community and across the UK.\r\n\r\n\r\nThe role is very flexible and depends on your skills and on the needs in your local area, but you can take part in a range of activities, such as: spreading awareness with people you know and on social media; fundraising; organising events; engaging with MPs, MSPs, AMs and councillors; engaging with local press; expanding your local 70/30 group.\r\n\r\n\r\nAmbassadors will take part in a training session with a member of the team and are invited to join the bi-monthly national conference call with other ambassadors across the country. Ambassadors usually give 2 or more hours of their time a week, but get in touch if you are interested and don't have much time available as there is always some way you can help!\r\n\r\n\r\nPlease visit our website and complete the form to become an ambassador today at www.wavetrust.org/7030 or contact Alex Williamson at email: awilliamson@wavetrust.org.\n\n## Experience required\n\nOther than passion for the cause, each Ambassador will bring their own skills and experience to the role. The role is extremely flexible and all necessary training and support is provided.\n\n## Training details\n\nGood support is provided to all volunteers. There is an initial training session with a member of the team either in person or over a conference call. Ambassadors are then invited to take part in the bi-monthly national calls, and can ask for any support needed.\n\n## Frequency commitment details\n\nFlexible times available to suit volunteers. All help is greatly appreciated.\n\n## Travel details\n\nVolunteer opportunities available across Aberdeen City and Aberdeenshire.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g1p00000FLjg5AAD#role",
                        "type": "Role",
                        "title": "70/30 Ambassadors",
                        "description": "Other than passion for the cause, each Ambassador will bring their own skills and experience to the role. The role is extremely flexible and all necessary training and support is provided.",
                        "commitment": "Flexible times available to suit volunteers. All help is greatly appreciated.",
                        "applyLink": "https://volunteer.scot/search/a0g1p00000FLjg5AAD/7030-ambassadors?#modal_register_a0g1p00000FLjg5AAD",
                        "allowsRemoteParticipation": false,
