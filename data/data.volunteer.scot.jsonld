            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HxQJHYA3",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HxQJHYA3/catering-volunteer",
                    "publishStart": "2026-10-05",
                    "publishEnd": "2027-02-04",
                    "title": "Catering Volunteer",
                    "description": "## Description\n\nTaking orders \n\nPrepare teas/coffees \n\nServe food to customers \n\nClear and clean tables \n\nParticipate as part of a team\n\nAssist in the opening/closing of the Kafe as appropriate \n\nLoading and unloading of the dishwasher \n\nParticipate in training as required \n\nSupporting hospice catering events\n\n## Experience required\n\nCatering / Hospitality,Cleaning / Tidying / Sorting,Retail / Customer Service, Good Communicator,Good Listener,Hard Working,Organised,Practical,Reliable / Dependable,Social Conscience,Team Player,Trustworthy,\n\n## Training details\n\nHospice Induction - Role Specific Induction - 4 Week Training - Minimum Support and Supervision on going\n\n## Travel details\n\nThe opportunity takes place at multiple location across South Lanarkshire \nEast Kilbride\n\n## Travel expenses\n\nReasonable travelling to and from the place of volunteering is authorised by the line Manager.",
                    "requiresEmergencyParticipation": false,
