        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXfaAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXfaAAE/british-heart-foundation-202-union-street",
            "name": "British Heart Foundation - 202 Union Street",
            "description": "We fight for every heartbeat. \r\nCoronary heart disease is the countrys single biggest killer but we are leading the fight against it. \r\n\r\nVolunteering Changes Lives \r\n\r\nBHF Retail are now recruiting volunteers for flexible opportunities for our shops s raising funds for valuable research through our retail shops and stores. \r\nThere are lots of benefits to volunteering, such as developing your existing skills, gaining new skills and supporting a cause you care about. Whatever your reason for joining, you can expect to have lots of fun and meet some great people. \r\n\r\nHowever you choose to volunteer your time helps us to save lives. Our volunteers help our fight for every heartbeat and make a big difference in their local communities. As one of our volunteers you will receive a full induction and further training in specific roles. \r\nYour support powers our research. Every pound raised and every minute of your time will help make a massive difference to people's lives. Join the fight for every heartbeat.",
            "website": "https://bhf.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039426"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CharityShop",
                    "skos:prefLabel": "Charity Shop"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
