            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000IMS4vYAH",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000IMS4vYAH/volunteer-content-creator-help-share-real-stories-of-access",
                    "publishStart": "2026-04-20",
                    "publishEnd": "2027-03-19",
                    "title": "Volunteer Content Creator - help share real stories of access",
                    "description": "## Description\n\nHelp others explore with confidence\r\n\r\nDo you want to make the world more accessible? You can – by sharing your experiences of disabled access.\r\n\r\nAt Euan’s Guide, we believe that what you know helps others go. By reviewing places you visit – whether it is a favourite café, a museum with good access or somewhere that could improve – you are helping someone else feel more confident about going out.\r\n\r\nYou do not need to be an expert or write loads. Just say what it was like for you.\r\n\r\nWhether it is your first review or your fiftieth, your voice matters. Your insight could be the reason someone tries somewhere new, avoids a difficult experience or feels seen for the first time.\r\n\r\nJoin our volunteer community today and help us grow a trusted resource of real, practical reviews – written by people who have been there.\r\n\r\nNo one understands access like you do.\r\nMore voices mean better choices.\n\n## Training details\n\nVolunteers will have a friendly informal chat online or in person with one of our volunteer coordinators. They will be shown how to use the Euan's Guide website to start Sharing their experiences.\n\n## Frequency commitment details\n\nVolunteers can take part in this opportunity at a time and place that suits them\n\n## Travel details\n\nVolunteers can take part in this opportunity from their own home, or when they are out and about.\n\n## Travel expenses\n\nPre-agreed travel expenses will be discussed with a member of the Euan's Guide Team",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000IMS4vYAH#role",
                        "type": "Role",
                        "title": "Volunteer Content Creator - help share real stories of access",
                        "commitment": "Volunteers can take part in this opportunity at a time and place that suits them",
