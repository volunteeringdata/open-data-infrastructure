            "dc:source": "https://volunteer.scot/organisations/0010800002zsOnWAAU/survivors-of-human-trafficking-in-scotland-sohtis",
            "name": "Survivors of Human Trafficking in Scotland (SOHTIS)",
            "description": "SOHTIS s the leading anti-human trafficking organisation in Scotland. We believe everyone deserves to live in freedom with dignity and respect and we are committed to recovering of victims of human trafficking and the long-term support for survivors.",
            "website": "https://sohtis.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC048296"
                }
            ],
            "cause": [
