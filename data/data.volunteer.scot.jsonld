        {
            "id": "https://data.volunteer.scot/Organisation/00124000008ngprAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ngprAAA/relationships-scotland-counselling-highland",
            "name": "Relationships Scotland-Counselling Highland",
            "description": "To offer a Relationship Counselling Service throughout the Highland Region.",
            "website": "https://www.relationships-scotland.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC001163"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000GCt2kYAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000GCt2kYAD/various-roles",
                    "publishStart": "2026-04-06",
                    "publishEnd": "2027-04-05",
                    "title": "Various Roles",
                    "description": "## Description\n\nAt Counselling Highland, we’ve been supporting individuals and families across the Highlands for over 30 years. As we enter an exciting new chapter of growth and innovation, we’re inviting compassionate, curious, and community-minded people from all walks of life to join us as volunteers.\r\n\r\nWhether you’re looking to:\r\n✨ Learn new skills & gain valuable work experience\r\n✨ Build your confidence and sense of purpose\r\n✨ Improve your own wellbeing and mental health\r\n✨ Meet like-minded people and make new friends\r\n✨ Give something back to your community\r\n✨ Help improve how things work—for the better\r\n\r\nWe are currently seeking volunteers for the following roles:\r\n🔹 Intake Workers – the first friendly point of contact for those seeking support\r\n🔹 Healthy Relationships Project Worker –  get on board with this brand new exciting project delivering preventative work in the community\r\n🔹 Admin & Office Support – helping keep the heart of our service running smoothly\r\n\r\nNo specific experience is necessary—just kindness, reliability, and a willingness to get involved. We welcome volunteers from all backgrounds, ages, and abilities, and we’ll provide full support and training to help you thrive in your role.\n\n## Training details\n\n- Confidentiality and GDPR\r\n- Mental health awareness \r\n- Safeguarding \r\n- Equality and Inclusion",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F464cb52b-d321-4979-ad2d-91d78f3ac00f%2FJqK8q7mcUtcgywKvmhEW9RRQbgy1%2Flisting.jpg?alt=media&token=157fbb18-05bd-4757-9ecc-35706d52cae2",
