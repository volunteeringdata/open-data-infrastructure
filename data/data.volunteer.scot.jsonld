                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000H2DsDYAV",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000H2DsDYAV/walk-leader",
                    "publishStart": "2026-05-28",
                    "publishEnd": "2026-11-26",
                    "title": "Walk Leader",
                    "description": "## Description\n\nJewish Care Scotland leads a weekly walking group in the local area.\r\n\r\nMeeting each Tuesday morning from 10.30 am, we are looking for volunteers to support our group.  The group have different abilities and goals and we are looking for volunteers of all fitness levels and abilities to join in.\r\n\r\nVolunteers are not required to be available every week and will be added to the volunteer rota to suit their availability.\r\n\r\nTravel expenses will be reimbursed.\r\n\r\nTraining will be provided and successful applicants will be required to complete a PVG check.\n\n## Travel details\n\nMay Terrace, Giffnock, G46 6LD",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fc69e277b-2c31-48c8-a0a0-0283173e21e8%2FyKvNsCtq9ZNPsjkwuXTxwxTv3Tx2%2Flisting.jpg?alt=media&token=689db06e-d6c8-4b25-8ec3-334db73fcdd7",
