        {
            "id": "https://data.volunteer.scot/Organisation/0010800002uqzYzAAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002uqzYzAAI/we-are-here-scotland-cic",
            "name": "We Are Here Scotland CIC",
            "description": "We Are Here Scotland is a Community Interest Company creating spaces and working with a variety of artists and creatives within Scotland's creative industries.\r\n\r\nFrom visual arts to music, dance, poetry, photography and beyond, our community's stories deserve to be heard, celebrated, and properly supported. We create platforms and opportunities for our community through professional development, advocacy, mentoring, showcases, workshops, and public events. Whether you're an established creative or just starting out, we want this space to offer community, connection, and inspiration, whilst building a legacy of equality and representation for future generations. This includes supporting intersectionally within our community.",
            "website": "https://www.weareherescotland.com/",
            "cause": [
