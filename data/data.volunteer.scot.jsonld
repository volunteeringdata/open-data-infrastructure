        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nY2BAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nY2BAAU/samaritans-aberdeen",
            "name": "Samaritans-Aberdeen",
            "description": "Samaritans provides confidential emotional support 24 hours a day by telephone, personal visit, email, and letter, through its branch network – support that includes outreach activity at festivals and outside our centres in prisons, hospitals, schools, the workplace and with homeless people.\r\nOur purpose is to:\r\n•enable persons who are experiencing feelings of distress or despair, including those who may be at risk of suicide, to receive confidential emotional support at any time of the day or night from appropriately trained Samaritans in order to improve their emotional health and to reduce the incidence of suicide; and \r\n•promote a better understanding in society of suicide, suicidal behaviour and the value of expressing feelings which may otherwise lead to suicide or impaired emotional health.",
            "website": "https://www.samaritans.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC010661"
                }
            ],
            "cause": [
