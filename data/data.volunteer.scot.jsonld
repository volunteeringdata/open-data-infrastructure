        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nb0kAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nb0kAAA/express-group-fife",
            "name": "Express Group Fife",
            "description": "For almost 50 years people in Fife experiencing mental health problems have been able to turn to Express Group Fife to help them cope and recover. The aim of the groups is to promote positive mental health and wellbeing by providing a safe place for sharing experiences and peer support. There are currently eleven groups at nine locations across Fife each week, providing various activities to encourage social interaction and confidence building, helping to make new friends and make the most of life in the community. The groups are run by a dedicated group of staff, volunteers and very much by the members themselves, which creates a tremendous feeling of belonging and safety. For some, the groups are perhaps the only place they can meet people and socialise; for others, they are a chance to help and show what they can do. The cooked meal at the end of the morning is a definite draw for many!",
            "website": "https://www.expressgroupfife.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC015338"
                }
            ],
