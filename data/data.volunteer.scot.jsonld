            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000008zx3NYAQ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000008zx3NYAQ/treasurer",
                    "publishStart": "2025-03-19",
                    "publishEnd": "2027-01-18",
                    "title": "Treasurer",
                    "description": "## Description\n\nThe John Rae Society (JRS) is looking for a new Treasurer with experience of charity accounting and/or business planning and capital project delivery, to help lead our exciting Hall of Clestrain development projects over the next 5 years.\r\n\r\nWe are looking for a passionate individual dedicated to public education and heritage preservation, proactive and engaged in Board discussions.\r\n\r\nYou will have the opportunity to gain valuable experience in charity finance and in rescuing internationally significant heritage.\n\n## Experience required\n\nWe're looking for someone with a finance and/or management accounting background, who has a positive outlook and is prepared to help both strategically and practically.\n\n## Training details\n\nA full induction will be provided.\n\n## Travel expenses\n\nTravel and expenses can be paid.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fa5a139bf-7c38-4c2c-9454-4d3231126e17%2FliLEC2s9ZwYA46gEa6AxGTVGunx2%2Flisting.jpg?alt=media&token=deb5440b-67d1-4eef-a17f-09705e9415e5",
