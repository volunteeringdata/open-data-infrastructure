            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000086JY1YAM",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000086JY1YAM/treasurer",
                    "publishStart": "2025-01-23",
                    "publishEnd": "2027-02-10",
                    "title": "Treasurer",
                    "description": "## Description\n\nAt Dalkeith Citizens Advice Bureau we are looking to appoint a new unremunerated treasurer to join our board. We play an important role in serving the community across Midlothian. As treasurer you will contribute to ensuring Board Members are aware of their financial responsibilities with sufficient understanding of the CAB’s financial systems, policies and reports to enable effective Board decision-making. This includes attending Bi-monthly board meetings with hall members. Presenting financial information and reports to Board meetings, General Meetings, strategic review and planning exercises or other meetings as needed. Guiding and advising the Board in their consideration of budgets, accounts, financial statements, financial procedures and other financial issues, including the financial implications of the strategic and project plans. Further requirements will be discussed on application.\n\n## Experience required\n\nYou do not need to have prior experience of being a board treasurer, but some experience or knowledge of charity financial management and fundraising is beneficial. An ability to understand, analyse and make recommendations related to financial information is necessary. An ability to present often complex financial information to the Board and other stakeholders to ensure their understanding. A general understanding of legal and regulatory requirements for charity financial activities, and a willingness to be available to staff to provide support and guidance on financial matters.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F1a40f951-fdcf-4d4d-8646-b0888e76bcbe%2FWkLzgT1VE9cAHEWcVMpdVMd5bL63%2Flisting.jpg?alt=media&token=512d5a74-ab7a-475c-973f-4c0e201499e7",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD0000086JY1YAM#role",
                        "type": "Role",
