            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HktvmYAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HktvmYAB/swimming-support-volunteer-barra",
                    "publishStart": "2026-07-13",
                    "publishEnd": "2027-02-26",
                    "title": "Swimming Support Volunteer (Barra)",
                    "description": "## Description\n\nWe take children swimming once a week, ratio is 1 adult to 2 children, and we have a lot of children!  It would be great if there are any volunteers in the community willing to help us out.  Volunteers are expected to support and supervise children in the water, helping to ensure their safety and encourage their participation in the water.  Nursery staff are responsible for assisting the children with changing before and after swimming, including any personal care.  Volunteers will not be expected to provide intimate care, assist with toileting or help children get changed.  This volunteering opportunity is only available to residents on Barra and Vatersay, and will require a PVG.\n\n## Frequency commitment details\n\nStarting mid August.  Wednesday morning 09.30am - 10.30 am during term time only",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HktvmYAB#role",
                        "type": "Role",
