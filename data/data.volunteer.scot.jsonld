        {
            "id": "https://data.volunteer.scot/Organisation/0012400000fcjtmAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000fcjtmAAA/cancer-research-uk-union-street-store",
            "name": "Cancer Research UK: Union Street Store",
            "description": "Lets beat cancer sooner! At Cancer Research UK we pioneer research to bring forward the day when all cancers are cured. We fund scientists, doctors and nurses to help beat cancer sooner. We also provide cancer information to the public.",
            "website": "https://www.cancerresearchuk.org",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CharityShop",
                    "skos:prefLabel": "Charity Shop"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
