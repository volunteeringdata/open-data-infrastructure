                        "commitment": "Flexible times and days available to suit volunteers. All help greatly appreciated.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000I1yMLYAZ/compass-shop-assistant-volunteers?#modal_register_a0gQD00000I1yMLYAZ",
                        "allowsRemoteParticipation": false,
