        {
            "id": "https://data.volunteer.scot/Organisation/0012400001BdA4gAAF",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400001BdA4gAAF/cycling-without-age-scotland",
            "name": "Cycling Without Age Scotland",
            "description": "Giving our elderly generation and people with limited mobility the right to wind in their hair by enabling Cycling Without Age to be rolled out across Scotland. Supporting Community Groups, Care Homes, Sheltered Housing Associations.",
            "website": "https://cwas.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC048128"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
                    "skos:prefLabel": "Befriending / Mentoring"
                },
                {
