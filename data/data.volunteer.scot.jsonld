        {
            "id": "https://data.volunteer.scot/Organisation/0011p00001x9RxuAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00001x9RxuAAE/scvo",
            "name": "SCVO",
            "description": "SCVO is the Scottish Council for Voluntary Organisations, the national membership organization for Scotland's voluntary sector. Its mission is to support and develop a sustainable voluntary sector by providing resources, acting as an advocate, and highlighting the sector's vital role in areas like poverty reduction, social justice, and environmental protection. SCVO's activities include publishing policy reports, conducting research on sector challenges, and publishing Third Force News (TFN), Scotland's only specialist publication for the voluntary sector, according to the Scottish Council for Voluntary Organisations.",
            "website": "https://scvo.scot/",
            "charityRegistration": [
