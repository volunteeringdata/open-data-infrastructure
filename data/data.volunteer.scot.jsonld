        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000JWc5mYAD",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000JWc5mYAD/chest-heart-and-stroke-north-ayrshire",
            "name": "Chest Heart and Stroke North Ayrshire",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000BVl4MYAT",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000BVl4MYAT/kindness-volunteer",
                    "publishStart": "2026-09-07",
                    "publishEnd": "2027-03-01",
                    "title": "Kindness Volunteer",
                    "description": "## Description\n\nou will support people living with our conditions to reduce feelings of loneliness and isolation by providing a “light touch,” person centred, telephone call service once per week. An easy going and warm outlook would be advantageous to this role.\r\n\r\nEveryone has the right to live life to the full. After a diagnosis of a chest or heart condition, stroke, or Long Covid, many people experience fear and isolation, and struggle with the impact on their lives. The care and support we deliver every day ensures everyone can live the life they want to. Across Scotland, we provide vital advice, information, and support through our No Life Half Lived strategy.\n\n## Experience required\n\nGood listening and communication skills\r\nReliable, patient & empathic qualities\r\nRespectful of the opinions of others\r\nAble to maintain boundaries\r\nAbility to work independently with guidance and support\r\nAn understanding of the importance of maintaining confidentiality\r\nAmbassador for Chest Heart & Stroke Scotland",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000BVl4MYAT#role",
                        "type": "Role",
                        "title": "Kindness Volunteer",
                        "description": "Good listening and communication skills\r\nReliable, patient & empathic qualities\r\nRespectful of the opinions of others\r\nAble to maintain boundaries\r\nAbility to work independently with guidance and support\r\nAn understanding of the importance of maintaining confidentiality\r\nAmbassador for Chest Heart & Stroke Scotland",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000BVl4MYAT/kindness-volunteer?#modal_register_a0gQD00000BVl4MYAT",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18"
                    },
