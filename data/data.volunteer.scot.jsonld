            "id": "https://data.volunteer.scot/Organisation/00108000033WsVCAA0",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00108000033WsVCAA0/mcr-pathways",
            "name": "MCR Pathways",
            "description": "MCR Pathways supports young people in or on the edges of the care system to realise their full potential. By providing relationship-based mentoring alongside employment and further & higher education experiences, young people are encouraged to discover and pursue their ambitions.",
            "website": "https://mcrpathways.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC045816"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
                    "skos:prefLabel": "Volunteering"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/YoungPeople",
                    "skos:prefLabel": "Young People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000QNzjuAAD",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000QNzjuAAD/mentor",
                    "publishStart": "2022-02-25",
                    "publishEnd": "2027-02-01",
                    "title": "Mentor",
                    "description": "## Summary\n\nMCR Pathways is a school-based mentoring programme that connects young people who need additional encouragement, with a supportive mentor. We support volunteer mentors who meet their mentees weekly, in school, for a year or more.\n\n## Description\n\nMCR Pathways is a multi-award-winning mentoring programme helping Scotland’s care-experienced and vulnerable young people achieve the same educational outcomes, career opportunities and life chances as all other young people.\r\n \r\nAt the core of the MCR Programme are 1 hour weekly in-school meetings between a young person and mentor, who listens and provides encouragement.\r\n \r\nMCR Mentors come from all walks of life and commit to supporting a young person in school for a minimum of a year, ideally two. They are trained and supported by MCR throughout the mentoring relationship.\r\n \r\nExternal research shows that MCR mentoring has made a significant and lasting impact on young people’s confidence and self-esteem, in addition to school staying-on rates, attainment and progression to positive destinations - college, university, and employment.\r\n \r\nShare an hour and support a young person to reach their potential. When one person mentors, two lives are changed. Get involved! https://mcrpathways.org/become-a-mentor/\n\n## Experience required\n\nNo specific skills or experiences are required. Training will be completed in the onboarding process and support will be provided throughout the mentoring journey.\n\n## Frequency commitment details\n\n1 hour per week, during the school day.\n\n## Travel details\n\nIn 1 of 9 Dundee secondary schools - Baldragon Academy, Braeview Academy, Craigie High School, Grove Academy, Harris Academy, Morgan Academy, St John's RC High School, St Paul's RC Academy and Rockwell Learning Centre.\n\n## Travel expenses\n\nPlease note: No expenses are paid for this opportunity",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000QNzjuAAD#role",
                        "type": "Role",
                        "title": "Mentor",
                        "description": "No specific skills or experiences are required. Training will be completed in the onboarding process and support will be provided throughout the mentoring journey.",
