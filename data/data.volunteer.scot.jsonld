        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZnTAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZnTAAU/st-davids-bradbury-day-centre",
            "name": "St David's Bradbury Day Centre",
            "description": "The key principals, aims and objectives of the day service are to maintain privacy, confidentiality, dignity, independence, and choice for older people and their carers residing in Midlothian.  The opportunities which we provide to our service users and their carers allow them to participate in activities which they may have become excluded from because of their ill health, isolation or loneliness.  The social support is designed to increase their confidence and their self-esteem and to support people to live in their own home for as long as possible.",
            "website": "https://www.stdavidsbradburydaycentre.org.uk",
