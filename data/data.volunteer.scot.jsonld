                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000000eOHrAAM",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000000eOHrAAM/drivers-for-people-carrier-mini-bus",
                    "publishStart": "2010-03-23",
                    "publishEnd": "2027-01-15",
                    "title": "Drivers for People Carrier & Mini Bus",
                    "description": "## Description\n\nWe are looking for drivers for our people carrier and mini bus.  Drivers will pick up in and around Barrhead and Neilston on a Thursday afternoon (1 - 4.30 pm) to bring our members to Afternoon Tea at Barrhead Resource Centre.  Drivers for people carrier must have a full clean driving license and drivers for minibus must have the same but also D1 on license.\n\n## Frequency commitment details\n\nWeekdays.\n\n## Travel details\n\nDrivers need to come to office at Thornliebank Resource Centre to collect address sheets then pick up members and return home when afternoon tea is finished.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fe5363596-1678-4db2-9b31-3f383464880c%2FmQsKXYYIupgt1ub9BeDSGFfo1O33%2Fheader.jpg?alt=media&token=0d7d87db-81ce-47ce-b487-1a895463458e",
