            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000005v3HdYAI",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000005v3HdYAI/community-driver",
                    "publishStart": "2026-10-01",
                    "publishEnd": "2027-03-30",
                    "title": "Community Driver",
                    "description": "## Description\n\nVolunteer Driver to support our Hot Food Delivery Service, delivering a hot nutritious meal to older people in Prestonpans. \r\n\r\nPennypit Delivery is a hot food delivery service that runs every Friday. The delivery service is available to the elderly and socially isolated. We deliver to 45 elderly and 15 socially isolated people within the PSG area. This service allows our staff and volunteers to provide extra support to people within our community. While the main priority is to provide them with a hot meal another positive outcome is that our staff and service users get in contact for a small amount of time to drop off their food before the weekend. For some, the person delivering their food is the only contact they have each week so we make sure to have a wee chat. This service has been another essential program within the befriending project and we are still seeing a need for it within the community with a small increase in numbers being added every month.\n\n## Experience required\n\nDriving\r\nCaring;Good Communicator;Patient;Practical;Reliable / Dependable;Trustworthy",
                    "requiresEmergencyParticipation": false,
                    "role": {
