        {
            "id": "https://data.volunteer.scot/Organisation/001QD00001752T3YAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00001752T3YAI/lighthouse-construction-charity",
            "name": "Lighthouse Construction Charity",
            "description": "The Lighthouse Charity provides 24/7 holistic support to our UK and Ireland construction community on all aspects of emotional, physical and financial wellbeing. \r\n\r\nA crucial element of the charity’s strategy is to provide a range of free and widely available reactive and proactive resources to support the industry.\r\n\r\nWe offer a free and confidential 24/7 helpline, live web chat service and text facility which provides a range of information, guidance and support on a huge variety of wellbeing issues. These services are complemented by our free self-support app, along with our Lighthouse Beacons who provide a safe space for people to share concerns.\r\n\r\nOur Wellbeing Academy offers a variety of free soft skills and leadership training delivered across a variety of platforms to suit every learning style.",
            "website": "https://lighthousecharity.org/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Helplines",
                    "skos:prefLabel": "Helplines"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SelfHelpSupport",
                    "skos:prefLabel": "Self-Help / Support"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HpvfBYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HpvfBYAR/awareness-volunteers-lighthouse-charity",
                    "publishStart": "2026-07-31",
                    "publishEnd": "2027-01-29",
                    "title": "Awareness Volunteers - Lighthouse Charity",
                    "description": "## Description\n\nAwareness Volunteer:\r\nWe are looking for volunteers to deliver talks about the Lighthouse charity. We currently offer two presentations (with additional resources being developed), which can be delivered either face to face or virtually, depending on what suits the client and the volunteer best. These last between 30-45 minutes and training will be provided.\n\n## Experience required\n\nConfidence, public speaking,\n\n## Training details\n\nFull training is provided which entails Initial e-learning, then a scheduled meeting with the volunteer manager to run through the presentations so we can support on style and tone.\n\n## Frequency commitment details\n\nWe ask that you complete a minimum of 1 talk per quarter – more if you have the time.\n\n## Travel details\n\nThere is no expectation for our volunteers to travel for hours, travel costs are reimbursed which is outlined in our volunteer policy and agreement.\n\n## Travel expenses\n\ntravel costs will be reimbursed as outlined in the volunteer policy and agreement.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F9b617067-ba25-4cac-9313-ae42ead0e9c7%2Fm5KbcSc6IkV0T0LHkiDoDEYTyhB2%2Fheader.jpg?alt=media&token=89fbcac3-5a55-456b-bf99-30d71cba1e9c",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HpvfBYAR#role",
                        "type": "Role",
                        "title": "Awareness Volunteers - Lighthouse Charity",
                        "description": "Confidence, public speaking,",
                        "commitment": "We ask that you complete a minimum of 1 talk per quarter – more if you have the time.",
                        "applyLink": "https://lighthousecharity.org/become-a-volunteer-for-the-lighthouse-charity/",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/MentalHealth",
                                "skos:prefLabel": "Mental Health"
                            }
                        ],
                        "service": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/ExpensesPaid",
                                "skos:prefLabel": "Expenses Paid"
