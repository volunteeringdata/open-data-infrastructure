        {
            "id": "https://data.volunteer.scot/Organisation/001QD0000169RrhYAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD0000169RrhYAE/our-dog-foundation",
            "name": "OUR Dog Foundation",
            "description": "OUR Dog Foundation are an APHA approved importer who rescue dogs from kill shelters and off the streets of Romania and then find them loving UK homes. They are a non-profit organisation run entirely by volunteers.",
            "website": "https://ourdogfoundation.org/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HiCLRYA3",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HiCLRYA3/fundraiser",
                    "publishStart": "2026-07-10",
                    "publishEnd": "2027-01-08",
                    "title": "Fundraiser",
                    "description": "## Summary\n\nOUR Dog Foundation are looking for volunteers to join their team and help them increase their capacity to rescue more dogs\n\n## Description\n\nOUR Dog Foundation is a volunteer run organisation operating across the UK that saves dogs from kill shelters and the streets of Romania to provide them with loving homes.\r\n\r\nThey are looking for volunteers to join their team and help them increase their capacity to rescue more dogs. As a Fundraiser, you will run activities or join in with local events to raise awareness and money for the cause. This could be organising a collection in a local supermarket, attending a gala day, or sharing information on how to donate online.\r\n\r\nAs a member of the OUR Dog team, you will connect with other volunteers remotely via Teams to share updates and progress, and may have the opportunity to get involved with other areas of the organisation, including supporting dog surrenders and adoptions.\n\n## Experience required\n\nVolunteers should be comfortable dealing with money and communicating with members of the public.\n\n## Training details\n\nAn induction to the organisation and ongoing support will be available from the existing volunteer team.\n\n## Travel details\n\nThis role can be undertaken from home and in your local area.\n\n## Travel expenses\n\nExpenses can be discussed on a case by case basis.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HiCLRYA3#role",
                        "type": "Role",
                        "title": "Fundraiser",
