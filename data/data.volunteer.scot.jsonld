        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nbxTAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbxTAAQ/st-andrews-hospice",
            "name": "St Andrew's Hospice",
            "description": "St Andrews Hospice is a specialist palliative care hospice, who provide multidisciplinary support for patients, families and carers in the following areas:\n\nUp to 30 inpatient specialist palliative care beds\nOutpatient & Wellbeing services for specialist palliative care services\nCommunity Support at Home Services\nGrief & Bereavement Support Services\nConsultant Led Medical Team\n\nThey are a registered charity providing care and treatment for those living with life-limiting illnesses.",
            "website": "https://www.st-andrews-hospice.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
