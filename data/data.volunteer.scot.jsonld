            "name": "Wee School Pantry",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000VuospAAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000VuospAAB/pantry-helper",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Pantry Helper",
                    "description": "## Description\n\nAn exciting opportunity for someone to be involved in a busy community food larder. We are looking for an enthusiastic and reliable person to help every Thursday between 10am-1pm. and 4pm-6pm. Also on a Friday from 12-1.30pm Main duties will include, unpacking and sorting food items, restocking the pantry and lifting and handling. Some of the work can be quite physically demanding so we require someone who is able to lift and operate a lifting trolley. A drivers licence would be desirable to help with the shifting of stock between larders in the Garnock Valley but this is not essential.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000VuospAAB#role",
                        "type": "Role",
                        "title": "Pantry Helper",
                        "applyLink": "https://volunteer.scot/search/a0g0800000VuospAAB/pantry-helper?#modal_register_a0g0800000VuospAAB",
                        "allowsRemoteParticipation": false
                    },
