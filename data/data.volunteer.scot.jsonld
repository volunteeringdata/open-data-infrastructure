        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nczfAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nczfAAA/coastal-communities-museum",
            "name": "Coastal Communities Museum",
            "description": "The development of the Coastal Communities Museum is the culmination of a ten year community campaign to reopen and redevelop the Museum previously housed in the upper floors of the Grade C Listed 1876 North Berwick School building in School Road.\r\n \r\nThe redevelopment is a Partnership between East Lothian Council (ELC) and local people which is designed to represent the rich culture and heritage, not just of North Berwick, but of all the communities in the North Berwick Coastal Ward which includes Aberlady, Gullane, Dirleton, Whitekirk and the hinterland.",
            "website": "http://www.coastalmuseum.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC043666"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
                    "skos:prefLabel": "Arts and Culture"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
