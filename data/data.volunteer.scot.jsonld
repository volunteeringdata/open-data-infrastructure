            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000008syIjYAI",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000008syIjYAI/tv-ayrshire-volunteer-crew-16-25-years",
                    "publishStart": "2025-03-11",
                    "publishEnd": "2027-01-05",
                    "title": "TV Ayrshire Volunteer Crew (16 - 25 years)",
                    "description": "## Description\n\nEstablished in May 2014 by Taylor McInroy and Eddy Gemmell, Ayrshire Film Co. was set up as a Community Interest Company to create a difference within Ayrshire. Our goal is to become an asset for our community, so that in the decades to come young people in Ayrshire can be creative, community groups can be recognised for their work and local businesses can thrive. We want to collaborate with people and organisations that share our vision.\r\nhttps://ayrshirefilmco.org/\r\n\r\nWe are currently recruiting 35 creative minds.  If you're aged 16 - 25, live in Ayrshire and have a passion for media then this is the opportunity for you!\r\n\r\nYour commitment:-\r\nVolunteer 4 hours per month to attend sessions and create content\r\nAttend monthly 'in person' training in Ayrshire\r\nOne year commitment April 2025 to 2026\r\nBring ideas ,enthusiasm and a positive attitude to the crew\r\n\r\nWhat you get:-\r\nAccess professional equipment and real-world experience\r\nAttend training sessions and masterclasses in media\r\nEngage with our community and build your own portfolio\r\nGet one - on- one  support to achieve your career goals\r\nWork in a team and become a TV Ayrshire Ambassador",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F1a7019a1-ba02-40f0-aded-a2f3af26e602%2F0nFCUqNjeiXPIFO483j0BVWArU43%2Flisting.jpg?alt=media&token=8c208fed-23a5-4bd0-8c5e-6caa53cdfe5f",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000008syIjYAI#role",
                        "type": "Role",
                        "title": "TV Ayrshire Volunteer Crew (16 - 25 years)",
