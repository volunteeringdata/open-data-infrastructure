        {
            "id": "https://data.volunteer.scot/Organisation/0010800003F1SPjAAN",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003F1SPjAAN/st-johns-patient-transport-north-ayrshire",
            "name": "St Johns Patient Transport - North Ayrshire",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HuyqvYAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HuyqvYAB/volunteer-cpr-champion",
                    "publishStart": "2026-08-20",
                    "publishEnd": "2027-02-18",
                    "title": "Volunteer CPR Champion",
                    "description": "## Description\n\nHelp your community feel confident to act in an emergency. St John Scotland is looking for friendly, approachable volunteers to become CPR Champions - supporting informal awareness sessions that teach simple, lifesaving skills like CPR and how to use a public access defibrillator (PAD). \r\nWhat you’ll do: • Deliver informal CPR awareness sessions • Show people how to use a defibrillator • Support local events and community groups • Help build confidence to act in an emergency\n\n## Experience required\n\nBe a positive ambassador for St John Scotland, always acting professionally and respectfully. • Feel confident speaking to small groups and engaging with a range of audiences. • Be able to demonstrate CPR, including kneeling and performing chest compressions (reasonable adjustments will be considered where appropriate). • Be reliable, proactive, and willing to learn. • Be able to travel locally to attend sessions and events.\n\n## Training details\n\nFull training provided to deliver bystander CPR awareness sessions. • Ongoing support from the Area CPR Lead and wider volunteer structure. • Refresher training or updates as required. • Covered by St John Scotland’s volunteer insurance when undertaking approved activities.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HuyqvYAB#role",
                        "type": "Role",
                        "title": "Volunteer CPR Champion",
                        "description": "Be a positive ambassador for St John Scotland, always acting professionally and respectfully. • Feel confident speaking to small groups and engaging with a range of audiences. • Be able to demonstrate CPR, including kneeling and performing chest compressions (reasonable adjustments will be considered where appropriate). • Be reliable, proactive, and willing to learn. • Be able to travel locally to attend sessions and events.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000HuyqvYAB/volunteer-cpr-champion?#modal_register_a0gQD00000HuyqvYAB",
                        "allowsRemoteParticipation": false,
                        "reward": [
