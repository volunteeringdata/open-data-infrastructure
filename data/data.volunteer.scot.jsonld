        {
            "id": "https://data.volunteer.scot/Organisation/0011p00002S8Oe3AAF",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00002S8Oe3AAF/abernecessities",
            "name": "AberNecessities",
            "description": "AberNecessities is a local charity. We believe every child deserves the best start possible in life, that’s why AberNecessities aims to provide support to the children of disadvantaged families across Aberdeen and Aberdeenshire. \r\nEverybody, no matter their background and their lifestyle, experiences their own problems and difficulties, but as a parent, providing the basics for your child should never be one of them.\r\n\r\nThat is why AberNecessities work to make sure that families who are experiencing difficulties have the support they need to give their children the best chance in life and make a real difference.",
            "website": "http://www.abernecessities.co.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Carers",
