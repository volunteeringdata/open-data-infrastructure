            "id": "https://data.volunteer.scot/Organisation/001QD00000cB4AaYAK",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000cB4AaYAK/cycling-without-age-scotland-inverurie-kemnay-kintore",
            "name": "Cycling without Age Scotland Inverurie, Kemnay & Kintore",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityEngagement",
                    "skos:prefLabel": "Community Engagement"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000009ypk1YAA",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000009ypk1YAA/co-passenger",
                    "publishStart": "2026-09-01",
                    "publishEnd": "2027-02-23",
                    "title": "Co-Passenger",
                    "description": "## Description\n\nCycling Without Age, a worldwide movement that aims to provide joy and vitality to all through the magic of bicycle rides. Through the simple act of sharing a bike ride, it weaves a sense of community and gathers unique and invaluable stories, unlocked only by the wind and wheels.\r\nCo-passenger is responsible for helping passengers onto and off of trishaw and keeping the passenger company whilst being cycled about.\r\nA great way to support people in the local area to get out and enjoy some time in the community and the wind in their hair.\n\n## Training details\n\nAll volunteers will receive initial health and safety training. Pilots and Co passengers will be trained on how to help passengers on and off the trishaw and pilots will be trained on cycling the trishaw and will undergo an assessment before taking passengers on the trishaw.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Ff33129df-b688-4161-bfff-3fe1374126ca%2FlEXO65grohbx2Afhkqiihbacwbv2%2Flisting.jpg?alt=media&token=1f05436b-9904-4aee-aaec-b2833e7b0f31",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000009ypk1YAA#role",
