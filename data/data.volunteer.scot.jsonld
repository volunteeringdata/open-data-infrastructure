            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000V7LfuAAF",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000V7LfuAAF/urban-shop-volunteer-save-the-children-nicolson-street",
                    "publishStart": "2022-11-21",
                    "publishEnd": "2027-01-31",
                    "title": "Urban Shop Volunteer - Save the Children, Nicolson Street",
                    "description": "## Summary\n\nOur Edinburgh Nicolson Street Save the Children Shop is a modern, contemporary, urbanised street store, unlike any other traditional charity shop you have ever seen - We want you to join us in raising much needed funding and awareness to help improve the lives of children all over the world!\n\n## Description\n\nOur Edinburgh Nicolson Street Save the Children Shop is a modern, contemporary, urbanised street store, unlike any other traditional charity shop you have ever seen - We want you to join us in raising much needed funding and awareness to help improve the lives of children all over the world! No previous experience is required as all training will be provided. Activities include customer service, creative merchandising, working as part of a large and diverse team and having fun!\nShop Volunteer (Nicolson Street) | Save the Children UK Volunteering\n\n## Experience required\n\nNo previous experience is required as all training will be provided on an ongoing basis. \n\nActivities include customer service, creative merchandising, sorting through donations, preparing items for sale, cash handling and working as part of a large and diverse team.\n\n## Training details\n\nWe provide initial training which covers all processes and the health and safety and we then offer  buddy/ongoing training - tailored around the individual and their particular interests and skill sets.\n\n## Travel details\n\nSave the Children Shop\n112 Nicolson Street\nEdinburgh\nEH8 9EJ\n\nOn the main bus route between Princes Street and Cameron Toll - buses include 5, 7,37,47,X62\n\n## Travel expenses\n\nTravel expenses can be reimbursed on acceptance of receipt - this can be done on the day or weekly - whatever is best for the volunteer.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000V7LfuAAF#role",
                        "type": "Role",
                        "title": "Urban Shop Volunteer - Save the Children, Nicolson Street",
                        "description": "No previous experience is required as all training will be provided on an ongoing basis. \n\nActivities include customer service, creative merchandising, sorting through donations, preparing items for sale, cash handling and working as part of a large and diverse team.",
                        "applyLink": "https://volunteer.scot/search/a0g0800000V7LfuAAF/urban-shop-volunteer-save-the-children-nicolson-street?#modal_register_a0g0800000V7LfuAAF",
