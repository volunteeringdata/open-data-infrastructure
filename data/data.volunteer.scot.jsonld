        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXZxAAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXZxAAM/patients-advocacy-service",
            "name": "Patients Advocacy Service",
            "description": "The Patients Advocacy Service works in a unique environment with some of the most vulnerable people within the mental health system. We aim to provide information, support and assistance to as many of the patients living in the State Hospital as possible.",
            "website": "https://N/a",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC041185"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/LearningDisability",
                    "skos:prefLabel": "Learning Disability"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/PhysicalDisability",
