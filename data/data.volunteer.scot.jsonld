        {
            "id": "https://data.volunteer.scot/Organisation/00124000010ES55AAG",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000010ES55AAG/fledgling-arts-collective-central-dundee",
            "name": "Fledgling Arts Collective Central (Dundee)",
            "description": "Fledgling Arts Collective Central are a volunteer run charity providing a platform both online and offline for those who struggle with mental health, addiction, gender dysphoria, sexuality &/or feel like they don't quite 'fit'. We encourage you to express yourselves through art as catharsis. Combining Art & Catharsis, we believe in being CathARTic.",
            "website": "http://www.fledglingartscollectivecentral.com/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Addictions",
                    "skos:prefLabel": "Addictions"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/MentalHealth",
                    "skos:prefLabel": "Mental Health"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000003NHx9AAG",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000003NHx9AAG/outreach-assistant",
                    "publishStart": "2018-06-05",
                    "publishEnd": "2027-02-01",
                    "title": "Outreach Assistant",
                    "description": "## Summary\n\nWe are non-profit-making-volunteer run Arts Collective & charity providing a platform both online and offline for those who struggle with mental health, addiction, gender dysphoria, sexuality, feel like they don't quite 'fit', or feel estranged to this world ,\n\n## Description\n\nWe are non-profit-making-volunteer run Arts Collective & charity providing a platform both online and offline for those who struggle with mental health, addiction, gender dysphoria, sexuality, feel like they don't quite 'fit', or feel estranged to this world: to express themselves through art.\r\n\r\nWe are looking for Online Volunteers who will respond to our members in either a live chat (booked in advance) or via email messaging style. Fledgling is currently run by Volunteers online , so this would be an online post.\n\n## Experience required\n\nWe are looking for people who are both trained and untrained in mental health counselling, a good listener is an absolute must . Also it would be helpful if you have some experience of mental health struggles, but not essential. You should have passion and compassion for mental health also;\r\ngood communication and interpersonal skills; dedication, commitment, working on own initiative, reliable, Organised \r\nAt ease dealing with people\n\n## Training details\n\nOnline mentoring\n\n## Frequency commitment details\n\n2 days a week minimum, Monday - Sunday all week\n\n## Travel details\n\nHome based.\n\n## Travel expenses\n\nPlease note: No expenses are paid for this opportunity",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g24000003NHx9AAG#role",
                        "type": "Role",
                        "title": "Outreach Assistant",
                        "description": "We are looking for people who are both trained and untrained in mental health counselling, a good listener is an absolute must . Also it would be helpful if you have some experience of mental health struggles, but not essential. You should have passion and compassion for mental health also;\r\ngood communication and interpersonal skills; dedication, commitment, working on own initiative, reliable, Organised \r\nAt ease dealing with people",
                        "commitment": "2 days a week minimum, Monday - Sunday all week",
