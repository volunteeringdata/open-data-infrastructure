        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000eB24JYAS",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000eB24JYAS/south-lanarkshire-disability-sport",
            "name": "South Lanarkshire Disability Sport",
            "description": "South Lanarkshire Disability Sport is a registered charity where the main aim is to lead in the development of sport for people with physical, sensory or learning disabilities.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC053835"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000B7qLJYAZ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000B7qLJYAZ/session-volunteer",
                    "publishStart": "2026-07-17",
                    "publishEnd": "2027-01-01",
                    "title": "Session Volunteer",
                    "description": "## Description\n\n🎯 Get Involved — Volunteer with Multisport & Boccia Sessions! 🎯\n\nDo you enjoy sport, meeting new people, and making a positive difference?\n\nWe’re looking for friendly, enthusiastic volunteers to help out at multisport and boccia sessions for children and adults with disabilities across South Lanarkshire.\n\nNo experience is needed — just bring a smile, some energy, and a willingness to get stuck in. Whether you're helping set up games, supporting participants, or cheering from the sidelines, your time will really count.\n\nA few hours a week can make a huge difference.\n\nWe run sessions weekly, on Friday evenings, at Alistair McCoist Sport Complex in East Kilbride 5-7pm! \n\nWe are always looking for other support in various clubs and sessions across South Lanarkshire, so please get in touch! \n\nGet in touch on South Lanarkshire Disability Sport Social Media platforms, or email the team at SLDisabilitysport@outlook.com to find out more or apply.\n\n## Experience required\n\nNo Expertise, Caring,Open minded,Team Player,\n\n## Training details\n\nNo experience needed, all training will be ongoing and opportunity for CPD course and workshop opportunities.\n\n## Travel details\n\nThe opportunity takes place at multiple location across South Lanarkshire Yes\nAcross South Lanarkshire,East Kilbride\n\n## Travel expenses\n\nTravel expenses paid",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000B7qLJYAZ#role",
                        "type": "Role",
                        "title": "Session Volunteer",
                        "description": "No Expertise, Caring,Open minded,Team Player,",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000B7qLJYAZ/session-volunteer?#modal_register_a0gQD00000B7qLJYAZ",
                        "allowsRemoteParticipation": false,
