        {
            "id": "https://data.volunteer.scot/Organisation/0010800003ILpNFAA1",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003ILpNFAA1/nspcc-midlothian",
            "name": "NSPCC (Midlothian)",
            "description": "We are the UK's leading children's charity. We've been looking out for children for over 130 years and we couldn't do without you.\r\nFind out more about our structure, the way we operate and how we fight for every childhood.",
            "website": "https://www.nspcc.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC037717"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F9cba050d-b122-4b2b-98d8-b3e5bfb50d4a%2FWkLzgT1VE9cAHEWcVMpdVMd5bL63%2Fuser-upload.jpg?alt=media&token=738a5edc-1d42-41f6-bc30-c906502b5809",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Counselling",
                    "skos:prefLabel": "Counselling"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Helplines",
                    "skos:prefLabel": "Helplines"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000VhwwhAAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000VhwwhAAB/book-scheme-co-ordinator",
                    "publishStart": "2023-05-30",
                    "publishEnd": "2027-02-10",
                    "title": "Book Scheme Co-ordinator",
                    "description": "## Description\n\nYou’ll volunteer without regular time commitments, ‘as and when’ volunteering! Engage with the public, organisations and local communities – promoting a positive image of the NSPCC! You’ll be a valued part of one of our Volunteer Community Fundraising Teams across the UK, raising awareness and funds. We appreciate that work, family and friends come first and, with that in mind, this role offers flexibility to fit in with your lifestyle. The aim of the community book scheme is for members of the general public to give an honesty donation in return for a donated book. To also support the NSPCC Community fundraising manager to create and sustain new book schemes in the local community.\n\n## Experience required\n\nTo have good organisational, communication and networking skills together with lots of enthusiasm.\n\n## Training details\n\n• A designated point of contact\r\n• We will support you with the right information, tools, and training\r\n• Be part of the NSPCC and our mission to end child cruelty\r\n• Meet like-minded people and enjoy new experiences\r\n• Access to the Volunteer Portal with training opportunities, knowledge and learning and a discount portal\r\n• Volunteer Newsletter\n\n## Travel expenses\n\nExpenses will be paid monthly via our volunteer online system",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Ffe63c66d-5958-44f4-8707-4e9b5b37f8a6%2FWkLzgT1VE9cAHEWcVMpdVMd5bL63%2Flisting.jpg?alt=media&token=87dab09f-1c5b-42b9-abf0-f664b889b676",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000VhwwhAAB#role",
                        "type": "Role",
