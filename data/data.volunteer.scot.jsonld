        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZfxAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZfxAAE/healthcare-improvement-scotland",
            "name": "Healthcare Improvement Scotland",
            "description": "The purpose of Healthcare Improvement Scotland is to enable the people of Scotland to experience the best quality of health and social care.  The areas where we can make the most impact and focus our efforts are:\r\n\r\n> enabling people to make informed choices about their care and treatment\r\n> helping health and social care organisations to improve their services\r\n> providing evidence and sharing knowledge with services to help them improve\r\n> enabling people to get the best out of the services they use\r\n> providing quality assurance that gives people confidence in NHS services\r\n> making the best use of resources to add value to the care people receive\r\n\r\nOur broad work programme supports health and social care services to improve. This includes the regulation of independent hospitals and clinics.",
            "website": "https://www.healthcareimprovementscotland.org",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Advocacy",
                    "skos:prefLabel": "Advocacy"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SocialCare",
                    "skos:prefLabel": "Social Care"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000FbjAPYAZ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000FbjAPYAZ/peoples-experience-volunteer",
                    "publishStart": "2026-02-26",
                    "publishEnd": "2026-12-21",
                    "title": "People’s Experience Volunteer",
                    "description": "## Description\n\nPeople’s Experience Volunteers (PEVs) provide views, experience and opinions and challenge on issues that HIS has identified as priorities or areas of focus important to health and care in Scotland. PEVs may be involved in both regional and national projects, depending on the scope of the activity. You may be invited to share your views on various topics, review materials to ensure they are clear and accessible, or use your local knowledge to help shape engagement strategies.\r\n\r\nYour contributions are flexible and focused on shorter term projects and feedback. Examples of activities include:\r\n- Providing Feedback: you may be asked to provide feedback on specific questions related to health and care. This could involve sharing views on our ideas, improvements and work programmes.\r\n- Reviewing Reports and Materials: you may participate in reviewing how individuals engage with and understand our reports, web pages and health-related information. Your input will contribute to improving the clarity and accessibility of our communication materials. \r\n- Collaboration: you may have the opportunity to contribute to the planning and development of engagement strategies led or supported by HIS. Your contributions may include shaping and testing questions, ensuring clarity and understanding and helping identify key community concerns. \r\n\r\nAll your feedback will be anonymised and we will make sure that it isn’t shared in a way that could identify you.\r\n\r\nWhat could a volunteer gain from the experience:\r\nVolunteering has been shown to have a positive effect on volunteers. Volunteering in this role may give you a sense of purpose or may help you gain confidence and new knowledge. As a volunteer with us you can help improve the health and care experience of people receiving care in Scotland. This role may also give you opportunities to meet other volunteers in your own or other areas and be part of a community of volunteers within Healthcare Improvement Scotland.\n\n## Experience required\n\nYou don’t need any specific skills, just an interest in making health and care better for everyone.\n\n## Training details\n\nTo ensure that volunteers have a positive and fulfilling experience, we offer a range of support. This includes induction, training, ongoing assistance and various resources to facilitate your role. Our aim is to provide a structured and supportive environment where volunteers can contribute effectively and feel valued.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F174d450e-4242-4a1a-99d9-2f87d5fdb414%2FliLEC2s9ZwYA46gEa6AxGTVGunx2%2Flisting.jpg?alt=media&token=a21e7184-4e4c-4475-97c7-24417542f608",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000FbjAPYAZ#role",
                        "type": "Role",
                        "title": "People’s Experience Volunteer",
                        "description": "You don’t need any specific skills, just an interest in making health and care better for everyone.",
                        "applyLink": "https://www.hisengage.scot/engaging-communities/how-you-can-get-involved/get-involved-with-healthcare-improvement-scotland/",
                        "allowsRemoteParticipation": true,
                        "specialistRole": [
