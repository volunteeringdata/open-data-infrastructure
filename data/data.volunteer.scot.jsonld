        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nfDWAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nfDWAAY/advocacy-orkney",
            "name": "Advocacy Orkney",
            "description": "Through the provision of advocacy services, Advocacy Orkney empowers individuals to have a voice in decisions being made about them and their families, to access services and to learn the skills they need to protect and care for themselves. \r\n\r\nWe do not 'do to' people, we 'do with' people. That starts with listening and learning from each individual to ensure that they receive the support and advice that is most useful to them in the way that best meets their needs.",
            "website": "https://www.orkneycommunities.co.uk/ADVOCACYORKNEY",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC033298"
                }
            ],
            "cause": [
