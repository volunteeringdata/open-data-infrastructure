            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000I1wArYAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000I1wArYAJ/board-members",
                    "publishStart": "2026-09-16",
                    "publishEnd": "2027-03-17",
                    "title": "Board Members",
                    "description": "## Description\n\nWe are wishing to strengthen the skills on our Board and in particular are looking for the following skills: \r\n\r\nGovernance \r\nFinance \r\nProcurement \r\nFundraising \r\n\r\nWe would also like to recruit a Volunteer Admin person\n\n## Experience required\n\nGovernance Experience \r\nBoard experience; charity/CIC/company governance; understanding of Directors' duties; risk management; policies and procedures; strategic planning\r\n\r\nFinance Experience \r\nAccountant, auditor, management accountant or senior financial management experience; budgeting; cash flow; financial controls; reporting; interpreting accounts\r\n\r\nProcurement Experience \r\nProcurement, commissioning, contract management, supply chain, tendering, commercial management or public-sector purchasing\r\n\r\nFundraising Experience\r\nGrant funding, trusts/foundations, public-sector funding, corporate partnerships, fundraising, sponsorship, social investment or business development\r\n\r\nAdministration Experience \r\nExperience using Microsoft 365 and all apps within that system",
                    "requiresEmergencyParticipation": false,
                    "role": {
