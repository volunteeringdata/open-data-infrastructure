                                "skos:prefLabel": "Environment"
                            }
                        ]
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
                                "type": "Location",
                                "name": "ML8 4DR",
                                "address": "ML8 4DR",
                                "latitude": 55.73296989352606,
                                "longitude": -3.832202673376392,
                                "simd": "https://data.volunteer.scot/Geography/SIMD/ML84DR"
                            },
                            {
                                "@id": "https://data.volunteer.scot/Geography/LocalAuthority/SouthLanarkshire",
