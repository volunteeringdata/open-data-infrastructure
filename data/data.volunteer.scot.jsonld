            "name": "Ninewells Community Garden",
            "description": "Ninewells Community Garden aims to promote physical activity and good health through community gardening; in an environment where horticulture supports wellbeing, therapy and rehabilitation.  The garden is open for visitors every day and we work with a wide range of volunteers and partner organisations to offer sessions throughout the week for gardeners of all abilities.",
            "website": "http://www.ninewellsgarden.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC044580"
                }
