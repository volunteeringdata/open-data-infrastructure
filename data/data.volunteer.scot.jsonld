            "name": "Muscular Dystrophy UK",
            "description": "Muscular Dystrophy UK (MDUK) is the only charity the UK to provide support to the more than 60 types of muscle-wasting conditions.",
            "website": "https://www.musculardystrophyuk.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039445"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
