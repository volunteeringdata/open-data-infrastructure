        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000ZOVL5YAP",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000ZOVL5YAP/cairngorms-national-park-authority",
            "name": "Cairngorms National Park Authority",
            "website": "https://www.cairngorms.co.uk/volunteers",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HoFTVYA3",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HoFTVYA3/volunteer-cairngorms",
                    "publishStart": "2026-07-24",
                    "publishEnd": "2027-01-22",
                    "title": "Volunteer Cairngorms",
                    "description": "## Description\n\nLooking to volunteer in the Cairngorms National Park?\r\n\r\nVolunteer Cairngorms brings together a wide range of volunteering opportunities from the Cairngorms National Park Authority and partner organisations. Whether you're interested in conservation, wildlife, community projects, health walks, outdoor access or citizen science, there are opportunities to suit a range of interests, skills and availability. \r\n\r\nOpportunities are updated throughout the year and vary in location, time commitment and experience required.\r\n\r\nVisit their website to browse current opportunities and register your interest through the Volunteer Cairngorms website.\n\n## Training details\n\nTraining and induction are provided where required by the organisations offering each opportunity",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F420c896a-5cec-48f8-b0b0-2d5ee234bad1%2FURrwIlfn49aLc6Utdqwqr6mFR1F3%2Flisting.jpg?alt=media&token=7e9f7ca4-a557-4f07-a43c-d19464358c1c",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HoFTVYA3#role",
                        "type": "Role",
                        "title": "Volunteer Cairngorms",
                        "applyLink": "https://cairngorms.co.uk/taking-part/volunteering/volunteering-opportunities",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
