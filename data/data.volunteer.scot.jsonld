            "dc:source": "https://volunteer.scot/organisations/00124000008nczwAAA/link-east-fife-mental-health-adolescent-befriending-project",
            "name": "LINK - East Fife Mental Health Adolescent Befriending Project",
            "description": "LINK works with marginalised, isolated 12-18 year olds in East Fife and Levenmouth with mental health issues. We aim to assist the young people to increase their resilience, confidence, social skills and self esteem through the support of a consistent and reliable befriender.",
            "website": "https://www.linkbefriending.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC027493"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
                    "skos:prefLabel": "Befriending / Mentoring"
                },
