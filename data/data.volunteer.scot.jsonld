        {
            "id": "https://data.volunteer.scot/Organisation/0012400000cbpbxAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000cbpbxAAA/highland-hospice-shop-aviemore",
            "name": "Highland Hospice Shop - Aviemore",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000C7XJhYAN",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000C7XJhYAN/retail-volunteer-aviemore",
                    "publishStart": "2025-09-16",
                    "publishEnd": "2027-03-24",
                    "title": "Retail Volunteer - Aviemore",
                    "description": "## Description\n\nOur shops help fund Hospice care in the Highlands. As a retail volunteer you will work as part of the team with the Shop Manager to keep the shop open and to generate income from the sale of donated and new goods. We have 15 shops located across the Highlands including our Fort William shop.\r\n\r\nYou will be providing a high standard of customer care, sorting and pricing donations. You will operate the till and handle cash, help keep the shop tidy and clean.\r\n\r\nIn this role you will learn about the work of Highland Hospice and how the shop supports this valuable work throughout the Highlands.  Volunteers will gain retail experience, meet people, help the community and gain confidence.\n\n## Training details\n\nAll volunteers receive a full induction and on the job training.\n\n## Taster details\n\nTaster sessions are available for interested volunteers.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F30923a53-76fc-4cac-b7f7-67c1a4ee78c7%2FJqK8q7mcUtcgywKvmhEW9RRQbgy1%2Flisting.jpg?alt=media&token=106e9778-3545-4f9a-bd8b-e0b538b11806",
