                },
                {
                    "id": "https://data.volunteer.scot/Activity/a0g1p00000DJUmSAAX",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g1p00000DJUmSAAX/chatelherault-conservation-volunteer",
                    "publishStart": "2026-09-21",
                    "publishEnd": "2027-03-20",
                    "title": "Chatelherault Conservation Volunteer",
                    "description": "## Description\n\nVolunteers will be undertaking a series of conservation tasks including replacing timber steps, woodland management and removal of non-native species.\nThe site is part of the Clyde Valley Woodlands National Nature Reserve. Volunteers would be helping to manage and conserve the site and it’s habitats for the benefit of the wildlife and for people to enjoy. The volunteers could also learn more about the biodiversity, and opportunities are available to get involved in other projects and programmes with South Lanarkshire Council's Greenspace Team and Clydesdale Community Initiatives. \n\nNo skills required. Guidance, training and tools talks are given for each task.\n\n## Experience required\n\nNo Expertise, Hard Working,Practical,Reliable / Dependable,Team Player,\n\n## Travel details\n\nThe opportunity takes place at multiple location across South Lanarkshire \nHamilton",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g1p00000DJUmSAAX#role",
                        "type": "Role",
                        "title": "Chatelherault Conservation Volunteer",
                        "description": "No Expertise, Hard Working,Practical,Reliable / Dependable,Team Player,",
                        "applyLink": "https://volunteer.scot/search/a0g1p00000DJUmSAAX/chatelherault-conservation-volunteer?#modal_register_a0g1p00000DJUmSAAX",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
