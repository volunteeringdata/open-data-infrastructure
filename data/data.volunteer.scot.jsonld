        {
            "id": "https://data.volunteer.scot/Organisation/0012400001Au3zRAAR",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400001Au3zRAAR/help-for-heroes-aberdeen",
            "name": "Help for Heroes (Aberdeen)",
            "description": "-Who we are and what we do:\r\nHelp for Heroes supports those with injuries and illnesses sustained while serving in the British Armed Forces. No matter when someone served, we give them the support they need to lead active, independent and fulfilling lives.\r\n-How we do it:\r\nOur specialist teams focus on the five key areas of an individual’s life: medical, mind, body, spirit and family. We provide support to the whole family to help them all cope with the challenges they face.\r\n\r\nLong-term recovery is more than repairing damaged bodies and minds; it’s about rebuilding lives.",
            "website": "https://www.helpforheroes.org.uk",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
