        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nbm8AAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbm8AAA/highland-foodbank",
            "name": "Highland Foodbank",
            "description": "To provide food parcels for the local community",
            "website": "https://www.blysthwood.org",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000Hnv4zYAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000Hnv4zYAB/warehouse-support-volunteer",
                    "publishStart": "2026-07-23",
                    "publishEnd": "2027-01-21",
                    "title": "Warehouse Support Volunteer",
                    "description": "## Description\n\nHighland Foodbank provides short-term, emergency support to people across the Highlands who are experiencing food insecurity. As part of the Trussell community of food banks, they work to ensure that no one faces hunger alone while also addressing the wider issues that cause food insecurity.\r\n\r\nWarehouse Support Volunteers help support the day-to-day work of Highland Foodbank behind the scenes. This role may suit people who prefer a practical, behind-the-scenes volunteering opportunity while still making a valuable contribution to the work of Highland Foodbank. Warehouse volunteer opportunities are currently available only in Inverness.\n\n## Training details\n\nAll volunteers receive guidance on manual handling, health and safety, and safeguarding. PVG checks will be arranges where required.",
                    "requiresEmergencyParticipation": false,
