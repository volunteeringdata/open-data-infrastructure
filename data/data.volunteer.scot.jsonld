        {
            "id": "https://data.volunteer.scot/Organisation/0011p00001z3VnkAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00001z3VnkAAE/re-engage",
            "name": "Re-engage",
            "description": "Re-engage is committed to older people being heard, valued and engaged.  As we get older, our social circles diminish, and we find ourselves with fewer and fewer people to turn to.  Imagine realising one day that all your friends and family have gone from your life. Loneliness can be cruel, and it affects millions of people over 75 who live in social isolation.\n\nRe-engage is making life less lonely for thousands of older people every year.  Our vision is a world where no one is ever too old to make friends and enjoy social interaction.  Our mission is to work within communities to end social isolation and loneliness in older people.",
            "website": "https://www.reengage.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC039377"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
                    "skos:prefLabel": "Befriending / Mentoring"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/OlderPeople",
                    "skos:prefLabel": "Older People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JqytDYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JqytDYAR/telephone-befriending-volunteer",
                    "publishStart": "2026-11-12",
                    "publishEnd": "2027-05-13",
                    "title": "Telephone Befriending Volunteer",
                    "description": "## Description\n\nA friendly phone call can make someone's day.  Could you be the person who makes it?\r\n\r\nRe-engage is seeking friendly, caring volunteers to provide regular telephone companionship to older people experiencing loneliness or social isolation.\r\n\r\nAs a Call Companion, you'll be matched with an older person for regular, relaxed phone calls.  Whether you're sharing stories, discussing everyday life or simply enjoying a laugh together, your calls can help someone feel connected, valued and less alone.\r\n\r\nOver time, you'll have the opportunity to build a meaningful friendship, bringing enjoyment and companionship to both you and the person you support.\r\n\r\nWhat you will be doing\r\n* Making friendly telephone calls to your matched older person 2–4 times per month, at mutually agreed times\r\n* Spending approximately 30 minutes per call chatting, listening and sharing stories\r\n* Building a positive, supportive relationship through regular contact\r\n* Following Re-engage's training and guidance to ensure conversations are safe, appropriate and enjoyable\r\n* Keeping in regular contact with the Re-engage team\r\n\r\nPVG membership required.\n\n## Travel details\n\nTakes place from the volunteer's home.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fedd932ec-6526-4262-9a1a-37b940dce7c2%2FBw5WzjI1NfRc2PWpRcVqa12TbNe2%2Flisting.jpg?alt=media&token=2962a473-e05b-423a-a43f-294d5611b392",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000JqytDYAR#role",
                        "type": "Role",
                        "title": "Telephone Befriending Volunteer",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000JqytDYAR/telephone-befriending-volunteer?#modal_register_a0gQD00000JqytDYAR",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "service": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Service/NamedContactForVolunteer",
                                "skos:prefLabel": "Named Contact For Volunteer"
                            }
                        ]
                    },
                    "session": {
