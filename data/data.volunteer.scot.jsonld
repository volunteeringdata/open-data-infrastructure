                            }
                        ]
                    }
                },
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000043XErYAM",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000043XErYAM/volunteer-fundraiser",
                    "publishStart": "2026-06-17",
                    "publishEnd": "2026-12-07",
                    "title": "Volunteer Fundraiser",
                    "description": "## Description\n\n\"We are looking for a Volunteer Fundraiser\r\nDo you love socialising and meeting new people in your area? You can get involved as a volunteer fundraiser at a range of different events, give as much or as little time as you have to help spread the word about our important work.\r\nThe Role:\r\n• Organise and run local fundraising events\r\n• Support other team members with fun local events\r\n• Help at events, including event set up and post-event clear-up\r\n• Help to raise awareness of the charity\r\n• Attend regular group meetings in person or virtually to discuss ideas and give updates on events and fundraising activities\r\n• Help at meetings by sometimes chairing and taking minutes.\r\n• Meet and correspond with local organisations and businesses to support the events\r\n• Help to promote events locally through a variety of online and offline networks\r\n• Keep accurate records of expenditure and fundraising money for reporting\r\nMost importantly we hope that you like to have fun and will enjoy supporting the CLASP fundraising team to reach their fundraising target.\"\n\n## Experience required\n\nYou will have a proven record of fund raising in the past or a deep desire to be a part of our fundraising team",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD0000043XErYAM#role",
                        "type": "Role",
                        "title": "Volunteer Fundraiser",
                        "description": "You will have a proven record of fund raising in the past or a deep desire to be a part of our fundraising team",
                        "applyLink": "https://volunteer.scot/search/a0gQD0000043XErYAM/volunteer-fundraiser?#modal_register_a0gQD0000043XErYAM",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18"
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
                                "@id": "https://data.volunteer.scot/Geography/LocalAuthority/NorthAyrshire",
                                "type": "Location",
                                "name": "North Ayrshire"
                            }
                        ]
                    }
                },
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000V7IYYAA3",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000V7IYYAA3/trustee",
                    "publishStart": "2026-05-27",
                    "publishEnd": "2026-11-16",
                    "title": "Trustee",
                    "description": "## Description\n\n\"We are recruiting volunteers to join our Board of Trustees\r\nCLASP is a long established charity, working across North Ayrshire to offer support to people aged 50+ through provision of a range of services and activities to reduce isolation and loneliness, and improve health and wellbeing. We offer:\r\n\r\n- Localised access to advice and information on issues affecting social inclusion\r\n- Advice to ensure local people and groups gain an increased knowledge of their rights and their capacity to actively address issues affecting the quality of their lives\r\n- Assistance in accessing training and educational opportunities to gain transferable skills, enabling individuals to access employment and further educational opportunities\r\n- Support to ensure that local people aged 50+ and groups are able to access training in the use of Information Technology to meet their personal needs\r\n\r\nAs a trustee, you will have:\r\n- Induction, training and reimbursable expenses\r\n- The chance to improve the health and well being of people in the local community\r\n- The opportunity to influence future projects and to develop new skills\r\n\r\nMinimum time commitment would be attending board monthly board meetings (in person or via Zoom), but we would hope our new trustees would use their expertise to further support the three senior managers on a regular basis.\r\n\r\n\"\n\n## Experience required\n\n\"Whether you are an experienced trustee, or looking for your first opportunity to use your skills to support a charity board, we would love to hear from you.\r\n\r\nOur new trustees will ideally have skills in the following areas: Finance; Health & Safety; Admin; Volunteering.\r\n\r\nExperience of working in a community is preferable but not essential, along with the ability to connect and promote the work of the charity.\"\n\n## Travel details\n\nMeetings are held in Stevenston or via Zoom",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000V7IYYAA3#role",
                        "type": "Role",
                        "title": "Trustee",
                        "description": "\"Whether you are an experienced trustee, or looking for your first opportunity to use your skills to support a charity board, we would love to hear from you.\r\n\r\nOur new trustees will ideally have skills in the following areas: Finance; Health & Safety; Admin; Volunteering.\r\n\r\nExperience of working in a community is preferable but not essential, along with the ability to connect and promote the work of the charity.\"",
                        "applyLink": "https://volunteer.scot/search/a0g0800000V7IYYAA3/trustee?#modal_register_a0g0800000V7IYYAA3",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18"
                    },
