                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000QNtX0AAL",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000QNtX0AAL/discharge-lounge-volunteer",
