        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000Ztb4VYAR",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000Ztb4VYAR/chest-heart-stroke-scotland-west-dunbartonshire",
            "name": "Chest Heart & Stroke Scotland (West Dunbartonshire)",
            "description": "Our new refreshed No Life Half Lived strategy is to ensure that we can be there for anyone who needs us. Our vision is to help shape a Scotland where people with our conditions can live their lives well. Full lives, with the right support, at the right time, and in the right place.",
            "website": "https://www.chss.org.uk/news/chest-heart-stroke-scotland-open-pop-up-shop-in-clydebank/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC129114"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
