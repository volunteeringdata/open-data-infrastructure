        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZBOAA2",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZBOAA2/university-of-dundee-clinical-skills",
            "name": "University of Dundee (Clinical Skills)",
            "description": "The University of Dundee's Simulated Patient (SP) Programme began in 1997.  Simulated patients continue to be an essential part of the development and training of healthcare professionals.  Simulated patients provide safe, \"real life\" training opportunities where students can gain confidence and rehearse their examination and interview skills as well as developing a caring attitude towards their patients.",
            "website": "https://patientbank.dundee.ac.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC015096"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BlackMinorityEthnic",
                    "skos:prefLabel": "Black / Minority Ethnic"
                },
                {
