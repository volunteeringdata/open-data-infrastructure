            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HpyUzYAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HpyUzYAJ/volunteer-addiction-support-worker",
                    "publishStart": "2026-07-31",
                    "publishEnd": "2027-01-29",
                    "title": "Volunteer Addiction Support Worker",
                    "description": "## Description\n\nWe are looking for a compassionate and reliable volunteer to join our team and help support individuals on their recovery journey.\r\nRequirements: Minimum 1yr continuous sobriety or clean time.\r\nActively attending recovery meetings (being a group member is preferred but not essential)\r\nAvailable Monday, Wednesday & Friday from 12pm-3pm\r\n\r\nThe role is ideal for someone who wants to give back , shared lived experience , and support others in building a healthier future.  Strong empathy, reliability and commitment to recovery principles are essential.\r\nIf you are passionate about helping others and maintaining your own recovery while supporting the community , we would love to hear from you.\n\n## Experience required\n\nMinimum 1yr continuous sobriety or clean time\n\n## Travel details\n\nKirkintilloch",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HpyUzYAJ#role",
