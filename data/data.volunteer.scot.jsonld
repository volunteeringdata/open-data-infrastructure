                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000H292DYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000H292DYAR/volunteer-befriender",
                    "publishStart": "2026-05-28",
                    "publishEnd": "2026-11-26",
                    "title": "Volunteer Befriender",
                    "description": "## Description\n\nWe are seeking volunteers to deliver befriending visits to members of the community at risk of social isolation.\r\n\r\nVolunteers will be matched with local community members with similar interests.  This role supports emotional wellbeing and promotes independence.  There will be no requirement to provide personal care or moving and assisting.\r\n\r\nDrivers and non-drivers welcome.  Volunteer drivers must hold a full, valid driving license and insurance.\r\n\r\nVolunteer expenses will be reimbursed.\r\n\r\nTraining will be provided and successful applicants will be required to complete a PVG check.\n\n## Travel details\n\nMay Terrace, Giffnock, G46 6LD",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F2fef7360-e74b-4b7b-9454-dc63541d2001%2FyKvNsCtq9ZNPsjkwuXTxwxTv3Tx2%2Flisting.jpg?alt=media&token=edf555c1-3ba4-401a-8290-042773edeaf1",
