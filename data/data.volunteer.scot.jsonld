        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000oEBN1YAO",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000oEBN1YAO/south-ayrshire-access-panel",
            "name": "South Ayrshire Access Panel",
            "website": "https://accesspanel.scot/what-are-access-panels/find-your-local-access-panel/south-ayrshire-access-panel/",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000D34E5YAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000D34E5YAJ/access-panel-member",
                    "publishStart": "2025-11-04",
                    "publishEnd": "2027-03-04",
                    "title": "Access Panel Member",
                    "description": "## Description\n\nThe South Ayrshire Access Panel is a group of volunteers who meet monthly and work to improve access and inclusion for disabled people in our local community. The Panel has members of all ages, abilities and backgrounds who share a passion for the issues faced by disabled people.  This includes carers and professionals whose role is to support access. We aim to do this by raising awareness and helping to change attitudes among the general public about the need for inclusive access. We are also keen to link with other groups who work in any shared areas of interest.\r\n\r\nThe Role:\r\nTo attend monthly meetings, and possibly some networking. Meetings take place in Ayr on the 3rd Thursday of every month from 10-12.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fb5695a63-0298-45d5-92d2-d50a71cf3bc0%2F3wQ4LNHTVDdv38i2OQS2H73Yrhd2%2Fheader.jpg?alt=media&token=e55ab6f7-a527-4daa-91a1-87c2fb5776e1",
