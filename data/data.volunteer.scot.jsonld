        {
            "id": "https://data.volunteer.scot/Organisation/0012400000hijkQAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000hijkQAAQ/rosyth-community-projects-ltd-eats-rosyth",
            "name": "Rosyth Community Projects Ltd (EATS Rosyth)",
            "description": "Inspiring everyone to grow, nourish and share.  With our diverse and ambitious projects, we provide welcoming spaces inspiring people to connect and grow, building a vibrant, resilient community. Through our connection to food and nature we actively improve health and social inclusion, which is vital for the wellbeing of everyone.",
            "website": "https://www.eatsrosyth.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC048688"
