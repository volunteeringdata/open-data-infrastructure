        {
            "id": "https://data.volunteer.scot/Organisation/0010800003Am1zSAAR",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003Am1zSAAR/rnid-shetland",
            "name": "RNID (Shetland)",
            "description": "RNID in Scotland.  We're here for everyone in Scotland who is deaf or has hearing loss or tinnnitus. we work in communitites across the country to provide information and support.  We also campaign for equal access to employment, health and entertainment, and to improve standards in audiology care.",
            "website": "https://rnid.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038926"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SensoryImpairment",
                    "skos:prefLabel": "Sensory Impairment"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000SsMiYAAV",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000SsMiYAAV/hearing-aid-support-worker",
                    "publishStart": "2022-10-06",
                    "publishEnd": "2026-12-09",
                    "title": "Hearing Aid Support worker",
                    "description": "## Description\n\nProvide support to NHS hearing aid users at our hearing aid maintenance clinics, helping with basic maintenance and support of hearing aids.\r\nAs a hearing aid support volunteer, you will:\r\n•\tundertake basic maintenance on hearing aids, cleaning or changing tubing and replacing batteries\r\n•\toffer practical support to optimise hearing aids\r\n•\tsignpost other agencies that may be beneficial to the service user\r\n•\tmonitor the number of visits to drop-in service and feedback to the Project Co-ordinator\r\n•\tMeet with other RNID volunteers and staff to discuss the project and suggest any improvements.\r\nFull training will be provided by NHS Shetland audiology dept, with ongoing support provided by locally based project co-ordinator.\r\n\r\n\r\nAs an RNID volunteer, you will:\r\n•\tmake a real difference to the people you support\r\n•\thelp us run this important service\r\n•\treceive training and learn new skills\r\n•\tmeet people in different situations\r\n•\traise awareness of deafness in the community\r\n•\thave reasonable, out-of-pocket and pre-approved travel expenses repaid.\n\n## Experience required\n\n•\tknowledge of or willingness to learn about issues affecting people confronting deafness, tinnitus and hearing loss- particularly older people.\r\n•\tsome experience of using hearing aids would be preferable but not essential.\r\n•\tfriendly, reliable and an approachable manner.\r\n•\tability to listen to questions and to answer appropriately\r\n•\thappy to work with a wide range of people.\n\n## Travel details\n\nVarious community settings across the Shetland Islands.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000SsMiYAAV#role",
                        "type": "Role",
                        "title": "Hearing Aid Support worker",
                        "description": "•\tknowledge of or willingness to learn about issues affecting people confronting deafness, tinnitus and hearing loss- particularly older people.\r\n•\tsome experience of using hearing aids would be preferable but not essential.\r\n•\tfriendly, reliable and an approachable manner.\r\n•\tability to listen to questions and to answer appropriately\r\n•\thappy to work with a wide range of people.",
