            "id": "https://data.volunteer.scot/Organisation/001QD000016HHGgYAO",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000016HHGgYAO/crosshouse-childrens-fund",
            "name": "Crosshouse Children's Fund",
            "description": "Crosshouse Children's Fund is the charity for babies, children and young people in hospital in Ayrshire and Arran. From the tiniest babies in the neonatal unit at Ayrshire Maternity, to the children's wards at Crosshouse and across the community - Crosshouse Children's Fund is for Ayrshire's children in hospital.\r\n\r\nEach year more than 25,000 babies, children and young people from across Ayrshire and Arran are treated in the hospitals we support. Funds raised bring the very latest medical equipment to Ayrshire, help families navigate their child's journey, and help children cope in hospital.",
            "website": "https://www.crosshousechildrensfund.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC051964"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
