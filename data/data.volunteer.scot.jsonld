        {
            "id": "https://data.volunteer.scot/Organisation/001QD000017EAETYA4",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000017EAETYA4/heartsong-live",
            "name": "Heartsong Live",
            "description": "Heartsong Live is an award-winning Christian community radio station and registered charity based in Scotland. For more than nine years, they have been using media to inspire hope, strengthen communities and amplify voices that might otherwise go unheard.\r\n\r\nBroadcasting across Scotland on DAB and online to a global audience, they produce life-inspiring programmes that inform, encourage and connect people from all backgrounds. Our content includes faith, music, wellbeing, mental health, community stories, interviews and discussions that address issues affecting everyday life while promoting positive change.\r\n\r\nAlongside our broadcasting, they deliver community outreach and media education projects that equip people of all ages with practical skills, confidence and opportunities to develop their potential. Through initiatives such as Media Makers Live, children and young people gain hands-on experience in broadcasting, podcasting, journalism and digital media, helping them build communication skills and confidence for the future.\r\n\r\nEverything Heartsong Live do is guided by our Christian values of faith, compassion, integrity, inclusion and service. They believe every person has value, every voice deserves to be heard and strong communities are built when people are encouraged, equipped and given the opportunity to thrive.",
            "website": "https://heartsonglive.co.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC053098"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
                    "skos:prefLabel": "Arts and Culture"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FaithReligionBelief",
                    "skos:prefLabel": "Faith / Religion / Belief"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HpfddYAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HpfddYAB/content-producer-audio-and-production",
                    "publishStart": "2026-07-30",
                    "publishEnd": "2027-01-28",
                    "title": "Content Producer (Audio and Production)",
                    "description": "## Summary\n\nYou can support the smooth day-to-day running of Heartsong Live through digital audio support.\n\n## Description\n\nHeartsong Live is an innovative, community-focused Christian radio station committed to amplifying voices and enhancing lives. Inspired by their Christian values, they create uplifting radio programmes, podcasts and community initiatives that bring hope, encouragement and practical support to people from all walks of life.\r\n\r\nYou can support the production of high-quality radio programmes, podcasts and promotional content. This role will involve editing interviews, podcasts and radio programmes; preparing programme rundowns; producing promotional audio and station trailers; supporting presenters before broadcasts; uploading completed programmes and podcasts; and organising digital audio files and archives.\r\n\r\nVolunteering with Heartsong Live is more than giving your time. It is an opportunity to develop new skills, gain valuable experience and become part of a team that is passionate about making a positive difference through media.\n\n## Experience required\n\nHeartsong radio is looking for volunteers who have an interest in audio production and broadcasting, enjoy storytelling, are creative and detail-oriented, and are willing to learn audio editing software. Volunteers should respect and support Heartsong Live’s Christian ethos and values.\n\n## Training details\n\nA full induction will be provided. Ongoing support is available from the Heartsong Live team and project coordinator.\n\n## Travel details\n\nThis role can be carried out remotely, with opportunities to attend broadcasts, meetings, training sessions and community events throughout the year.\n\n## Travel expenses\n\nExpenses can be discussed on an individual basis.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HpfddYAB#role",
                        "type": "Role",
                        "title": "Content Producer (Audio and Production)",
                        "description": "Heartsong radio is looking for volunteers who have an interest in audio production and broadcasting, enjoy storytelling, are creative and detail-oriented, and are willing to learn audio editing software. Volunteers should respect and support Heartsong Live’s Christian ethos and values.",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000HpfddYAB/content-producer-audio-and-production?#modal_register_a0gQD00000HpfddYAB",
                        "allowsRemoteParticipation": true,
