        {
            "id": "https://data.volunteer.scot/Organisation/0010800003F3E7oAAF",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003F3E7oAAF/newtongrange-development-trust",
            "name": "Newtongrange Development Trust",
            "description": "Newtongrange Development Trust (NDT) exists to build on the strong community spirit in Newtongrange. It grew out of 'Newtongrange Resilience Volunteers' which was established in early 2020 as a community response to the COVID pandemic. In late 2020 NDT was formally set up as a community development trust for Newtongrange village.\r\n NDT's mission is to:\r\n· Provide a focal point for our Newtongrange community.\r\n· Respond to economic, social, environmental and cultural needs.\r\n· Create and respond to opportunities that become available to the community.\r\n· Work in partnership with likeminded organisations for the benefit of Newtongrange\r\n· Listen to local residents and give our community a voice.\r\n· Develop community facilities and projects that impact on the quality of life for residents in Newtongrange.\r\n· Provide support to local community groups as necessary.\r\n· Lead initiatives that aspire to bring economic growth along with increased volunteering and employment opportunities to Newtongrange.",
            "website": "https://www.ndt.scot",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC050782"
                }
