        {
            "id": "https://data.volunteer.scot/Organisation/0010800003F0vy4AAB",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800003F0vy4AAB/carrick-community-food-garden",
            "name": "Carrick Community Food Garden",
            "description": "The Carrick Community Food Garden supports our community and community groups through learning.",
            "website": "https://www.facebook.com/CarrickCommunityFoodGarden",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EnvironmentRecycling",
                    "skos:prefLabel": "Environment / Recycling"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityEngagement",
                    "skos:prefLabel": "Community Engagement"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Agriculture",
                    "skos:prefLabel": "Agriculture"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Horticulture",
                    "skos:prefLabel": "Horticulture"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000Vhn8EAAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000Vhn8EAAR/be-involved-volunteer",
                    "publishStart": "2023-07-06",
                    "publishEnd": "2027-04-02",
                    "title": "Be involved volunteer",
                    "description": "## Description\n\nThe Carrick Community Food Garden (CCFG) invites you to discover the joy of growing fruit and vegetables, building and creating with members of your community garden, where everyone shares the work and the harvest.\r\n\r\nBeing part of a community garden is a great activity to do by yourself or with friends and family and a good opportunity to get outdoors, learn new skills, meet new and like-minded people, keep active, improve mental health and contribute towards your community and the environment.\r\n\r\nAll work is supervised, tasks could include clearing the ground in preparation for food growing, planting, seed sowing, weeding, digging, harvesting produce, building raised beds, shifting compost and general site maintenance or occasional help with events and sharing ideas.\r\n\r\nWe share the harvest with our community food pantry, contributors, the groups we support and when possible we cook and share meals on site.\r\n\r\nWe encourage people of all ages and levels of fitness, from complete beginners to experienced growers there is a way for you to contribute to your community garden. At CCFG we are very flexible, you can drop in to learn more and see what it's like before you decide to contribute your time and energy.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fd4a34bd3-c6f2-4010-b535-bdedf4c3d1f0%2FXiQTI9rs8XhdfYu2EPhcBTs4his2%2Flisting.jpg?alt=media&token=cc9d8085-ff4c-48b2-8709-ca0eb725c47b",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000Vhn8EAAR#role",
