        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nYvMAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nYvMAAU/east-renfrewshire-girlguiding",
            "name": "East Renfrewshire Girlguiding",
            "description": "Girlguiding Scotland, as part of a worldwide Movement, enables girls and young women to fulfill their potential and to take an active and responsible role in society through our distinctive, stimulating and enjoyable programme of activities delivered by trained volunteer leaders.\nOur Vision is to be recognised as the leading organisation for girls and young women and to widen and increase our membership.",
            "website": "https://www.girlguidingscotland.org.uk",
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F4ba33e72-5889-2cc2-342a-c6066a344a17%2FmQsKXYYIupgt1ub9BeDSGFfo1O33%2Fuser-upload.jpg?alt=media&token=df934d3e-84ea-40cd-88c4-6d60603b75d3",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
