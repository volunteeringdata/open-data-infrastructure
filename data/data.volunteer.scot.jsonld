        {
            "id": "https://data.volunteer.scot/Organisation/0010800002wlENOAA2",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002wlENOAA2/south-east-scotland-scouts",
            "name": "South East Scotland Scouts",
            "description": "South East Scotland Scouts prepares young people with skills for life - helping them speak up and play their part. Each week we give over 6,000 young people aged 6 to 25 the skills they need for school, college, university, the job interview, the important speech, the tricky challenge, and the big dreams: the skills they need for life across South East Scotland.\r\n\r\nBy 2023 Scouts will have prepared more young people with skills for life, supported by amazing leaders delivering an inspiring programme. We will be growing, more inclusive, shaped by young people and making a bigger impact in our communities.\r\nOur mission: Scouting actively engages and supports young people in their personal development, empowering them to make a positive contribution to society\r\nOur values: We act with care, respect, integrity, cooperation, exploring our own and others’ beliefs\r\nOur goals: By delivering this plan we will achieve the following goals against our four objectives",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC010563"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2Fef43b3bd-a11c-3e42-4056-f29b46f74784%2FWkLzgT1VE9cAHEWcVMpdVMd5bL63%2Fuser-upload.jpg?alt=media&token=2b571a18-c02b-4abf-99cd-6b9921523a7f",
            "cause": [
                {
