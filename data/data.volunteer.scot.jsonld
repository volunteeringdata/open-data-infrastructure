        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZsgAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZsgAAE/larkhall-community-growers",
            "name": "Larkhall Community Growers",
            "description": "Larkhall Community Growers (LCG) is a small social enterprise whose main aim is to make a positive impact on the lives of people living in the Larkhall Community.\nWe have a wide range of projects and activities which bring the community together from Hareleeshill Community Garden to Larkhall Community Project.",
            "website": "https://www.larkhallcommunitygrowers.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC042093"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
