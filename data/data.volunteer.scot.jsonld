            "dc:source": "https://volunteer.scot/organisations/00124000008nXdgAAE/befriend-a-child",
            "name": "Befriend a Child",
            "description": "At Befriend a Child we support school-aged children in Aberdeen and Aberdeenshire who are growing up in difficult life circumstances. We match them with trained volunteers or ‘Befrienders’ or ‘Mentors’ who act as positive role models to help children develop resilience, self-confidence, and self-esteem.",
            "website": "https://www.befriendachild.org.uk",
