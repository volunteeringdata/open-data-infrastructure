        {
            "id": "https://data.volunteer.scot/Organisation/0010800002usUAHAA2",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002usUAHAA2/police-scotland-special-constables-aberdeen-aberdeenshire-and-moray",
            "name": "Police Scotland Special Constables (Aberdeen, Aberdeenshire and Moray)",
            "description": "With a long and impressive history. The special constable role is a part-time, volunteer opportunity where members of the public can maximise their spare time supporting their communities.",
            "website": "https://www.scotland.police.uk/recruitment/special-constables/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/LawAndJustice",
                    "skos:prefLabel": "Law and Justice"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/OffendersExOffenders",
                    "skos:prefLabel": "Offenders / Ex-Offenders"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
                    "skos:prefLabel": "Volunteering"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityEngagement",
