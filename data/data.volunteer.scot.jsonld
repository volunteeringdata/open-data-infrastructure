        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000QT1csYAD",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000QT1csYAD/fostering-compassion",
            "name": "Fostering Compassion",
            "description": "Fostering Compassion is a groundbreaking humane education project for vulnerable children who may be showing worrying behaviour towards animals or be struggling with compassion and empathy. The children we work with have suffered trauma, abuse, neglect and poverty affecting mental, physical and emotional wellbeing and we are able to provide much needed support. Unique in our approach, our activities share the stories of rescued animals in a way that the children draw parallels between their circumstances and the animals. This helps the children see animals as sentient beings who can share similar emotions to them. Through sharing the animals stories, the children gain a greater understanding of their circumstances often providing a platform for the children to open up about their own abuse and neglect encouraging healing.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC046975"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AnimalWelfare",
                    "skos:prefLabel": "Animal Welfare"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/YoungPeople",
                    "skos:prefLabel": "Young People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000006W7ZBYA0",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000006W7ZBYA0/service-delivery-volunteer",
                    "publishStart": "2024-11-05",
                    "publishEnd": "2027-02-10",
                    "title": "Service Delivery Volunteer",
                    "description": "## Description\n\nFostering Compassion is a groundbreaking humane education project for vulnerable children who may be showing worrying behaviour towards animals or be struggling with compassion and empathy. The children we work with have suffered trauma, abuse, neglect and poverty affecting mental, physical and emotional wellbeing and we are able to provide much needed support. Unique in our approach, our activities share the stories of rescued animals in a way that the children draw parallels between their circumstances and the animals. This helps the children see animals as sentient beings who can share similar emotions to them. Through sharing the animals stories, the children gain a greater understanding of their circumstances often providing a platform for the children to open up about their own abuse and neglect encouraging healing.We are looking for volunteers to help in all areas of the organisation.\n\n## Experience required\n\nShould be compassionate and love animals and children\n\n## Training details\n\nInitially office/admin work would be required with an induction given and time doing this to get to know the charity. Further training will be given before working directly with children. Ongoing training and support will be given.\n\n## Travel details\n\nCar preferred, bus travel possible\n\n## Travel expenses\n\nExpenses for outgoings related to support sessions, workshops and events within the charity will be covered with prior agreement. Travel expenses to and from the premises are not covered.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000006W7ZBYA0#role",
                        "type": "Role",
                        "title": "Service Delivery Volunteer",
                        "description": "Should be compassionate and love animals and children",
                        "applyLink": "https://volunteer.scot/search/a0gQD000006W7ZBYA0/service-delivery-volunteer?#modal_register_a0gQD000006W7ZBYA0",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/Children",
