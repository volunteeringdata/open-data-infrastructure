        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000DtDGbYAN",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000DtDGbYAN/bookends",
            "name": "BookEnds",
            "description": "BookEnds is a part of University of Aberdeen’s Student Charities Campaign which means that a large portion of what we make each year in the shop goes to local charities in Aberdeen and Aberdeenshire.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/ArtsAndCulture",
                    "skos:prefLabel": "Arts and Culture"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CharityShop",
