                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000OUwZiAAL",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000OUwZiAAL/retail-volunteer-cowdenbeath",
