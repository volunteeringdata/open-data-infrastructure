            "id": "https://data.volunteer.scot/Organisation/00124000008nZB3AAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZB3AAM/tayside-council-on-alcohol-dundee",
            "name": "Tayside Council on Alcohol (Dundee)",
            "description": "Tayside Council on Alcohol provides counselling, support and information to anyone affected by their own, or anothers, problem drinking.  We also work in many ways to raise awareness of alcohol related issues and promote sensible and positive use of alcohol. The young persons services provide a wide range of support and treatment facilities for young people experiencing problems because of their substance use.",
            "website": "https://alcoholtayside.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC006511"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunitySafety",
