                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000Vup0UAAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000Vup0UAAR/social-activities-helper",
                    "publishStart": "2023-06-16",
                    "publishEnd": "2027-01-31",
                    "title": "Social Activities Helper",
                    "description": "## Summary\n\nEnthusiastic, energetic and organised volunteers needed to help us delivery social activities\n\n## Description\n\nDBPSS regards its volunteers as a vital support in the delivery of its services and social activities for its visually impaired Members. Our rewarding roles are a great way to give back and get involved with your local community. \r\n\r\nWe are currently looking for enthusiastic, helpful, and willing to get involved volunteers to join our small friendly team. The roles will involve assisting the team to enable them to deliver the activities, and volunteers would be required to help prepare and serve refreshments, assist in the activities (bingo calling experience would be great!), sit and chat with the Members, help us in the kitchen and the dreaded tidying up after activities! A full driving licence would also be helpful.\n\n## Experience required\n\nWilling to help out, enthusiastic, patient, and a friendly people person.\n\n## Training details\n\nVisual Awareness Training will be provided\n\n## Travel details\n\nThomas Herd House, 10-12 Ward Road, Dundee, DD1 1LX\n\n## Travel expenses\n\nlocal bus fares\n\n## Taster details\n\nPotential volunteers are more than welcome to attend and meet the staff/Members",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000Vup0UAAR#role",
                        "type": "Role",
