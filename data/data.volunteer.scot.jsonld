        {
            "id": "https://data.volunteer.scot/Organisation/00124000014ctqaAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000014ctqaAAA/barnardos-intandem-north-ayrshire",
            "name": "Barnardo's Intandem North Ayrshire",
            "description": "Barnado's care for vulnerable children and young people they provide many services including family support, befriending, mentoring and group work sessions. The Intandem service is specifically a mentoring service for vulnerable children aged 8 -14 years.\r\n\r\nArran deals with - Young adults who don't engage with further education, training establishments or similar are contacted to bring them back onto a path to re-engage for their future. Age 15-24",
            "website": "https://www.barnardos.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC037605"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
                    "skos:prefLabel": "Befriending / Mentoring"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000SsLNfAAN",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000SsLNfAAN/mentor",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Mentor",
                    "description": "## Description\n\nAyrshire Intandem Mentoring Service offers support to young people looked after at home aged 8-14 years living in Ayrshire.\r\nVolunteer Mentors main tasks will be to:\r\n*Provide weekly 1:1 mentoring support\r\n*Build a positive, trusting, supportive and secure relationship with children & young people aged 8 – 14 \r\n*Promote the wellbeing of every child through creative and fun approaches\r\n*Communicate and link with the Intandem Mentor Coordinator on a regular basis.\r\nYou have the potential to make a real difference in a young persons life by helping build confidence and self-esteem and most importantly being someone they can talk to about anything.\r\nThis role is subject to an application form being submitted, providing 2 references and completing a PVG Disclosure (is free for volunteers)",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000SsLNfAAN#role",
                        "type": "Role",
                        "title": "Mentor",
                        "applyLink": "https://volunteer.scot/search/a0g0800000SsLNfAAN/mentor?#modal_register_a0g0800000SsLNfAAN",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
                        "theme": [
