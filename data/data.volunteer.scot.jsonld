        {
            "id": "https://data.volunteer.scot/Organisation/001QD00001DvmhUYAR",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00001DvmhUYAR/tcv-forth-valley-biodiversity-action-team",
            "name": "TCV Forth Valley Biodiversity Action Team",
            "website": "https://stirlingvolunteering.org/profile/TCVForthValleyBiodiversityActionTeam",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JeTJpYAN",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JeTJpYAN/tcv-forth-valley-biodiversity-action-team",
                    "publishStart": "2026-11-09",
                    "publishEnd": "2027-05-08",
                    "title": "TCV Forth Valley Biodiversity Action Team",
                    "description": "## Summary\n\nTCV Forth Valley Biodiversity Action Team\n\n## Description\n\nThe Forth Valley Biodiversity Action Team undertake various practical conservation tasks and improve green spaces across Falkirk and Stirling. We are dedicated to enhancing biodiversity through a range of activities from woodland management, creating habitats for wildlife, eradicating invasive species, sowing wildflower seeds, wildlife surveys and tree planting. Volunteering is a great way to gain new skills, see new places and meet new people.\n\nNo previous experience is required\n\nSessions take place throughout the Forth Valley area including Stirling, Falkirk and Clackmannanshire. Pick ups are available from Stirling train station in the TCV minibus and travel expenses up to &pound;5 can be covered.\n\nCome and join us to help care for the environment and spend some time in the great outdoors!",
                    "requiresEmergencyParticipation": false,
