        {
            "id": "https://data.volunteer.scot/Organisation/00124000014ct27AAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000014ct27AAA/fertility-network-scotland-shetland",
            "name": "Fertility Network Scotland (Shetland)",
            "description": "Fertility Network Scotland provides free advice, support, help, information and understanding for anyone affected by fertility issues.  We also work to raise awareness of the impact of fertility problems and to campaign for fair provision of fertility treatement throughout Scotland.",
            "website": "https://www.fertilitynetwork.org",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/SelfHelpSupport",
                    "skos:prefLabel": "Self-Help / Support"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000007SJxUAAW",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000007SJxUAAW/support-group-volunteer",
                    "publishStart": "2017-02-28",
                    "publishEnd": "2027-02-03",
                    "title": "Support Group Volunteer",
                    "description": "## Summary\n\nAs a Support Group volunteer with Fertility Network Scotland, volunteers will benefit from helping others in the area with fertility issues.  Volunteers may develop friendships, meet and work with new people to provide a network of much needed and valued support in their area.\r\nAs a Support Group Volunteer you will take care of all aspects of the group including:\r\nAct as a main contact for the group,\r\nOrganise and maintain an email circulation list of attendees,\r\nArrange speakers for group meetings,\r\nOrganise room bookings,\r\nOrganise social activities,\r\nSupport and advise other group volunteers,\r\nPromote group in local area,\r\nAdhere to Fertility Network Scotland policies and procedures.\r\nFertility Network Scotland provides advice, information and support for anyone affected by fertility issues.  We also work to raise awareness of the impact of fertility problems and to campaign for fair provision of fertility treatment throughout Scotland.\n\n## Description\n\nAs a Support Group volunteer with Fertility Network Scotland, volunteers will benefit from helping others in the area with fertility issues.  Volunteers may develop friendships, meet and work with new people to provide a network of much needed and valued support in their area.\r\nAs a Support Group Volunteer you will take care of all aspects of the group including:\r\nAct as a main contact for the group,\r\nOrganise and maintain an email circulation list of attendees,\r\nArrange speakers for group meetings,\r\nOrganise room bookings,\r\nOrganise social activities,\r\nSupport and advise other group volunteers,\r\nPromote group in local area,\r\nAdhere to Fertility Network Scotland policies and procedures.\r\nFertility Network Scotland provides advice, information and support for anyone affected by fertility issues.  We also work to raise awareness of the impact of fertility problems and to campaign for fair provision of fertility treatment throughout Scotland.\n\n## Experience required\n\nGood communication and leadership  skills, reliability and trustworthiness, knowledge of fertility issues and involuntary childlessness (essential),  motivated with administrative and IT skills, public speaking skills to address groups of people, willing to undertake training, attend events etc.\n\n## Frequency commitment details\n\nFlexible.\n\n## Travel details\n\nIn Volunteers own area.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g24000007SJxUAAW#role",
                        "type": "Role",
                        "title": "Support Group Volunteer",
                        "description": "Good communication and leadership  skills, reliability and trustworthiness, knowledge of fertility issues and involuntary childlessness (essential),  motivated with administrative and IT skills, public speaking skills to address groups of people, willing to undertake training, attend events etc.",
                        "commitment": "Flexible.",
                        "applyLink": "https://volunteer.scot/search/a0g24000007SJxUAAW/support-group-volunteer?#modal_register_a0g24000007SJxUAAW",
                        "allowsRemoteParticipation": false,
