            "name": "Scotland’s Gardens Scheme",
            "description": "Scotland's Gardens raises money for charity by encouraging, promoting and supporting garden owners to open their gardens to the public; raising money for a charity of their choice through admissions, plant sales and refreshments.",
            "website": "https://scotlandsgardens.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC049866"
