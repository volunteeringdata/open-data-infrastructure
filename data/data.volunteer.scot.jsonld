            "name": "scarf",
            "description": "Scarf is a charity/social enterprise delivering a range of services to householders, communities, and businesses throughout the Northeast of Scotland. For almost 40 years we have been offering free and impartial energy saving advice to help people lower their fuel bills and carbon emissions.",
            "website": "http://www.scarf.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
