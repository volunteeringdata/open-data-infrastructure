            "dc:source": "https://volunteer.scot/organisations/00108000034TLc4AAG/orkney-dance-and-fitness-ltd",
            "name": "Orkney Dance and Fitness Ltd",
            "description": "Orkney Dance and Fitness Ltd provides a variety of dance and fitness activities to all ages in the West Mainland and online. We specialise in functional gentle exercise for the older adult and exercise for Parkinson's.",
            "website": "https://www.orkneydanceandfitness.com",
