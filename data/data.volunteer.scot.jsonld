                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000QhjSdAAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000QhjSdAAJ/young-visitor-volunteer",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Young Visitor Volunteer",
                    "description": "## Description\n\n𝗬𝗼𝘂𝗻𝗴 𝗩𝗼𝗹𝘂𝗻𝘁𝗲𝗲𝗿𝘀 𝗮𝘁 𝘁𝗵𝗲 𝗦𝗰𝗼𝘁𝘁𝗶𝘀𝗵 𝗠𝗮𝗿𝗶𝘁𝗶𝗺𝗲 𝗠𝘂𝘀𝗲𝘂𝗺 \r\nThis exciting opportunity is perfect for anyone that would like to improve their public speaking and knowledge of history as we look for Visitor Services volunteers. Young volunteers between ages of 16 and 24 can be guided through the process to sign up for the Saltire Awards where you will be recognised for the volunteering hours. \r\nThe activities you can expect to be involved in include guiding tours through all facilities, explaining exhibitions and helping at annual events such as Halloween and Pirate Days.",
                    "requiresEmergencyParticipation": false,
