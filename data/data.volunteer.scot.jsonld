        {
            "id": "https://data.volunteer.scot/Organisation/00124000014dtt0AAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000014dtt0AAA/fertility-network-scotland-aberdeen-north-east",
            "name": "Fertility Network Scotland (Aberdeen & North East)",
            "description": "The national charity, here for anyone who has ever experienced fertility problems. Fertility Network Scotland provides advice, information and support to anyone affected by fertility issues. We raise awareness of the impact of fertility problems and campaign for fair provision of fertility treatment throughout Scotland.",
            "website": "http://fertilitynetworkuk.org",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
