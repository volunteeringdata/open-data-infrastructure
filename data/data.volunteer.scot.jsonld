        {
            "id": "https://data.volunteer.scot/Organisation/00124000008naRtAAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008naRtAAI/highland-hospice-wick",
            "name": "Highland Hospice, Wick",
            "description": "To help run a charity shop and therefore fundraise \nfor the use of people in the highlands.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CharityShop",
                    "skos:prefLabel": "Charity Shop"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
