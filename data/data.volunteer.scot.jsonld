        {
            "id": "https://data.volunteer.scot/Organisation/0010800002yw2grAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002yw2grAAA/family-learning-team-mayfield-primary-school",
            "name": "Family Learning Team & Mayfield Primary School",
            "website": "https://www.nacfamilylearning.weebly.com",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000QNqXgAAL",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000QNqXgAAL/mayfield-community-and-school-garden-project-volunteers",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Mayfield Community and School Garden Project volunteers",
                    "description": "## Description\n\n\"Large area of land needs cleared and made ready for planting for next year for use by both the school pupils and local families.\r\nVolunteers are required intially for 1 - 2 hours each week on a Tuesday afternoon from 2 - 4pm.\r\nThey will be required to help with clearing the ground and raised beds to enable them to be refilled when ready. Funding applications are hopefully being put in place by the school to allow for new fencing around a huge polytunnel which needs recovered. Once money has been granted we may well need help covering the polytunnel and once complete to help with filling out beds and sowing seeds to grow a variety of fruits and vegetables. This area will require regular maintenance. A basic knowledge of plant care and use of gardening tools would be beneficial but not essential.\r\nVolunteers may be required to work in a group and alongside other community organisations as well as the school who will assist from time to time.\r\nTools will be provided but if volunteers have their own that is great.\"\n\n## Experience required\n\nBasic plant care / horticulture / gardening a definite advantage.\n\n## Training details\n\nHoping to offer accredited award and team up with Ayrshire College next year\n\n## Travel details\n\nVolunteers must make their own way to and from the school. Unfortunately at this time there is no funding for travel expenses but that may change if funding is granted.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000QNqXgAAL#role",
                        "type": "Role",
                        "title": "Mayfield Community and School Garden Project volunteers",
                        "description": "Basic plant care / horticulture / gardening a definite advantage.",
                        "applyLink": "https://volunteer.scot/search/a0g0800000QNqXgAAL/mayfield-community-and-school-garden-project-volunteers?#modal_register_a0g0800000QNqXgAAL",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
                        "reward": [
                            "https://ns.volunteeringdata.io/TrainingProvided"
                        ]
                    },
