                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000VhnJgAAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000VhnJgAAJ/driver",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Driver",
                    "description": "## Description\n\nSt John Scotland Ayrshire & Arran is starting a patient transport\r\nservice for renal patients in University Hospital Ayr.\r\nWe are recruiting volunteer drivers to transport dialysis patients to\r\nand from the Renal Unit at University Hospital Ayr. This is a new\r\ninitiative, completely free for patients.\r\nAll patients are referred to St John Scotland by NHS Ayrshire & Arran.\r\nVolunteer drivers, using their own cars, collect passengers from their\r\nhomes in Ayr (initially) at a pre-arranged time, taking them to the\r\nhospital and returning them home afterwards. We pay mileage costs.\r\nA few hours per week is all that we ask. This opportunity is hugely\r\nrewarding.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000VhnJgAAJ#role",
                        "type": "Role",
                        "title": "Driver",
                        "applyLink": "https://volunteer.scot/search/a0g0800000VhnJgAAJ/driver?#modal_register_a0g0800000VhnJgAAJ",
                        "allowsRemoteParticipation": false
                    },
                    "session": {
                        "type": "Session",
