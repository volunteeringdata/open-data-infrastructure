                                "longitude": -4.276214085979045,
                                "simd": "https://data.volunteer.scot/Geography/SIMD/G767AT"
                            },
                            {
                                "@id": "https://data.volunteer.scot/Geography/LocalAuthority/EastRenfrewshire",
