        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000epb6aYAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000epb6aYAA/tyninghame-community-farm-east-lothian",
            "name": "Tyninghame Community Farm (East Lothian)",
            "description": "TCF is run as a not-for-profit ‘Community Supported Agriculture’ (CSA) scheme. These aim to create a partnership between farmers or growers and their customers, often called ‘members’. Members commit to buying local produce for a season and this predictable income mitigates the risks of small-scale sustainable agriculture. In return members get weekly veg boxes and a direct relationship with the farm, often involving farm visits and volunteering. This promotes transparency, trust, and a sense of community as members get to understand where their food comes from and how it’s produced.",
            "website": "https://www.tyninghame.farm/home",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EnvironmentRecycling",
                    "skos:prefLabel": "Environment / Recycling"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000AdtEzYAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000AdtEzYAJ/market-gardening-on-community-farm",
                    "publishStart": "2026-09-14",
                    "publishEnd": "2027-03-13",
                    "title": "Market gardening on community farm",
                    "description": "## Description\n\nWe have a range of market gardening tasks that are carefully supervised and allow conversations with fellow volunteers. Tasks depend on the season and weather but include: preparing vegetable beds, planting out, hoeing, hand weeding and mowing. Intermittent jobs include moving soil, making compost, positioning crop covers, hedging and repairing wooden sheds.\r\nThe farm is directly on the 120 Lothian Bus route between Dunbar, East Linton and North Berwick.\r\nWe always finish with tea and cake/biscuits and good chat.\n\n## Experience required\n\nCommunity / Economic Development Work; Conservation / Gardening\n\n## Training details\n\nVolunteers would learn how to fulfil tasks proficiently and acquire incidental knowledge about vegetable growing.\n\n## Frequency commitment details\n\nCommitment Flexible 2 Hours, Monthly",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000AdtEzYAJ#role",
                        "type": "Role",
                        "title": "Market gardening on community farm",
                        "description": "Community / Economic Development Work; Conservation / Gardening",
                        "commitment": "Commitment Flexible 2 Hours, Monthly",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000AdtEzYAJ/market-gardening-on-community-farm?#modal_register_a0gQD00000AdtEzYAJ",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "0",
