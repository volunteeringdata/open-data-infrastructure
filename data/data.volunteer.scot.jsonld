            "dc:source": "https://volunteer.scot/organisations/00124000008nbTuAAI/university-of-edinburgh-simulated-patient-programme",
            "name": "University of Edinburgh - Simulated Patient Programme",
            "description": "Medical Students need to learn how to interact with patients from an early stage in their training. The best way to attain these skills and gain experience in dealing with patients is to role-play the encounter in a relaxed, safe and non-threatening atmosphere. To facilitate this we require members of the public to simulate patients.",
            "website": "http://www.med.ed.ac.uk/teachdiv/simpatient.htm",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
