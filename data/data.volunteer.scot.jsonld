        {
            "id": "https://data.volunteer.scot/Organisation/0011p000021tbC6AAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p000021tbC6AAI/sporting-memories-foundation-scotland-scio",
            "name": "Sporting Memories Foundation Scotland (SCIO)",
            "description": "Sporting Memories Foundation Scotland clubs are open to older sports fans who enjoy reminiscing about their experiences of watching or playing sport. The weekly clubs, facilitated by a trained volunteer, provide a friendly, inclusive and welcoming environment for anybody and are especially keen to welcome those who may feel isolated through illness.",
            "website": "https://www.sportingmemoriesnetwork.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC047268"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
                },
                {
