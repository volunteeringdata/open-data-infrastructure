            "id": "https://data.volunteer.scot/Organisation/0012400000YcYpyAAF",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000YcYpyAAF/oldmachar-church-of-scotland",
            "name": "Oldmachar Church of Scotland",
            "description": "We provide a range of support for the community.",
            "website": "http://www.oldmacharchurch.org/",
            "charityRegistration": [
