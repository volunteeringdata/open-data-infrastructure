        {
            "id": "https://data.volunteer.scot/Organisation/0012400001JdaD9AAJ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400001JdaD9AAJ/west-coast-furniture-bank-scio",
            "name": "West Coast Furniture Bank SCIO",
            "description": "West coast furniture bank provide essential household items for people in Ayrshire who are living in extreme poverty conditions and have nothing. WCFB has been set up to supply furniture, white goods and general household items completely free of charge.",
            "website": "https://www.westcoastfurniturebank.com/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC049372"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000GvfxSAAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000GvfxSAAR/van-drivers-mate",
                    "publishStart": "2026-08-10",
                    "publishEnd": "2027-02-08",
                    "title": "Van drivers mate",
                    "description": "## Description\n\nThis role entails working with the driver and the rest of the team to pick up furniture/house hold goods, this comes from people who have donated items to us.  You will also be delivering furniture and other household items to clients that have be referred to us by partner agencies. \r\nYou will be responsible for navigation and safe manual handling of the furniture and household goods. This role requires DIY skills and is physically demanding.  In order to be a part of this team you must be polite, discreet, courteous, helpful and respectful to both clients and donors.\n\n## Experience required\n\nSome manual handling training preferred, navigational skills and DIY skills.\n\n## Training details\n\nHealth and safety, on the job and supervision training.\n\n## Travel details\n\nWe are located in Stevenston, being reasonably close to rail and bus links.\n\n## Travel expenses\n\nRail, bus or car mileage.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000GvfxSAAR#role",
