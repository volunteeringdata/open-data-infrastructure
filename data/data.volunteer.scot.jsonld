                        ]
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
                                "type": "Location",
                                "name": "G81 1UJ",
                                "address": "G81 1UJ",
                                "latitude": 55.90127799894807,
                                "longitude": -4.4069618749037405,
                                "simd": "https://data.volunteer.scot/Geography/SIMD/G811UJ"
