            "dc:source": "https://volunteer.scot/organisations/00124000008nWzRAAU/st-margaret-of-scotland-hospice",
            "name": "St Margaret of Scotland Hospice",
            "description": "To assist with fundraising to maintain high standards of palliative care in St Margarets Hospice.",
