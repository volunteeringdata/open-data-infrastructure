        {
            "id": "https://data.volunteer.scot/Organisation/0010800002osc18AAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002osc18AAA/white-ribbon-scotland-orkney",
            "name": "White Ribbon Scotland (Orkney)",
            "description": "White Ribbon Orkney is a local volunteer group within the national White Ribbon Scotland charity, which works to end violence against women. It encourages men and boys to pledge to never commit, condone, or remain silent about violence against women. The Orkney group, formed in 2020, raises awareness through community events, presentations to organizations, and by recruiting more volunteers to help spread the message across the islands.",
            "website": "https://www.whiteribbonscotland.org.uk/campaign/orkney-islands-status-project/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC051163"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F5ace1940-65f4-8fb5-0049-5e8bc0ba09bd%2F47Tx2kdmwYfilSzPKnW1PvQyS0A2%2Fuser-upload.jpg?alt=media&token=f4a22e80-4230-4749-a341-043fdadd8deb",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CampaigningLobbying",
                    "skos:prefLabel": "Campaigning / Lobbying"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Men",
                    "skos:prefLabel": "Men"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Women",
                    "skos:prefLabel": "Women"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD0000002ch7YAA",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD0000002ch7YAA/volunteers-speakers-to-help-end-violence-against-women-across-orkney",
                    "publishStart": "2023-09-22",
                    "publishEnd": "2027-01-18",
                    "title": "Volunteers Speakers to help end violence against women across Orkney",
                    "description": "## Description\n\nCombating violence against women is a priority. Sadly, such behaviour exists here in Orkney. White Ribbon Orkney is part of a world-wide movement, and we are looking for additional volunteer speakers to be trained and engage with non-perpetrating men to educate about violence against women and what they can do to help eliminate it. Volunteer speakers will be assisted and supported to deliver presentations to encourage men to take the pledge - ‘never to commit, condone or remain silent about violence against women in all its forms ‘. We rely on support of volunteers to pass on the messages of the campaign through grassroots conversations and by holding speaker events, which are only limited by their imagination. Speakers are asked to consider what opportunities may be presented through their private and professional lives to deliver this key message. If this is you then we want to hear from you to help make a difference? \r\n\r\nWhat could a volunteer gain from the experience?\r\n\r\nVolunteers would be supporting the campaign to reduce violence against women and girls and would be part of a world-wide movement, rooted firmly in Orkney. They would gain experience of public speaking and help develop their network.\n\n## Experience required\n\nEach volunteer will have the opportunity to engage in events which they feel are suitable to their abilities Ability to work with others (events are organised within a small team of volunteers) Ability to speak with people about violence against women and girls and host group discussions.\n\n## Training details\n\nFull training: 2 x 2.5hr online training modules and thereafter peer support will be available locally and nationally along with access to our Volunteer platform with access to training and presentation material",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F6bf4e280-8b48-4080-9555-0ed433fceba1%2F47Tx2kdmwYfilSzPKnW1PvQyS0A2%2Flisting.jpg?alt=media&token=02336dc5-2071-477d-922c-939a4902c967",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD0000002ch7YAA#role",
                        "type": "Role",
                        "title": "Volunteers Speakers to help end violence against women across Orkney",
                        "description": "Each volunteer will have the opportunity to engage in events which they feel are suitable to their abilities Ability to work with others (events are organised within a small team of volunteers) Ability to speak with people about violence against women and girls and host group discussions.",
                        "applyLink": "https://volunteer.scot/search/a0gQD0000002ch7YAA/volunteers-speakers-to-help-end-violence-against-women-across-orkney?#modal_register_a0gQD0000002ch7YAA",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "16",
                        "theme": [
                            {
                                "@id": "https://data.volunteer.scot/Taxonomy/Theme/HumanCivilRightsJustice",
                                "skos:prefLabel": "Human / Civil Rights / Justice"
                            }
                        ],
                        "reward": [
                            "https://ns.volunteeringdata.io/TrainingProvided"
                        ]
                    },
                    "session": {
