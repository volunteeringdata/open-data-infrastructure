        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nXQsAAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nXQsAAM/royal-voluntary-service-shetland",
            "name": "Royal Voluntary Service Shetland",
            "description": "Our volunteers make a difference to the lives of people in their communities, helping them to live independently and with dignity or to others, caught up in emergencies and disasters.  Providing much needed support and services to people who need them most e.g. accompanied shopping, p.o., banking trips, writing letters, filling in forms, reading, helping at social and/or lunch clubs, driving to appointments and clinics, hairdressers, supporting annual events e.g. Flu fairs, soup & sandwiches, Christmas party/lunch. Supporting Blue Light organisations in emergencies.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038924"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EmergencyResponseDisasterRelief",
                    "skos:prefLabel": "Emergency Response / Disaster Relief"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Elderly",
                    "skos:prefLabel": "Elderly"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FamilySupport",
                    "skos:prefLabel": "Family Support"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g24000000eKD3AAM",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g24000000eKD3AAM/social-club-volunteer-various-locations",
                    "publishStart": "2015-05-08",
                    "publishEnd": "2027-02-17",
                    "title": "Social Club Volunteer - Various locations",
                    "description": "## Summary\n\nThis is an opportunity to work with other volunteers to run Social Clubs at various locations throughout Shetland with support and guidance.  It involves chatting with older adults, creating a stimulating environment for them such as booking entertainment or organising an alternative activity.  Also day trips.\n\n## Description\n\nThis is an opportunity to work with other volunteers to run Social Clubs at various locations throughout Shetland with support and guidance. \r\nDuties include:\r\nchatting with older adults / booking entertainment such a music, talks, photography / Organising activities such as board games / Arranging day trips for example visiting a museum / taking a register / handling money / reporting any concerns about an elderly person / booking transport.\r\n\r\nVolunteers arrive early to set up and stay to finish up any activity.\n\n## Experience required\n\nGood communication skills, experience of working with the elderly, basic numeracy skills.\n\n## Frequency commitment details\n\nVolunteers arrive early to set up and stay to finish up any activity.\n\n## Travel details\n\nVarious throughout Shetland\n\n## Travel expenses\n\nTravel expenses will be reimbursed.",
                    "requiresEmergencyParticipation": false,
