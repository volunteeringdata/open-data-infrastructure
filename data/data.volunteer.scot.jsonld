        {
            "id": "https://data.volunteer.scot/Organisation/0011p00001UAn1RAAT",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0011p00001UAn1RAAT/the-john-rae-society",
            "name": "The John Rae Society",
            "description": "The John Rae Society is dedicated to advancing the recognition of the life and achievements of John Rae as the discoverer of the final navigable link of the Northwest Passage and one of the greatest arctic explorers. \r\n\r\nWe plan to restore the Hall of Clestrain where he was born and open it to the public. This will allow us to better promote several facets of the Orkney-Canada relationship, including telling the story of the life of the many Orkney men who served in the Hudson Bay Company in the Northwest Territories, of Rae's respect for the native peoples and their customs, and their traditions and skills in surviving the harsh climate of the area.",
            "website": "https://www.johnraesociety.com/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC044463"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F5a74edf0-42d3-9142-5777-fd444e3b9634%2Fy4Y6e60YtRQisjNIjB79rsh2Vsl1%2Fuser-upload.jpg?alt=media&token=7c726105-bd58-43b7-a07a-47a0f58b2fd8",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Heritage",
                    "skos:prefLabel": "Heritage"
