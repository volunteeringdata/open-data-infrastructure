            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g2400000As9HvAAJ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g2400000As9HvAAJ/shop-assistant",
                    "publishStart": "2017-11-21",
                    "publishEnd": "2027-05-11",
                    "title": "Shop Assistant",
                    "description": "## Summary\n\nDEBRA is a charity that supports individuals and families affected by Epidermolysis Bullosa (EB), a painful genetic skin blistering condition which can be fatal. By joining us, you not only support the cause but learn retail work, all by working in a friendly environment. Ideal for people with a language barrier.\n\n## Description\n\nDuties include: Meeting and greeting customers, cleaning, steaming clothes, merchandising shop floor & identifying rags, pricing and general retail work.\n\n## Experience required\n\nNone\n\n## Training details\n\nHealth and Safety, content of employee terms, working procedures. customer service and general retail.\n\n## Travel details\n\nUnit 18/20, the Toll, Clarkston, Glasgow, G76 7BG\n\n## Travel expenses\n\nExpenses not paid",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F6f956cbc-581a-0f3f-8639-c162b8a493b7%2FZTpsVM2s6uO1kBK4LhzHjps4n472%2Flisting.jpg?alt=media&token=62306682-5db9-4909-bbac-94dfbde7d41c",
