                        "id": "https://data.volunteer.scot/Activity/a0gQD00000FcGzBYAV#role",
                        "type": "Role",
                        "title": "Charity Shop Volunteer - Dalgety Bay",
                        "description": "Good communication and attention to detail\r\nAn aptitude for team working\r\nStrong organisational skills\r\nA good understanding of what makes great customer service\r\nThe ability to represent CHAS enthusiastically and appropriately",
