            "id": "https://data.volunteer.scot/Organisation/00124000008nbHLAAY",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbHLAAY/the-prince-and-princess-of-wales-hospice",
            "name": "The Prince and Princess of Wales Hospice",
            "description": "The Hospice provides care for patients with a life limiting illness and support for those close to them. This is carried out through a range of services including in patient ward, day services, out patients and family support.",
            "website": "https://www.ppwh.org.uk",
            "charityRegistration": [
                {
