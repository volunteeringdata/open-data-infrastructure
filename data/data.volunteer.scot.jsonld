            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZB1AAM/yusuf-youth-initiative",
            "name": "Yusuf Youth Initiative",
            "description": "The Yusuf Youth Initiative is a dynamic youth led organization aspiring to nurture leaders of tomorrow.  We provide enriching programs incorporating accreditation in sports, volunteering and the development of social action projects that will encourage young people from the BME community to grow, strive and become change makers in a vibrant and changing society.",
            "website": "https://www.yyi.org.uk",
