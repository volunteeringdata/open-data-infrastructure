        {
            "id": "https://data.volunteer.scot/Organisation/0012400001OzHofAAF",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400001OzHofAAF/spinal-injuries-scotland",
            "name": "Spinal Injuries Scotland",
            "website": "https://opportunities.volunteerglasgow.org/profile/SpinalInjuriesScotland",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HlquDYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HlquDYAR/social-volunteerdriver",
                    "publishStart": "2026-07-15",
                    "publishEnd": "2027-01-13",
                    "title": "Social Volunteer/Driver",
                    "description": "## Description\n\nAs a social volunteer you will be part of the current volunteer team workingalongside the peer support staff and will be supporting the charity in. activities such as coffee meets, social evenings at the Queen Elizabeth National Spinal Injuries Unit (QENSIU). We hold other events such as, the annual BBQ at Castle Semple and other outings and also taking part in fundraising events alongside the team.\r\n\r\nKey Responsibilities\r\nTo provide practical support to the staff and work alongside current volunteers on the team\r\nAttend social activities to assist and help with planning.\r\nPromote our services and free membership to patients and members\n\n## Experience required\n\nBe a good communicator. Be non-judgmental and able to respect individuals’ disability, cultural, religious and ethnic backgrounds.\r\nBe outgoing, friendly, approachable, patient and sensitive.\r\nThe charity requires and will apply for a Protection of Vulnerable Group (PVG) Membership in relation to working with vulnerable adults. The charity will apply for this on your behalf.\r\nPromote the values and ethos of Spinal Injuries Scotland\n\n## Training details\n\nFull induction & training\r\nWe cover out of pocket expenses.\r\nRegular training and flexible remote working arrangements\r\nRelevant training and development of skills\r\nThe opportunity to make a real difference.\n\n## Travel details\n\nQueen Elizabeth Hospital, Glasgow",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000HlquDYAR#role",
                        "type": "Role",
                        "title": "Social Volunteer/Driver",
                        "description": "Be a good communicator. Be non-judgmental and able to respect individuals’ disability, cultural, religious and ethnic backgrounds.\r\nBe outgoing, friendly, approachable, patient and sensitive.\r\nThe charity requires and will apply for a Protection of Vulnerable Group (PVG) Membership in relation to working with vulnerable adults. The charity will apply for this on your behalf.\r\nPromote the values and ethos of Spinal Injuries Scotland",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000HlquDYAR/social-volunteerdriver?#modal_register_a0gQD00000HlquDYAR",
                        "allowsRemoteParticipation": false,
