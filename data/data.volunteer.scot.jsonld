            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00108000039a66UAAQ/brain-tumour-research",
            "name": "Brain Tumour Research",
            "description": "We are the only national charity in the UK focused on finding a cure for all types of brain tumours through campaigning to increase the national investment in brain tumour research to £35 million per year, while fundraising to create a network of seven sustainable Brain Tumour Research Centres of Excellence across the UK.",
            "website": "https://www.braintumourresearch.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC046840"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FundraisingFunding",
                    "skos:prefLabel": "Fundraising / Funding"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
                    "skos:prefLabel": "Health"
