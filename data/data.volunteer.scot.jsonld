        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZR3AAM",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZR3AAM/archie-child-bereavement-service",
            "name": "ARCHIE Child Bereavement Service",
            "description": "ARCHIE Child Bereavement Service provide direct support to bereaved children and young people throughout Grampian.\r\n\r\nWe offer a wide range of services, which are carefully tailored to suit the individual needs of the child and their family. We recognise that every child is different and we believe that with appropriate support, information and guidance all children and young people will manage their grief.",
            "website": "https://www.archie.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC040712"
                }
            ],
            "cause": [
                {
