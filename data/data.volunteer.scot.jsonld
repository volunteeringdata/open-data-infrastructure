        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nZ1KAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nZ1KAAU/voluntary-action-east-renfrewshire-scio",
            "name": "Voluntary Action East Renfrewshire SCIO",
            "description": "Voluntary Action East Renfrewshire (SCIO) connects and supports volunteering, social enterprising activity and voluntary groups to make East Renfrewshire a better place to live",
            "website": "https://www.va-er.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC028103"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F3e920bf3-a2a0-6f26-0dfd-bd36b68e3c80%2FmQsKXYYIupgt1ub9BeDSGFfo1O33%2Fuser-upload.jpg?alt=media&token=ada2e50b-efbb-431c-92f0-fa2a9570a4a9",
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000068pJYAQ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000068pJYAQ/walking-and-strength-balance-activity-volunteer",
                    "publishStart": "2023-10-10",
                    "publishEnd": "2027-05-11",
                    "title": "Walking and Strength & Balance Activity Volunteer",
                    "description": "## Description\n\nThe Community Hub East Renfrewshire is leading health and wellbeing activities in collaboration with East Renfrewshire Health & Social Care Partnership.  The aim is to encourage adults to join in activities that support their health and wellbeing, such as walks or chair-based exercise, whilst meeting new friends and enjoying spaces in their community.\r\n\r\nWe are looking for Volunteer Walk Leaders and Strength & Balance facilitators across East Renfrewshire.\r\n\r\nThe benefits of becoming involved:\r\n* Develop your knowledge and skills surrounding activities within the local community and increased activity from regular walks\r\n* Increase your confidence\r\n* Socialise and establish new friendships\r\n* Have fun\r\n* Full training will be provided\r\n\r\nNew volunteers can expect:\r\n* On-going support from the Community Hub\r\n* An opportunity to meet new people and make new friends\r\n* A chance to help others to enjoy local walks\r\n\r\nTime commitment:\r\nAt least one hour each week to support the activities.\n\n## Training details\n\n* Training to help you lead a healthy walk\r\n* Strength and balance training\r\n\r\nScottish Charity, Walking Scotland and The Community Hub provide training.  Other relevant training may also be available and is always free for volunteers to attend.\n\n## Frequency commitment details\n\nAt least one hour each week to support the activities\n\n## Travel details\n\nThe activities take place across East Renfrewshire with volunteers placed to the activity and area that most suits them.  Whilst the programme aims to build on existing activities, we also support volunteers to develop new activities within their community that they feel would benefit their local area.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F71ef2f66-5e7a-4111-be7e-99ca7e17d7e6%2FZTpsVM2s6uO1kBK4LhzHjps4n472%2Flisting.jpg?alt=media&token=e560c7bb-cd16-41bb-8b8f-9ab9dabdf240",
