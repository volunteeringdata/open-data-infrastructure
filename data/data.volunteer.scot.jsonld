        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nX2hAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nX2hAAE/double-l-centre-management-committee",
            "name": "Double L Centre Management Committee",
            "description": "The aims and objectives of the Committee are: (a) To promote the benefit of the inhabitants of the neighbourhood without distinction of sex or political, religious or other opinions by associating with the local authorities, voluntary organisations and local community in a common effort to advance education and provide facilities in the interest of Social Welfare for recreation and leisure time occupation with the object of improving the conditions of life of the community resident in Linnvale and surrounding area. (b) The Committee shall be non-party in politics and non-sectarian in religion. (c) To maintain and manage a centre for activities promoted by the Committee in furtherance of the above objectives. (d) To foster a community spirit in the neighbourhood for the achievement of these and other such objects as may by law be deemed to be charitable.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC021477"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityFacilities",
