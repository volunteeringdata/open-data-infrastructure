        {
            "id": "https://data.volunteer.scot/Organisation/0012400000cy1hRAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0012400000cy1hRAAQ/brain-tumour-charity-the",
            "name": "Brain Tumour Charity (The)",
            "description": "The Brain Tumour Charity is the world’s leading brain tumour charity and the largest dedicated funder of research into brain tumours globally.\r\n\r\nCommitted to saving and improving lives, we’re moving further, faster to help every single person affected by a brain tumour. We’re set on finding new treatments, offering the highest level of support and driving urgent change. And we’re doing it right now. Because we understand that when you, or someone you love, is diagnosed with a brain tumour – a cure really can’t wait.",
            "website": "https://www.thebraintumourcharity.org",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC045081"
                }
            ],
            "cause": [
                {
