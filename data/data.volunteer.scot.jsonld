        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nbRzAAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nbRzAAI/linknet-mentoring",
            "name": "LINKnet Mentoring",
            "description": "LINKnet Mentoring Ltd is a voluntary sector mentoring project established to help minority ethnic people living in Edinburgh and the Lothian. We aim to help people from Ethnic Minorities get into jobs, education and also with their Personal Development and integration into the society. LINKnet aims to increase representation of minority ethnic people in further and higher education, employment, public and civic life of Scottish society through a structured one to one mentoring programme which is free to join. \r\n\r\n\r\nOne of the main aim of LINKnet is to enhance the quality of life of individuals by improving their personal circumstances so that they are better able and better prepared to attain their goals in the areas of education, employment and personal development. The project also hopes to achieve a collective impact on the minority ethnic community as a whole in their struggle to be better represented in all spheres of life. LINKnet's long-term ambition is to see an equitable Scottish society in which everyone can plays their part and feels part of the wider Scottish community.",
            "website": "https://www.linknetmentoring.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC029440"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BlackMinorityEthnic",
                    "skos:prefLabel": "Black / Minority Ethnic"
                },
                {
