            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000009xZm9YAE",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000009xZm9YAE/cancer-transport-driver-volunteer",
                    "publishStart": "2025-05-06",
                    "publishEnd": "2027-03-09",
                    "title": "Cancer Transport Driver Volunteer",
                    "description": "## Description\n\nTransport volunteers are like the friend you can call on for a lift.  There is a shortage of transport to essential cancer treatment appointments from many areas of Falkirk and by offering this transport, you’ll be helping people in your community by taking them to and from appointments.  Use your driving skills and friendly personality to help people and be an important link in your community.\r\n\r\nRVS are looking for Volunteer Transport Drivers to drive patients to their cancer treatment appointments, supporting and accompanying them during their radiotherapy/chemotherapy, as appropriate.\r\n\r\nVolunteers will need to use their own vehicle to offer a friendly journey, supporting people to and from their home and destination. You'll will build relationships with the people you drive for. \r\n\r\nA Volunteer uniform is available and an ID badge will be provided.\n\n## Experience required\n\nFriendly personality with empathy and understanding\r\nFull driving license required \r\nFully taxed and insured vehicle\r\nEffective communication skills\r\nReliable and committed \r\nConfidential and discreet\n\n## Training details\n\nOnline training will be provided by Royal Voluntary Service, alongside our onboarding process. This will include us applying for a PVG membership for all new Volunteers through Disclosure Scotland.\n\n## Frequency commitment details\n\nYou will have complete flexibility in the amount of time and the days you are willing to commit to. We will discuss journey plans in advance before you commit to them.\n\n## Travel details\n\nDrivers and clients will be based within the Falkirk Council area. Appointments are most likely to be Edinburgh or Glasgow.\n\n## Travel expenses\n\nMileage expenses will be paid at the rate stated in the expenses policy, currently 55p per mile.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD000009xZm9YAE#role",
                        "type": "Role",
                        "title": "Cancer Transport Driver Volunteer",
                        "description": "Friendly personality with empathy and understanding\r\nFull driving license required \r\nFully taxed and insured vehicle\r\nEffective communication skills\r\nReliable and committed \r\nConfidential and discreet",
                        "commitment": "You will have complete flexibility in the amount of time and the days you are willing to commit to. We will discuss journey plans in advance before you commit to them.",
                        "applyLink": "https://my.royalvoluntaryservice.org.uk/opportunities",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
