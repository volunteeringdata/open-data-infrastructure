        {
            "id": "https://data.volunteer.scot/Organisation/00124000008naLdAAI",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008naLdAAI/royal-voluntary-service",
            "name": "Royal Voluntary Service",
            "description": "RVS. aims to help people maintain independence and dignity in their own homes and communities, particularly in later life. This strategy places increased emphasis on:  - Food delivered to the home - Extending the service we provide in hospitals to include not just   cafes and shops but also patient support and get-you-home   service - Community help schemes that support independence for older   and housebound people at home and in their community -  Emergency services to support those vulnerable through    national or other disasters",
            "website": "https://www.royalvoluntaryservice.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC038924"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
