        {
            "id": "https://data.volunteer.scot/Organisation/00124000008ndy9AAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ndy9AAA/hanover-scotland",
            "name": "Hanover Scotland",
            "description": "Our purpose is to provide simple solutions for life, helping older people to feel safe and secure at home and to lead fulfilling and independent lives. We will aim to exceed our customers expectations and to provide high quality personalised services that enhance their quality of life",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC014738"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2Fba30c361-0249-19e8-3745-e328420967af%2FUC59fMqTlUgceOwgyfCxCWOzN1y2%2Fuser-upload.jpg?alt=media&token=d153f185-a52b-4d36-a25d-eb4d9cd50427",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/HousingAssociation",
                    "skos:prefLabel": "Housing Association"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/OlderPeople",
                    "skos:prefLabel": "Older People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000FdHWcYAN",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000FdHWcYAN/volunteer-befriender",
                    "publishStart": "2026-02-27",
                    "publishEnd": "2026-11-26",
                    "title": "Volunteer Befriender",
                    "description": "## Description\n\nThe Volunteer Befriender helps residents who feel isolated or unable to get out very easily on their own by giving time on a one to one basis to help a person maintain social contact, provide companionship and reduce loneliness and social isolation.  Volunteer befrienders build a positive relationship with an individual and visit them on a regular basis in their own flat.  This could mean spending some time with a person for an hour or two every week/fortnight, we also encourage getting out and about for a coffee or short walk.  Generally, befrienders are there to chat and get to know someone, have fun, support the person to continue with existing interests, whilst encouraging them to embark on new activities.\r\n\r\nSkills & Experience:\r\nNo qualifications are necessary.  We are looking for volunteers who are interested in working with older people, have good communication and listening skills and are reliable and willing to work as part of a team.\r\n\r\nBenefit of Volunteering:\r\n* Helping older people in your community to stay connected and to be less socially isolated\r\n* Helping older adults in your community to remain active and independent\r\n* Personal development\r\n* Making new friends\r\n* Valuable experience for work in care\r\n\r\nTime Commitment:\r\n* Once a week/fortnight/month\r\n* Monday – Sunday, am & pm\n\n## Travel details\n\nMurray Place, Barrhead, East Renfrewshire - local transport",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fb70a763d-1df6-4363-8fcf-2327fe002663%2FUC59fMqTlUgceOwgyfCxCWOzN1y2%2Flisting.jpg?alt=media&token=988a25c1-b1bd-4fe4-9227-e6352c907730",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000FdHWcYAN#role",
