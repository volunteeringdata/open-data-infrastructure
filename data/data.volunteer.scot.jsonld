                            "https://ns.volunteeringdata.io/TrainingProvided"
                        ]
                    },
                    "session": {
                        "type": "Session",
                        "location": [
                            {
                                "type": "Location",
                                "name": "G74 2HP",
                                "address": "G74 2HP",
                                "latitude": 55.762529055176564,
                                "longitude": -4.162642444535823,
                                "simd": "https://data.volunteer.scot/Geography/SIMD/G742HP"
