            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JNZDbYAP",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JNZDbYAP/health-and-care-volunteer-falkirk",
                    "publishStart": "2026-11-03",
                    "publishEnd": "2027-02-05",
                    "title": "Health and Care Volunteer (Falkirk)",
                    "description": "## Description\n\nWe would like you to:\n\nBe available to volunteer on a regular basis.\nShifts available Monday to Sunday, between 7am and 10pm.\nIdeally be available to volunteer for a minimum of 4 hours per week.\nSupport people in their own homes by providing companionship, practical assistance, wellbeing support, and connections to local services that promote independence, confidence, and community engagement.\nHave held a driving licence for at least 2 years which allows you to drive vehicles in the UK. Have access to your own vehicle.\nBe able to commit to volunteering for a minimum of 12 months.\n\n## Experience required\n\nWarm and friendly with empathy for others.\nGood communication and listening skills.\nEncouraging and supportive.\nEnjoy meeting and spending time with new people.\nAble to work independently and as part of a team.\n\n## Travel details\n\nBy car.\n\n## Travel expenses\n\nAs a volunteer, you can claim travel and other out-of-pocket expenses",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-volunteerscotland-search.appspot.com/o/opportunities%2FJRjkAPjCnPXRrETvld9RRVxLqpa2%2FCRIbno8MAQS07k2e-thumbnail.jpg?alt=media&token=0ad75ddf-266e-41fd-98a2-9bb3b58af56a",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000JNZDbYAP#role",
