        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000gqB0vYAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000gqB0vYAE/muir-is-tir",
            "name": "Muir is Tir",
            "description": "Addresses the challenges of coastal change for island communities, through co-created, nature-based approaches to coastal stewardship.  It will have direct impacts on the participating communities in Barra and Vatersay, who aim to develop the skills and knowledge that will allow them to, manage the changing coastline.",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
