                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000APzIfYAL",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000APzIfYAL/near-you-volunteer",
                    "publishStart": "2025-06-17",
                    "publishEnd": "2027-02-10",
                    "title": "Near You Volunteer",
                    "description": "## Description\n\nOur in-person volunteers welcome people to our services. They have a chat with visitors, find out what service or information they’re looking for. Help us offer a free, in-person drop-in service for people who have hearing loss or tinnitus, or want to get their hearing checked. Our volunteers support hearing aid users by cleaning their hearing aids and replacing batteries and tubing. They provide tips for getting the most from hearing aids.\r\n\r\nDon’t worry if you don’t have experience maintaining hearing aids. We give our volunteers full training so they’re knowledgeable and confident setting up and using the hearing aid maintenance kit\n\n## Experience required\n\nfriendly and reliable\n\n## Travel expenses\n\nexpenses paid by bank transfer on a monthly basis",
                    "requiresEmergencyParticipation": false,
                    "role": {
