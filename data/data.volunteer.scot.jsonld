            "dc:source": "https://volunteer.scot/organisations/00124000008nZoqAAE/gorebridge-community-development-trust",
            "name": "Gorebridge Community Development Trust",
            "description": "Gorebridge Community Development Trust is a charitable, non-profit body which delivers projects with Gorebridge and the surrounding area. It is an independent, volunteer and community-led organisation which is part of a large network of Development Trusts in Scotland.",
            "website": "http://gorebridge.org.uk",
            "charityRegistration": [
