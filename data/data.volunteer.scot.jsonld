        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000cLYFRYA4",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000cLYFRYA4/dundee-dragons-wheelchair-sports-club",
            "name": "Dundee Dragons Wheelchair Sports Club",
            "description": "The club’s structure affords support to players, coaches and volunteers to enable personal growth and development of skills which can lead to employment and into further education, as well as contributing towards the reduction in social isolation and increased wellbeing.\r\n\r\nFurthermore the Dundee Dragons model is helping to increase levels of physical activity, enhance self-esteem, from participation to performance and providing the families and extended families with a long term purpose many of them thought they would never have.",
            "website": "https://www.dundeedragons.net",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC046015"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/LearningDisability",
                    "skos:prefLabel": "Learning Disability"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/MentalHealth",
                    "skos:prefLabel": "Mental Health"
                },
                {
