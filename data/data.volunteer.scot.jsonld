                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000008WGbJYAW",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000008WGbJYAW/volunteer-van-driver-van-provided",
                    "publishStart": "2026-08-17",
                    "publishEnd": "2027-02-10",
                    "title": "Volunteer Van Driver (Van Provided)",
                    "description": "## Description\n\nAre you over 30 with a full UK driving licence and a passion for helping others? Mamacita Foundation is looking for a Volunteer Van Driver to support our food bank and community outreach programs.\n\n## Experience required\n\nFull UK driving licence (held for at least 1 year)\nNo convictions or claims on your driving record\nReliable, responsible, and committed to making a difference\n\n## Frequency commitment details\n\nDeliver food parcels and essential items to individuals and families in need.\nCollect surplus food  and donations within Aberdeen.\n\n## Travel details\n\nHilton Convention Centre",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-volunteerscotland-search.appspot.com/o/opportunities%2FrCwMyvl0W5amNTM7QlAVsy0VOmz2%2FnQUWQnVk2HMjfl6p-thumbnail.jpg?alt=media&token=300e4006-4f3b-4e56-b6d4-5c5672a7babd",
