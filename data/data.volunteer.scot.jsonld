        {
            "id": "https://data.volunteer.scot/Organisation/001QD000013T1ADYA0",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD000013T1ADYA0/scottish-legal-aid-board",
            "name": "Scottish Legal Aid Board",
            "description": "The Scottish Legal Aid Board manages legal aid in Scotland. Legal aid is state-funded legal help and representation for people who cannot afford to pay for a solicitor themselves, it is a non-departmental public body responsible to the Scottish Government.",
            "website": "https://www.slab.org.uk/",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/LawAndJustice",
                    "skos:prefLabel": "Law and Justice"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000J4wvJYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000J4wvJYAR/lay-members-required-for-the-the-childrens-quality-assurance-committee",
                    "publishStart": "2026-10-28",
                    "publishEnd": "2026-11-30",
                    "title": "Lay Members required for the the Children's Quality Assurance Committee",
                    "description": "## Description\n\nTo participate in the oversight and consideration of peer review reports presented to the Committee about individual solicitors and helping to decide if a solicitor should pass such a review. Also to contribute to the development of the Children’s Quality Assurance Scheme by bringing forward ideas as the scheme progresses and adapts to current circumstances.\n\n## Experience required\n\nStrong analytical skills with the ability to exercise sound judgement in relation to the handling of complex and sensitive issues.\r\nGood interpersonal skills with the ability to communicate effectively with a wide range of people.\r\nThe ability to work constructively as part of a team in a board committee environment, with the confidence and independence of thought to challenge and test proposals on decisions made by the committee.\r\nThe ability to interpret and evaluate substantial volumes of (often complex) information effectively with the ability to devise pragmatic solutions.\r\nA basic comprehension of the Children’s Hearings System, associated court proceedings and the legal profession in Scotland.\r\nA good understanding of the requirements of  professional competence\r\nAn understanding of quality assurance and peer review schemes and the ability to evaluate professional standards\r\nCommitted to the ethos of public service\r\nCommitted to diversity in public service\n\n## Training details\n\nwill be given online\n\n## Frequency commitment details\n\nhalf day Tuesday afternoon (2pm - 4pm) every second month (February, April, June, August, October & December)\n\n## Travel details\n\nn/a remote meeting\n\n## Travel expenses\n\nvolunteer position although travel expenses will be paid",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000J4wvJYAR#role",
                        "type": "Role",
                        "title": "Lay Members required for the the Children's Quality Assurance Committee",
                        "description": "Strong analytical skills with the ability to exercise sound judgement in relation to the handling of complex and sensitive issues.\r\nGood interpersonal skills with the ability to communicate effectively with a wide range of people.\r\nThe ability to work constructively as part of a team in a board committee environment, with the confidence and independence of thought to challenge and test proposals on decisions made by the committee.\r\nThe ability to interpret and evaluate substantial volumes of (often complex) information effectively with the ability to devise pragmatic solutions.\r\nA basic comprehension of the Children’s Hearings System, associated court proceedings and the legal profession in Scotland.\r\nA good understanding of the requirements of  professional competence\r\nAn understanding of quality assurance and peer review schemes and the ability to evaluate professional standards\r\nCommitted to the ethos of public service\r\nCommitted to diversity in public service",
                        "commitment": "half day Tuesday afternoon (2pm - 4pm) every second month (February, April, June, August, October & December)",
                        "applyLink": "https://www.slab.org.uk/news/three-non-solicitor-members-needed-for-childrens-quality-assurance-committee/",
                        "allowsRemoteParticipation": true,
