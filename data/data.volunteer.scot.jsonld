        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nX9JAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nX9JAAU/barnardos",
            "name": "Barnardo's",
            "description": "At Barnardo's we believe in children - no matter who they are, what they have done or what they may have been through.  We will ensure their needs are met and their voices heard.",
            "website": "https://www.barnardos.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC037605"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/AdviceInformation",
                    "skos:prefLabel": "Advice / Information"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Children",
                    "skos:prefLabel": "Children"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/FamilySupport",
                    "skos:prefLabel": "Family Support"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/YoungPeople",
                    "skos:prefLabel": "Young People"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000G7GV3YAN",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000G7GV3YAN/charity-retail-volunteers",
                    "publishStart": "2026-03-31",
                    "publishEnd": "2027-04-05",
                    "title": "Charity Retail Volunteers",
                    "description": "## Description\n\nOur amazing team of vibrant and diverse volunteers helps us run over 500 shops. Our stores sell lots of great donated and new goods to help raise vital funds to make a real difference to disadvantaged children, young people and families across the UK. \r\n\r\nOur retail stores are the face of our charity on the high street and in local communities. We have loads of amazing stock donated to us every week, and this all needs to be sorted, tagged and out on the shop floor for sale!\r\n\r\nPlease contact:\r\nSharon Lay\r\nVolunteer Recruitment Support Officer\r\nE: sharon.lay@barnardos.org.uk\r\nT: 07594781343\n\n## Training details\n\nBefore commencing volunteering in our stores, all applicants will complete online training in disciplines such as health and safety, safeguarding and data protection. All of these courses are fully certified. They will receive 'On the Job' practical training in store.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F16d218db-bd6f-4515-9292-b3f3241988fc%2FJqK8q7mcUtcgywKvmhEW9RRQbgy1%2Flisting.jpg?alt=media&token=7a16350e-38f5-42ff-9ba2-4a3681f41c03",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000G7GV3YAN#role",
