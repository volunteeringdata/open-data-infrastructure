        {
            "id": "https://data.volunteer.scot/Organisation/0010800002xlTcSAAU",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/0010800002xlTcSAAU/long-covid-scotland",
            "name": "Long Covid Scotland",
            "description": "Long Covid Scotland is a volunteer-led charity run by people living with Long Covid on behalf of those living with Long Covid. \r\n\r\nWe collectively advocate on employment and benefits, research and local and national policy. We are derived from Long Covid Support, a successful charity and campaign with over 55, 0000 members, represented at Independent SAGE, the ISARIC global research forum, and the All-Party Parliamentary Group on Coronavirus.\r\n\r\nWe are advocating for rehab, research and recognition for people living in Scotland. We have partnerships with various organisations, including Scottish Government, Health and Social Care Alliance Scotland, and various universities. We are keen to develop new partnerships, including with other chronic illness groups and charities.",
            "website": "https://www.longcovid.scot/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC052053"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Health",
