            "dc:source": "https://volunteer.scot/organisations/001QD00000lACJVYA4/hi-scot-credit-union",
            "name": "HI-Scot Credit Union",
            "description": "The Mission of HI-Scot Credit Union is to provide ethical, value for money, safe, community based and inclusive financial services to our members.",
            "website": "https://www.hi-scot.com",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CreditUnionsCommunityBanking",
