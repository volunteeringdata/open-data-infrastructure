            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JQuwVYAT",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JQuwVYAT/activity-supporter-volunteers-at-aye-aye-club-asn-social-club-for-age-15-25-year-olds",
                    "publishStart": "2026-11-13",
                    "publishEnd": "2027-04-30",
                    "title": "Activity Supporter Volunteers at Aye Aye Club (ASN social club for age 15-25 year olds)",
                    "description": "## Summary\n\nAye Aye Club is a social club for young people with additional support needs (age 15-25).   Are you interested in making a difference by helping young people with additional support needs to feel included, valued and supported?  Would you like to gain experience and develop valuable skills in supporting young people?  Then this opportunity is for you!   \r\n\r\nAt Aye Aye Club you will have the chance to:-\r\n- Meet new people, build friendships and become part of a welcoming inclusive club where everyone belongs.\r\n- Be part of a rewarding team, working alongside other friendly volunteers while making a positive contribution to your local community.\r\n- Grow your confidence in communicating with and supporting others.\r\n- Develop teamwork, communication, patience and problem-solving skills.\r\n- Have fun!  Get involved in games, activities, outings and plenty of laughter.\r\n- Feel rewarded.  Enjoy seeing young people grow in confidence, independence and friendships.\r\n- Volunteers will receive an informal induction to introduce them to Aye Aye Club, its activities, and the needs of the young people attending. They will be given guidance on their role, safeguarding, health and safety, and appropriate support strategies.  Ongoing support will be provided by the club organisers, with opportunities to ask questions, share experiences and discuss any concerns. Additional training will be offered where appropriate to help volunteers feel confident and supported in their role.\r\n\r\nWe meet in Bridge of Don Community Centre, once a week during term time, on Monday evenings from 19:00 until 21:00.   The Community Centre is in the same building as Bridge of Don Academy, Braehead Way, Aberdeen, AB22 8RR which is served by the No.1 First Bus Route or there is car parking available.\r\n\r\nIf interested please get in touch by emailing ayeaye.club.fitlike@gmail.com, we would be delighted to hear from you.  You don't need special skills to make a special difference.  Just bring your enthusiasm, kindness and willingness to get involved!\n\n## Description\n\nAye Aye Club is a social club for young people with additional support needs (age 15-25).   Are you interested in making a difference by helping young people with additional support needs to feel included, valued and supported?  Would you like to gain experience and develop valuable skills in supporting young people?  Then this opportunity is for you!   \r\n\r\nAt Aye Aye Club you will have the chance to:-\r\n- Meet new people, build friendships and become part of a welcoming inclusive club where everyone belongs.\r\n- Be part of a rewarding team, working alongside other friendly volunteers while making a positive contribution to your local community.\r\n- Grow your confidence in communicating with and supporting others.\r\n- Develop teamwork, communication, patience and problem-solving skills.\r\n- Have fun!  Get involved in games, activities, outings and plenty of laughter.\r\n- Feel rewarded.  Enjoy seeing young people grow in confidence, independence and friendships.\r\n- Volunteers will receive an informal induction to introduce them to Aye Aye Club, its activities, and the needs of the young people attending. They will be given guidance on their role, safeguarding, health and safety, and appropriate support strategies.  Ongoing support will be provided by the club organisers, with opportunities to ask questions, share experiences and discuss any concerns. Additional training will be offered where appropriate to help volunteers feel confident and supported in their role.\r\n\r\nWe meet in Bridge of Don Community Centre, once a week during term time, on Monday evenings from 19:00 until 21:00.   The Community Centre is in the same building as Bridge of Don Academy, Braehead Way, Aberdeen, AB22 8RR which is served by the No.1 First Bus Route or there is car parking available.\r\n\r\nIf interested please get in touch by emailing ayeaye.club.fitlike@gmail.com, we would be delighted to hear from you.  You don't need special skills to make a special difference.  Just bring your enthusiasm, kindness and willingness to get involved!\n\n## Training details\n\nExcellent support and guidance is provided to all volunteers. \r\n\r\nVolunteers will receive an informal induction to introduce them to Aye Aye Club, its activities, and the needs of the young people attending. They will be given guidance on their role, safeguarding, health and safety, and appropriate support strategies.  Ongoing support will be provided by the club organisers, with opportunities to ask questions, share experiences and discuss any concerns. Additional training will be offered where appropriate to help volunteers feel confident and supported in their role.\n\n## Frequency commitment details\n\nWe meet in Bridge of Don Community Centre, once a week during term time, on Monday evenings from 19:00 until 21:00.\n\n## Travel details\n\nWe meet in Bridge of Don Community Centre, once a week during term time, on Monday evenings from 19:00 until 21:00.   The Community Centre is in the same building as Bridge of Don Academy, Braehead Way, Aberdeen, AB22 8RR which is served by the No.1 First Bus Route or there is car parking available.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F0aa7748e-a2a5-48e8-9d9d-7a2b3c55e65a%2FcHXvvp9V29hwqnv9fenQAWCTB5N2%2Flisting.jpg?alt=media&token=51b9834e-928f-413d-a37b-96e0b95cfb87",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000JQuwVYAT#role",
                        "type": "Role",
                        "title": "Activity Supporter Volunteers at Aye Aye Club (ASN social club for age 15-25 year olds)",
                        "commitment": "We meet in Bridge of Don Community Centre, once a week during term time, on Monday evenings from 19:00 until 21:00.",
