                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD000001wVqrYAE",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD000001wVqrYAE/escort-for-afternoon-tea",
