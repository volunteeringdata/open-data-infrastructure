        {
            "id": "https://data.volunteer.scot/Organisation/001QD00000QjiPNYAZ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/001QD00000QjiPNYAZ/next-chapter-scotland",
            "name": "Next Chapter Scotland",
            "description": "Next Chapter Scotland exists to help anyone in Scotland who has been involved with the criminal justice system to navigate the stigma and discrimination that they can face throughout their lives.\r\n\r\nOur vision is of a society that no longer judges people based on their worst choices but, instead, sees them as they are today.\r\n\r\nOur mission is to help people in Scotland who have been involved with the criminal justice system to navigate the stigma and discrimination they can face.",
            "website": "https://www.nextchapterscotland.org.uk/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC052899"
                }
            ],
            "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FAccount%2F2a3b0c62-5995-4f6f-a9e9-64a123c51373%2FWkLzgT1VE9cAHEWcVMpdVMd5bL63%2Fuser-upload.jpg?alt=media&token=8df00f7b-dc1e-478e-8d97-cb218b335b83",
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/OffendersExOffenders",
                    "skos:prefLabel": "Offenders / Ex-Offenders"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000JUA2DYAX",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000JUA2DYAX/outreach-volunteer-edinburgh",
                    "publishStart": "2026-11-05",
                    "publishEnd": "2027-05-06",
                    "title": "Outreach Volunteer - Edinburgh",
                    "description": "## Description\n\nWe’re looking for compassionate, reliable volunteers to join our Next Chapter Scotland Outreach team in Edinburgh. This service supports people and families affected by the justice system offering information, advocacy and a listening ear when it’s needed most.\r\n\r\nWhat’s involved:\r\nWe are looking for volunteers to promote our service in various community venues across Edinburgh.\r\n\r\n- Two full days of initial training\r\n- Ongoing support and optional further training if you’d like to grow your role\r\n- Lived experience of the criminal justice system (your own or through a family) is especially valued\r\n- No PVG required\r\n\r\nYou’ll be part of a supportive, trauma-informed team helping people take the next step in their journey.\r\n\r\nIf you’d like to learn more or get involved, send us a message or email info@nextchapterscotland.org.uk\n\n## Experience required\n\nA friendly, inclusive attitude.\n\n## Travel details\n\nTravel expenses are available where required.\n\n## Travel expenses\n\nTravel expenses are available where required.",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000JUA2DYAX#role",
