            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000BualfYAB",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000BualfYAB/volunteer-business-consultant",
                    "publishStart": "2026-09-02",
                    "publishEnd": "2027-03-03",
                    "title": "Volunteer Business Consultant",
                    "description": "## Description\n\nHave a passion to shape your community or assist local people?  \r\nGot skills to help an organisation change the world? \r\nWant to gain extra experience that will benefit your career development?\r\nSported is recruiting volunteers with professional or real-life experience. \r\nWe’ll connect you with a grassroots organisation that will value your knowledge. \r\nYou bring insight and enthusiasm. \r\nWe’ll offer support and guidance – so you can transform lives.\n\n## Experience required\n\nSported is looking for skills and professional experience in any of the following:\r\n- Business & Strategic Planning\r\n- Facilities Management & Asset Transfer\r\n- Financial Management\r\n- Fundraising & Income Generation\r\n- Governance\r\n- Inclusion\r\n- Leadership Coaching & Mentoring\r\n- Marketing & Communications\r\n- Evaluation & Impact Measurement\r\n- Environmental Sustainability\r\n- Sports Development\r\n- Volunteer & Staff Management\r\n- Legal\r\n- Project Management\n\n## Training details\n\nInduction, training opportunities and local support available.\n\n## Frequency commitment details\n\n2 - 3 hours per month maximum.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2Fd77ec5ac-7cc4-4f8f-a323-a108d7667238%2FliLEC2s9ZwYA46gEa6AxGTVGunx2%2Flisting.jpg?alt=media&token=ef7626ef-dd78-46a5-ba5c-0d84dca82286",
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000BualfYAB#role",
                        "type": "Role",
                        "title": "Volunteer Business Consultant",
