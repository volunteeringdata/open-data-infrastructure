            "dc:source": "https://volunteer.scot/organisations/0012400000gapjmAAA/abilitynet",
            "name": "AbilityNet",
            "description": "AbilityNet aims to make the benefits of computers available to adults and children with disabilities to enable them to use a computer at home, in education or in employment. AbilityNet provides a wide range of services to individuals, professionals in the field of disability, employers and the public sector.",
            "website": "https://www.abilitynet.org.uk",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
