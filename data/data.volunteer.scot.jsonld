            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0g0800000QhjUUAAZ",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0g0800000QhjUUAAZ/macmillan-community-buddy",
                    "publishStart": "2023-07-04",
                    "publishEnd": "2027-02-01",
                    "title": "Macmillan Community Buddy",
                    "description": "## Summary\n\nBring your listening and communication skills to support people living with cancer to feel less isolated and lonely and to help with practical tasks that they are temporarily having trouble with. Together, we can be right there for people with cancer.\n\n## Description\n\nBring your listening and communication skills to support people living with cancer to feel less isolated and lonely and to help with practical tasks that they are temporarily having trouble with. Together, we can be right there for people with cancer.\r\n\r\n· Providing face-to-face support in the community or in people’s homes to alleviate loneliness and help with simple practical tasks\r\n· Adopting a non-judgemental and supportive approach to understand the needs and concerns of people living with cancer \r\n· Supporting 1-3 people living with cancer every week for up to 12 visits \r\n· Completing post call ‘records of activity’ reports and using all required systems \r\n· Joining group catch up calls every 4-6 weeks to get key updates and/or share good practice \r\n· Volunteering within agreed hours and following all best practice guidelines \r\n· Signposting to additional support if required and raising any further concerns with the Macmillan team\n\n## Experience required\n\n· Good listener and clear communicator\r\n· Patient, flexible and reliable\r\n· Ability to respect others’ differences and choices\r\n· Ability to demonstrate empathy and understanding while maintaining boundaries\r\n· Ability to recognise when to ask for support\r\n· Ability to work independently with guidance and support\r\n· Understand the need to maintain confidentiality\r\n· Ability and willingness to travel in your local area\r\n· Good IT skills in order to access required systems and resources\n\n## Training details\n\nThe training consists of both self-directed online learning and 'live' online group training and will take a combined total of approximately 10 hours to complete. You will need to complete this training within 6 weeks of submitting your application.\n\n## Frequency commitment details\n\n2-4 hours a week.\n\n## Travel details\n\nTravel within a 20 mile radius.\n\n## Travel expenses\n\nMacmillan will reimburse volunteers’ reasonable expenses necessarily incurred for travelling in the performance of duties of their employment. For example, to events, external meetings, training etc.\n\n## Taster details\n\nSign up for an Information session: https://www.smartsurvey.co.uk/s/7AVLWC/",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0g0800000QhjUUAAZ#role",
                        "type": "Role",
                        "title": "Macmillan Community Buddy",
                        "description": "· Good listener and clear communicator\r\n· Patient, flexible and reliable\r\n· Ability to respect others’ differences and choices\r\n· Ability to demonstrate empathy and understanding while maintaining boundaries\r\n· Ability to recognise when to ask for support\r\n· Ability to work independently with guidance and support\r\n· Understand the need to maintain confidentiality\r\n· Ability and willingness to travel in your local area\r\n· Good IT skills in order to access required systems and resources",
                        "commitment": "2-4 hours a week.",
                        "applyLink": "https://volunteer.scot/search/a0g0800000QhjUUAAZ/macmillan-community-buddy?#modal_register_a0g0800000QhjUUAAZ",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18",
