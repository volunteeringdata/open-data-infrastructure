        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nWqtAAE",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nWqtAAE/voluntary-action-south-ayrshire",
            "name": "Voluntary Action South Ayrshire",
            "description": "Voluntary Action South Ayrshire (VASA) is the local Third Sector Interface. It is recognised by Scottish Government and South Ayrshire Council as fulfilling a key role in ensuring the continued development of a robust Third Sector in South Ayrshire.\r\n\r\nAs VASA has been created from an amalgamation of Volunteer Centre South Ayrshire (VCSA) and Council for Voluntary Organisations in Kyle and Carrick (CVOKC) it is founded on a wealth of experience gained during decades of work with Third Sector organisations, agencies and groups operating in South Ayrshire.",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC028234"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/CommunityDevelopment",
                    "skos:prefLabel": "Community Development"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Volunteering",
                    "skos:prefLabel": "Volunteering"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000HtB7VYAV",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000HtB7VYAV/saltire-awards-youth-ambassador",
                    "publishStart": "2026-08-13",
                    "publishEnd": "2027-03-01",
                    "title": "Saltire Awards Youth Ambassador",
                    "description": "## Summary\n\nBecome a Youth Ambassador for the Saltire Awards in South Ayrshire and encourage your peers to become volunteers!\n\n## Description\n\nWe're looking for young people in South Ayrshire to become Saltire Ambassadors - could this be you?\r\n\r\n\r\nAs a Saltire Ambassador, you will work in a team of young people to help local charities and causes get more young volunteers. You will also help pupils at your school learn about the Saltire Awards and the benefits of volunteering. This is a fun and exciting role which will involve:\r\n\r\n- A commitment of 1 evening meet-up per month in addition to organising in-school events and activities\r\n- Support and training on topics such as Youth Voice, Social Media Marketing, Mental Health, and Intersectionality\r\n- Using your own skills and creativity to encourage your peers to volunteer (pupils in previous groups have organised Christmas donations projects, planned intergenerational days, spoke in their school assemblies about volunteering, made social media content, and even hosted large events like the annual Saltire Awards Ceremony in Ayr Town Hall!)\r\n\r\n\r\nThis role is open to all young people aged 11-25 in South Ayrshire who have an interest in volunteering and who would like to help us show more young people how they can make a difference in their community.\r\n\r\n\r\nPlease get in touch if you would like to know more!\n\n## Experience required\n\nMust have previous experience of volunteering.\n\n## Frequency commitment details\n\nParticipants will be invited to in-person activities and will have the opportunity to take on additional volunteering activity, such as creating social media content, in their own time.\n\n## Travel details\n\nThe monthly meetings are hosted in the Ayr Office but a hybrid option is available for anyone who cannot make it in person. Travel expenses are reimbursed.\n\n## Taster details\n\nA short meeting with our Youth Officer, Megan, is available to any young person who is interested in joining.",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F94002dd6-d146-4eae-8a0a-70e82a90dce5%2FpTiNohf96BSsIZ8wtD0Y4L5FPnh1%2Flisting.jpg?alt=media&token=1e25c75c-801a-470b-b8f3-4cee502aa003",
                    "role": {
