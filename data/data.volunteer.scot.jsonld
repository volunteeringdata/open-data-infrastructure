        {
            "id": "https://data.volunteer.scot/Organisation/00124000008ndklAAA",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ndklAAA/mcr-pathways",
            "name": "MCR Pathways",
            "description": "MCR Pathways was founded in 2007 to address the outcome gap between care-experienced young people and their peers. We support young people, who have experienced disadvantage, to realise their full potential through education. We do this through our school-based mentoring programme – matching young people with a fully trained volunteer mentor.\r\n\r\nOur vision is that every care-experienced young person, or those who have experienced disadvantage, get the same education outcomes, career opportunities and life chances as every other young person.",
            "website": "https://mcrpathways.org/",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC045816"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/BefriendingMentoring",
                    "skos:prefLabel": "Befriending / Mentoring"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/EducationLearningTraining",
                    "skos:prefLabel": "Education / Learning / Training"
                }
            ],
            "activity": [
                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000Hms9BYAR",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000Hms9BYAR/mcr-pathways-mentor-thurso-high-school",
                    "publishStart": "2026-07-20",
                    "publishEnd": "2027-01-18",
                    "title": "MCR Pathways Mentor - Thurso High School",
                    "description": "## Description\n\nBecome a volunteer mentor with MCR Pathways. Share one hour a week with a young person at a secondary school local to you. Provide support and encouragement, to help them realise their talents, potential and build their confidence towards a positive post-school destination. \r\n\r\nThe young people on the mentoring programme are usually in S3 to S6, and are living with a disadvantage which may create a barrier to their education. This could be social work involvement, living with a breavement, dealing with addiction issues at home, or being a young carer. Each young person and situation is unique, and we carefully match mentors to young people based on experiences, interests and personality. \r\n\r\nOur mentors are from all walks of life, with a range of life experiences and all ages (over 21). We ask for our volunteers to be a reliable and consistent support to one young person for a minimum of one school year.\n\n## Training details\n\n1 hour per week, in school term time",
                    "requiresEmergencyParticipation": false,
                    "image": "https://firebasestorage.googleapis.com/v0/b/scvo-org.appspot.com/o/milo%2FVolunteering_Opportunity__c%2F0ad9d3ae-2891-4343-9d1d-0d05c03fca47%2FtXGTItWBZHZ8aDJWAo6mP9Z951U2%2Flisting.jpg?alt=media&token=fa0fec54-f31e-4a9b-b034-53976a8782ef",
