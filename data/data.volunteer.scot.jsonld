            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008ncSfAAI/saline-and-steelend-environmental-group",
            "name": "Saline and Steelend Environmental Group",
            "description": "Saline and Steelend Environment Group runs a variety of initiatives in the local community, including The Drying Green Garden, which is open to the public to enjoy and volunteer.",
            "cause": [
                {
