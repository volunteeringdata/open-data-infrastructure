                {
                    "id": "https://data.volunteer.scot/Activity/a0gQD00000BVruYYAT",
                    "type": "Activity",
                    "dc:source": "https://volunteer.scot/search/a0gQD00000BVruYYAT/advice-lice-cost-of-living",
                    "publishStart": "2026-09-07",
                    "publishEnd": "2027-03-01",
                    "title": "Advice Lice Cost of Living",
                    "description": "## Description\n\nThe Advice Line team offer a single point of access to our services and offer support to people to manage their condition and live life to the full.\r\n\r\nJoin our Advice Line team who offer a single point of access to our services and offer support to people to manage their condition and live life to the full.\r\n\r\nYou will provide information and guidance via telephone and/or video call to people affected by Chest, Heart, Stroke or Long Covid conditions who are experiencing financial issues in relation to their health condition. You will provide information and guidance to help people understand what benefits they may be entitled to in support of them receiving the correct level of support. This support will include listening and understanding their needs and signposting to external agencies.\n\n## Experience required\n\nReliable and committed\r\nExcellent listening and communication skills\r\nPatient & empathic qualities\r\nEncouraging & Supportive\r\nAbility to volunteer independently with guidance and support\r\nRespectful of the opinions of others\r\nUnderstand the need for confidentiality\r\nAbility to maintain boundaries\r\nComfortable to use IT equipment and data bases for the purpose of the role (training and support will be provided)\r\nAbility to commit to initial and ongoing training and development\r\nAmbassador for Chest, Heart & Stroke Scotland",
                    "requiresEmergencyParticipation": false,
                    "role": {
                        "id": "https://data.volunteer.scot/Activity/a0gQD00000BVruYYAT#role",
                        "type": "Role",
                        "title": "Advice Lice Cost of Living",
                        "description": "Reliable and committed\r\nExcellent listening and communication skills\r\nPatient & empathic qualities\r\nEncouraging & Supportive\r\nAbility to volunteer independently with guidance and support\r\nRespectful of the opinions of others\r\nUnderstand the need for confidentiality\r\nAbility to maintain boundaries\r\nComfortable to use IT equipment and data bases for the purpose of the role (training and support will be provided)\r\nAbility to commit to initial and ongoing training and development\r\nAmbassador for Chest, Heart & Stroke Scotland",
                        "applyLink": "https://volunteer.scot/search/a0gQD00000BVruYYAT/advice-lice-cost-of-living?#modal_register_a0gQD00000BVruYYAT",
                        "allowsRemoteParticipation": false,
                        "minimumAge": "18"
