        {
            "id": "https://data.volunteer.scot/Organisation/00124000008nhxBAAQ",
            "type": "Organisation",
            "dc:source": "https://volunteer.scot/organisations/00124000008nhxBAAQ/the-haven-centre",
            "name": "The Haven Centre",
            "description": "The diagnosis of a life limiting illness such as cancer,  dementia, multiple sclerosis, motor neurone disease or Parkinson’s disease is a life changing event, not only for the individual but for the whole family and those closest to that person. \n\nThe Haven provides a range of 1:1 and small group based emotional and wellbeing services which are designed to help individuals cope with the physical, emotional and practical aspects of their illness and to enable them to face the future with hope. Support is available through pre-booked in-person appointments from within The Haven centre and/or through telephone and video support calls. \nAll staff are fully trained specialists in their field.\nAll services are free. The Haven are open Monday to Thursday 9am - 4pm.",
            "website": "https://www.thehavencentre.com",
            "charityRegistration": [
                {
                    "registrar": "https://www.oscr.org.uk",
                    "registrationNumber": "SC032130"
                }
            ],
            "cause": [
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Carers",
                    "skos:prefLabel": "Carers"
                },
                {
                    "@id": "https://data.volunteer.scot/Taxonomy/Cause/Counselling",
                    "skos:prefLabel": "Counselling"
                },
                {
