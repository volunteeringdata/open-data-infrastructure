        {
            "id": "545B93CE-48C4-4E5A-B4C2-BC9A2B5596AC",
            "name": "Community on Solid Ground",
            "type": "Organisation",
            "description": "Community on Solid Ground is an active and effective charity that uses sports, education, training, social activities, and mentoring to empower young people to increase their confidence, motivation, skills, employability and quality of life. All of CSG&rsquo;s work is underpinned by the determination to improve the quality of life in the local community, addressing four key indicators:Health and Wellbeing\r\n\r\nCSG combats health issues, such as adolescent depression and obesity, by increasing regular participation in sports activities. By offering healthy eating and cooking workshops and debates on lifestyle choices, we aim to instil positive behaviour leading to long-term healthy lifestyles for our service users.\r\n",
            "applylink": "https://mcrvip.com/volunteers/provider-profile/-yosgorguk",
            "email": "admin@yosg.org.uk",
            "phone": "01618814631",
            "website": "https://mcrvip.com/volunteers/provider-profile/-yosgorguk",
            "location": [
                {
                    "address": "Manley Park Community Centre, York Avenue, Whalley Range",
                    "latitude": 53.448314666748047,
                    "longitude": -2.2705655097961426
                }
            ]
        },
