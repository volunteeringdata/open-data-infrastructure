        {
            "id": "C7FD0B03-65D0-4CCE-BECC-DE0CD98DED56",
            "type": "Organisation",
            "description": "We help people living in Northamptonshire make the best of later life and have a secure and dignified old age. We provide a wide range of services to a growing number of older people, improving their quality of life, promoting independence and preventing frailty, poverty and isolation. \r\n\r\nWe are a local independent charity, proud to be a member of the Age UK partnership of around 130 local charities.\r\n",
            "applylink": "https://volunteerpassport.co.uk/volunteers/provider-profile/AgeUKNorthamptonshire",
