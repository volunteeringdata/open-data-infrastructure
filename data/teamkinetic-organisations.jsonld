        {
            "id": "7BE58EE8-E362-48C2-B6A3-A9B2A6B59DCF",
            "name": "Gardening for Better Mood",
            "type": "Organisation",
            "description": "The idea of developing this project came from my clinical observation. I am a CBT therapist and a psychologist, and while treating people with depression, I have noticed that some people struggle to engage in pleasurable activities. The treatment for depression consists of engaging in pleasurable activities and cognitive restructuring. People struggle with the first part of the intervention because they don&#39;t like to do activities alone or don&#39;t know what they like. So, the idea of this project is to offer CBT sessions where people will learn how to moderate their mood. We will complement the therapy by offering a green space where they can access a wide range of pleasurable activities such as gardening, arts and crafts activities for the garden, building and creating things in the garden such as creating a fire pit, sitting areas, water features and lots more. On top of this, the participants would be part of a small group of people struggling with similar emotional difficulties, which will help normalise their experience and allow them to learn how to accept and regulate their feelings\r\n",
            "applylink": "https://barnetvolunteersc19.co.uk/volunteers/provider-profile/GardeningforBetterMood",
            "email": "contact@gardeningforbettermood.co.uk",
            "phone": "07725181600",
            "website": "https://barnetvolunteersc19.co.uk/volunteers/provider-profile/GardeningforBetterMood",
            "location": [
                {
                    "address": "Mill Hill",
                    "latitude": 51.6133816,
                    "longitude": -0.2463566
                }
            ]
        },
        {
            "id": "9277B06B-B06F-4004-807C-54E436C4E0CE",
