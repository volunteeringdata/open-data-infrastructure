        {
            "id": "69B33C5F-2747-49D0-AE58-8057ECA768EC",
            "name": "SCCCC",
            "type": "Organisation",
            "description": "Established in 1966, SCCCC (Sheffield Churches Council for Community Care) is a multi award winning charity which supports older people (65+) across Sheffield, providing a &#39;helping hand&#39; when they need it most.&nbsp;We work alongside Sheffield City Council, Sheffield Teaching Hospitals and a wide range of statutory and voluntary sector partners to improve wellbeing and reduce isolation and loneliness in the city&#39;s older community.&nbsp;Staff and volunteers provide befriending support through visits and over the phone to help combat loneliness. They also provide a range of practical assistance to older people in their own homes and around admittance or discharge from hospital.&nbsp;More information about our history, ethos and services can be found at www.scccc.co.uk.&nbsp;\r\n\r\nWe currently have the following volunteer opportunities available\r\n\r\nCommunity Based Roles - Friendly Visiting opportunities available all across the city, where you visit an older person in their own home\r\n\r\nHome Based Role - Telephone Supporter opportunities both long and short term available\r\n\r\n&nbsp;\r\n\r\n&nbsp;\r\n",
            "applylink": "https://search.sheffieldvolunteercentre.org.uk/volunteers/provider-profile/SCCCC",
            "email": "volunteers@scccc.co.uk",
            "phone": "07770741936",
            "website": "https://search.sheffieldvolunteercentre.org.uk/volunteers/provider-profile/SCCCC",
            "location": [
                {
                    "address": "Unit 19, President Buildings, Savile Street East,",
                    "latitude": 53.39447021484375,
                    "longitude": -1.4464495182037354
                }
            ]
        },
