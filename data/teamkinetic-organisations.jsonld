        {
            "id": "C9B6D813-34B2-4643-932C-60A0D0DC56D6",
            "name": "Feel Good Festival – RYTC & ESB Partnership",
            "type": "Organisation",
            "description": "RYTC is a creative organisation that supports children, young people, and families through the power of drama, storytelling, and creative arts. We provide accessible, wellbeing-focused programmes that build confidence, connection, and emotional expression in safe, nurturing environments.\r\n\r\nOur work includes drama workshops, creative learning projects, community events, and partnerships that celebrate inclusion, resilience, and personal growth. We believe every child and young person deserves to be seen, heard, and supported &mdash; and that creativity is a powerful tool for wellbeing and positive change.\r\n\r\nRYTC works closely with Education Selection Box&nbsp; to co-create opportunities that inspire young people and strengthen local communities across Warwickshire and the surrounding areas.\r\n",
            "applylink": "https://volunteer.communityactionderby.org.uk/volunteers/provider-profile/FeelGoodFestival–RYTCESBPartnership",
            "email": "thecompleteworkseducation@gmail.com",
