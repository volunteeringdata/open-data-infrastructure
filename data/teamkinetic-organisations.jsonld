        {
            "id": "90847FC8-B6FC-4FF8-8AA6-26156FB65D0D",
            "name": "Jubilee Hospital Radio",
            "type": "Organisation",
            "description": "Jubilee Hospital Radio was established in 1977, the year of Queen Elizabeth II&#39;s Silver Jubilee. We commenced broadcasting a year later on the 25th June 1978, initially from two converted rooms at the former nurses home and we have been providing music and entertainment to the staff and patients of the Princess Elizabeth Hospital ever since. We were the Islands first local radio station until BBC local radio arrived in the Islands in 1982 followed by commercial radio ten years later in 1992.\r\n",
            "applylink": "https://volunteer.gg/volunteers/provider-profile/JubileeHospitalRadio",
