        {
            "id": "999D3B18-7D9F-46DA-A543-D630472F44F5",
            "name": "Food Bank Aid",
            "type": "Organisation",
            "description": "We are a young, inclusive charity providing food, toilitries, and household goods to 30 food banks in North London.\r\n\r\nWe are looking for volunteers to pick &amp; pack in our distribution hub or deliver food to the food banks.\r\n\r\nA fabulous opportunity to work in a place with good vibes and becoming part of the Food Bank Aid family. The hub is a great place to socialise, we have tea, coffee and cakesduring every shift and music to accompany the volunteers. You will have a fulfilling and fun experience at Food Bank Aid!\r\n\r\n&nbsp;\r\n\r\n&nbsp;\r\n",
            "applylink": "https://barnetvolunteersc19.co.uk/volunteers/provider-profile/FoodBankAid",
            "email": "volunteering@foodbankaid.org.uk",
            "phone": "07875750651",
