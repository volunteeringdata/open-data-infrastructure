        {
            "id": "E747F7D9-0266-4792-9CA0-5485178A4B04",
            "name": "Alfriston Outreach Service",
            "type": "Organisation",
            "description": "Alfriston Outreach Service (Also known as Alfriston Day Centre) is providing Coronavirus support for older people in the Royal Borough of Kingston. We offer a wide range of services which include but are not limited to :\r\n\r\nActivity Packs &amp; Letters, Grocery Shopping and Delivery, Providing Hearing Aid Batteries, Collecting and Delivering Prescriptions, Laundry, Nutrition Support (Hot meals), Technology Support, Befriending and Mental Health Support, Crisis Intervention and Appointment Support.&nbsp;\r\n",
            "applylink": "https://opportunities.volunteeringkingston.org.uk/volunteers/provider-profile/AlfristonOutreachService",
            "email": "alfriston_Day@yahoo.co.uk",
