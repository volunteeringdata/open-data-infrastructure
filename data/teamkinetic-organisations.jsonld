        {
            "id": "60B5440B-99D0-4542-B30B-EE99E685627C",
            "name": "CREATE Paisley",
            "type": "Organisation",
            "description": "CREATE Paisley (CREATE) is an innovative youth project in Renfrewshire which seeks to see &lsquo;young people transformed through creativity, community, confidence and finding their voice&rsquo;. CREATE works with young people, primarily ages 12-21, through drop ins, arts workshops, youth voice and activism, arts and wellbeing, mentoring and much more across key areas in Paisley, Johnstone, Linwood and throughout Renfrewshire. CREATE&rsquo;s work is supported by a management team, a trained youth work team, artists and creatives,&nbsp;a dedicated team of volunteers and a number of key partners and funders. Find out more at: www.createpaisley.org.uk.\r\n",
            "applylink": "https://volunteer.engagerenfrewshire.org/volunteers/provider-profile/CreatePaisley",
            "email": "info@createpaisley.org.uk",
            "phone": "0300 365 0321",
            "website": "https://volunteer.engagerenfrewshire.org/volunteers/provider-profile/CreatePaisley",
            "location": [
                {
                    "address": "CREATE Paisley",
                    "latitude": 55.8459363,
                    "longitude": -4.4214242
                }
            ]
        },
