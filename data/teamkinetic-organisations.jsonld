        {
            "id": "5F27DEA6-EBDB-4147-A5C1-0C3ED8612CE6",
            "name": "WMP Creative / Pedal for Scotland 2017",
            "type": "Organisation",
            "description": "Pedal for Scotland returns for our 19th year on 10th September 2017. Pedal for Scotland&rsquo;s main event day will feature the 45 mile Classic Challenge from Glasgow to Edinburgh and the colossal 93 mile Big Belter from Glasgow to Edinburgh using the first 20 miles of the Classic Challenge route. Stay tuned as we announce our Wee Jaunt rides over the coming months!\r\n\r\n&nbsp;\r\n\r\nFor more information about the event visit our website;&nbsp;http://pedalforscotland.org&nbsp;\r\n",
            "applylink": "https://volunteer.glasgowlife.org.uk/volunteers/provider-profile/WMPCreativePedalforScotland2017",
