        {
            "id": "B3B0F4C4-38DE-4D52-9896-184BB7ED5D47",
            "name": "Cambridge & Norfolk Probation Well Being Services",
            "type": "Organisation",
            "description": "Our personal wellbeing services are available to male prison leavers and those on community orders aged 18 plus.\r\n\r\nOur services are designed to help clients integrate into the communities by developing stronger, healthier relationships and interactions with family, friends and wider support networks.\r\n\r\nWe offer a range of&nbsp;one-to-one and group programmes and interventions including:\r\n\r\n\r\n\tCoaching and mentoring\r\n\tPartnerships and specialist legal advice holistically support clients&rsquo; wellbeing\r\n\tSocial capital and personal development.\r\n\r\n",
            "applylink": "https://the-forward-trust.teamkinetic.co.uk/volunteers/provider-profile/NorfolkProbationWellBeingServices",
