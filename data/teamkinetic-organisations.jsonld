        {
            "id": "49DBC05E-386B-428D-80C9-938CE5B21CC4",
            "name": "wishesjust4you CIC",
            "type": "Organisation",
            "description": "At wishesjust4you, we believe in the power of kindness and the magic of dreams. Founded by Bill Stillman and a small group of compassionate individuals, our charity is dedicated to bringing light, joy, and unforgettable moments to children living with lifelong disabilities and life-limiting illnesses. From animal park visits to paragliding adventures, and Art Education, we&rsquo;re here to turn wishes into realities\r\n",
            "applylink": "https://mvda.teamkinetic.co.uk/volunteers/provider-profile/wishesjust4youCIC",
            "email": "bill@wishesjust4you.co.uk",
