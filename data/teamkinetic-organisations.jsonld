        {
            "id": "4BE64A10-ED9B-4B32-B20C-69C1915539CA",
            "name": "The Holly Lodge Centre",
            "type": "Organisation",
            "description": "The Holly Lodge Centre is an education charity in the heart of Richmond Park. We are a hidden treasure, with a beautiful 2 acre nature trail, a Victorian kitchen garden, large picnic garden and 2 Victorian classrooms. We provide learning to primary school children but also specialise in working with those with disabilites, young and old. We teach about plants, pond dipping and habitats, as well as gardening, life in Victorian times and art. Volunteering here is always different but always rewarding!\r\n",
            "applylink": "https://volunteer.wandsworthcarealliance.org.uk/volunteers/provider-profile/-thehollylodgecentreorguk",
            "email": "aking@thehollylodgecentre.org.uk",
            "phone": "02089408730",
            "website": "https://volunteer.wandsworthcarealliance.org.uk/volunteers/provider-profile/-thehollylodgecentreorguk",
            "location": [
                {
                    "address": " Holly Lodge",
                    "latitude": 51.45145,
                    "longitude": -0.283045
                }
            ]
