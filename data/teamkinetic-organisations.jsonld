        {
            "id": "BCA7915E-33E4-48C6-85B2-7413FDC0C462",
            "name": "Runfest",
            "type": "Organisation",
            "description": "RUNFEST is an events management company, holding popular running races in Kew, Richmond and the Kingston area. We are small, family run company and love to provide our runners with a welcoming, fun and enjoyable exerience at our events.&nbsp;\r\n\r\nAny community events like ours cannot happen without the help of volunteers. Volunteer posts vary in time, so even if you have a couple of hours to offer we would love to have you!\r\n\r\nRoles vary from welcome marshals, course marshals, baggage, water-station and finish line volunteers.\r\n\r\nOnce completed you will automatically be added to our volunteer list and we&nbsp;will be in touch to provide you with all the info you need. We will do our upmost best to&nbsp;allocate you the day and time of your choice.\r\n",
            "applylink": "https://opportunities.volunteeringkingston.org.uk/volunteers/provider-profile/Runfest",
            "email": "info@run-fest.com",
            "phone": "07424 214170",
            "website": "https://opportunities.volunteeringkingston.org.uk/volunteers/provider-profile/Runfest",
            "location": [
