        {
            "id": "48D6C0C4-FF13-43DB-8C34-81898180D1AF",
            "name": "Age UK Cheshire",
            "type": "Organisation",
            "description": "Age UK Cheshire is a local organisation working with older people, their families, and their carers to support them in living their best lives. We do this by helping people to combat poverty, relieve social isolation and increase their independence. We want to create a future where every older person in Cheshire has the opportunity to live their best life.\r\n\r\nWe are an independent, local registered charity but work with others, including national&nbsp;Age UK, and other local Age UKs who are all also independent charities.\r\n\r\n&nbsp;\r\n",
            "applylink": "https://volunteernowcwva.com/volunteers/provider-profile/AgeUKCheshire",
