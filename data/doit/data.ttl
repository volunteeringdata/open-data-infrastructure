id:641080bdf4e70ca28bb5e075 :cause id:64093b542eed5dcadba50897,
                                   id:64093b552eed5dcadba508a3;
                            :organisationDescription "Millions of tonnes of good food is wasted by the UK food industry every year. At the same time, millions of people are struggling to afford to eat. Our work addresses these two issues by redistributing food industry surplus, which would otherwise go to waste, to the people who need it most.";
                            :organisationImage <https://s3.eu-west-2.amazonaws.com/doit2.0-production-uploads/OrganizationPicture/9d25ca1a-fc6a-4f6d-9d21-d3677d3a239d_2023-03-14T14:12:13.277Z.jpeg>;
                            :organisationName "FareShare UK";
                            :organisationWebsite <https://fareshare.org.uk/>.
