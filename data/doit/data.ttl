id:6457da82b13fb19f079ef7c9 :activityDescription "A flexible role within a friendly team. You can volunteer from home or come in and join us in person. Admin tasks can be agreed to suit your interests and abilities. Examples include phone calls, data entry and envelope stuffing.";
                            :activityOrganisation id:645653edd3728615d5afef39;
                            :activityTitle "Admin Volunteer".
id:6457da82b13fb19f079ef7ca :address "Erleigh Road, Reading RG1 5LR";
