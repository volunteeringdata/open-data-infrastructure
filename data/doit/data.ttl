id:66633081adf7df6624f0ff8d :cause id:64093b542eed5dcadba50899;
                            :organisationDescription "Our helpline is open every day between 10-am and 10pm on 0300 7729844. The helpline offers emotional and practical support with any anxiety problem, including panic attacks, phobias and OCD. We provide additional services to members. Our website includes resources on anxiety.";
                            :organisationImage <https://s3.eu-west-2.amazonaws.com/doit2.0-production-uploads/OrganizationPicture/a95ab25e-dfe7-42f1-8d65-1348e0d50c4b_2024-06-07T16:08:33.077Z.jpeg>;
                            :organisationName "No Panic";
                            :organisationWebsite <https://nopanic.org.uk/>.
id:6666182a8373775562f5b658 :activityDescription """No Panic are looking for volunteers to write about anxiety for our Content Team.

You will be required to write between 4 and 10 articles a year. Articles could be about anxiety experiences, anxiety management or particular types of anxiety.

Articles will consist of between 500-1000 words. You will be able to decide how many articles you write a year during your interview.""";
                            :activityOrganisation id:66633081adf7df6624f0ff8d;
                            :activityTitle "Content Team Contributor";
                            :allowsRemoteParticipation false.
id:6666182a8373775562f5b659 :address "From Home";
                            :latitude "52.5647271"^^xsd:double;
                            :longitude "-1.4671882"^^xsd:double.
id:6666b7607d17dcc000bee6c9 :cause id:64093b552eed5dcadba508a3;
                            :organisationDescription """Tir Natur is a rewilding charity, set up to address the nature & climate crises in Wales. 
We are working to raise money to buy land for rewilding as a demonstration of what may be achieved. """;
                            :organisationImage <https://s3.eu-west-2.amazonaws.com/doit2.0-production-uploads/OrganizationPicture/4ba18aa8-0d92-42a2-a927-e251683a82b9_2024-06-21T16:55:23.411Z.jpeg>;
                            :organisationName "Tir Natur";
