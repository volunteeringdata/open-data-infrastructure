                            :organisationDescription "WWF-UK is a leading environmental charity working to restore nature and tackle the root causes of biodiversity loss and climate change. It collaborates globally to stop deforestation, protect wildlife, and create a sustainable future for people and the planet.";
                            :organisationImage <https://s3.eu-west-2.amazonaws.com/doit2.0-production-uploads/OrganizationPicture/04017ced-1943-4f3a-9c40-b0f7f5330cc1_2025-05-28T14:16:45.370Z.jpeg>;
                            :organisationName "WWF-UK";
