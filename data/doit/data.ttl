                            :longitude "-2.980835"^^xsd:double.
id:688d26fe15da325528f66c22 :activityDescription "A community theatre in Shrewsbury (UK) needs actors (over 18) to perform a new musical all about Autism and disability awareness, called The Group. We need people to take on singing and/or acting parts in the production. Rehearsals currently are expected to take place Sundays 3:00pm in the Sundorne area of Shrewsbury from August 2025 onwards. This is also ideal for anybody studying a performance-related course or seeking acting experience, or seeking experience working with people with Autism or disabilities. ";
                            :activityOrganisation id:65de69ab18cafe210c7be087;
                            :activityTitle "Acting";
                            :allowsRemoteParticipation false.
id:688d26fe15da325528f66c23 :address "218 Sundorne Road, Shrewsbury";
