                            :latitude "50.966414"^^xsd:double;
                            :longitude "0.09591300000000001"^^xsd:double.
id:6675b8e7f562ef8681953ca8 :activityDescription """We are an organisation of like-minded people in Wales and interest is growing in rewilding.  We meet every month online to discuss plans and activities and agree actions.
We need someone who is keen on the environment and interested in rewilding to take minutes at our monthly meetings and prompt people about the actions they have agreed to take on.
Communication skills are important, as well as accurate note-taking.""";
                            :activityOrganisation id:6666b7607d17dcc000bee6c9;
                            :activityTitle "Admin support";
                            :allowsRemoteParticipation false.
id:6675b8e7f562ef8681953ca9 :address "From Home";
                            :latitude "52.33614730872424"^^xsd:double;
                            :longitude "-3.763081039075162"^^xsd:double.
