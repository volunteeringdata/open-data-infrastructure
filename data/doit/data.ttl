id:64189cc4d38dcacf49621360 :cause id:64093b542eed5dcadba50897;
                            :organisationDescription """Redbourn In Bloom Horticultural Society

Involved in the RHS Anglia in Bloom and Britain in Bloom initiatives to make a better environment for our village""";
                            :organisationImage <https://s3.eu-west-2.amazonaws.com/doit2.0-production-uploads/OrganizationPicture/ae539016-ee62-47f5-ab5e-1d289e58fe17_2023-03-26T18:08:38.723Z.jpeg>;
