                            :organisationImage <https://s3.eu-west-2.amazonaws.com/doit2.0-production-uploads/OrganizationPicture/a649ad61-ddc5-441c-b96b-f825f1c3bea9_2025-01-31T14:11:15.779Z.jpeg>;
