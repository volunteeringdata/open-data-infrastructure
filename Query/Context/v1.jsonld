{
    "@context": {
        "@base": "https://id.volunteeringdata.io/",
        "@vocab": "https://ns.volunteeringdata.io/",
        "volunteering": "https://ns.volunteeringdata.io/",
        "dc": "http://purl.org/dc/terms/",
        "geosparql": "http://www.opengis.net/ont/geosparql#",
        "skos": "http://www.w3.org/2004/02/skos/core#",
        "id": "@id",
        "graph": "@graph",
        "type": "@type",
        "value": "@value",
        "applyLink": { "@type": "@id" },
        "image": { "@type": "@id" },
        "website": { "@type": "@id" },
        "registrar": { "@type": "@id" },
        "publishStart": { "@type": "http://www.w3.org/2001/XMLSchema#date" },
        "publishEnd": { "@type": "http://www.w3.org/2001/XMLSchema#date" },
        "latitude": { "@type": "http://www.w3.org/2001/XMLSchema#double" },
        "longitude": { "@type": "http://www.w3.org/2001/XMLSchema#double" },
        "geosparql:asWKT": { "@type": "http://www.opengis.net/ont/geosparql#wktLiteral" },
        "organisation": { "@type": "@id" },
        "activity": { "@container": "@set", "@type": "@id" },
        "role": { "@container": "@set", "@type": "@id" },
        "session": { "@container": "@set", "@type": "@id" },
        "time": { "@container": "@set", "@type": "@id" },
        "inXSDDateTimeStamp": { "@id": "http://www.w3.org/2006/time#inXSDDateTimeStamp", "@type": "http://www.w3.org/2001/XMLSchema#dateTimeStamp" },
        "location": { "@container": "@set", "@type": "@id" },
        "accessibility": { "@container": "@set", "@type": "@id" },
        "cause": { "@container": "@set", "@type": "@id" },
        "requirement": { "@container": "@set", "@type": "@id" },
        "reward": { "@container": "@set", "@type": "@id" },
        "skill": { "@container": "@set", "@type": "@id" }
    },
    "accessibility": { "@embed": "@always" },
    "cause": { "@embed": "@always" },
    "requirement": { "@embed": "@always" },
    "reward": { "@embed": "@always" },
    "skill": { "@embed": "@always" }
}
