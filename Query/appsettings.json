{
  "QueryService": {
    "SparqlEndpointUri": "http://localhost:5199/sparql"
  },
  "Proxy": {
    "Routes": {
        "1": {
            "ClusterId": "1",
            "Match": {
                "Path": "/sparql",
                "Methods": [
                    "GET"
                ],
                "QueryParameters": [
                    {
                        "Name": "query",
                        "IsCaseSensitive": true,
                        "Mode": "Exists"
                    }
                ]
            }
        },
        "2": {
            "ClusterId": "1",
            "Match": {
                "Path": "/sparql",
                "Methods": [
                    "POST"
                ],
                "Headers": [
                    {
                        "Name": "Content-Type",
                        "Values": [
                            "application/x-www-form-urlencoded",
                            "application/sparql-query"
                        ]
                    }
                ]
            }
        }
    },
    "Clusters": {
      "1": {
        "Destinations": {
          "1": {
            "Address": "http://sparql.example.com/"
          }
        }
      }
    }
  }
}
