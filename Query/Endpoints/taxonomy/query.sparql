BASE <https://id.volunteeringdata.io/>
PREFIX : <https://ns.volunteeringdata.io/>
PREFIX dc: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    :Taxonomy
        a :ConceptScheme ;
        :label ?label ;
        :description ?description ;
        :topConcept ?topConcept ;
    .

    ?topConcept
        :label ?topConceptLabel ;
        :narrower ?concept ;
    .

    ?concept
        a ?topConcept ;
        :label ?conceptLabel ;
    .
}
WHERE {
    :Taxonomy
        dc:title ?label ;
        dc:description ?description ;
        skos:hasTopConcept ?topConcept ;
    .

    ?topConcept skos:prefLabel ?topConceptLabel .

    OPTIONAL {
        { ?concept a ?topConcept . }
        UNION
        { ?concept skos:broader+ ?topConcept . }

        ?concept skos:prefLabel ?conceptLabel .
    }
}
