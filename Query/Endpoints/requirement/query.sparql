BASE <https://id.volunteeringdata.io/>
PREFIX : <https://ns.volunteeringdata.io/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    <Requirement> :requirements ?requirement .

    ?requirement
        :label ?label ;
    .
}
WHERE {
    { [] :requirement ?requirement . }
    UNION
    { ?requirement skos:broader+ :Requirement . }

    ?requirement skos:prefLabel ?label .
}
