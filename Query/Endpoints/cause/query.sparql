BASE <https://id.volunteeringdata.io/>
PREFIX : <https://ns.volunteeringdata.io/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    <Causes> :causes ?cause .

    ?cause
        :label ?label ;
    .
}
WHERE {
    { ?cause a :Cause . }
    UNION
    { ?cause skos:broader+ :Cause . }

    ?cause skos:prefLabel ?label .
}
