.

:WeekdayTimePeriod
    a owl:Class ;
    rdfs:subClassOf :Time ;
    rdfs:isDefinedBy <https://ns.volunteeringdata.io/> ;
    rdfs:comment "A predefined time period within a specific day of the week (morning, afternoon or evening)."@en ;
    rdfs:label "Weekday Time Period"@en ;
.

### Object Properties
:timeSession
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://ns.volunteeringdata.io/> ;
    rdfs:subPropertyOf :session ;
    owl:inverseOf :sessionTime ;
    rdfs:domain :Time ;
    rdfs:range :Session ;
    rdfs:label "time has session"@en ;
.


## Predefined Temporal Entities
:MondayMorning
    a time:TemporalEntity, :Time, :WeekdayTimePeriod ;
    rdfs:isDefinedBy <https://ns.volunteeringdata.io/> ;
    rdfs:label "Monday morning"@en ;
    time:hasBeginning [
        a time:Instant ;
        time:inDateTime [
            a time:GeneralDateTimeDescription ;
            time:dayOfWeek time:Monday ;
            time:hour "6"^^xsd:nonNegativeInteger ;
            time:minute "0"^^xsd:nonNegativeInteger ;
            time:second "0"^^xsd:nonNegativeInteger ;
        ] ;
    ] ;
    time:hasEnd [
        a time:Instant ;
        time:inDateTime [
            a time:GeneralDateTimeDescription ;
            time:dayOfWeek time:Monday ;
            time:hour "12"^^xsd:nonNegativeInteger ;
            time:minute "0"^^xsd:nonNegativeInteger ;
            time:second "0"^^xsd:nonNegativeInteger ;
        ] ;
    ] ;
.

:MondayAfternoon
    a time:TemporalEntity, :Time, :WeekdayTimePeriod ;
    rdfs:isDefinedBy <https://ns.volunteeringdata.io/> ;
    rdfs:label "Monday afternoon"@en ;
    time:hasBeginning [
        a time:Instant ;
        time:inDateTime [
            a time:GeneralDateTimeDescription ;
            time:dayOfWeek time:Monday ;
            time:hour "12"^^xsd:nonNegativeInteger ;
            time:minute "0"^^xsd:nonNegativeInteger ;
            time:second "0"^^xsd:nonNegativeInteger ;
        ] ;
    ] ;
    time:hasEnd [
        a time:Instant ;
        time:inDateTime [
            a time:GeneralDateTimeDescription ;
            time:dayOfWeek time:Monday ;
            time:hour "18"^^xsd:nonNegativeInteger ;
            time:minute "0"^^xsd:nonNegativeInteger ;
            time:second "0"^^xsd:nonNegativeInteger ;
        ] ;
    ] ;
.

:MondayEvening
    a time:TemporalEntity, :Time, :WeekdayTimePeriod ;
    rdfs:isDefinedBy <https://ns.volunteeringdata.io/> ;
    rdfs:label "Monday evening"@en ;
    time:hasBeginning [
        a time:Instant ;
        time:inDateTime [
            a time:GeneralDateTimeDescription ;
            time:dayOfWeek time:Monday ;
            time:hour "18"^^xsd:nonNegativeInteger ;
            time:minute "0"^^xsd:nonNegativeInteger ;
            time:second "0"^^xsd:nonNegativeInteger ;
        ] ;
    ] ;
    time:hasEnd [
        a time:Instant ;
        time:inDateTime [
            a time:GeneralDateTimeDescription ;
            time:dayOfWeek time:Monday ;
            time:hour "24"^^xsd:nonNegativeInteger ;
            time:minute "0"^^xsd:nonNegativeInteger ;
            time:second "0"^^xsd:nonNegativeInteger ;
        ] ;
    ] ;
.

:TuesdayMorning
    a time:TemporalEntity, :Time, :WeekdayTimePeriod ;
    rdfs:isDefinedBy <https://ns.volunteeringdata.io/> ;
    rdfs:label "Tuesday morning"@en ;
    time:hasBeginning [
        a time:Instant ;
        time:inDateTime [
            a time:GeneralDateTimeDescription ;
            time:dayOfWeek time:Tuesday ;
            time:hour "6"^^xsd:nonNegativeInteger ;
            time:minute "0"^^xsd:nonNegativeInteger ;
            time:second "0"^^xsd:nonNegativeInteger ;
        ] ;
    ] ;
    time:hasEnd [
        a time:Instant ;
        time:inDateTime [
            a time:GeneralDateTimeDescription ;
            time:dayOfWeek time:Tuesday ;
            time:hour "12"^^xsd:nonNegativeInteger ;
            time:minute "0"^^xsd:nonNegativeInteger ;
            time:second "0"^^xsd:nonNegativeInteger ;
        ] ;
    ] ;
.

